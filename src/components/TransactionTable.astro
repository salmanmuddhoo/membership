---
// A list of transactions, whatever kind, wherever it is shown (S-1506): a
// person's across every account, or the Society's day. One row per
// transaction; a transfer once, naming the other side.
import { transactionStatusLabel } from '@lib/ledger/labels';
import type { TransactionSummary } from '@lib/ledger/review';
import { formatMoney } from '@lib/payments/money';
import { FILTER, HINT, TABLE, TBODY, THEAD } from '@lib/ui';

interface Props {
  transactions: TransactionSummary[];
  // Shown when the list is not one person's, so the row says whose it is.
  showHolder?: boolean;
  empty: string;
}

const { transactions, showHolder = false, empty } = Astro.props;

const KIND_LABELS: Record<string, string> = {
  deposit: 'Deposit',
  withdrawal: 'Withdrawal',
  transfer_leg: 'Transfer',
  reversal: 'Reversal',
  closure: 'Account closure',
  resignation: 'Resignation',
  demise: 'Demised claim',
};
const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});
// Which way the money went, from the account's side.
function direction(t: TransactionSummary): 'in' | 'out' | '' {
  if (t.kind === 'deposit') return 'in';
  if (t.kind === 'withdrawal') return 'out';
  if (t.kind === 'transfer_leg')
    return t.legDirection === 'credit' ? 'in' : 'out';
  return '';
}
function otherSide(t: TransactionSummary): string | null {
  if (t.kind !== 'transfer_leg') return null;
  if (t.payeeName) return `to ${t.payeeName}`;
  if (!t.counterpartAccountNo) return null;
  const who = t.counterpartHolderName ? `${t.counterpartHolderName} · ` : '';
  return `${t.legDirection === 'credit' ? 'from' : 'to'} ${who}${t.counterpartAccountNo} · ${t.counterpartAccountTypeName}`;
}
const CELL = 'px-2 py-2';
---

<div class={`overflow-x-auto ${FILTER}`}>
  {transactions.length === 0 ? (
    <p class={HINT}>{empty}</p>
  ) : (
    <table class={TABLE} data-sortable>
      <thead class={THEAD}>
        <tr>
          <th class={CELL}>Date</th>
          <th class={CELL}>Reference</th>
          <th class={CELL}>Kind</th>
          {showHolder && <th class={CELL}>Who</th>}
          <th class={CELL}>Account</th>
          <th class={`${CELL} text-right`}>In</th>
          <th class={`${CELL} text-right`}>Out</th>
          <th class={CELL}>Status</th>
          <th class={CELL}>Recorded by</th>
        </tr>
      </thead>
      <tbody class={TBODY}>
        {transactions.map(t => (
          <tr class="text-neutral-800 dark:text-neutral-100">
            <td
              class={`${CELL} whitespace-nowrap`}
              data-sort-value={t.createdAt.toISOString()}
            >
              {dateFormat.format(t.createdAt)}
            </td>
            <td class={CELL} data-sort-value={t.displayReference}>
              <a href={`/transactions/${t.id}`} class="font-medium underline">
                <code class="text-xs">{t.displayReference}</code>
              </a>
              {t.receiptNo && (
                <a
                  href={`/receipts/${t.id}`}
                  class="block text-xs text-neutral-500 underline dark:text-neutral-400"
                >
                  {t.receiptNo}
                </a>
              )}
            </td>
            <td class={CELL} data-sort-value={KIND_LABELS[t.kind] ?? t.kind}>
              {KIND_LABELS[t.kind] ?? t.kind}
              {otherSide(t) && (
                <span class="block text-xs text-neutral-500 dark:text-neutral-400">
                  {otherSide(t)}
                </span>
              )}
              {t.reason && (
                <span class="block text-xs text-neutral-500 dark:text-neutral-400">
                  {t.reason}
                </span>
              )}
            </td>
            {showHolder && (
              <td class={CELL} data-sort-value={t.holderName || t.holderKind}>
                <a href={`/members/${t.holderId}`} class="underline">
                  {t.holderName || t.holderKind}
                </a>
                {t.memberNo && (
                  <span class="block text-xs text-neutral-500 dark:text-neutral-400">
                    {t.memberNo}
                  </span>
                )}
              </td>
            )}
            <td class={CELL}>
              <a href={`/accounts/${t.accountId}`} class="underline">
                {t.accountNo}
              </a>
              {' · '}
              {t.accountTypeName}
            </td>
            <td
              class={`${CELL} text-right tabular-nums`}
              data-sort-value={
                direction(t) === 'in' || t.kind === 'reversal' ? t.amount : ''
              }
            >
              {direction(t) === 'in' && formatMoney(t.amount, t.currency)}
              {t.kind === 'reversal' &&
                `(${formatMoney(t.amount, t.currency)})`}
            </td>
            <td
              class={`${CELL} text-right tabular-nums`}
              data-sort-value={direction(t) === 'out' ? t.amount : ''}
            >
              {direction(t) === 'out' && formatMoney(t.amount, t.currency)}
            </td>
            <td class={CELL}>{transactionStatusLabel(t)}</td>
            <td class={CELL}>{t.capturedByName}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</div>

<script>
  import { wireSortableTables } from '@lib/client/table-sort';

  wireSortableTables();
</script>
