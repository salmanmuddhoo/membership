---
// What the Payments step shows about the Cash Deposit Form (migration 0062,
// officer feedback).
//
// The form itself is a page of its own — /applications/<id>/source-of-fund.
// It used to be laid out inside this box, which asked the applicant to sign
// for a declaration they could not read: it was a line of small print beside
// a button. This is only the gate now: one link out to the form while it is
// still needed, and what is on file once it is done.
//
// It renders no <form> of its own — it sits inside the Payments step's — only
// a hidden checkbox named sourceOfFundFormConfirmed, which the server reads
// (payments.ts's applyCashPaymentRules) as "the form was completed". That is
// checked here from the filed document itself rather than from anything the
// officer ticks: the only evidence the form exists is the form existing.
import { VIEW_BUTTON, DELETE_BUTTON } from '@lib/ui';

interface Props {
  applicationId: string;
  cashThreshold: string;
  formPath: string;
  alreadyFiled: { documentId: string; fileName: string } | null;
}

const { applicationId, cashThreshold, formPath, alreadyFiled } = Astro.props;
---

<div
  data-cash-reminder
  hidden
  class="space-y-3 rounded-lg border border-amber-300 px-3 py-3 text-sm text-amber-900 dark:border-amber-900 dark:text-amber-200"
>
  <input
    type="checkbox"
    name="sourceOfFundFormConfirmed"
    value="true"
    data-cash-form-confirm
    tabindex="-1"
    checked={!!alreadyFiled}
    class="sr-only"
  />

  {alreadyFiled ? (
    <>
      <p class="font-medium">Source of Fund form signed and filed</p>
      <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 text-xs">
        <span>{alreadyFiled.fileName}</span>
        <div class="flex shrink-0 items-center gap-2">
          <button
            type="button"
            data-view-document
            data-document-id={alreadyFiled.documentId}
            class={VIEW_BUTTON}
          >
            View
          </button>
          {/* A real submit, not a script: deleting a filed document is the
              page's own delete-document intent, which audits it and takes the
              file out of SharePoint. formnovalidate because this button has
              nothing to do with the payment fields around it. */}
          <button
            type="submit"
            name="intent"
            value="delete-document"
            formnovalidate
            title="Delete"
            aria-label="Delete the signed form"
            class={DELETE_BUTTON}
          >
            ✕
          </button>
          <input
            type="hidden"
            name="documentId"
            value={alreadyFiled.documentId}
          />
        </div>
      </div>
      <p class="text-xs">Delete it if the applicant needs to sign again.</p>
    </>
  ) : (
    <>
      <p>
        Cash over {cashThreshold} needs a signed Source of Fund form before the
        receipt can be issued.
      </p>
      <p>
        <a
          href={formPath}
          data-source-of-fund-link
          data-application-id={applicationId}
          class="inline-block rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-amber-600"
        >
          Source of fund form
        </a>
      </p>
    </>
  )}
</div>

<script>
  // The amount travels to the form so the figure the applicant signs for is
  // the one about to be taken, rather than a second guess at it. Read off
  // the same Total cell the Payments step keeps live, and refreshed as it
  // changes — a link built once at render would carry a stale figure.
  const link = document.querySelector<HTMLAnchorElement>(
    '[data-source-of-fund-link]'
  );
  const totalCell = document.querySelector<HTMLElement>('[data-payment-total]');

  if (link && totalCell) {
    const base = link.getAttribute('href') ?? '';

    const sync = () => {
      // "MUR 68,500.00" back to "68500.00", which is what the form's own
      // query parameter accepts.
      const digits = (totalCell.textContent ?? '').replace(/[^\d.]/g, '');
      link.href = /^\d+(\.\d{1,2})?$/.test(digits)
        ? `${base}?amount=${encodeURIComponent(digits)}`
        : base;
    };

    sync();
    new MutationObserver(sync).observe(totalCell, {
      childList: true,
      characterData: true,
      subtree: true,
    });
  }
</script>
