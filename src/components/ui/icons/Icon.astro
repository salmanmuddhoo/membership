---
import { Icons } from './icons.ts';

interface Props {
  name: keyof typeof Icons | string;
  class?: string;
}

const { name, class: className = 'size-5 shrink-0' } = Astro.props;
const icon = Icons[name as string];
---

{
  icon && (
    <svg
      class={className}
      viewBox={icon.viewBox ?? '0 0 24 24'}
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {icon.paths.map(d => (
        <path d={d} />
      ))}
    </svg>
  )
}
