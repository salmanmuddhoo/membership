---
// Sub-navigation shared by the reference-configuration pages. Kept in one
// place so a new section appears in every page's nav at once rather than in
// whichever ones were remembered.
import { SECONDARY_SM } from '@lib/ui';

export const CONFIG_SECTIONS = [
  {
    href: '/admin/configuration/membership-types',
    label: 'Membership types',
    blurb: 'Which fields the application form shows, and which are mandatory.',
  },
  {
    href: '/admin/configuration/account-types',
    label: 'Account types',
    blurb: 'Products, their opening amounts, and which one a membership opens.',
  },
  {
    href: '/admin/configuration/fees',
    label: 'Fee schedules',
    blurb: 'What is charged at application, versioned so receipts stay true.',
  },
  {
    href: '/admin/configuration/payment-methods',
    label: 'Payment methods',
    blurb: 'How money is received, and which methods need a reference.',
  },
  {
    href: '/admin/configuration/bank-accounts',
    label: 'Bank accounts',
    blurb: "The Society's own accounts at the bank, and what each stands at.",
  },
  {
    href: '/admin/configuration/checklists',
    label: 'Document checklists',
    blurb: 'Which documents each applicant type and subject must provide.',
  },
  {
    href: '/admin/configuration/workflows',
    label: 'Workflows',
    blurb: 'The approval chain, its steps and the statuses they move through.',
  },
  {
    href: '/admin/configuration/approval-matrix',
    label: 'Approval matrix',
    blurb: 'Which transactions post at once, and which go to a chain.',
  },
  {
    href: '/admin/configuration/notification-templates',
    label: 'Notification wording',
    blurb:
      'What a member is told when their application moves, and by which channel.',
  },
  {
    href: '/admin/configuration/member-app',
    label: 'Member app',
    blurb: 'Which transactions a member may start from the app.',
  },
  {
    href: '/admin/configuration/retention',
    label: 'Retention',
    blurb: 'How long each kind of record is kept before it is disposed of.',
  },
  {
    href: '/admin/configuration/readiness',
    label: 'Readiness',
    blurb: 'Every setting, what it stands at, and who last changed it.',
  },
] as const;

const current = Astro.url.pathname;
---

<nav class="flex flex-wrap gap-2" aria-label="Configuration sections">
  {CONFIG_SECTIONS.map(section => (
    <a
      href={section.href}
      aria-current={current === section.href ? 'page' : undefined}
      class:list={[
        current === section.href
          ? 'rounded-lg px-3 py-1.5 text-sm font-medium text-neutral-800 bg-mint-300 transition'
          : SECONDARY_SM,
      ]}
    >
      {section.label}
    </a>
  ))}
</nav>
