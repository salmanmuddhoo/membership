---
interface Props {
  class?: string;
  alt?: string;
}

// The emblem has a white background and includes the name, so it sits on a
// white rounded badge to read cleanly on both light and dark surfaces.
const { class: className = 'size-10', alt = 'Al Barakah MCSL' } = Astro.props;
---

<span
  class={`inline-flex shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-white ring-1 ring-black/5 ${className}`}
>
  <img
    src="/logo.png"
    alt={alt}
    width="1024"
    height="1024"
    class="h-full w-full object-contain p-1"
    decoding="async"
  />
</span>
