---
// Officer feedback: a way to hide the browser's own chrome (address bar,
// tabs) so more of a small screen — the usual case in the field — is the
// application rather than the browser around it. The Fullscreen API is
// the only way to do that; there is no CSS equivalent.
import Icon from '@components/ui/icons/Icon.astro';
---

<button
  type="button"
  id="fullscreen-toggle"
  aria-label="Enter full screen"
  title="Full screen"
  class="flex h-8 w-8 items-center justify-center rounded-full text-neutral-600 transition hover:bg-neutral-200 dark:text-neutral-400 dark:hover:bg-neutral-800"
>
  <span data-fullscreen-enter class="inline-flex">
    <Icon name="expand" class="size-4.5 shrink-0" />
  </span>
  <span data-fullscreen-exit class="hidden">
    <Icon name="collapse" class="size-4.5 shrink-0" />
  </span>
</button>

<script>
  // Hidden entirely where the API does not exist (an embedded webview,
  // typically) rather than offering a button that can only ever fail.
  const button = document.getElementById('fullscreen-toggle');
  if (button && document.documentElement.requestFullscreen) {
    const enterIcon = button.querySelector<HTMLElement>(
      '[data-fullscreen-enter]'
    );
    const exitIcon = button.querySelector<HTMLElement>(
      '[data-fullscreen-exit]'
    );

    const sync = () => {
      const active = Boolean(document.fullscreenElement);
      enterIcon?.classList.toggle('hidden', active);
      enterIcon?.classList.toggle('inline-flex', !active);
      exitIcon?.classList.toggle('hidden', !active);
      exitIcon?.classList.toggle('inline-flex', active);
      button.setAttribute(
        'aria-label',
        active ? 'Exit full screen' : 'Enter full screen'
      );
    };

    button.addEventListener('click', () => {
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else {
        // Rejected silently if the browser refuses (no user gesture, or a
        // policy denial) — nothing else this button can usefully do about
        // either.
        document.documentElement.requestFullscreen().catch(() => {});
      }
    });
    // The browser itself can also leave full screen — Esc, or its own
    // chrome — without going through this button, so the icon shown here
    // has to track that too, not just what this button last did.
    document.addEventListener('fullscreenchange', sync);
  } else {
    button?.remove();
  }
</script>
