---
import Meta from '@components/Meta.astro';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  viewport?: string;
}

const {
  title = 'Al Barakah MCSL',
  description,
  bodyClass = '',
  viewport,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-pt-16">
  <head>
    <Meta description={description} viewport={viewport} />
    <title>{title}</title>
    {
      /* Set the theme before paint to avoid a flash of the wrong colour scheme. */
    }
    <script is:inline>
      if (
        localStorage.getItem('hs_theme') === 'dark' ||
        (!('hs_theme' in localStorage) &&
          window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body
    class={`flex min-h-screen flex-col bg-neutral-200 text-neutral-800 selection:bg-mint-300 selection:text-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 ${bodyClass}`}
  >
    <slot />
    <script>
      // Only the three Preline components this layout actually uses — the
      // user-menu dropdown, the off-canvas sidebar and the theme toggle —
      // rather than the whole library, which was five times the script to
      // download, parse and run on every page. The non-auto builds, because
      // the auto ones register themselves purely by side effect, and the
      // package does not declare that, so the bundler drops them as unused.
      import HSDropdown from 'preline/plugins/dropdown-non-auto';
      import HSOverlay from 'preline/plugins/overlay-non-auto';
      import HSThemeSwitch from 'preline/plugins/theme-switch-non-auto';
      const init = () => {
        HSDropdown.autoInit();
        HSOverlay.autoInit();
        HSThemeSwitch.autoInit();
      };
      if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', init);
      else init();
    </script>
    <script>
      // A manifest alone does not make a page installable — Chrome and
      // Android also require a registered service worker before they will
      // offer "Add to Home Screen". `navigator.serviceWorker` does not
      // exist on a browser without support (or without HTTPS, which it
      // also requires), hence the guard rather than letting the call throw.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
  </body>
</html>
