---
import BaseLayout from './BaseLayout.astro';
import BrandLogo from '@components/BrandLogo.astro';
import ThemeIcon from '@components/ThemeIcon.astro';
import EnvBadge from '@components/EnvBadge.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { isProductionEnvironment } from '@lib/config';
import { navigationFor } from '@lib/navigation';
import { pendingActionCount } from '@lib/applications/workflow';
import { pendingTransactionCount } from '@lib/ledger/review';

interface Props {
  title?: string;
  heading?: string;
}

const { title = 'Dashboard · Al Barakah MCSL', heading = 'Dashboard' } =
  Astro.props;

const user = Astro.locals.user;
const email = user?.email ?? '';
// The person's name, falling back to the address only before an account has
// been resolved — a name is how a colleague is known, and an address is how
// the system finds them.
const displayName = Astro.locals.principal?.displayName || user?.name || email;
const initial = (displayName.charAt(0) || 'A').toUpperCase();
// What tells one colleague's account from another sharing their name here —
// their role(s), not their address, which nobody in this office needed to
// see to know who they were signed in as.
const roleLabel = Astro.locals.principal?.roleNames.join(', ') || '';

// Navigation is built from the permissions this person actually holds, so a
// link is never shown to someone the middleware would refuse. The permission
// named here must match the one the route declares in
// src/lib/access/authorise.ts — otherwise the menu and the guard disagree, and
// the person meets a refusal page instead of a missing link.
const principal = Astro.locals.principal;
const can = (permission: string) =>
  principal?.permissions.has(permission) ?? false;

// S-611: how many applications are waiting on THIS person right now —
// Regional Manager, Secretary and President each see their own count, live
// off the same query the "Your next step" section on an application itself
// resolves from, not a number stored and incremented by hand. Zero renders
// as no badge at all, same as nothing pending ever having existed. The
// middleware starts the count before the page's own reads (locals
// .pendingActions) so it is usually already in by the time this awaits it.
const applicationsBadge =
  principal && can('application.view')
    ? await (Astro.locals.pendingActions ?? pendingActionCount(principal))
    : 0;
// S-1403: the same for transactions — a badge counts what its own link
// opens, so the President's number on Transactions is the transactions
// waiting on them, and the one on Applications stays the applications.
const transactionsBadge =
  principal && can('transaction.view')
    ? await (Astro.locals.pendingTransactions ??
        pendingTransactionCount(principal))
    : 0;

const navGroups = navigationFor({
  permissions: principal?.permissions ?? new Set<string>(),
  applicationsBadge,
  transactionsBadge,
  production: isProductionEnvironment(),
});

const currentPath = Astro.url.pathname;
---

<BaseLayout title={title} bodyClass="islamic-pattern">
  {/* Sidebar (off-canvas on small screens, fixed on large screens) */}
  <aside
    id="app-sidebar"
    class="hs-overlay hs-overlay-open:translate-x-0 fixed inset-y-0 start-0 z-60 hidden w-64 -translate-x-full transform border-e border-neutral-200 bg-neutral-100 transition-all duration-300 [--auto-close:lg] lg:end-auto lg:bottom-0 lg:block lg:translate-x-0 dark:border-neutral-800 dark:bg-neutral-950"
    role="navigation"
    aria-label="Sidebar"
  >
    <div class="flex h-full flex-col">
      <div class="sidebar-header flex items-center justify-between gap-x-2 px-4 py-4">
        <a
          href="/dashboard"
          class="sidebar-brand-link flex min-w-0 items-center gap-x-2.5 rounded-lg px-2 py-1 transition hover:bg-neutral-200 dark:hover:bg-neutral-900"
        >
          <BrandLogo class="sidebar-brand-logo size-9 shrink-0" alt="" />
          <div class="sidebar-brand-text leading-tight">
            <span class="block text-sm font-bold text-neutral-800 dark:text-neutral-100">
              Al Barakah
            </span>
            <span class="block text-xs text-neutral-500 dark:text-neutral-400">
              MCSL
            </span>
          </div>
        </a>

        <button
          id="sidebar-toggle"
          type="button"
          class="hidden size-8 shrink-0 items-center justify-center rounded-lg text-neutral-500 transition hover:bg-neutral-200 hover:text-neutral-800 lg:inline-flex dark:text-neutral-400 dark:hover:bg-neutral-900 dark:hover:text-neutral-100"
          aria-label="Collapse menu"
          aria-expanded="true"
          aria-controls="app-sidebar"
        >
          <Icon
            id="sidebar-toggle-icon"
            name="chevronLeft"
            class="size-4 shrink-0 transition-transform duration-200"
          />
        </button>
      </div>

      <nav class="min-h-0 flex-1 space-y-4 overflow-y-auto px-3 py-2">
        {navGroups.map(group => (
          <div class="space-y-1">
            {group.label && (
              <p class="nav-group-heading px-3 pt-2 pb-1 text-xs font-semibold tracking-wide text-neutral-400 uppercase dark:text-neutral-500">
                {group.label}
              </p>
            )}
            {group.items.map(item => {
              const active = currentPath.startsWith(item.href);
              return (
                <a
                  href={item.href}
                  title={item.label}
                  aria-current={active ? 'page' : undefined}
                  class={`nav-item flex items-center gap-x-3 rounded-lg px-3 py-2 text-sm font-medium transition ${
                    active
                      ? 'bg-mint-300 text-neutral-800'
                      : 'text-neutral-600 hover:bg-neutral-200 hover:text-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white'
                  }`}
                >
                  <span class="relative flex shrink-0 items-center justify-center">
                    <Icon name={item.icon} class="size-5 shrink-0" />
                    {item.badge && (
                      <span
                        class="nav-badge-dot absolute -top-1 -end-1 hidden size-2.5 rounded-full bg-red-500 ring-2 ring-neutral-100 dark:ring-neutral-950"
                        aria-hidden="true"
                      />
                    )}
                  </span>
                  <span class="nav-label flex-1">{item.label}</span>
                  {item.badge && (
                    <span class="nav-badge-full inline-flex min-w-5 items-center justify-center rounded-full bg-red-500 px-1.5 py-0.5 text-xs font-semibold text-white">
                      {item.badge}
                    </span>
                  )}
                </a>
              );
            })}
          </div>
        ))}
      </nav>

      <div class="sidebar-footer border-t border-neutral-200 px-6 py-4 dark:border-neutral-800">
        <p class="text-xs text-neutral-400 dark:text-neutral-500">
          Internal operations platform
        </p>
      </div>
    </div>
  </aside>

  {/* Backdrop overlay uses Preline's built-in overlay handling on mobile */}

  <div
    id="app-main-wrapper"
    class="flex min-h-screen w-full flex-col transition-[padding-inline-start] duration-200 lg:ps-64"
  >
    {/* Header */}
    <header
      id="app-header"
      class="sticky top-0 z-40 flex items-center gap-x-4 border-b border-neutral-200 bg-neutral-100/90 px-4 py-3 backdrop-blur-md sm:px-6 dark:border-neutral-800 dark:bg-neutral-950/90"
    >
      <button
        type="button"
        class="flex size-9 items-center justify-center rounded-lg text-neutral-600 hover:bg-neutral-200 lg:hidden dark:text-neutral-300 dark:hover:bg-neutral-800"
        aria-label="Open sidebar"
        aria-controls="app-sidebar"
        data-hs-overlay="#app-sidebar"
      >
        <Icon name="menu" class="size-5" />
      </button>

      <h1 class="text-base font-semibold text-neutral-800 dark:text-neutral-100">
        {heading}
      </h1>
      <EnvBadge />

      <div class="ms-auto flex items-center gap-x-2">
        <ThemeIcon />

        {/* User menu */}
        <div class="hs-dropdown relative inline-flex [--placement:bottom-right]">
          <button
            id="user-menu"
            type="button"
            class="hs-dropdown-toggle flex items-center gap-x-2 rounded-full py-1 ps-1 pe-2 text-sm text-neutral-700 hover:bg-neutral-200 dark:text-neutral-200 dark:hover:bg-neutral-800"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label="User menu"
          >
            <span class="bg-mint-300 flex size-8 items-center justify-center rounded-full text-sm font-bold text-neutral-800">
              {initial}
            </span>
            <span class="hidden max-w-40 truncate sm:block">{displayName}</span>
            <Icon name="chevronDown" class="size-4" />
          </button>

          <div
            class="hs-dropdown-menu duration hs-dropdown-open:opacity-100 z-50 hidden min-w-60 rounded-xl border border-neutral-200 bg-neutral-100 p-1 opacity-0 shadow-md transition-[opacity,margin] dark:border-neutral-700 dark:bg-neutral-900"
            role="menu"
            aria-orientation="vertical"
            aria-labelledby="user-menu"
          >
            <div class="px-3 py-2">
              <p class="text-xs text-neutral-500 dark:text-neutral-400">
                Signed in as
              </p>
              <p class="truncate text-sm font-medium text-neutral-800 dark:text-neutral-100">
                {displayName}
              </p>
              {/*
                What tells one colleague's account from another sharing their
                name apart here — not the address, which nobody needed to see
                to know whose account this was.
              */}
              {roleLabel && (
                <p class="truncate text-xs text-neutral-500 dark:text-neutral-400">
                  {roleLabel}
                </p>
              )}
            </div>
            <div class="my-1 border-t border-neutral-200 dark:border-neutral-700"></div>
            <a
              href="/auth/logout"
              data-astro-prefetch="false"
              class="flex w-full items-center gap-x-3 rounded-lg px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-200 dark:text-neutral-300 dark:hover:bg-neutral-800"
              role="menuitem"
            >
              <Icon name="logout" class="size-4" />
              Sign out
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
      <slot />
    </main>
  </div>

  <style is:inline>
    /*
     * Desktop sidebar collapse. Driven by data-sidebar="collapsed" on <html>,
     * set before paint (see BaseLayout.astro) and toggled by the script below,
     * so there is no flash of the wrong width on load. Scoped to the lg
     * breakpoint the sidebar itself already uses — collapsing never applies to
     * the mobile off-canvas drawer.
     */
    @media (min-width: 1024px) {
      html[data-sidebar='collapsed'] #app-sidebar {
        width: 4rem;
      }

      html[data-sidebar='collapsed'] #app-main-wrapper {
        padding-inline-start: 4rem;
      }

      html[data-sidebar='collapsed'] .sidebar-header {
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding-inline: 0.5rem;
      }

      html[data-sidebar='collapsed'] .sidebar-brand-logo {
        width: 1.75rem;
        height: 1.75rem;
      }

      html[data-sidebar='collapsed'] .sidebar-brand-text,
      html[data-sidebar='collapsed'] .nav-group-heading,
      html[data-sidebar='collapsed'] .nav-badge-full,
      html[data-sidebar='collapsed'] .sidebar-footer {
        display: none;
      }

      html[data-sidebar='collapsed'] .nav-item {
        justify-content: center;
        padding-inline: 0.5rem;
      }

      /* Visually hidden, still read aloud: sr-only, while collapsed. */
      html[data-sidebar='collapsed'] .nav-label {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }

      html[data-sidebar='collapsed'] .nav-badge-dot {
        display: block;
      }

      html[data-sidebar='collapsed'] #sidebar-toggle-icon {
        transform: rotate(180deg);
      }
    }
  </style>

  <script is:inline>
    // Desktop sidebar collapse toggle. The width itself is pure CSS, keyed
    // off data-sidebar on <html> (see the style block above and
    // BaseLayout's pre-paint script) — this just flips that attribute,
    // keeps the toggle button's accessible state in sync, and remembers
    // the choice. is:inline (rather than a bundled module) so it always
    // renders straight into the page — the same reasoning as the pre-paint
    // script.
    (function () {
      var html = document.documentElement;
      var toggle = document.getElementById('sidebar-toggle');

      function syncToggle() {
        var collapsed = html.dataset.sidebar === 'collapsed';
        if (!toggle) return;
        toggle.setAttribute('aria-expanded', String(!collapsed));
        toggle.setAttribute(
          'aria-label',
          collapsed ? 'Expand menu' : 'Collapse menu'
        );
      }

      syncToggle();

      if (toggle) {
        toggle.addEventListener('click', function () {
          var collapsed = html.dataset.sidebar === 'collapsed';
          if (collapsed) {
            delete html.dataset.sidebar;
          } else {
            html.dataset.sidebar = 'collapsed';
          }
          try {
            localStorage.setItem('sidebar-collapsed', String(!collapsed));
          } catch {
            // localStorage unavailable (private mode, blocked storage) —
            // the choice just does not persist across visits.
          }
          syncToggle();
        });
      }
    })();
  </script>
</BaseLayout>
