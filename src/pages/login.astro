---
import AuthLayout from '@layouts/AuthLayout.astro';
import BrandLogo from '@components/BrandLogo.astro';
import EnvBadge from '@components/EnvBadge.astro';

// Friendly messages for the two failure cases the /auth routes redirect back with.
const errorCode = Astro.url.searchParams.get('error');
const errorMessage =
  errorCode === 'config'
    ? 'Sign-in is not configured yet. Please contact your administrator.'
    : errorCode === 'auth'
      ? 'We could not sign you in. Please try again.'
      : null;
---

<AuthLayout
  title="Sign in · Al Barakah MCSL"
  description="Sign in to the Al Barakah MCSL operations platform."
>
  <div class="relative z-10 w-full max-w-md">
    {
      /* Full-page background photo, dimmed to ~50% so the card stays readable */
    }
    <div
      class="fixed inset-0 -z-10 bg-cover bg-center bg-no-repeat"
      style="background-image: url('/background.jpg');"
      aria-hidden="true"
    >
    </div>
    <div
      class="fixed inset-0 -z-10 bg-neutral-200/50 dark:bg-neutral-900/50"
      aria-hidden="true"
    >
    </div>

    <div class="mb-6 flex flex-col items-center text-center">
      <BrandLogo class="size-12" />
      <h1 class="mt-4 text-xl font-bold text-neutral-800 dark:text-neutral-100">
        Al Barakah MCSL
      </h1>
      <p class="text-sm text-neutral-500 dark:text-neutral-400">
        Internal Operations Platform
      </p>
      <EnvBadge class="mt-3" />
    </div>

    <div
      class="rounded-2xl border border-neutral-200 bg-neutral-100 shadow-sm dark:border-neutral-800 dark:bg-neutral-950"
    >
      <div class="p-6 sm:p-8">
        <div class="mb-6">
          <h2
            class="text-lg font-semibold text-neutral-800 dark:text-neutral-100"
          >
            Sign in
          </h2>
          <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
            Use your Al Barakah staff account to continue.
          </p>
        </div>

        {
          errorMessage && (
            <div
              class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900/50 dark:bg-red-900/20 dark:text-red-300"
              role="alert"
            >
              {errorMessage}
            </div>
          )
        }

        <a
          href="/auth/login"
          class="bg-mint-300 hover:bg-mint-400 focus-visible:ring-mint-400/50 inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent px-4 py-3 text-sm font-bold text-neutral-800 transition duration-300 focus:outline-hidden focus-visible:ring-3"
        >
          Sign in
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>

    <p class="mt-6 text-center text-xs text-neutral-400 dark:text-neutral-500">
      Al Barakah MCSL — authorised staff only.
    </p>
  </div>
</AuthLayout>
