---
// M7 · Legacy migration (docs/backlog.md): a System Administrator imports
// people straight from the legacy register, a chunk at a time
// (src/lib/migration/batches.ts) so a file of thousands of rows survives a
// closed tab. Direct, no review or approval — the whole batch lands
// approved in one step, per business direction. importMembers itself
// decides member vs. non-member per row (an AB Number makes one a member;
// migration/members.ts's own comment explains why).
import DashboardLayout from '@layouts/DashboardLayout.astro';
import MigrationSummaryTable from '@components/MigrationSummaryTable.astro';
import {
  MigrationError,
  buildImportTemplate,
  checksumBuffer,
  fileBalanceCents,
  parseImportFile,
  validateRows,
  type RowError,
} from '@lib/migration/members';
import {
  batchOutcome,
  runningBatch,
  startMigrationBatch,
} from '@lib/migration/batches';
import { migrationSummary } from '@lib/migration/summary';
import { formatMoney, fromCents, toCents } from '@lib/payments/money';
import {
  BUTTON,
  CARD,
  CARD_OK,
  CARD_TITLE,
  DANGER,
  HINT,
  MUTED,
  PAGE,
  SECONDARY_SM,
  CARD_DANGER,
  CARD_DANGER_TITLE,
  NOTICE,
  NOTICE_ERROR,
  PROGRESS,
  PROGRESS_BAR,
} from '@lib/ui';

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

const principal = Astro.locals.principal!;
const canMigrate = principal.permissions.has('system.migrate_members');

// The template download — its own GET, not a POST, so it is a plain link
// rather than a button that resubmits the whole page.
if (canMigrate && Astro.url.searchParams.has('template')) {
  const buffer = await buildImportTemplate();
  return new Response(buffer, {
    headers: {
      'content-type':
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
      'content-disposition':
        'attachment; filename="member-migration-template.xlsx"',
    },
  });
}

let error: string | null = null;
let rowErrors: RowError[] = [];
// S-710 reconciliation — set when the operator supplies a control total and
// it does not match what was actually imported.
let reconciliation: {
  expectedRows: number | null;
  expectedBalance: number | null; // in cents
  passed: boolean;
  messages: string[];
} | null = null;

if (Astro.request.method === 'POST') {
  if (!canMigrate) {
    error = 'You do not have permission to import members.';
  } else {
    const form = await Astro.request.formData();
    const file = form.get('file');
    const expectedRowsRaw = (
      form.get('expected_rows') as string | null
    )?.trim();
    const expectedBalanceRaw = (
      form.get('expected_balance') as string | null
    )?.trim();

    if (!(file instanceof File) || file.size === 0) {
      error = 'Choose a filled-in template to upload.';
    } else {
      try {
        const buffer = Buffer.from(await file.arrayBuffer());
        const checksum = checksumBuffer(buffer);
        const rows = await parseImportFile(buffer);
        if (rows.length === 0) {
          error = 'No rows were found in that file.';
        } else {
          const { valid, errors } = await validateRows(rows);
          // S-710 control totals, checked against the file before anything
          // is written (QA-22): a mismatch means the file is not the one
          // the totals describe, and importing it first — then saying so —
          // left the operator to undo rows by hand.
          const expectedRows = expectedRowsRaw ? Number(expectedRowsRaw) : null;
          let expectedBalance: number | null = null;
          let totalsUnreadable = false;
          if (expectedRows !== null && !Number.isInteger(expectedRows)) {
            totalsUnreadable = true;
          }
          if (expectedBalanceRaw) {
            try {
              expectedBalance = toCents(expectedBalanceRaw);
            } catch {
              totalsUnreadable = true;
            }
          }
          // What the uploaded file carries, every balance on every row —
          // checked against what the file has, not what a run happened to
          // write (QA-22).
          const fileBalance = fileBalanceCents(rows);
          const messages: string[] = [];
          if (expectedRows !== null && rows.length !== expectedRows) {
            messages.push(
              `Expected ${expectedRows} row${expectedRows === 1 ? '' : 's'}, the file has ${rows.length}.`
            );
          }
          if (expectedBalance !== null && fileBalance !== expectedBalance) {
            messages.push(
              `Expected balance ${formatMoney(fromCents(expectedBalance))}, the file has ${formatMoney(fromCents(fileBalance))}.`
            );
          }
          if (totalsUnreadable) {
            error =
              'Enter the expected rows as a whole number and the expected balance as an amount.';
          } else if (errors.length > 0) {
            rowErrors = errors;
            error =
              `${errors.length} row${errors.length === 1 ? '' : 's'} ` +
              'need fixing before anything is imported. Nothing was written.';
          } else if (messages.length > 0) {
            reconciliation = {
              expectedRows,
              expectedBalance,
              passed: false,
              messages,
            };
          } else {
            const batchId = await startMigrationBatch(
              valid,
              checksum,
              { userId: principal.userId, email: principal.email },
              principal.permissions
            );
            const reconciled =
              expectedRows !== null || expectedBalance !== null;
            return Astro.redirect(
              `/admin/migration?batch=${batchId}${reconciled ? '&reconciled=1' : ''}`
            );
          }
        }
      } catch (err) {
        if (err instanceof MigrationError) {
          error = err.message;
        } else {
          console.error('[admin/migration]', err);
          error = 'That file could not be read. Please try again.';
        }
      }
    }
  }
}

// Everything imported to date, whichever upload brought it.
const toDate = canMigrate ? await migrationSummary() : null;

// A batch already under way — this operator's, or anyone else's — takes
// over the screen: only one import runs at a time.
const running = canMigrate ? await runningBatch() : null;

const batchParam = Astro.url.searchParams.get('batch');
const viewed =
  canMigrate && batchParam && UUID.test(batchParam)
    ? await batchOutcome(batchParam)
    : null;
const reconciled = Astro.url.searchParams.get('reconciled') === '1';

const dateTimeFormat = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'Indian/Mauritius',
});

const progressPct =
  running && running.total > 0
    ? Math.round((running.processed / running.total) * 100)
    : 0;
---

<DashboardLayout title="Migration · Al Barakah MCSL" heading="Migration">
  <div class={PAGE.list}>
    {!canMigrate && (
      <div class={NOTICE}>You do not have permission to import members.</div>
    )}

    {canMigrate && (
      <>
        {running && (
          <section class={CARD} data-batch-progress data-batch-id={running.id}>
            <h2 class={CARD_TITLE}>Importing</h2>
            <p class={`${MUTED} mt-2`} data-batch-rows>
              {running.processed} of {running.total} rows
            </p>
            <div class={`${PROGRESS} mt-2`}>
              <div
                class={PROGRESS_BAR}
                style={`width: ${progressPct}%`}
                data-batch-bar
              />
            </div>
            <p class={`${MUTED} mt-2`} data-batch-counts>
              {running.imported} imported · {running.failed} could not be
              imported
            </p>
            <p class={`${HINT} mt-2`}>
              Started by {running.startedByName ?? 'Unknown'} ·{' '}
              {dateTimeFormat.format(running.startedAt)}
            </p>
            <div class={`${NOTICE_ERROR} mt-3`} data-batch-error hidden></div>
            <button type="button" class={`${DANGER} mt-4`} data-batch-cancel>
              Cancel import
            </button>
          </section>
        )}

        {!running && (
          <section class={CARD}>
            <h2 class={CARD_TITLE}>Import from the legacy register</h2>
            <p class={`${MUTED} mt-2`}>
              Every row is approved as soon as it is imported.
            </p>
            <p class={`${MUTED} mt-2`}>
              In the template, a red heading is required on every row, an amber
              one in some cases (its note says when), a grey one is optional.
              The Instructions sheet lists the rules.
            </p>
            <a
              href="/admin/migration?template=1"
              class={`${BUTTON} mt-4 inline-block`}
            >
              Download the template
            </a>
          </section>
        )}

        {error && <div class={NOTICE_ERROR}>{error}</div>}

        {rowErrors.length > 0 && (
          <section class={CARD_DANGER}>
            <h2 class={CARD_DANGER_TITLE}>Rows to fix</h2>
            <ul class="mt-3 space-y-2 text-sm text-red-800 dark:text-red-200">
              {rowErrors.map(e => (
                <li>
                  <span class="font-medium">
                    {e.sheet}, row {e.rowNumber}
                    {e.legacyCode && ` (${e.legacyCode})`}:
                  </span>{' '}
                  {e.message}
                </li>
              ))}
            </ul>
          </section>
        )}

        {reconciliation && !reconciliation.passed && (
          <section class={CARD_DANGER}>
            <h2 class={CARD_DANGER_TITLE}>
              Reconciliation failed. Nothing was written.
            </h2>
            <ul class="mt-2 space-y-1 text-sm text-red-800 dark:text-red-200">
              {reconciliation.messages.map(m => (
                <li>{m}</li>
              ))}
            </ul>
          </section>
        )}

        {viewed && viewed.progress.status === 'completed' && (
          <section class={CARD_OK}>
            <h2 class={CARD_TITLE}>
              {viewed.progress.imported} of {viewed.progress.total} rows
              imported
            </h2>
            {reconciled && (
              <p class="mt-1 text-sm font-medium text-green-700 dark:text-green-400">
                Reconciliation passed.
              </p>
            )}
            {viewed.added &&
              (viewed.added.total.holders !== 0 ||
                viewed.added.total.amountCents !== 0) && (
                <div class="mt-4">
                  <MigrationSummaryTable summary={viewed.added} />
                </div>
              )}
            {viewed.failures.length > 0 && (
              <>
                <h3 class="mt-4 text-sm font-semibold text-red-800 dark:text-red-200">
                  {viewed.failures.length} could not be imported
                </h3>
                <ul class="mt-2 space-y-1 text-sm text-red-800 dark:text-red-200">
                  {viewed.failures.map(f => (
                    <li>
                      {f.legacyCode}: {f.message}
                    </li>
                  ))}
                </ul>
              </>
            )}
          </section>
        )}

        {viewed && viewed.progress.status === 'cancelled' && (
          <div class={NOTICE}>
            Import cancelled. Everything it had imported was removed.
          </div>
        )}

        {toDate && toDate.total.holders > 0 && (
          <section class={CARD}>
            <h2 class={CARD_TITLE}>Imported so far</h2>
            <div class="mt-3">
              <MigrationSummaryTable summary={toDate} />
            </div>
          </section>
        )}

        {!running && (
          <section class={CARD}>
            <h2 class={CARD_TITLE}>Upload a filled-in template</h2>
            <form
              method="post"
              enctype="multipart/form-data"
              class="mt-4 space-y-4"
              data-migration-form
            >
              <div class="flex items-center gap-3">
                <label class={`${SECONDARY_SM} cursor-pointer`}>
                  Choose file
                  <input
                    type="file"
                    name="file"
                    accept=".xlsx"
                    required
                    data-migration-file
                    class="sr-only"
                  />
                </label>
                <span data-migration-filename class={HINT}>
                  No file selected
                </span>
              </div>
              <fieldset class="rounded-lg border border-neutral-200 p-4 dark:border-neutral-700">
                <legend class="px-1 text-xs font-medium text-neutral-500 dark:text-neutral-400">
                  Control totals (optional — leave blank to skip reconciliation)
                </legend>
                <div class="mt-2 grid grid-cols-1 gap-3 sm:grid-cols-2">
                  <label class="flex flex-col gap-1">
                    <span class="text-xs text-neutral-600 dark:text-neutral-300">
                      Expected rows
                    </span>
                    <input
                      type="number"
                      name="expected_rows"
                      min="0"
                      placeholder="e.g. 250"
                      class="rounded border border-neutral-300 bg-white px-3 py-1.5 text-sm text-neutral-800 dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                    />
                  </label>
                  <label class="flex flex-col gap-1">
                    <span class="text-xs text-neutral-600 dark:text-neutral-300">
                      Expected total balance (Rs)
                    </span>
                    <input
                      type="text"
                      name="expected_balance"
                      placeholder="e.g. 1500000"
                      class="rounded border border-neutral-300 bg-white px-3 py-1.5 text-sm text-neutral-800 dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                    />
                  </label>
                </div>
              </fieldset>
              <button type="submit" class={BUTTON}>
                Import
              </button>
            </form>
          </section>
        )}
      </>
    )}
  </div>
</DashboardLayout>

<script>
  // The native file input writes its own "no file chosen" text in the
  // browser's language — hidden here, and this says it in English instead
  // (CLAUDE.md: English only).
  const input = document.querySelector<HTMLInputElement>(
    '[data-migration-file]'
  );
  const filename = document.querySelector<HTMLElement>(
    '[data-migration-filename]'
  );
  if (input && filename) {
    input.addEventListener('change', () => {
      filename.textContent = input.files?.[0]?.name ?? 'No file selected';
    });
  }
</script>

<script>
  // Drives the "Importing" card: polls step.json a chunk at a time
  // (src/lib/migration/batches.ts, 50 rows a request) and updates the bar
  // in place. Closing the tab only pauses the import — coming back to this
  // page picks the same batch back up.
  interface ChunkProgress {
    status: 'running' | 'completed' | 'cancelled';
    total: number;
    processed: number;
    imported: number;
    failed: number;
  }

  const card = document.querySelector<HTMLElement>('[data-batch-progress]');
  if (card) {
    const batchId = card.dataset.batchId!;
    const rowsEl = card.querySelector<HTMLElement>('[data-batch-rows]');
    const barEl = card.querySelector<HTMLElement>('[data-batch-bar]');
    const countsEl = card.querySelector<HTMLElement>('[data-batch-counts]');
    const errorEl = card.querySelector<HTMLElement>('[data-batch-error]');
    const cancelBtn = card.querySelector<HTMLButtonElement>(
      '[data-batch-cancel]'
    );

    let stopped = false;
    let consecutiveFailures = 0;
    let runPromise: Promise<void> | null = null;

    function showError(message: string) {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    function hideError() {
      if (errorEl) errorEl.hidden = true;
    }

    function applyProgress(progress: ChunkProgress) {
      if (rowsEl) {
        rowsEl.textContent = `${progress.processed} of ${progress.total} rows`;
      }
      if (barEl) {
        const pct =
          progress.total > 0
            ? Math.round((progress.processed / progress.total) * 100)
            : 0;
        barEl.style.width = `${pct}%`;
      }
      if (countsEl) {
        countsEl.textContent = `${progress.imported} imported · ${progress.failed} could not be imported`;
      }
    }

    async function errorMessage(response: Response): Promise<string> {
      try {
        const body = await response.json();
        if (body?.error) return body.error as string;
      } catch {
        // Keep the default message below.
      }
      return 'Something went wrong. Please try again.';
    }

    // Waits out one failure and says whether to try again: five in a row
    // and the operator has to reload rather than this hammering the server.
    async function pause(message: string): Promise<boolean> {
      consecutiveFailures += 1;
      showError(message);
      if (consecutiveFailures >= 5) {
        showError('The import has paused. Reload the page to carry on.');
        return false;
      }
      await new Promise(resolve => setTimeout(resolve, 3000));
      return !stopped;
    }

    async function run(): Promise<void> {
      while (!stopped) {
        const body = new FormData();
        body.set('batchId', batchId);
        let response: Response;
        try {
          response = await fetch('/admin/migration/step.json', {
            method: 'POST',
            body,
          });
        } catch {
          if (!(await pause('Could not reach the server.'))) return;
          continue;
        }
        if (!response.ok) {
          if (!(await pause(await errorMessage(response)))) return;
          continue;
        }
        consecutiveFailures = 0;
        hideError();
        const progress: ChunkProgress = await response.json();
        applyProgress(progress);
        if (stopped) return;
        if (progress.status !== 'running') {
          location.href = `/admin/migration?batch=${batchId}`;
          return;
        }
      }
    }

    runPromise = run();

    cancelBtn?.addEventListener('click', async () => {
      const ok = await window.appConfirm(
        'Cancel this import? Everything it has imported so far is removed.',
        { okLabel: 'Cancel import', danger: true }
      );
      if (!ok) return;
      cancelBtn.disabled = true;
      stopped = true;
      if (runPromise) await runPromise;
      try {
        const body = new FormData();
        body.set('batchId', batchId);
        const response = await fetch('/admin/migration/cancel.json', {
          method: 'POST',
          body,
        });
        if (!response.ok) throw new Error(await errorMessage(response));
        location.href = `/admin/migration?batch=${batchId}`;
      } catch (err) {
        showError(
          err instanceof Error
            ? err.message
            : 'Something went wrong. Please try again.'
        );
        cancelBtn.disabled = false;
        stopped = false;
        runPromise = run();
      }
    });
  }
</script>
