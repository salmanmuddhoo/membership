---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import ConfigNav from '@components/ConfigNav.astro';
import {
  ConfigError,
  createAccountType,
  deleteAccountType,
  listAccountTypes,
  listChecklists,
  listMembershipTypes,
  setAccountTypeEligibility,
  setOpensOnApproval,
  updateAccountType,
} from '@lib/config/reference';
import {
  PAGE,
  CARD,
  CARD_TITLE,
  HINT,
  PANEL,
  INPUT,
  BUTTON,
  BUTTON_SM,
  SECONDARY_SM,
  DANGER_SM,
} from '@lib/ui';

const principal = Astro.locals.principal!;
const canManage = principal.permissions.has('config.manage');

let error: string | null = null;
let notice: string | null = null;

// Both forms carry all five limits (S-1304), so an unticked box is a "no"
// and a blank cap is "no limit" — never "leave it alone".
function limitsFrom(form: FormData) {
  return {
    minimumBalance: String(form.get('minimumBalance') ?? '0'),
    allowsDeposit: form.get('allowsDeposit') === 'on',
    allowsWithdrawal: form.get('allowsWithdrawal') === 'on',
    allowsTransfer: form.get('allowsTransfer') === 'on',
    maximumTransactionAmount:
      String(form.get('maximumTransactionAmount') ?? '') || null,
  };
}

if (Astro.request.method === 'POST') {
  if (!canManage) {
    error = 'You do not have permission to change configuration.';
  } else {
    const form = await Astro.request.formData();
    const intent = String(form.get('intent') ?? '');
    const actor = { userId: principal.userId, email: principal.email };

    try {
      if (intent === 'create') {
        await createAccountType(
          {
            code: String(form.get('code') ?? ''),
            name: String(form.get('name') ?? ''),
            category: String(form.get('category') ?? 'savings'),
            minimumOpeningAmount: String(
              form.get('minimumOpeningAmount') ?? '0'
            ),
            checklistId: String(form.get('checklistId') ?? '') || null,
            requiresApproval: form.get('requiresApproval') === 'on',
            defaultStatus: String(form.get('defaultStatus') ?? 'active'),
            numberPrefix: String(form.get('numberPrefix') ?? '') || null,
            ...limitsFrom(form),
          },
          actor
        );
        notice = 'Account type created.';
      } else if (intent === 'update') {
        await updateAccountType(
          String(form.get('typeId')),
          {
            name: String(form.get('name') ?? ''),
            category: String(form.get('category') ?? 'savings'),
            minimumOpeningAmount: String(
              form.get('minimumOpeningAmount') ?? '0'
            ),
            checklistId: String(form.get('checklistId') ?? '') || null,
            requiresApproval: form.get('requiresApproval') === 'on',
            defaultStatus: String(form.get('defaultStatus') ?? 'active'),
            isActive: form.get('isActive') === 'on',
            numberPrefix: String(form.get('numberPrefix') ?? '') || null,
            ...limitsFrom(form),
          },
          actor
        );
        notice = 'Account type updated.';
      } else if (intent === 'opens-on-approval') {
        const opens = form.get('opens') === 'yes';
        await setOpensOnApproval(String(form.get('typeId')), opens, actor);
        notice = opens
          ? 'Memberships approved from now on open this account.'
          : 'Memberships approved from now on do not open this account.';
      } else if (intent === 'eligibility') {
        await setAccountTypeEligibility(
          String(form.get('typeId')),
          form.getAll('membershipTypeId').map(String),
          actor
        );
        notice = 'Eligibility updated.';
      } else if (intent === 'delete') {
        await deleteAccountType(String(form.get('typeId')), actor);
        notice = 'Account type deleted.';
      }
    } catch (err) {
      if (err instanceof ConfigError) {
        error = err.message;
      } else {
        console.error('[config/account-types]', err);
        error = 'Something went wrong. Please try again.';
      }
    }
  }
}

const [types, checklists, membershipTypes] = await Promise.all([
  listAccountTypes(),
  listChecklists(),
  listMembershipTypes(),
]);

const STATUSES = ['active', 'pending', 'inactive', 'dormant'];
---

<DashboardLayout
  title="Account types · Al Barakah MCSL"
  heading="Account types"
>
  <div class={PAGE.list}>
    <ConfigNav />

    {error && (
      <div class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
        {error}
      </div>
    )}
    {notice && (
      <div class="border-mint-400 bg-mint-50 dark:border-mint-700 dark:bg-mint-950 rounded-lg border px-4 py-3 text-sm text-neutral-800 dark:text-neutral-100">
        {notice}
      </div>
    )}

    <section class={CARD}>
      <h2 class={CARD_TITLE}>Products</h2>
      <p class={`${HINT} mt-1`}>
        The default is the account opened when a membership is approved.
        Accounts already opened are not affected.
      </p>

      <div class="mt-5 space-y-4">
        {types.map(type => (
          <details class={PANEL}>
            <summary class="flex cursor-pointer flex-wrap items-center gap-x-3 gap-y-1">
              <span class="font-medium text-neutral-800 dark:text-neutral-100">
                {type.name}
              </span>
              <code class="rounded bg-neutral-100 px-1.5 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
                {type.code}
              </code>
              {type.isMembershipDefault && (
                <span class="bg-mint-200 dark:bg-mint-900 rounded px-1.5 py-0.5 text-xs text-neutral-800 dark:text-neutral-100">
                  opens on approval
                </span>
              )}
              {!type.isActive && (
                <span class="rounded bg-red-100 px-1.5 py-0.5 text-xs text-red-800 dark:bg-red-950 dark:text-red-200">
                  inactive
                </span>
              )}
              <span class="text-xs text-neutral-500 dark:text-neutral-400">
                min. Rs {type.minimumOpeningAmount}
              </span>
              <span class="text-xs text-neutral-500 dark:text-neutral-400">
                floor Rs {type.minimumBalance}
              </span>
            </summary>

            <form method="post" class="mt-4 grid gap-3 sm:grid-cols-2">
              <input type="hidden" name="typeId" value={type.id} />
              <label class="text-sm text-neutral-600 dark:text-neutral-300">
                Name
                <input
                  type="text"
                  name="name"
                  value={type.name}
                  disabled={!canManage}
                  class={INPUT}
                />
              </label>
              <label class="text-sm text-neutral-600 dark:text-neutral-300">
                Category
                <input
                  type="text"
                  name="category"
                  value={type.category}
                  disabled={!canManage}
                  class={INPUT}
                />
              </label>
              <label class="text-sm text-neutral-600 dark:text-neutral-300">
                Minimum opening amount (Rs)
                <input
                  type="text"
                  inputmode="decimal"
                  name="minimumOpeningAmount"
                  value={type.minimumOpeningAmount}
                  disabled={!canManage}
                  class={INPUT}
                />
              </label>
              <label class="text-sm text-neutral-600 dark:text-neutral-300">
                Minimum balance (Rs)
                <input
                  type="text"
                  inputmode="decimal"
                  name="minimumBalance"
                  value={type.minimumBalance}
                  disabled={!canManage}
                  class={INPUT}
                />
              </label>
              <label class="text-sm text-neutral-600 dark:text-neutral-300">
                Maximum per transaction (Rs, blank for no limit)
                <input
                  type="text"
                  inputmode="decimal"
                  name="maximumTransactionAmount"
                  value={type.maximumTransactionAmount ?? ''}
                  disabled={!canManage}
                  class={INPUT}
                />
              </label>
              <label class="text-sm text-neutral-600 dark:text-neutral-300">
                Default status
                <select
                  name="defaultStatus"
                  disabled={!canManage}
                  class={INPUT}
                >
                  {STATUSES.map(s => (
                    <option value={s} selected={s === type.defaultStatus}>
                      {s}
                    </option>
                  ))}
                </select>
              </label>
              <label class="text-sm text-neutral-600 dark:text-neutral-300">
                Number prefix for a non-member's account (e.g. HSA)
                <input
                  type="text"
                  name="numberPrefix"
                  value={type.numberPrefix ?? ''}
                  disabled={!canManage}
                  class={INPUT}
                />
              </label>
              <label class="text-sm text-neutral-600 sm:col-span-2 dark:text-neutral-300">
                Documents required to open
                <select name="checklistId" disabled={!canManage} class={INPUT}>
                  <option value="">— none —</option>
                  {checklists.map(c => (
                    <option value={c.id} selected={c.id === type.checklistId}>
                      {c.name}
                    </option>
                  ))}
                </select>
              </label>
              <fieldset class="flex flex-wrap gap-x-6 gap-y-2 sm:col-span-2">
                <legend class="text-sm text-neutral-600 dark:text-neutral-300">
                  Allowed on this account
                </legend>
                <label class="mt-1 flex items-center gap-x-2 text-sm text-neutral-600 dark:text-neutral-300">
                  <input
                    type="checkbox"
                    name="allowsDeposit"
                    checked={type.allowsDeposit}
                    disabled={!canManage}
                    class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
                  />
                  Deposits
                </label>
                <label class="mt-1 flex items-center gap-x-2 text-sm text-neutral-600 dark:text-neutral-300">
                  <input
                    type="checkbox"
                    name="allowsWithdrawal"
                    checked={type.allowsWithdrawal}
                    disabled={!canManage}
                    class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
                  />
                  Withdrawals
                </label>
                <label class="mt-1 flex items-center gap-x-2 text-sm text-neutral-600 dark:text-neutral-300">
                  <input
                    type="checkbox"
                    name="allowsTransfer"
                    checked={type.allowsTransfer}
                    disabled={!canManage}
                    class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
                  />
                  Transfers
                </label>
              </fieldset>
              <label class="flex items-center gap-x-2 text-sm text-neutral-600 dark:text-neutral-300">
                <input
                  type="checkbox"
                  name="requiresApproval"
                  checked={type.requiresApproval}
                  disabled={!canManage}
                  class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
                />
                Opening needs approval
              </label>
              <label class="flex items-center gap-x-2 text-sm text-neutral-600 dark:text-neutral-300">
                <input
                  type="checkbox"
                  name="isActive"
                  checked={type.isActive}
                  disabled={!canManage}
                  class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
                />
                Active
              </label>

              {!type.isMembershipDefault && (
                <fieldset class="sm:col-span-2">
                  <legend class="text-sm text-neutral-600 dark:text-neutral-300">
                    Who may open this
                  </legend>
                  <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                    Nothing ticked means every membership type may. Tick one or
                    more to restrict it to only those.
                  </p>
                  <div class="mt-2 flex flex-wrap gap-3">
                    {membershipTypes.map(mt => (
                      <label class="flex items-center gap-x-2 text-sm text-neutral-800 dark:text-neutral-100">
                        <input
                          type="checkbox"
                          name="membershipTypeId"
                          value={mt.id}
                          checked={type.eligibleMembershipTypeIds.includes(
                            mt.id
                          )}
                          disabled={!canManage}
                          class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
                        />
                        {mt.name}
                      </label>
                    ))}
                  </div>
                </fieldset>
              )}

              {canManage && (
                <div class="flex flex-wrap gap-2 pt-2 sm:col-span-2">
                  <button
                    type="submit"
                    name="intent"
                    value="update"
                    class={BUTTON_SM}
                  >
                    Save
                  </button>
                  {!type.isMembershipDefault && (
                    <button
                      type="submit"
                      name="intent"
                      value="eligibility"
                      class={SECONDARY_SM}
                    >
                      Save eligibility
                    </button>
                  )}
                  {type.isActive && (
                    <>
                      <input
                        type="hidden"
                        name="opens"
                        value={type.isMembershipDefault ? 'no' : 'yes'}
                      />
                      <button
                        type="submit"
                        name="intent"
                        value="opens-on-approval"
                        class={SECONDARY_SM}
                      >
                        {type.isMembershipDefault
                          ? 'Do not open on approval'
                          : 'Open on approval'}
                      </button>
                    </>
                  )}
                </div>
              )}
            </form>
            {canManage && (
              <form method="post" class="mt-2" data-confirm-delete-type>
                <input type="hidden" name="typeId" value={type.id} />
                <button
                  type="submit"
                  name="intent"
                  value="delete"
                  class={DANGER_SM}
                >
                  Delete
                </button>
              </form>
            )}
          </details>
        ))}
      </div>
    </section>

    {canManage && (
      <section class={CARD}>
        <h2 class={CARD_TITLE}>Add an account type</h2>
        <form method="post" class="mt-4 grid gap-3 sm:grid-cols-2">
          <input type="hidden" name="intent" value="create" />
          <label class="text-sm text-neutral-600 dark:text-neutral-300">
            Code
            <input
              type="text"
              name="code"
              required
              placeholder="term_deposit"
              class={INPUT}
            />
          </label>
          <label class="text-sm text-neutral-600 dark:text-neutral-300">
            Name
            <input type="text" name="name" required class={INPUT} />
          </label>
          <label class="text-sm text-neutral-600 dark:text-neutral-300">
            Category
            <input type="text" name="category" value="savings" class={INPUT} />
          </label>
          <label class="text-sm text-neutral-600 dark:text-neutral-300">
            Minimum opening amount (Rs)
            <input
              type="text"
              inputmode="decimal"
              name="minimumOpeningAmount"
              value="0.00"
              class={INPUT}
            />
          </label>
          <label class="text-sm text-neutral-600 dark:text-neutral-300">
            Minimum balance (Rs)
            <input
              type="text"
              inputmode="decimal"
              name="minimumBalance"
              value="0.00"
              class={INPUT}
            />
          </label>
          <label class="text-sm text-neutral-600 dark:text-neutral-300">
            Maximum per transaction (Rs, blank for no limit)
            <input
              type="text"
              inputmode="decimal"
              name="maximumTransactionAmount"
              class={INPUT}
            />
          </label>
          <label class="text-sm text-neutral-600 dark:text-neutral-300">
            Number prefix for a non-member's account (e.g. HSA)
            <input
              type="text"
              name="numberPrefix"
              placeholder="Only needed to open this for a non-member"
              class={INPUT}
            />
          </label>
          <fieldset class="flex flex-wrap gap-x-6 gap-y-2 sm:col-span-2">
            <legend class="text-sm text-neutral-600 dark:text-neutral-300">
              Allowed on this account
            </legend>
            <label class="mt-1 flex items-center gap-x-2 text-sm text-neutral-600 dark:text-neutral-300">
              <input
                type="checkbox"
                name="allowsDeposit"
                checked
                class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
              />
              Deposits
            </label>
            <label class="mt-1 flex items-center gap-x-2 text-sm text-neutral-600 dark:text-neutral-300">
              <input
                type="checkbox"
                name="allowsWithdrawal"
                checked
                class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
              />
              Withdrawals
            </label>
            <label class="mt-1 flex items-center gap-x-2 text-sm text-neutral-600 dark:text-neutral-300">
              <input
                type="checkbox"
                name="allowsTransfer"
                checked
                class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
              />
              Transfers
            </label>
          </fieldset>
          <div class="sm:col-span-2">
            <button type="submit" class={BUTTON}>
              Create
            </button>
          </div>
        </form>
      </section>
    )}
  </div>
</DashboardLayout>

<script>
  // A courtesy, not the enforcement — deleteAccountType (reference.ts)
  // refuses the ones actually in use regardless of whether this confirms.
  for (const form of document.querySelectorAll<HTMLFormElement>(
    'form[data-confirm-delete-type]'
  )) {
    window.confirmedSubmit(
      form,
      'Delete this account type? This cannot be undone, and only ' +
        'works if it has never been opened, applied for, or paid for.'
    );
  }
</script>
