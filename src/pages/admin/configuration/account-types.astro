---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import ConfigNav from '@components/ConfigNav.astro';
import {
  ConfigError,
  createAccountType,
  listAccountTypes,
  listChecklists,
  setMembershipDefault,
  updateAccountType,
} from '@lib/config/reference';

const principal = Astro.locals.principal!;
const canManage = principal.permissions.has('config.manage');

let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  if (!canManage) {
    error = 'You do not have permission to change configuration.';
  } else {
    const form = await Astro.request.formData();
    const intent = String(form.get('intent') ?? '');
    const actor = { userId: principal.userId, email: principal.email };

    try {
      if (intent === 'create') {
        await createAccountType(
          {
            code: String(form.get('code') ?? ''),
            name: String(form.get('name') ?? ''),
            category: String(form.get('category') ?? 'savings'),
            minimumOpeningAmount: String(
              form.get('minimumOpeningAmount') ?? '0'
            ),
            checklistId: String(form.get('checklistId') ?? '') || null,
            requiresApproval: form.get('requiresApproval') === 'on',
            defaultStatus: String(form.get('defaultStatus') ?? 'active'),
          },
          actor
        );
        notice = 'Account type created.';
      } else if (intent === 'update') {
        await updateAccountType(
          String(form.get('typeId')),
          {
            name: String(form.get('name') ?? ''),
            category: String(form.get('category') ?? 'savings'),
            minimumOpeningAmount: String(
              form.get('minimumOpeningAmount') ?? '0'
            ),
            checklistId: String(form.get('checklistId') ?? '') || null,
            requiresApproval: form.get('requiresApproval') === 'on',
            defaultStatus: String(form.get('defaultStatus') ?? 'active'),
            isActive: form.get('isActive') === 'on',
          },
          actor
        );
        notice = 'Account type updated.';
      } else if (intent === 'default') {
        await setMembershipDefault(String(form.get('typeId')), actor);
        notice =
          'Default product changed. Memberships approved from now on open it.';
      }
    } catch (err) {
      if (err instanceof ConfigError) {
        error = err.message;
      } else {
        console.error('[config/account-types]', err);
        error = 'Something went wrong. Please try again.';
      }
    }
  }
}

const [types, checklists] = await Promise.all([
  listAccountTypes(),
  listChecklists(),
]);

const STATUSES = ['active', 'pending', 'inactive', 'dormant'];
---

<DashboardLayout
  title="Account types · Al Barakah MCSL"
  heading="Account types"
>
  <div class="mx-auto max-w-5xl space-y-6">
    <ConfigNav />

    {
      error && (
        <div class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
          {error}
        </div>
      )
    }
    {
      notice && (
        <div class="border-mint-400 bg-mint-50 dark:border-mint-700 dark:bg-mint-950 rounded-lg border px-4 py-3 text-sm text-neutral-800 dark:text-neutral-100">
          {notice}
        </div>
      )
    }

    <section
      class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950"
    >
      <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
        Products
      </h2>
      <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
        Exactly one type is the membership default — the account opened
        automatically when a membership is approved (FRD 7.6). Changing it
        affects approvals from that moment on; accounts already opened are not
        touched.
      </p>

      <div class="mt-5 space-y-4">
        {
          types.map(type => (
            <details class="rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
              <summary class="flex cursor-pointer flex-wrap items-center gap-x-3 gap-y-1">
                <span class="font-medium text-neutral-800 dark:text-neutral-100">
                  {type.name}
                </span>
                <code class="rounded bg-neutral-100 px-1.5 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
                  {type.code}
                </code>
                {type.isMembershipDefault && (
                  <span class="bg-mint-200 dark:bg-mint-900 rounded px-1.5 py-0.5 text-xs text-neutral-800 dark:text-neutral-100">
                    membership default
                  </span>
                )}
                {!type.isActive && (
                  <span class="rounded bg-red-100 px-1.5 py-0.5 text-xs text-red-800 dark:bg-red-950 dark:text-red-200">
                    inactive
                  </span>
                )}
                <span class="text-xs text-neutral-500 dark:text-neutral-400">
                  min. Rs {type.minimumOpeningAmount}
                </span>
              </summary>

              <form method="post" class="mt-4 grid gap-3 sm:grid-cols-2">
                <input type="hidden" name="typeId" value={type.id} />
                <label class="text-sm text-neutral-600 dark:text-neutral-300">
                  Name
                  <input
                    type="text"
                    name="name"
                    value={type.name}
                    disabled={!canManage}
                    class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                  />
                </label>
                <label class="text-sm text-neutral-600 dark:text-neutral-300">
                  Category
                  <input
                    type="text"
                    name="category"
                    value={type.category}
                    disabled={!canManage}
                    class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                  />
                </label>
                <label class="text-sm text-neutral-600 dark:text-neutral-300">
                  Minimum opening amount (Rs)
                  <input
                    type="text"
                    inputmode="decimal"
                    name="minimumOpeningAmount"
                    value={type.minimumOpeningAmount}
                    disabled={!canManage}
                    class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                  />
                </label>
                <label class="text-sm text-neutral-600 dark:text-neutral-300">
                  Default status
                  <select
                    name="defaultStatus"
                    disabled={!canManage}
                    class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                  >
                    {STATUSES.map(s => (
                      <option value={s} selected={s === type.defaultStatus}>
                        {s}
                      </option>
                    ))}
                  </select>
                </label>
                <label class="text-sm text-neutral-600 sm:col-span-2 dark:text-neutral-300">
                  Documents required to open
                  <select
                    name="checklistId"
                    disabled={!canManage}
                    class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                  >
                    <option value="">— none —</option>
                    {checklists.map(c => (
                      <option value={c.id} selected={c.id === type.checklistId}>
                        {c.name}
                      </option>
                    ))}
                  </select>
                </label>
                <label class="flex items-center gap-x-2 text-sm text-neutral-600 dark:text-neutral-300">
                  <input
                    type="checkbox"
                    name="requiresApproval"
                    checked={type.requiresApproval}
                    disabled={!canManage}
                    class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
                  />
                  Opening needs approval
                </label>
                <label class="flex items-center gap-x-2 text-sm text-neutral-600 dark:text-neutral-300">
                  <input
                    type="checkbox"
                    name="isActive"
                    checked={type.isActive}
                    disabled={!canManage}
                    class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
                  />
                  Active
                </label>

                {canManage && (
                  <div class="flex flex-wrap gap-2 pt-2 sm:col-span-2">
                    <button
                      type="submit"
                      name="intent"
                      value="update"
                      class="bg-mint-300 hover:bg-mint-400 rounded-lg px-3 py-1.5 text-sm font-bold text-neutral-800 transition"
                    >
                      Save
                    </button>
                    {!type.isMembershipDefault && type.isActive && (
                      <button
                        type="submit"
                        name="intent"
                        value="default"
                        class="rounded-lg border border-neutral-300 px-3 py-1.5 text-sm font-medium text-neutral-700 transition hover:bg-neutral-100 dark:border-neutral-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
                      >
                        Make membership default
                      </button>
                    )}
                  </div>
                )}
              </form>
            </details>
          ))
        }
      </div>
    </section>

    {
      canManage && (
        <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
          <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
            Add an account type
          </h2>
          <form method="post" class="mt-4 grid gap-3 sm:grid-cols-2">
            <input type="hidden" name="intent" value="create" />
            <label class="text-sm text-neutral-600 dark:text-neutral-300">
              Code
              <input
                type="text"
                name="code"
                required
                placeholder="term_deposit"
                class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
              />
            </label>
            <label class="text-sm text-neutral-600 dark:text-neutral-300">
              Name
              <input
                type="text"
                name="name"
                required
                class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
              />
            </label>
            <label class="text-sm text-neutral-600 dark:text-neutral-300">
              Category
              <input
                type="text"
                name="category"
                value="savings"
                class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
              />
            </label>
            <label class="text-sm text-neutral-600 dark:text-neutral-300">
              Minimum opening amount (Rs)
              <input
                type="text"
                inputmode="decimal"
                name="minimumOpeningAmount"
                value="0.00"
                class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
              />
            </label>
            <div class="sm:col-span-2">
              <button
                type="submit"
                class="bg-mint-300 hover:bg-mint-400 rounded-lg px-3 py-1.5 text-sm font-bold text-neutral-800 transition"
              >
                Create
              </button>
            </div>
          </form>
        </section>
      )
    }
  </div>
</DashboardLayout>
