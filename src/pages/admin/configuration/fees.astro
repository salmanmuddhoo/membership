---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import ConfigNav from '@components/ConfigNav.astro';
import {
  ConfigError,
  FEE_COMPONENTS,
  cashMaximum,
  cashSourceOfFundChecklist,
  cashSourceOfFundThreshold,
  listFeeSchedules,
  publishFeeVersion,
  resignationChecks,
  setCashMaximum,
  setResignationChecks,
  setCashSourceOfFundChecklist,
  setCashSourceOfFundThreshold,
  type FeeComponentCode,
  type FeeRequirement,
} from '@lib/config/reference';

const principal = Astro.locals.principal!;
const canManage =
  principal.permissions.has('fee.manage') ||
  principal.permissions.has('config.manage');

let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  if (!canManage) {
    error = 'You do not have permission to change fees.';
  } else {
    const form = await Astro.request.formData();
    const actor = { userId: principal.userId, email: principal.email };
    const intent = String(form.get('intent') ?? 'publish-fee-version');

    try {
      if (intent === 'set-cash-threshold') {
        await setCashSourceOfFundThreshold(
          String(form.get('cashThreshold') ?? '').trim(),
          actor
        );
        notice = 'Cash source-of-fund threshold updated.';
      } else if (intent === 'set-cash-maximum') {
        await setCashMaximum(
          String(form.get('cashMaximum') ?? '').trim(),
          actor
        );
        notice = 'Cash maximum updated.';
      } else if (intent === 'set-resignation-checks') {
        await setResignationChecks(
          {
            pendingTransactions: form.get('pendingTransactions') === 'on',
            unpaidFees: form.get('unpaidFees') === 'on',
            financing: form.get('financing') === 'on',
          },
          actor
        );
        notice = 'Resignation checks updated.';
      } else if (intent === 'set-cash-checklist') {
        const items = String(form.get('cashChecklist') ?? '')
          .split('\n')
          .map(item => item.trim())
          .filter(item => item !== '');
        await setCashSourceOfFundChecklist(items, actor);
        notice = 'Source of Fund checklist updated.';
      } else {
        const components = FEE_COMPONENTS.map(code => ({
          code: code as FeeComponentCode,
          amount: String(form.get(`amount.${code}`) ?? '0').trim() || '0',
          requirement: String(
            form.get(`requirement.${code}`) ?? 'not_applicable'
          ) as FeeRequirement,
        }));

        await publishFeeVersion(
          String(form.get('scheduleId')),
          components,
          actor
        );
        notice =
          'New fee version published. Applications from now on use these ' +
          'amounts; receipts already issued keep the amounts they charged.';
      }
    } catch (err) {
      if (err instanceof ConfigError) {
        error = err.message;
      } else {
        console.error('[config/fees]', err);
        error = 'Something went wrong. Please try again.';
      }
    }
  }
}

const schedules = await listFeeSchedules();
const cashThreshold = await cashSourceOfFundThreshold();
const cashMax = await cashMaximum();
const checks = await resignationChecks();
const RESIGNATION_CHECKS: {
  name: keyof typeof checks;
  label: string;
  hint: string;
}[] = [
  {
    name: 'pendingTransactions',
    label: 'No transaction on its way on Shares or the MSA',
    hint: 'Anything submitted, under review or approved on either account.',
  },
  {
    name: 'unpaidFees',
    label: 'Joining fees fully paid',
    hint: 'What the membership was charged to join, less what was paid.',
  },
  {
    name: 'financing',
    label: 'No financing outstanding',
    hint: 'Nothing records financing yet; this passes until something does.',
  },
];
const checklistItems = await cashSourceOfFundChecklist();

const COMPONENT_LABELS: Record<string, string> = {
  entrance: 'Entrance Fee',
  takaful: 'Takaful Contribution',
  shares: 'Shares (initial share capital)',
  msa_deposit: 'Deposit into the default account',
  processing: 'Processing Fee',
};

const REQUIREMENTS: FeeRequirement[] = [
  'required',
  'optional',
  'not_applicable',
];

function total(components: { amount: string; requirement: string }[]): string {
  const sum = components
    .filter(c => c.requirement === 'required')
    .reduce((acc, c) => acc + Number(c.amount), 0);
  return sum.toLocaleString('en-MU', { minimumFractionDigits: 2 });
}

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
---

<DashboardLayout
  title="Fee schedules · Al Barakah MCSL"
  heading="Fee schedules"
>
  <div class="mx-auto max-w-5xl space-y-6">
    <ConfigNav />

    {error && (
      <div class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
        {error}
      </div>
    )}
    {notice && (
      <div class="border-mint-400 bg-mint-50 dark:border-mint-700 dark:bg-mint-950 rounded-lg border px-4 py-3 text-sm text-neutral-800 dark:text-neutral-100">
        {notice}
      </div>
    )}

    <p class="text-sm text-neutral-500 dark:text-neutral-400">
      Saving publishes a new version and closes the previous one.
    </p>

    {schedules.map(schedule => (
      <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
            {schedule.name}
          </h2>
          <code class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
            {schedule.code}
          </code>
          {schedule.current && (
            <span class="text-xs text-neutral-500 dark:text-neutral-400">
              version {schedule.current.versionNo} · Rs{' '}
              {total(schedule.current.components)} collected
            </span>
          )}
        </div>
        <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
          {schedule.description}
        </p>

        <form method="post" class="mt-4">
          <input type="hidden" name="intent" value="publish-fee-version" />
          <input type="hidden" name="scheduleId" value={schedule.id} />
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-xs text-neutral-500 dark:text-neutral-400">
                  <th class="py-1 pr-4 font-medium">Component</th>
                  <th class="py-1 pr-4 font-medium">Amount (Rs)</th>
                  <th class="py-1 font-medium">Applies</th>
                </tr>
              </thead>
              <tbody>
                {FEE_COMPONENTS.map(code => {
                  const component = schedule.current?.components.find(
                    c => c.code === code
                  );
                  return (
                    <tr class="border-t border-neutral-200 dark:border-neutral-800">
                      <td class="py-2 pr-4 text-neutral-700 dark:text-neutral-200">
                        {COMPONENT_LABELS[code]}
                      </td>
                      <td class="py-2 pr-4">
                        <input
                          type="text"
                          inputmode="decimal"
                          name={`amount.${code}`}
                          value={component?.amount ?? '0.00'}
                          disabled={!canManage}
                          class="w-32 rounded-lg border border-neutral-300 bg-white px-2 py-1 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                        />
                      </td>
                      <td class="py-2">
                        <select
                          name={`requirement.${code}`}
                          disabled={!canManage}
                          class="rounded-lg border border-neutral-300 bg-white px-2 py-1 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                        >
                          {REQUIREMENTS.map(r => (
                            <option
                              value={r}
                              selected={
                                r ===
                                (component?.requirement ?? 'not_applicable')
                              }
                            >
                              {r.replace('_', ' ')}
                            </option>
                          ))}
                        </select>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          {canManage && (
            <button
              type="submit"
              class="bg-mint-300 hover:bg-mint-400 mt-4 rounded-lg px-3 py-1.5 text-sm font-bold text-neutral-800 transition"
            >
              Publish new version
            </button>
          )}
        </form>

        {schedule.history.length > 0 && (
          <details class="mt-4 rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
            <summary class="cursor-pointer text-sm font-medium text-neutral-700 dark:text-neutral-200">
              Earlier versions ({schedule.history.length})
            </summary>
            <ul class="mt-3 space-y-2 text-sm">
              {schedule.history.map(version => (
                <li class="text-neutral-600 dark:text-neutral-300">
                  <span class="font-medium">Version {version.versionNo}</span>
                  <span class="text-xs text-neutral-400 dark:text-neutral-500">
                    {' '}
                    · {dateFormat.format(version.effectiveFrom)} to{' '}
                    {version.supersededAt
                      ? dateFormat.format(version.supersededAt)
                      : 'now'}
                  </span>
                  <span class="block text-xs text-neutral-500 dark:text-neutral-400">
                    {version.components
                      .filter(c => c.requirement !== 'not_applicable')
                      .map(c => `${COMPONENT_LABELS[c.code]} Rs ${c.amount}`)
                      .join(' · ')}
                  </span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </section>
    ))}

    <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
      <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
        Cash payments
      </h2>
      <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
        Above the threshold, recording a cash receipt asks the officer to sign a
        Source of Fund form on screen. Above the maximum, cash is not accepted
        at all — the officer is told to use another method or split the payment.
      </p>

      <div class="mt-4 flex flex-wrap gap-6">
        <form method="post" class="flex flex-wrap items-end gap-3">
          <input type="hidden" name="intent" value="set-cash-threshold" />
          <label class="text-sm text-neutral-600 dark:text-neutral-300">
            Source of fund threshold (Rs)
            <input
              type="text"
              inputmode="decimal"
              name="cashThreshold"
              value={cashThreshold}
              disabled={!canManage}
              class="mt-1 block w-40 rounded-lg border border-neutral-300 bg-white px-2 py-1 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
            />
          </label>
          {canManage && (
            <button
              type="submit"
              class="bg-mint-300 hover:bg-mint-400 rounded-lg px-3 py-1.5 text-sm font-bold text-neutral-800 transition"
            >
              Save
            </button>
          )}
        </form>

        <form method="post" class="flex flex-wrap items-end gap-3">
          <input type="hidden" name="intent" value="set-cash-maximum" />
          <label class="text-sm text-neutral-600 dark:text-neutral-300">
            Maximum (Rs)
            <input
              type="text"
              inputmode="decimal"
              name="cashMaximum"
              value={cashMax}
              disabled={!canManage}
              class="mt-1 block w-40 rounded-lg border border-neutral-300 bg-white px-2 py-1 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
            />
          </label>
          {canManage && (
            <button
              type="submit"
              class="bg-mint-300 hover:bg-mint-400 rounded-lg px-3 py-1.5 text-sm font-bold text-neutral-800 transition"
            >
              Save
            </button>
          )}
        </form>
      </div>

      <form method="post" class="mt-5 space-y-2">
        <input type="hidden" name="intent" value="set-cash-checklist" />
        <label class="block text-sm text-neutral-600 dark:text-neutral-300">
          Source of Fund checklist — one item per line, shown to the officer in
          this order before they sign
          <textarea
            name="cashChecklist"
            rows={Math.max(4, checklistItems.length + 1)}
            disabled={!canManage}
            class="mt-1 block w-full max-w-xl rounded-lg border border-neutral-300 bg-white px-2 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
          >{checklistItems.join('\n')}</textarea>
        </label>
        {canManage && (
          <button
            type="submit"
            class="bg-mint-300 hover:bg-mint-400 rounded-lg px-3 py-1.5 text-sm font-bold text-neutral-800 transition"
          >
            Save
          </button>
        )}
      </form>
    </section>

    <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
      <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
        Resignation checks
      </h2>
      <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
        A resignation cannot be submitted while a ticked check fails. Each one
        is named on the request when it blocks.
      </p>
      <form method="post" class="mt-4 space-y-3">
        <input type="hidden" name="intent" value="set-resignation-checks" />
        {RESIGNATION_CHECKS.map(check => (
          <label class="flex items-start gap-3 text-sm text-neutral-700 dark:text-neutral-200">
            <input
              type="checkbox"
              name={check.name}
              checked={checks[check.name]}
              disabled={!canManage}
              class="mt-1"
            />
            <span>
              <span class="font-medium">{check.label}</span>
              <span class="block text-xs text-neutral-500 dark:text-neutral-400">
                {check.hint}
              </span>
            </span>
          </label>
        ))}
        {canManage && (
          <button
            type="submit"
            class="bg-mint-300 hover:bg-mint-400 rounded-lg px-3 py-1.5 text-sm font-bold text-neutral-800 transition"
          >
            Save
          </button>
        )}
      </form>
    </section>
  </div>
</DashboardLayout>
