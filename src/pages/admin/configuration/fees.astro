---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import ConfigNav from '@components/ConfigNav.astro';
import {
  ConfigError,
  DORMANCY_REACTIVATIONS,
  FEE_COMPONENTS,
  cashMaximum,
  cashSourceOfFundChecklist,
  cashSourceOfFundThreshold,
  dormancyMonths,
  dormancyReactivation,
  listFeeSchedules,
  nearFloorMargin,
  publishFeeVersion,
  resignationChecks,
  setCashMaximum,
  setDormancyMonths,
  setSessionIdleMinutes,
  sessionIdleMinutes,
  setDormancyReactivation,
  setNearFloorMargin,
  setResignationChecks,
  setTakafulBenefit,
  takafulBenefit,
  setCashSourceOfFundChecklist,
  setCashSourceOfFundThreshold,
  type FeeComponentCode,
  type FeeRequirement,
} from '@lib/config/reference';
import {
  PAGE,
  CARD,
  CARD_TITLE,
  HINT,
  PANEL,
  LABEL,
  BUTTON,
  BUTTON_SM,
  INPUT_SM,
  NOTICE_ERROR,
  NOTICE_OK,
  TABLE,
  THEAD,
  TH,
  ROW,
  TD,
} from '@lib/ui';

const principal = Astro.locals.principal!;
const canManage =
  principal.permissions.has('fee.manage') ||
  principal.permissions.has('config.manage');

let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  if (!canManage) {
    error = 'You do not have permission to change fees.';
  } else {
    const form = await Astro.request.formData();
    const actor = { userId: principal.userId, email: principal.email };
    const intent = String(form.get('intent') ?? 'publish-fee-version');

    try {
      if (intent === 'set-cash-threshold') {
        await setCashSourceOfFundThreshold(
          String(form.get('cashThreshold') ?? '').trim(),
          actor
        );
        notice = 'Cash source-of-fund threshold updated.';
      } else if (intent === 'set-cash-maximum') {
        await setCashMaximum(
          String(form.get('cashMaximum') ?? '').trim(),
          actor
        );
        notice = 'Cash maximum updated.';
      } else if (intent === 'set-takaful-benefit') {
        await setTakafulBenefit(
          String(form.get('takafulBenefit') ?? '').trim(),
          actor
        );
        notice = 'Takaful benefit updated.';
      } else if (intent === 'set-near-floor-margin') {
        await setNearFloorMargin(
          String(form.get('nearFloorMargin') ?? '').trim(),
          actor
        );
        notice = 'Near-floor margin updated.';
      } else if (intent === 'set-resignation-checks') {
        await setResignationChecks(
          {
            pendingTransactions: form.get('pendingTransactions') === 'on',
            unpaidFees: form.get('unpaidFees') === 'on',
            financing: form.get('financing') === 'on',
          },
          actor
        );
        notice = 'Resignation checks updated.';
      } else if (intent === 'set-cash-checklist') {
        const items = String(form.get('cashChecklist') ?? '')
          .split('\n')
          .map(item => item.trim())
          .filter(item => item !== '');
        await setCashSourceOfFundChecklist(items, actor);
        notice = 'Source of Fund checklist updated.';
      } else if (intent === 'set-dormancy-months') {
        await setDormancyMonths(
          String(form.get('dormancyMonths') ?? '').trim(),
          actor
        );
        notice = 'Dormancy threshold updated.';
      } else if (intent === 'set-session-idle-minutes') {
        await setSessionIdleMinutes(
          String(form.get('sessionIdleMinutes') ?? '').trim(),
          actor
        );
        notice = 'Sign-out after inactivity updated.';
      } else if (intent === 'set-dormancy-reactivation') {
        await setDormancyReactivation(
          String(form.get('dormancyReactivation') ?? '').trim(),
          actor
        );
        notice = 'Dormancy reactivation rule updated.';
      } else {
        const components = FEE_COMPONENTS.map(code => ({
          code: code as FeeComponentCode,
          amount: String(form.get(`amount.${code}`) ?? '0').trim() || '0',
          requirement: String(
            form.get(`requirement.${code}`) ?? 'not_applicable'
          ) as FeeRequirement,
        }));

        await publishFeeVersion(
          String(form.get('scheduleId')),
          components,
          actor
        );
        notice =
          'New fee version published. Applications from now on use these ' +
          'amounts; receipts already issued keep the amounts they charged.';
      }
    } catch (err) {
      if (err instanceof ConfigError) {
        error = err.message;
      } else {
        console.error('[config/fees]', err);
        error = 'Something went wrong. Please try again.';
      }
    }
  }
}

const schedules = await listFeeSchedules();
const cashThreshold = await cashSourceOfFundThreshold();
const cashMax = await cashMaximum();
const checks = await resignationChecks();
const takaful = await takafulBenefit();
const nearFloor = await nearFloorMargin();
const dormancy = await dormancyMonths();
const idleMinutes = await sessionIdleMinutes();
const reactivation = await dormancyReactivation();
const RESIGNATION_CHECKS: {
  name: keyof typeof checks;
  label: string;
  hint: string;
}[] = [
  {
    name: 'pendingTransactions',
    label: 'No transaction on its way on Shares or the MSA',
    hint: 'Anything submitted, under review or approved on either account.',
  },
  {
    name: 'unpaidFees',
    label: 'Joining fees fully paid',
    hint: 'What the membership was charged to join, less what was paid.',
  },
  {
    name: 'financing',
    label: 'No financing outstanding',
    hint: 'Nothing records financing yet; this passes until something does.',
  },
];
const checklistItems = await cashSourceOfFundChecklist();

const COMPONENT_LABELS: Record<string, string> = {
  entrance: 'Entrance Fee',
  takaful: 'Takaful Contribution',
  shares: 'Shares (initial share capital)',
  msa_deposit: 'Deposit into the default account',
  processing: 'Processing Fee',
};

const REQUIREMENTS: FeeRequirement[] = [
  'required',
  'optional',
  'not_applicable',
];

function total(components: { amount: string; requirement: string }[]): string {
  const sum = components
    .filter(c => c.requirement === 'required')
    .reduce((acc, c) => acc + Number(c.amount), 0);
  return sum.toLocaleString('en-MU', { minimumFractionDigits: 2 });
}

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
---

<DashboardLayout
  title="Fee schedules · Al Barakah MCSL"
  heading="Fee schedules"
>
  <div class={PAGE.list}>
    <ConfigNav />

    {error && <div class={NOTICE_ERROR}>{error}</div>}
    {notice && <div class={NOTICE_OK}>{notice}</div>}

    <p class={HINT}>
      Saving publishes a new version and closes the previous one.
    </p>

    {schedules.map(schedule => (
      <section class={CARD}>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <h2 class={CARD_TITLE}>{schedule.name}</h2>
          <code class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
            {schedule.code}
          </code>
          {schedule.current && (
            <span class="text-xs text-neutral-500 dark:text-neutral-400">
              version {schedule.current.versionNo} · Rs{' '}
              {total(schedule.current.components)} collected
            </span>
          )}
        </div>
        <p class={`${HINT} mt-1`}>{schedule.description}</p>

        <form method="post" class="mt-4">
          <input type="hidden" name="intent" value="publish-fee-version" />
          <input type="hidden" name="scheduleId" value={schedule.id} />
          <div class="overflow-x-auto">
            <table class={TABLE} data-sortable>
              <thead>
                <tr class={THEAD}>
                  <th class={TH}>Component</th>
                  <th class={TH}>Amount (Rs)</th>
                  <th class={TH}>Applies</th>
                </tr>
              </thead>
              <tbody>
                {FEE_COMPONENTS.map(code => {
                  const component = schedule.current?.components.find(
                    c => c.code === code
                  );
                  return (
                    <tr class={ROW}>
                      <td
                        class={`${TD} text-neutral-700 dark:text-neutral-200`}
                      >
                        {COMPONENT_LABELS[code]}
                      </td>
                      <td
                        class={TD}
                        data-sort-value={component?.amount ?? '0.00'}
                      >
                        <input
                          type="text"
                          inputmode="decimal"
                          name={`amount.${code}`}
                          value={component?.amount ?? '0.00'}
                          disabled={!canManage}
                          class={`${INPUT_SM} w-32`}
                        />
                      </td>
                      <td
                        class={TD}
                        data-sort-value={
                          component?.requirement ?? 'not_applicable'
                        }
                      >
                        <select
                          name={`requirement.${code}`}
                          disabled={!canManage}
                          class={INPUT_SM}
                        >
                          {REQUIREMENTS.map(r => (
                            <option
                              value={r}
                              selected={
                                r ===
                                (component?.requirement ?? 'not_applicable')
                              }
                            >
                              {r.replace('_', ' ')}
                            </option>
                          ))}
                        </select>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          {canManage && (
            <button type="submit" class={`${BUTTON} mt-4`}>
              Publish new version
            </button>
          )}
        </form>

        {schedule.history.length > 0 && (
          <details class={`${PANEL} mt-4`}>
            <summary class="cursor-pointer text-sm font-medium text-neutral-700 dark:text-neutral-200">
              Earlier versions ({schedule.history.length})
            </summary>
            <ul class="mt-3 space-y-2 text-sm">
              {schedule.history.map(version => (
                <li class="text-neutral-600 dark:text-neutral-300">
                  <span class="font-medium">Version {version.versionNo}</span>
                  <span class="text-xs text-neutral-400 dark:text-neutral-500">
                    {' '}
                    · {dateFormat.format(version.effectiveFrom)} to{' '}
                    {version.supersededAt
                      ? dateFormat.format(version.supersededAt)
                      : 'now'}
                  </span>
                  <span class="block text-xs text-neutral-500 dark:text-neutral-400">
                    {version.components
                      .filter(c => c.requirement !== 'not_applicable')
                      .map(c => `${COMPONENT_LABELS[c.code]} Rs ${c.amount}`)
                      .join(' · ')}
                  </span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </section>
    ))}

    <section class={CARD}>
      <h2 class={CARD_TITLE}>Cash payments</h2>
      <p class={`${HINT} mt-1`}>
        Above the threshold, recording a cash receipt asks the officer to sign a
        Source of Fund form on screen. Above the maximum, cash is not accepted
        at all — the officer is told to use another method or split the payment.
      </p>

      <div class="mt-4 flex flex-wrap gap-6">
        <form method="post" class="flex flex-wrap items-end gap-3">
          <input type="hidden" name="intent" value="set-cash-threshold" />
          <label class={LABEL}>
            Source of fund threshold (Rs)
            <input
              type="text"
              inputmode="decimal"
              name="cashThreshold"
              value={cashThreshold}
              disabled={!canManage}
              class={`${INPUT_SM} mt-1 block w-40`}
            />
          </label>
          {canManage && (
            <button type="submit" class={BUTTON_SM}>
              Save
            </button>
          )}
        </form>

        <form method="post" class="flex flex-wrap items-end gap-3">
          <input type="hidden" name="intent" value="set-cash-maximum" />
          <label class={LABEL}>
            Maximum (Rs)
            <input
              type="text"
              inputmode="decimal"
              name="cashMaximum"
              value={cashMax}
              disabled={!canManage}
              class={`${INPUT_SM} mt-1 block w-40`}
            />
          </label>
          {canManage && (
            <button type="submit" class={BUTTON_SM}>
              Save
            </button>
          )}
        </form>
      </div>

      <form method="post" class="mt-5 space-y-2">
        <input type="hidden" name="intent" value="set-cash-checklist" />
        <label class={LABEL}>
          Source of Fund checklist — one item per line, shown to the officer in
          this order before they sign
          <textarea
            name="cashChecklist"
            rows={Math.max(4, checklistItems.length + 1)}
            disabled={!canManage}
            class="mt-1 block w-full max-w-xl rounded-lg border border-neutral-300 bg-white px-2 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
          >{checklistItems.join('\n')}</textarea>
        </label>
        {canManage && (
          <button type="submit" class={BUTTON_SM}>
            Save
          </button>
        )}
      </form>
    </section>

    <section class={CARD}>
      <h2 class={CARD_TITLE}>Demised claims</h2>
      <p class={`${HINT} mt-1`}>
        Paid to the claimant beside the balances of the member's accounts, as
        set when the claim is submitted.
      </p>
      <form method="post" class="mt-4 flex flex-wrap items-end gap-3">
        <input type="hidden" name="intent" value="set-takaful-benefit" />
        <label class={LABEL}>
          Takaful benefit (Rs)
          <input
            type="text"
            inputmode="decimal"
            name="takafulBenefit"
            value={takaful}
            disabled={!canManage}
            class={`${INPUT_SM} mt-1 block w-40`}
          />
        </label>
        {canManage && (
          <button type="submit" class={BUTTON_SM}>
            Save
          </button>
        )}
      </form>
    </section>

    <section class={CARD}>
      <h2 class={CARD_TITLE}>Near-floor notice</h2>
      <p class={`${HINT} mt-1`}>
        A withdrawal or transfer that leaves an account within this amount of
        its minimum balance sends the member a notice. 0 sends none.
      </p>
      <form method="post" class="mt-4 flex flex-wrap items-end gap-3">
        <input type="hidden" name="intent" value="set-near-floor-margin" />
        <label class={LABEL}>
          Margin (Rs)
          <input
            type="text"
            inputmode="decimal"
            name="nearFloorMargin"
            value={nearFloor}
            disabled={!canManage}
            class={`${INPUT_SM} mt-1 block w-40`}
          />
        </label>
        {canManage && (
          <button type="submit" class={BUTTON_SM}>
            Save
          </button>
        )}
      </form>
    </section>

    <section class={CARD}>
      <h2 class={CARD_TITLE}>Sign-out after inactivity</h2>
      <p class={`${HINT} mt-1`}>
        Staff are signed out after this many minutes without activity. 0 turns
        it off.
      </p>
      <form method="post" class="mt-4 flex flex-wrap items-end gap-3">
        <input type="hidden" name="intent" value="set-session-idle-minutes" />
        <label class={LABEL}>
          Minutes
          <input
            type="text"
            inputmode="numeric"
            name="sessionIdleMinutes"
            value={idleMinutes}
            disabled={!canManage}
            class={`${INPUT_SM} mt-1 block w-40`}
          />
        </label>
        {canManage && (
          <button type="submit" class={BUTTON_SM}>
            Save
          </button>
        )}
      </form>
    </section>

    <section class={CARD}>
      <h2 class={CARD_TITLE}>Dormancy</h2>
      <p class={`${HINT} mt-1`}>
        A member with no transaction or fee payment for this long is marked
        dormant each night. 0 turns it off.
      </p>
      <form method="post" class="mt-4 flex flex-wrap items-end gap-3">
        <input type="hidden" name="intent" value="set-dormancy-months" />
        <label class={LABEL}>
          Months
          <input
            type="text"
            inputmode="numeric"
            name="dormancyMonths"
            value={dormancy}
            disabled={!canManage}
            class={`${INPUT_SM} mt-1 block w-40`}
          />
        </label>
        {canManage && (
          <button type="submit" class={BUTTON_SM}>
            Save
          </button>
        )}
      </form>

      <form method="post" class="mt-4 flex flex-wrap items-end gap-3">
        <input type="hidden" name="intent" value="set-dormancy-reactivation" />
        <label class={LABEL}>
          Reactivation
          <select
            name="dormancyReactivation"
            disabled={!canManage}
            class={`${INPUT_SM} mt-1 block`}
          >
            {DORMANCY_REACTIVATIONS.map(value => (
              <option value={value} selected={reactivation === value}>
                {value === 'staff' ? 'By an officer, with a reason' : value}
              </option>
            ))}
          </select>
        </label>
        {canManage && (
          <button type="submit" class={BUTTON_SM}>
            Save
          </button>
        )}
      </form>
    </section>

    <section class={CARD}>
      <h2 class={CARD_TITLE}>Resignation checks</h2>
      <p class={`${HINT} mt-1`}>
        A resignation cannot be submitted while a ticked check fails. Each one
        is named on the request when it blocks.
      </p>
      <form method="post" class="mt-4 space-y-3">
        <input type="hidden" name="intent" value="set-resignation-checks" />
        {RESIGNATION_CHECKS.map(check => (
          <label class="flex items-start gap-3 text-sm text-neutral-700 dark:text-neutral-200">
            <input
              type="checkbox"
              name={check.name}
              checked={checks[check.name]}
              disabled={!canManage}
              class="mt-1"
            />
            <span>
              <span class="font-medium">{check.label}</span>
              <span class="block text-xs text-neutral-500 dark:text-neutral-400">
                {check.hint}
              </span>
            </span>
          </label>
        ))}
        {canManage && (
          <button type="submit" class={BUTTON_SM}>
            Save
          </button>
        )}
      </form>
    </section>
  </div>
</DashboardLayout>

<script>
  import { wireSortableTables } from '@lib/client/table-sort';

  wireSortableTables();
</script>
