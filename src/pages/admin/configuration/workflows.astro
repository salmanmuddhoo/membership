---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import ConfigNav from '@components/ConfigNav.astro';
import { query } from '@lib/db/pool';
import {
  ConfigError,
  listWorkflows,
  listWorkflowStatuses,
  setStatusActive,
  setStepEnabled,
  setStepQuorum,
  setStepRole,
} from '@lib/config/reference';

const principal = Astro.locals.principal!;
const canManage = principal.permissions.has('config.manage');

let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  if (!canManage) {
    error = 'You do not have permission to change configuration.';
  } else {
    const form = await Astro.request.formData();
    const intent = String(form.get('intent') ?? '');
    const actor = { userId: principal.userId, email: principal.email };

    try {
      if (intent === 'step') {
        const stepId = String(form.get('stepId'));
        // Role and quorum first: if enabling the step is what fails, the
        // administrator has not silently lost the other two edits.
        await setStepRole(stepId, String(form.get('roleId')), actor);
        await setStepQuorum(
          stepId,
          Number(form.get('quorumCount') ?? 1),
          actor
        );
        await setStepEnabled(stepId, form.get('isEnabled') === 'on', actor);
        notice = 'Step updated.';
      } else if (intent === 'status') {
        await setStatusActive(
          String(form.get('statusId')),
          form.get('isActive') === 'on',
          actor
        );
        notice = 'Status updated.';
      }
    } catch (err) {
      if (err instanceof ConfigError) {
        error = err.message;
      } else {
        console.error('[config/workflows]', err);
        error = 'Something went wrong. Please try again.';
      }
    }
  }
}

const [workflows, roles] = await Promise.all([
  listWorkflows(),
  query<{ id: string; name: string }>(
    'select id, name from role order by name'
  ).then(r => r.rows),
]);

const statusesByEntity = new Map(
  await Promise.all(
    [...new Set(workflows.map(w => w.entityType))].map(
      async entity => [entity, await listWorkflowStatuses(entity)] as const
    )
  )
);
---

<DashboardLayout title="Workflows · Al Barakah MCSL" heading="Workflows">
  <div class="mx-auto max-w-5xl space-y-6">
    <ConfigNav />

    {
      error && (
        <div class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
          {error}
        </div>
      )
    }
    {
      notice && (
        <div class="border-mint-400 bg-mint-50 dark:border-mint-700 dark:bg-mint-950 rounded-lg border px-4 py-3 text-sm text-neutral-800 dark:text-neutral-100">
          {notice}
        </div>
      )
    }

    <p class="text-sm text-neutral-500 dark:text-neutral-400">
      A step is assigned to a <strong>role</strong>, never to a person, so the
      chain does not stall when one officer is away — any holder of the role may
      act. A disabled step stays in the list and is skipped, which is how the
      Regional Manager review can be switched on later without a release.
    </p>

    {
      workflows.map(workflow => (
        <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
              {workflow.name}
            </h2>
            <code class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
              {workflow.entityType}
            </code>
          </div>
          <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
            {workflow.description}
          </p>

          <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-300">
            <span class="font-medium">Runs as:</span>{' '}
            {workflow.steps
              .filter(s => s.isEnabled)
              .map(s => s.roleName)
              .join(' → ')}
          </p>

          <div class="mt-4 space-y-3">
            {workflow.steps.map(step => (
              <form
                method="post"
                class="rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900"
              >
                <input type="hidden" name="stepId" value={step.id} />
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <span class="text-xs text-neutral-400 dark:text-neutral-500">
                    step {step.stepNo}
                  </span>
                  <span class="font-medium text-neutral-800 dark:text-neutral-100">
                    {step.name}
                  </span>
                  {!step.isEnabled && (
                    <span class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-600 dark:bg-neutral-700 dark:text-neutral-300">
                      disabled
                    </span>
                  )}
                  <span class="text-xs text-neutral-500 dark:text-neutral-400">
                    {step.fromStatus === step.toStatus
                      ? `gate at ${step.fromStatus}`
                      : `${step.fromStatus} → ${step.toStatus}`}
                  </span>
                </div>

                <div class="mt-3 grid gap-3 sm:grid-cols-3">
                  <label class="text-sm text-neutral-600 dark:text-neutral-300">
                    Role
                    <select
                      name="roleId"
                      disabled={!canManage}
                      class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                    >
                      {roles.map(r => (
                        <option value={r.id} selected={r.id === step.roleId}>
                          {r.name}
                        </option>
                      ))}
                    </select>
                  </label>
                  <label class="text-sm text-neutral-600 dark:text-neutral-300">
                    Quorum
                    <input
                      type="number"
                      name="quorumCount"
                      min="1"
                      value={step.quorumCount}
                      disabled={!canManage}
                      class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                    />
                  </label>
                  <label class="flex items-end gap-x-2 pb-1.5 text-sm text-neutral-600 dark:text-neutral-300">
                    <input
                      type="checkbox"
                      name="isEnabled"
                      checked={step.isEnabled}
                      disabled={!canManage}
                      class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
                    />
                    Enabled
                  </label>
                </div>

                {canManage && (
                  <button
                    type="submit"
                    name="intent"
                    value="step"
                    class="bg-mint-300 hover:bg-mint-400 mt-3 rounded-lg px-3 py-1.5 text-sm font-bold text-neutral-800 transition"
                  >
                    Save step
                  </button>
                )}
              </form>
            ))}
          </div>

          <h3 class="mt-6 text-sm font-medium text-neutral-700 dark:text-neutral-200">
            Statuses
          </h3>
          <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
            Statuses are configuration. A status the Society has not confirmed —
            Abeyance — is switched off rather than missing, so it can be turned
            on when the decision is made.
          </p>
          <div class="mt-3 space-y-2">
            {(statusesByEntity.get(workflow.entityType) ?? []).map(status => (
              <form
                method="post"
                class="flex flex-wrap items-center gap-2 text-sm"
              >
                <input type="hidden" name="statusId" value={status.id} />
                <span class="min-w-48 text-neutral-700 dark:text-neutral-200">
                  {status.name}
                </span>
                <code class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
                  {status.code}
                </code>
                {status.isTerminal && (
                  <span class="text-xs text-neutral-400 dark:text-neutral-500">
                    terminal
                  </span>
                )}
                <label class="flex items-center gap-x-2 text-neutral-600 dark:text-neutral-300">
                  <input
                    type="checkbox"
                    name="isActive"
                    checked={status.isActive}
                    disabled={!canManage}
                    class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
                  />
                  Active
                </label>
                {canManage && (
                  <button
                    type="submit"
                    name="intent"
                    value="status"
                    class="rounded border border-neutral-300 px-2 py-0.5 text-xs text-neutral-600 transition hover:bg-neutral-100 dark:border-neutral-600 dark:text-neutral-300 dark:hover:bg-neutral-800"
                  >
                    Save
                  </button>
                )}
              </form>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</DashboardLayout>
