---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import ConfigNav from '@components/ConfigNav.astro';
import {
  ConfigError,
  listChecklists,
  listFeeSchedules,
  listMembershipTypes,
  setFieldRule,
  setMajorityTransition,
  setMembershipTypeReferences,
  setNomineeCount,
} from '@lib/config/reference';
import {
  PAGE,
  CARD,
  CARD_TITLE,
  HINT,
  PANEL,
  INPUT,
  INPUT_BARE,
  BUTTON,
  BUTTON_SM,
  LABEL,
  NOTICE_ERROR,
  NOTICE_OK,
  TABLE,
  THEAD,
  TH,
  ROW,
  TD,
} from '@lib/ui';

const principal = Astro.locals.principal!;
const canManage = principal.permissions.has('config.manage');

let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  if (!canManage) {
    error = 'You do not have permission to change configuration.';
  } else {
    const form = await Astro.request.formData();
    const intent = String(form.get('intent') ?? '');
    const actor = { userId: principal.userId, email: principal.email };

    try {
      if (intent === 'references') {
        await setMembershipTypeReferences(
          String(form.get('typeId')),
          {
            checklistId: String(form.get('checklistId') ?? '') || null,
            nonMemberChecklistId:
              String(form.get('nonMemberChecklistId') ?? '') || null,
            feeScheduleId: String(form.get('feeScheduleId') ?? '') || null,
          },
          actor
        );
        notice = 'Checklist and fee schedule updated.';
      } else if (intent === 'fields') {
        // One form per type, so the visible/mandatory state of every field on
        // it is submitted together: a checkbox that is off sends nothing, and
        // reading each field's pair explicitly is what makes "unchecked" mean
        // false rather than "leave as it was".
        const visible = new Set(form.getAll('visible').map(String));
        const mandatory = new Set(form.getAll('mandatory').map(String));
        const ids = form.getAll('fieldId').map(String);

        for (const id of ids) {
          await setFieldRule(
            id,
            { isVisible: visible.has(id), isMandatory: mandatory.has(id) },
            actor
          );
        }
        notice = `Field rules updated for ${ids.length} field(s).`;
      } else if (intent === 'nomineeCount') {
        await setNomineeCount(
          String(form.get('typeId')),
          Number(form.get('nomineeCount')),
          actor
        );
        notice = 'Nominee count updated.';
      } else if (intent === 'majorityTransition') {
        const ageRaw = String(form.get('majorityAge') ?? '').trim();
        const transitionTypeIdRaw = String(
          form.get('majorityTransitionTypeId') ?? ''
        ).trim();
        await setMajorityTransition(
          String(form.get('typeId')),
          {
            age: ageRaw === '' ? null : Number(ageRaw),
            transitionTypeId:
              transitionTypeIdRaw === '' ? null : transitionTypeIdRaw,
          },
          actor
        );
        notice = 'Majority transition updated.';
      }
    } catch (err) {
      if (err instanceof ConfigError) {
        error = err.message;
      } else {
        console.error('[config/membership-types]', err);
        error = 'Something went wrong. Please try again.';
      }
    }
  }
}

const [types, checklists, schedules] = await Promise.all([
  listMembershipTypes(),
  listChecklists(),
  listFeeSchedules(),
]);

const SUBJECT_LABELS: Record<string, string> = {
  applicant: 'Applicant',
  nominee: 'Nominee',
  guardian: 'Guardian',
  beneficiary: 'Takaful beneficiary',
  employment: 'Employment Details',
};
---

<DashboardLayout
  title="Membership types · Al Barakah MCSL"
  heading="Membership types"
>
  <div class={PAGE.list}>
    <ConfigNav />

    {error && <div class={NOTICE_ERROR}>{error}</div>}
    {notice && <div class={NOTICE_OK}>{notice}</div>}

    {types.map(type => (
      <section class={CARD}>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <h2 class={CARD_TITLE}>{type.name}</h2>
          <code class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
            {type.code}
          </code>
          {!type.isActive && (
            <span class="rounded bg-red-100 px-1.5 py-0.5 text-xs text-red-800 dark:bg-red-950 dark:text-red-200">
              inactive
            </span>
          )}
        </div>
        <p class={`${HINT} mt-1`}>{type.description}</p>

        <form method="post" class="mt-4 grid gap-3 sm:grid-cols-2">
          <input type="hidden" name="typeId" value={type.id} />
          <label class={LABEL}>
            Document checklist
            <select name="checklistId" disabled={!canManage} class={INPUT}>
              <option value="">— none —</option>
              {checklists.map(c => (
                <option value={c.id} selected={c.id === type.checklistId}>
                  {c.name}
                </option>
              ))}
            </select>
          </label>
          {type.code === 'individual' && (
            <label class={LABEL}>
              Documents required from a non-member applicant
              <select
                name="nonMemberChecklistId"
                disabled={!canManage}
                class={INPUT}
              >
                <option value="">— none —</option>
                {checklists.map(c => (
                  <option
                    value={c.id}
                    selected={c.id === type.nonMemberChecklistId}
                  >
                    {c.name}
                  </option>
                ))}
              </select>
            </label>
          )}
          <label class={LABEL}>
            Fee schedule
            <select name="feeScheduleId" disabled={!canManage} class={INPUT}>
              <option value="">— none —</option>
              {schedules.map(s => (
                <option value={s.id} selected={s.id === type.feeScheduleId}>
                  {s.name}
                </option>
              ))}
            </select>
          </label>
          {canManage && (
            <div class="sm:col-span-2">
              <button
                type="submit"
                name="intent"
                value="references"
                class={BUTTON}
              >
                Save links
              </button>
            </div>
          )}
        </form>

        {type.fields.some(f => f.subject === 'nominee') && (
          <form method="post" class="mt-4 flex flex-wrap items-end gap-3">
            <input type="hidden" name="typeId" value={type.id} />
            <label class={LABEL}>
              Nominees to capture
              <input
                type="number"
                name="nomineeCount"
                min="1"
                max="10"
                value={type.nomineeCount}
                disabled={!canManage}
                class={`${INPUT_BARE} mt-1 block w-24`}
              />
            </label>
            {canManage && (
              <button
                type="submit"
                name="intent"
                value="nomineeCount"
                class={BUTTON_SM}
              >
                Save nominee count
              </button>
            )}
          </form>
        )}

        <form method="post" class="mt-4 flex flex-wrap items-end gap-3">
          <input type="hidden" name="typeId" value={type.id} />
          <label class={LABEL}>
            Age of majority
            <input
              type="number"
              name="majorityAge"
              min="1"
              max="100"
              placeholder="none"
              value={type.majorityAge ?? ''}
              disabled={!canManage}
              class={`${INPUT_BARE} mt-1 block w-24`}
            />
          </label>
          <label class={LABEL}>
            Automatically becomes
            <select
              name="majorityTransitionTypeId"
              disabled={!canManage}
              class={INPUT}
            >
              <option value="">— no automatic transition —</option>
              {types
                .filter(t => t.id !== type.id)
                .map(t => (
                  <option
                    value={t.id}
                    selected={t.id === type.majorityTransitionTypeId}
                  >
                    {t.name}
                  </option>
                ))}
            </select>
          </label>
          {canManage && (
            <button
              type="submit"
              name="intent"
              value="majorityTransition"
              class={BUTTON_SM}
            >
              Save majority transition
            </button>
          )}
        </form>

        <details class={`${PANEL} mt-4`}>
          <summary class="cursor-pointer text-sm font-medium text-neutral-700 dark:text-neutral-200">
            Form fields ({type.fields.length})
          </summary>

          <form method="post" class="mt-4 space-y-4">
            <input type="hidden" name="typeId" value={type.id} />
            {[
              'applicant',
              'nominee',
              'guardian',
              'beneficiary',
              'employment',
            ].map(subject => {
              const fields = type.fields.filter(f => f.subject === subject);
              if (fields.length === 0) return null;
              return (
                <fieldset>
                  <legend class="mb-2 text-sm font-medium text-neutral-700 dark:text-neutral-200">
                    {SUBJECT_LABELS[subject]}
                  </legend>
                  <div class="overflow-x-auto">
                    <table class={TABLE}>
                      <thead>
                        <tr class={THEAD}>
                          <th class={TH}>Field</th>
                          <th class={TH}>Type</th>
                          <th class={TH}>Shown</th>
                          <th class={TH}>Mandatory</th>
                        </tr>
                      </thead>
                      <tbody>
                        {fields.map(field => (
                          <tr class={ROW}>
                            <td
                              class={`${TD} text-neutral-700 dark:text-neutral-200`}
                            >
                              {field.label}
                              <input
                                type="hidden"
                                name="fieldId"
                                value={field.id}
                              />
                            </td>
                            <td
                              class={`${TD} text-xs text-neutral-400 dark:text-neutral-500`}
                            >
                              {field.dataType}
                            </td>
                            <td class={TD}>
                              <input
                                type="checkbox"
                                name="visible"
                                value={field.id}
                                checked={field.isVisible}
                                disabled={!canManage}
                                class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
                              />
                            </td>
                            <td class={TD}>
                              <input
                                type="checkbox"
                                name="mandatory"
                                value={field.id}
                                checked={field.isMandatory}
                                disabled={!canManage}
                                class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
                              />
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </fieldset>
              );
            })}

            {canManage && (
              <button
                type="submit"
                name="intent"
                value="fields"
                class={BUTTON_SM}
              >
                Save field rules
              </button>
            )}
          </form>
        </details>
      </section>
    ))}
  </div>
</DashboardLayout>
