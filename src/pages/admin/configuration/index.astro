---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { CONFIG_SECTIONS } from '@components/ConfigNav.astro';

const principal = Astro.locals.principal!;
const canManage = principal.permissions.has('config.manage');
---

<DashboardLayout
  title="Configuration · Al Barakah MCSL"
  heading="Configuration"
>
  <div class="mx-auto max-w-5xl space-y-6">
    <section
      class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950"
    >
      <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
        Reference configuration
      </h2>
      {
        !canManage && (
          <p class="mt-3 rounded-lg border border-neutral-300 px-3 py-2 text-sm text-neutral-600 dark:border-neutral-700 dark:text-neutral-300">
            You may view this configuration but not change it.
          </p>
        )
      }

      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {
          CONFIG_SECTIONS.map(section => (
            <a
              href={section.href}
              class="hover:border-mint-400 rounded-xl border border-neutral-200 bg-white p-4 transition dark:border-neutral-800 dark:bg-neutral-900"
            >
              <span class="font-medium text-neutral-800 dark:text-neutral-100">
                {section.label}
              </span>
              <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
                {section.blurb}
              </p>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</DashboardLayout>
