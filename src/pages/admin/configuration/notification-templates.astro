---
// What a member is told, in the Society's own words (S-901).
//
// The wording is configuration, not code: changing "Welcome to Al Barakah" is
// an edit here, not a release. Reaching this page needs config.view (the
// prefix rule in authorise.ts); changing anything needs config.manage, which
// this page checks itself.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import ConfigNav from '@components/ConfigNav.astro';
import { ConfigError } from '@lib/config/reference';
import { placeholdersForEvent } from '@lib/notifications/event-codes';
import {
  listNotificationTemplates,
  placeholderSequence,
  updateNotificationTemplate,
  type NotificationChannel,
} from '@lib/notifications/templates';
import {
  PAGE,
  CARD,
  CARD_TITLE,
  HINT,
  PANEL,
  LABEL,
  INPUT,
  BUTTON,
  CHECK_LABEL,
  NOTICE_ERROR,
  NOTICE_OK,
} from '@lib/ui';

const principal = Astro.locals.principal!;
const canManage = principal.permissions.has('config.manage');

let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  if (!canManage) {
    error = 'You do not have permission to change notification wording.';
  } else {
    const form = await Astro.request.formData();
    const subject = String(form.get('subject') ?? '').trim();

    try {
      await updateNotificationTemplate(
        String(form.get('id')),
        {
          subject: subject === '' ? null : subject,
          body: String(form.get('body') ?? ''),
          isActive: form.get('isActive') === 'on',
          providerTemplateName: String(
            form.get('providerTemplateName') ?? ''
          ).trim(),
          providerTemplateLanguage: String(
            form.get('providerTemplateLanguage') ?? ''
          ).trim(),
          ...(form.has('attachesDocumentShown')
            ? { attachesDocument: form.get('attachesDocument') === 'on' }
            : {}),
        },
        { userId: principal.userId, email: principal.email }
      );
      notice = 'Wording saved. Messages already sent keep what they said.';
    } catch (err) {
      if (err instanceof ConfigError) {
        error = err.message;
      } else {
        console.error('[config/notification-templates]', err);
        error = 'Something went wrong. Please try again.';
      }
    }
  }
}

const templates = await listNotificationTemplates();

const CHANNEL_LABELS: Record<NotificationChannel, string> = {
  email: 'Email',
  whatsapp: 'WhatsApp',
};

// The officer's name for the event, not the system's.
const EVENT_LABELS: Record<string, string> = {
  'application.submitted': 'Application received',
  'application.returned': 'Application returned for correction',
  'application.approved': 'Membership approved',
  'application.rejected': 'Application not approved',
  'account.submitted': 'Account application received',
  'account.returned': 'Account application returned for correction',
  'account.approved': 'Account opened',
  'account.rejected': 'Account application not approved',
  'receipt.issued': 'Receipt issued',
  'closure.submitted': 'Account closure received',
  'closure.under_review': 'Account closure under review',
  'closure.approved': 'Account closed and paid out',
  'closure.rejected': 'Account closure not approved',
  'resignation.submitted': 'Resignation received',
  'resignation.under_review': 'Resignation under review',
  'resignation.approved': 'Resignation approved and paid out',
  'resignation.rejected': 'Resignation not approved',
  'demised.submitted': 'Demised claim received',
  'demised.under_review': 'Demised claim under review',
  'demised.approved': 'Demised claim paid out',
  'demised.rejected': 'Demised claim not approved',
  'deposit.posted': 'Deposit received',
  'withdrawal.submitted': 'Withdrawal received',
  'withdrawal.under_review': 'Withdrawal under review',
  'withdrawal.disbursed': 'Withdrawal paid out',
  'withdrawal.rejected': 'Withdrawal not approved',
  'transfer.posted': 'Transfer completed',
  'balance.near_floor': 'Balance near its minimum',
  'transaction.awaiting': 'Staff: transaction awaiting a step',
  'transaction.returned': 'Staff: transaction returned to its captor',
  'receipt.voided': 'Staff: receipt voided',
};

const eventLabel = (code: string) =>
  EVENT_LABELS[code] ?? code.replace(/\./g, ' · ');

// Grouped by event so the two channels for one thing sit together — an
// administrator changing what an approval says wants both in front of them.
const byEvent = new Map<string, typeof templates>();
for (const template of templates) {
  const group = byEvent.get(template.eventCode) ?? [];
  group.push(template);
  byEvent.set(template.eventCode, group);
}
---

<DashboardLayout
  title="Notification wording · Al Barakah MCSL"
  heading="Notification wording"
>
  <div class={PAGE.list}>
    <ConfigNav />

    {error && <p class={NOTICE_ERROR}>{error}</p>}
    {notice && <p class={NOTICE_OK}>{notice}</p>}

    {!canManage && (
      <p class="rounded-xl border border-neutral-300 px-4 py-3 text-sm text-neutral-600 dark:border-neutral-700 dark:text-neutral-300">
        You may read this wording but not change it.
      </p>
    )}

    {[...byEvent.entries()].map(([eventCode, group]) => (
      <section class={`${CARD} space-y-3`}>
        <h2 class={CARD_TITLE}>{eventLabel(eventCode)}</h2>

        {(placeholdersForEvent(eventCode) ?? []).length > 0 && (
          <p class="flex flex-wrap items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400">
            <span>Available:</span>
            {(placeholdersForEvent(eventCode) ?? []).map(name => (
              <code class="rounded bg-neutral-200 px-1.5 py-0.5 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-200">
                {`{{${name}}}`}
              </code>
            ))}
          </p>
        )}

        {group.some(t => t.channel === 'whatsapp') &&
          placeholderSequence(group.find(t => t.channel === 'whatsapp')!.body)
            .length > 0 && (
            <p class="flex flex-wrap items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400">
              <span>WhatsApp slots:</span>
              {placeholderSequence(
                group.find(t => t.channel === 'whatsapp')!.body
              ).map((name, i) => (
                <code class="rounded bg-neutral-200 px-1.5 py-0.5 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-200">
                  {`{{${i + 1}}} = {{${name}}}`}
                </code>
              ))}
            </p>
          )}

        {group.map(template => (
          <form method="post" class={`${PANEL} space-y-3`}>
            <input type="hidden" name="id" value={template.id} />

            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-sm font-semibold text-neutral-800 dark:text-neutral-100">
                {CHANNEL_LABELS[template.channel]}
              </span>
              <label class={CHECK_LABEL}>
                <input
                  type="checkbox"
                  name="isActive"
                  checked={template.isActive}
                  disabled={!canManage}
                  class="rounded border-neutral-300 dark:border-neutral-600"
                />
                Send this
              </label>
            </div>

            {template.channel === 'email' && (
              <label class={LABEL}>
                Subject
                <input
                  type="text"
                  name="subject"
                  value={template.subject ?? ''}
                  disabled={!canManage}
                  class={INPUT}
                />
              </label>
            )}

            {template.channel === 'whatsapp' && (
              <div class="grid gap-3 sm:grid-cols-3">
                <label class={`${LABEL} sm:col-span-2`}>
                  WhatsApp template name
                  <input
                    type="text"
                    name="providerTemplateName"
                    value={template.providerTemplateName ?? ''}
                    disabled={!canManage}
                    class={INPUT}
                  />
                </label>
                <label class={LABEL}>
                  Language
                  <input
                    type="text"
                    name="providerTemplateLanguage"
                    value={template.providerTemplateLanguage}
                    disabled={!canManage}
                    class={INPUT}
                  />
                </label>
              </div>
            )}

            {template.eventCode === 'receipt.issued' && (
              <label class={CHECK_LABEL}>
                <input type="hidden" name="attachesDocumentShown" value="1" />
                <input
                  type="checkbox"
                  name="attachesDocument"
                  checked={template.attachesDocument}
                  disabled={!canManage}
                  class="rounded border-neutral-300 dark:border-neutral-600"
                />
                {template.channel === 'whatsapp'
                  ? 'Attach the receipt as a PDF (the WhatsApp template needs a document header)'
                  : 'Attach the receipt as a PDF'}
              </label>
            )}

            <label class={LABEL}>
              Message
              <textarea
                name="body"
                rows={template.channel === 'email' ? 8 : 4}
                disabled={!canManage}
                class={`${INPUT} font-mono`}
              >{template.body}</textarea>
            </label>

            {canManage && (
              <button type="submit" class={BUTTON}>
                Save
              </button>
            )}
          </form>
        ))}
      </section>
    ))}

    {templates.length === 0 && (
      <p class={`${CARD} ${HINT}`}>No notification wording has been set up.</p>
    )}
  </div>
</DashboardLayout>
