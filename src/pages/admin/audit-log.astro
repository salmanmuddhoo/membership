---
// The audit trail (FRD Section 10), as a filterable page rather than a raw
// table dump — gated by its own permission (audit.view, migration 0036) so
// who may see it is Configuration -> Roles' decision, not this page's own.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import {
  AUDIT_PAGE_LIMIT,
  distinctAuditActions,
  distinctAuditEntityTypes,
  listAuditEvents,
} from '@lib/access/audit';

const params = Astro.url.searchParams;
const actor = params.get('actor')?.trim() || '';
const action = params.get('action') || '';
const entityType = params.get('entityType') || '';
const entityId = params.get('entityId')?.trim() || '';
const fromRaw = params.get('from') || '';
const toRaw = params.get('to') || '';
const page = Math.max(Number(params.get('page') ?? '1') || 1, 1);

// A day picked in "To" means through the end of that day, not midnight at
// its start — the one point a straight `<=` on the typed date would miss.
const from = fromRaw ? new Date(`${fromRaw}T00:00:00`) : undefined;
const to = toRaw ? new Date(`${toRaw}T23:59:59.999`) : undefined;

const offset = (page - 1) * AUDIT_PAGE_LIMIT;

const [{ events, total }, actions, entityTypes] = await Promise.all([
  listAuditEvents({
    actor: actor || undefined,
    action: action || undefined,
    entityType: entityType || undefined,
    entityId: entityId || undefined,
    from,
    to,
    offset,
  }),
  distinctAuditActions(),
  distinctAuditEntityTypes(),
]);

const totalPages = Math.max(Math.ceil(total / AUDIT_PAGE_LIMIT), 1);

const dateTimeFormat = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'medium',
});

// Carries every filter across a page-number link — a next/previous click
// changes only `page`, not what was being looked for.
const pageHref = (target: number) => {
  const next = new URLSearchParams(params);
  next.set('page', String(target));
  return `/admin/audit-log?${next.toString()}`;
};
---

<DashboardLayout title="Audit log · Al Barakah MCSL" heading="Audit log">
  <div class="mx-auto max-w-6xl space-y-6">
    <section
      class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950"
    >
      <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
        Filter
      </h2>
      <form method="get" class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          Actor
          <input
            type="text"
            name="actor"
            value={actor}
            placeholder="Name or email"
            class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
          />
        </label>
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          Action
          <select
            name="action"
            class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
          >
            <option value="">All actions</option>
            {
              actions.map(a => (
                <option value={a} selected={a === action}>
                  {a}
                </option>
              ))
            }
          </select>
        </label>
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          Record type
          <select
            name="entityType"
            class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
          >
            <option value="">All record types</option>
            {
              entityTypes.map(t => (
                <option value={t} selected={t === entityType}>
                  {t}
                </option>
              ))
            }
          </select>
        </label>
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          Record ID
          <input
            type="text"
            name="entityId"
            value={entityId}
            placeholder="Exact ID"
            class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
          />
        </label>
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          From
          <input
            type="date"
            name="from"
            value={fromRaw}
            class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
          />
        </label>
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          To
          <input
            type="date"
            name="to"
            value={toRaw}
            class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
          />
        </label>
        <div class="flex items-end gap-2 lg:col-span-3">
          <button
            type="submit"
            class="bg-mint-300 hover:bg-mint-400 rounded-lg px-4 py-2 text-sm font-bold text-neutral-800 transition"
          >
            Filter
          </button>
          {
            (actor || action || entityType || entityId || fromRaw || toRaw) && (
              <a
                href="/admin/audit-log"
                class="text-sm text-neutral-500 underline dark:text-neutral-400"
              >
                Clear
              </a>
            )
          }
        </div>
      </form>
    </section>

    <section
      class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950"
    >
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2
          class="text-lg font-semibold text-neutral-800 dark:text-neutral-100"
        >
          {total} entr{total === 1 ? 'y' : 'ies'}
        </h2>
        {
          totalPages > 1 && (
            <p class="text-sm text-neutral-500 dark:text-neutral-400">
              Page {page} of {totalPages}
            </p>
          )
        }
      </div>

      {
        events.length === 0 ? (
          <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400">
            Nothing matches those filters.
          </p>
        ) : (
          <ul class="mt-4 space-y-2">
            {events.map(entry => (
              <li class="rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                  <span class="font-medium text-neutral-800 dark:text-neutral-100">
                    {entry.action}
                  </span>
                  <span class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
                    {entry.entityType} · {entry.entityId}
                  </span>
                </div>
                <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                  {entry.actorName}
                  {entry.actorEmail && ` (${entry.actorEmail})`} ·{' '}
                  {dateTimeFormat.format(entry.occurredAt)}
                  {entry.ipAddress && ` · ${entry.ipAddress}`}
                </p>
                {(entry.previousValue !== null || entry.newValue !== null) && (
                  <details class="mt-2">
                    <summary class="cursor-pointer text-xs font-medium text-neutral-600 dark:text-neutral-300">
                      Details
                    </summary>
                    <div class="mt-2 grid gap-3 sm:grid-cols-2">
                      {entry.previousValue !== null && (
                        <div>
                          <p class="text-xs font-medium text-neutral-500 dark:text-neutral-400">
                            Before
                          </p>
                          <pre class="mt-1 overflow-x-auto rounded-lg bg-neutral-100 p-2 text-xs text-neutral-700 dark:bg-neutral-950 dark:text-neutral-300">
                            {JSON.stringify(entry.previousValue, null, 2)}
                          </pre>
                        </div>
                      )}
                      {entry.newValue !== null && (
                        <div>
                          <p class="text-xs font-medium text-neutral-500 dark:text-neutral-400">
                            After
                          </p>
                          <pre class="mt-1 overflow-x-auto rounded-lg bg-neutral-100 p-2 text-xs text-neutral-700 dark:bg-neutral-950 dark:text-neutral-300">
                            {JSON.stringify(entry.newValue, null, 2)}
                          </pre>
                        </div>
                      )}
                    </div>
                  </details>
                )}
              </li>
            ))}
          </ul>
        )
      }

      {
        totalPages > 1 && (
          <div class="mt-4 flex items-center justify-between gap-2 text-sm">
            {page > 1 ? (
              <a
                href={pageHref(page - 1)}
                class="rounded-lg border border-neutral-300 px-3 py-1.5 font-medium text-neutral-700 transition hover:bg-neutral-100 dark:border-neutral-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
              >
                ← Newer
              </a>
            ) : (
              <span />
            )}
            {page < totalPages && (
              <a
                href={pageHref(page + 1)}
                class="rounded-lg border border-neutral-300 px-3 py-1.5 font-medium text-neutral-700 transition hover:bg-neutral-100 dark:border-neutral-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
              >
                Older →
              </a>
            )}
          </div>
        )
      }
    </section>
  </div>
</DashboardLayout>
