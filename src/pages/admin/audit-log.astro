---
// The audit trail (FRD Section 10), as a filterable page rather than a raw
// table dump — gated by its own permission (audit.view, migration 0036) so
// who may see it is Configuration -> Roles' decision, not this page's own.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import Pagination from '@components/Pagination.astro';
import {
  distinctAuditActions,
  distinctAuditEntityTypes,
  listAuditEvents,
  listSignIns,
  type AuditEventRow,
  type SignInRow,
} from '@lib/access/audit';
import {
  describeAuditDetail,
  type AuditDetail,
} from '@lib/access/audit-detail';
import { endOfLocalDay, localFormat, startOfLocalDay } from '@lib/time';
import { pagingFrom } from '@lib/paging';
import {
  BUTTON,
  CARD,
  CARD_TITLE,
  HINT,
  INPUT,
  PAGE,
  PANEL,
  SECONDARY_SM,
  TAB_CURRENT,
  TABLE,
  TBODY,
  TD,
  TH,
  THEAD,
  LABEL,
} from '@lib/ui';

const params = Astro.url.searchParams;
const view = params.get('view') === 'signins' ? 'signins' : 'activity';
const actor = params.get('actor')?.trim() || '';
const action = params.get('action') || '';
const entityType = params.get('entityType') || '';
const entityId = params.get('entityId')?.trim() || '';
const fromRaw = params.get('from') || '';
const toRaw = params.get('to') || '';
const paging = pagingFrom(Astro.url);

// A day picked in "To" means through the end of that day, not midnight at
// its start — the one point a straight `<=` on the typed date would miss.
// Both are Mauritius days, whatever the server's clock.
const from = fromRaw ? startOfLocalDay(fromRaw) : undefined;
const to = toRaw ? endOfLocalDay(toRaw) : undefined;

let events: AuditEventRow[] = [];
let actions: string[] = [];
let entityTypes: string[] = [];
let details = new Map<string, AuditDetail>();
let signIns: SignInRow[] = [];
let total = 0;

if (view === 'activity') {
  const [{ events: pageEvents, total: pageTotal }, allActions, allTypes] =
    await Promise.all([
      listAuditEvents({
        actor: actor || undefined,
        action: action || undefined,
        entityType: entityType || undefined,
        entityId: entityId || undefined,
        from,
        to,
        limit: paging.per,
        offset: paging.offset,
      }),
      distinctAuditActions(),
      distinctAuditEntityTypes(),
    ]);
  events = pageEvents;
  total = pageTotal;
  actions = allActions;
  entityTypes = allTypes;
  details = await describeAuditDetail(events);
} else {
  const { sessions, total: sessionTotal } = await listSignIns({
    person: actor || undefined,
    from,
    to,
    limit: paging.per,
    offset: paging.offset,
  });
  signIns = sessions;
  total = sessionTotal;
}

const dateTimeFormat = localFormat({
  dateStyle: 'medium',
  timeStyle: 'medium',
});

// Carries every filter across a tab link — a switch between "All activity"
// and "Sign-ins" changes only what it says it changes, not what was being
// looked for. Dropping page/per on purpose: the other tab's own list starts
// at its own first page.
const tabHref = (target: 'activity' | 'signins') => {
  const next = new URLSearchParams();
  if (actor) next.set('actor', actor);
  if (fromRaw) next.set('from', fromRaw);
  if (toRaw) next.set('to', toRaw);
  if (target === 'signins') next.set('view', 'signins');
  return `/admin/audit-log?${next.toString()}`;
};

const EIGHT_HOURS_MS = 8 * 60 * 60 * 1000;
function endedLabel(row: SignInRow): string {
  if (row.endedAt) return dateTimeFormat.format(row.endedAt);
  if (
    row.signedInAt &&
    Date.now() - row.signedInAt.getTime() < EIGHT_HOURS_MS
  ) {
    return 'Still signed in';
  }
  return '—';
}
function howEndedLabel(row: SignInRow): string {
  if (row.endedBy === 'signed_out') return 'Signed out';
  if (row.endedBy === 'timed_out') return 'After inactivity';
  return '—';
}
function durationLabel(row: SignInRow): string {
  if (!row.signedInAt || !row.endedAt) return '—';
  const totalMinutes = Math.max(
    Math.round((row.endedAt.getTime() - row.signedInAt.getTime()) / 60000),
    0
  );
  const hours = Math.floor(totalMinutes / 60);
  const minutes = totalMinutes % 60;
  return hours > 0 ? `${hours} h ${minutes} min` : `${minutes} min`;
}

// An action nothing below names, in words: "application.witnesses_set" reads
// "Application witnesses set". Every line says who did it.
function humaniseAction(action: string): string {
  const words = action.replace(/[._]+/g, ' ').trim().toLowerCase();
  return words.charAt(0).toUpperCase() + words.slice(1);
}

function describeEntry(entry: AuditEventRow, detail?: AuditDetail): string {
  const v = (entry.newValue as Record<string, unknown>) ?? {};
  const by = ` by ${entry.actorName}`;
  const ref = v.reference ? ` ${v.reference}` : '';
  const memberNo = v.memberNo ? ` ${v.memberNo}` : '';

  switch (entry.action) {
    case 'membership.application.started':
    case 'membership.application.started_from_customer':
    case 'membership.application.started_online':
      return `Application started${by}`;
    case 'membership.application.captured':
      return `Application${ref} submitted${by}`;
    case 'membership.application.reviewed':
      return v.outcome === 'return'
        ? `Application${ref} returned for correction${by}`
        : `Application${ref} forwarded to the Secretary${by}`;
    case 'membership.application.regional_reviewed':
      return v.outcome === 'return'
        ? `Application${ref} returned for correction${by}`
        : `Application${ref} forwarded by Regional Manager${by.slice(3)}`;
    case 'membership.application.approved':
      if (v.signoffsRecorded !== undefined)
        return `Application decision recorded${by} (${v.signoffsRecorded}/${v.signoffsRequired} votes)`;
      return v.outcome === 'reject'
        ? `Application${ref} declined${by}`
        : `Application${ref} approved${by}`;
    case 'membership.application.reopened':
      return `Application${ref} reopened${by}`;
    case 'membership.application.renumbered':
      return `Application reference updated to ${v.reference ?? ''}${by}`;
    case 'membership.application.deleted':
      return `Application deleted${by}`;
    case 'membership.application.received':
      return `Application received${by}`;
    case 'member.created':
      return `Member${memberNo} created${by}`;
    case 'member.contact.updated':
      return `Contact details updated${by}`;
    case 'member.details.corrected':
      return `Details corrected${by}`;
    case 'segregation.rule.added':
      return `Segregation rule added${by}`;
    case 'segregation.rule.enabled':
      return `Segregation rule switched on${by}`;
    case 'segregation.rule.disabled':
      return `Segregation rule switched off${by}`;
    case 'member.majority_transition':
      return `Member${memberNo} reached majority age${by}`;
    case 'member.migration.imported':
      return `Member${memberNo} imported via migration${by}`;
    case 'member.migration.updated':
      return `Migrated member updated${by}`;
    case 'member.details.applied':
      return `Details change applied${by}`;
    case 'member.details.declined':
      return `Details change declined${by}`;
    case 'member.details.requested':
      return `Details change requested${by}`;
    case 'member.link.refused':
      return `Member portal link refused for ${entry.actorName}`;
    case 'member.link.requested':
      return `Member portal link requested${by}`;
    case 'member.signup.requested':
      return `Member portal signup requested${by}`;
    case 'member.otp.resent':
      return `OTP resent${by}`;
    case 'member.otp.rejected':
      return `OTP rejected${by}`;
    case 'member.session.revoked':
      return `Member session revoked${by}`;
    case 'customer.created':
      return `Customer record created${by}`;
    case 'customer.converted':
      return `Customer converted to member${memberNo}${by}`;
    case 'customer.migration.imported':
      return `Customer imported via migration${by}`;
    case 'customer.migration.updated':
      return `Migrated customer updated${by}`;
    case 'migration.exported':
      return `Members exported${by}`;
    case 'account.opened': {
      const acctType = String(v.accountType ?? '');
      const forMember = v.memberNo ? ` for ${v.memberNo}` : '';
      return `${acctType} account opened${forMember}${by}`;
    }
    case 'account.transferred':
      return `Account transferred to member${memberNo}${by}`;
    case 'document.filed':
      return `Document filed${by}`;
    case 'document.verified':
      return v.state === 'rejected'
        ? `Document rejected${by}`
        : `Document verified${by}`;
    case 'document.removed':
      return `Document removed${by}`;
    case 'document.expired':
      return `Document expired${by}`;
    case 'membership.payment.recorded': {
      const receipt = v.receiptNo ? ` (receipt ${v.receiptNo})` : '';
      const amount = v.totalAmount ? ` — Rs ${v.totalAmount}` : '';
      return `Payment recorded${receipt}${amount}${by}`;
    }
    case 'membership.payment.refunded':
      return `Payment refunded${by}`;
    case 'membership.payment.voided':
      return `Payment voided${by}`;
    case 'role.created':
      return `Role created${by}`;
    case 'role.permissions_changed': {
      // Only what changed, never the role's whole list.
      const role = detail?.sentence ?? 'role';
      const change = (detail?.facts ?? [])
        .map(f => `${f.label.toLowerCase()} ${f.value}`)
        .join('; ');
      return `Permissions of ${role} updated${by}${change ? `: ${change}` : ''}`;
    }
    case 'role.updated':
      return `Role details updated${by}`;
    case 'role.deleted':
      return `Role deleted${by}`;
    case 'user.created':
      return `Staff account created${by}`;
    case 'user.roles_changed':
      return `Staff roles updated${by}`;
    case 'user.deleted':
      return `Staff account deleted${by}`;
    case 'access.session_rejected':
      return `Session rejected for ${entry.actorName}`;
    case 'access.denied':
      return `Access denied for ${entry.actorName}`;
    case 'system.data_reset':
      return `Test data reset${by}`;
    // A transaction's own trail (S-1406), under its reference.
    case 'transaction.captured':
      return `Transaction recorded${by}`;
    case 'transaction.submitted':
      return `Transaction submitted for approval${by}`;
    case 'transaction.reviewed':
      return `Transaction forwarded${by}`;
    case 'transaction.returned':
      return `Transaction returned${by}`;
    case 'transaction.rejected':
      return `Transaction rejected${by}`;
    case 'transaction.approved':
      return `Transaction approved${by}`;
    case 'transaction.resubmitted':
      return `Transaction corrected and resubmitted${by}`;
    case 'transaction.posted':
      // Every finished transaction reads Disbursed, same as elsewhere on
      // screen (business decision).
      return `Transaction disbursed${by}`;
    case 'auth.signed_in':
      return `Signed in${by}`;
    case 'auth.signed_out':
      return `Signed out${by}`;
    case 'auth.timed_out':
      return `Signed out after inactivity${by}`;
    case 'cash.session.opened':
      return `Cash drawer opened${by}`;
    case 'cash.session.closed':
      return `Cash drawer closed${by}`;
    case 'application.witnesses_set':
      return `Application witnesses set${by}`;
    case 'transaction.reversed':
      return `Transaction reversed${by}`;
    case 'transaction.voided':
      return `Transaction receipt voided${by}`;
    case 'transaction.cancelled':
      return `Transaction cancelled${by}`;
    case 'transaction.edited':
      return `Transaction edited${by}`;
    default:
      if (entry.action.startsWith('config.')) {
        // config.<table>.<insert|update|delete>: the table, in words.
        const parts = entry.action.split('.');
        const table = parts.length >= 3 ? parts.slice(1, -1).join(' ') : '';
        return table
          ? `${humaniseAction(table)} changed${by}`
          : `Configuration changed${by}`;
      }
      return `${humaniseAction(entry.action)}${by}`;
  }
}
---

<DashboardLayout title="Audit log · Al Barakah MCSL" heading="Audit log">
  <div class={PAGE.wide}>
    <nav class="flex gap-2" aria-label="Audit log views">
      <a
        href={tabHref('activity')}
        aria-current={view === 'activity' ? 'page' : undefined}
        class={view === 'activity' ? TAB_CURRENT : SECONDARY_SM}
      >
        All activity
      </a>
      <a
        href={tabHref('signins')}
        aria-current={view === 'signins' ? 'page' : undefined}
        class={view === 'signins' ? TAB_CURRENT : SECONDARY_SM}
      >
        Sign-ins
      </a>
    </nav>

    <section class={CARD}>
      <h2 class={CARD_TITLE}>Filter</h2>
      <form method="get" class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {view === 'signins' && (
          <input type="hidden" name="view" value="signins" />
        )}
        <label class={LABEL}>
          {view === 'signins' ? 'Person' : 'Actor'}
          <input
            type="text"
            name="actor"
            value={actor}
            placeholder="Name or email"
            class={INPUT}
            data-suggest={`/admin/audit-log/suggest.json${view === 'signins' ? '?view=signins' : ''}`}
          />
        </label>
        {view === 'activity' && (
          <>
            <label class={LABEL}>
              Action
              <select name="action" class={INPUT}>
                <option value="">All actions</option>
                {actions.map(a => (
                  <option value={a} selected={a === action}>
                    {humaniseAction(a)}
                  </option>
                ))}
              </select>
            </label>
            <label class={LABEL}>
              Record type
              <select name="entityType" class={INPUT}>
                <option value="">All record types</option>
                {entityTypes.map(t => (
                  <option value={t} selected={t === entityType}>
                    {t}
                  </option>
                ))}
              </select>
            </label>
            <label class={LABEL}>
              Record ID
              <input
                type="text"
                name="entityId"
                value={entityId}
                placeholder="Exact ID"
                class={INPUT}
              />
            </label>
          </>
        )}
        <label class={LABEL}>
          From
          <input type="date" name="from" value={fromRaw} class={INPUT} />
        </label>
        <label class={LABEL}>
          To
          <input type="date" name="to" value={toRaw} class={INPUT} />
        </label>
        <div class="flex items-end gap-2 lg:col-span-3">
          <button type="submit" class={BUTTON}>
            Filter
          </button>
          {(actor ||
            (view === 'activity' && (action || entityType || entityId)) ||
            fromRaw ||
            toRaw) && (
            <a
              href={
                view === 'signins'
                  ? '/admin/audit-log?view=signins'
                  : '/admin/audit-log'
              }
              class="text-sm text-neutral-500 underline dark:text-neutral-400"
            >
              Clear
            </a>
          )}
        </div>
      </form>
    </section>

    {view === 'activity' ? (
      <section class={CARD}>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class={CARD_TITLE}>
            {total} entr{total === 1 ? 'y' : 'ies'}
          </h2>
        </div>

        {events.length === 0 ? (
          <p class={`${HINT} mt-4`}>Nothing matches those filters.</p>
        ) : (
          <ul class="mt-4 space-y-2">
            {events.map(entry => {
              const detail = details.get(entry.id);
              const panelId = `audit-detail-${entry.id}`;
              return (
                <li class={PANEL}>
                  <button
                    type="button"
                    class="group flex w-full items-start justify-between gap-3 text-left"
                    aria-expanded="false"
                    aria-controls={panelId}
                    data-audit-toggle
                  >
                    <span class="min-w-0">
                      <span class="block text-sm font-medium text-neutral-800 dark:text-neutral-100">
                        {describeEntry(entry, detail)}
                      </span>
                      <span class="mt-1 block text-xs text-neutral-500 dark:text-neutral-400">
                        {dateTimeFormat.format(entry.occurredAt)}
                        {entry.ipAddress && ` · ${entry.ipAddress}`}
                      </span>
                    </span>
                    <svg
                      class="mt-0.5 h-4 w-4 shrink-0 text-neutral-400 transition-transform group-aria-expanded:rotate-90"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </button>
                  <div
                    id={panelId}
                    hidden
                    data-audit-detail
                    class="mt-3 border-t border-neutral-200 pt-3 dark:border-neutral-800"
                  >
                    {detail ? (
                      <>
                        <p class="text-sm text-neutral-700 dark:text-neutral-200">
                          {detail.sentence}
                        </p>
                        {detail.facts.length > 0 && (
                          <dl class="mt-2 grid gap-x-6 gap-y-1 text-xs sm:grid-cols-2">
                            {detail.facts.map(fact => (
                              <div class="flex gap-2">
                                <dt class="shrink-0 text-neutral-500 dark:text-neutral-400">
                                  {fact.label}:
                                </dt>
                                <dd class="text-neutral-700 dark:text-neutral-200">
                                  {fact.value}
                                </dd>
                              </div>
                            ))}
                          </dl>
                        )}
                      </>
                    ) : (
                      <p class={HINT}>No further detail.</p>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        )}
        <Pagination total={total} paging={paging} noun="entries" />
      </section>
    ) : (
      <section class={CARD}>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class={CARD_TITLE}>
            {total} session{total === 1 ? '' : 's'}
          </h2>
        </div>

        {signIns.length === 0 ? (
          <p class={`${HINT} mt-4`}>Nothing matches those filters.</p>
        ) : (
          <div class="mt-4 overflow-x-auto">
            <table class={TABLE}>
              <thead>
                <tr class={THEAD}>
                  <th class={TH}>Person</th>
                  <th class={TH}>Signed in</th>
                  <th class={TH}>Signed out</th>
                  <th class={TH}>How it ended</th>
                  <th class={TH}>Duration</th>
                  <th class={TH}>IP address</th>
                </tr>
              </thead>
              <tbody class={TBODY}>
                {signIns.map(row => (
                  <tr>
                    <td class={`${TD} text-neutral-700 dark:text-neutral-200`}>
                      {row.person}
                    </td>
                    <td class={`${TD} text-neutral-600 dark:text-neutral-300`}>
                      {row.signedInAt
                        ? dateTimeFormat.format(row.signedInAt)
                        : '—'}
                    </td>
                    <td class={`${TD} text-neutral-600 dark:text-neutral-300`}>
                      {endedLabel(row)}
                    </td>
                    <td class={`${TD} text-neutral-600 dark:text-neutral-300`}>
                      {howEndedLabel(row)}
                    </td>
                    <td class={`${TD} text-neutral-600 dark:text-neutral-300`}>
                      {durationLabel(row)}
                    </td>
                    <td class={`${TD} text-neutral-600 dark:text-neutral-300`}>
                      {row.ipAddress ?? '—'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <Pagination total={total} paging={paging} noun="sessions" />
      </section>
    )}
  </div>
</DashboardLayout>

<script>
  // Several detail rows may be open at once; each toggle only ever affects
  // its own panel, found by the id it names (S-... officer request: click an
  // entry to see its detail below it).
  document.addEventListener('click', event => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest<HTMLButtonElement>('[data-audit-toggle]');
    if (!button) return;
    const panelId = button.getAttribute('aria-controls');
    const panel = panelId ? document.getElementById(panelId) : null;
    if (!panel) return;
    const expanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!expanded));
    panel.hidden = expanded;
  });
</script>
