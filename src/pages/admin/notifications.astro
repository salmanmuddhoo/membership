---
// What the Society sent, and what did not get through (S-904) — gated by its
// own permission (notification.view, migration 0056) so who may see it is
// Configuration -> Roles' decision, not this page's own.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { getNotificationConfig } from '@lib/config';
import {
  listNotifications,
  notificationCounts,
  NOTIFICATION_PAGE_LIMIT,
  type NotificationLogRow,
  type NotificationStatus,
} from '@lib/notifications/log';
import {
  channelStatuses,
  sendTestNotification,
  TestSendError,
} from '@lib/notifications/test-send';
import {
  listNotificationTemplates,
  type NotificationChannel,
} from '@lib/notifications/templates';
import {
  BUTTON,
  CARD,
  CARD_TITLE,
  FILTER,
  HINT,
  INPUT,
  MUTED,
  PAGE,
  PANEL,
  SECONDARY,
  SECONDARY_SM,
  LABEL,
  NOTICE_ERROR,
  NOTICE_OK,
  PILL_WARN,
} from '@lib/ui';

const principal = Astro.locals.principal!;
// Reading the log is notification.view (this page's own rule). Sending a real
// message to a real number is a change to the outside world, so it needs the
// permission that governs the wording it sends.
const canTest = principal.permissions.has('config.manage');

let testError: string | null = null;
let testNotice: string | null = null;

if (Astro.request.method === 'POST') {
  if (!canTest) {
    testError = 'You do not have permission to send a test message.';
  } else {
    const form = await Astro.request.formData();
    try {
      const sent = await sendTestNotification(
        {
          templateId: String(form.get('templateId') ?? ''),
          recipient: String(form.get('recipient') ?? ''),
        },
        { userId: principal.userId, email: principal.email }
      );
      testNotice = `Sent to ${sent.recipient}.`;
    } catch (err) {
      if (err instanceof TestSendError) {
        testError = err.message;
      } else {
        // The provider's own words: an unapproved template name, an expired
        // token, a mailbox that does not exist. That reason is the entire
        // point of pressing the button.
        console.error('[admin/notifications] test send', err);
        testError =
          err instanceof Error ? err.message : 'The test could not be sent.';
      }
    }
  }
}

const params = Astro.url.searchParams;

const STATUSES: NotificationStatus[] = [
  'pending',
  'sent',
  'failed',
  'abandoned',
];
const CHANNELS: NotificationChannel[] = ['email', 'whatsapp'];

const statusParam = params.get('status') ?? '';
const channelParam = params.get('channel') ?? '';
const status = STATUSES.includes(statusParam as NotificationStatus)
  ? (statusParam as NotificationStatus)
  : undefined;
const channel = CHANNELS.includes(channelParam as NotificationChannel)
  ? (channelParam as NotificationChannel)
  : undefined;
const search = params.get('search')?.trim() || '';
const page = Math.max(Number(params.get('page') ?? '1') || 1, 1);

const [{ rows, total }, counts, templates] = await Promise.all([
  listNotifications({
    status,
    channel,
    search: search || undefined,
    offset: (page - 1) * NOTIFICATION_PAGE_LIMIT,
  }),
  notificationCounts(),
  listNotificationTemplates(),
]);

const statuses = channelStatuses(getNotificationConfig());
const sendable = templates.filter(t => t.isActive);

const totalPages = Math.max(Math.ceil(total / NOTIFICATION_PAGE_LIMIT), 1);

const dateTimeFormat = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'short',
});

const pageHref = (target: number) => {
  const next = new URLSearchParams(params);
  next.set('page', String(target));
  return `/admin/notifications?${next.toString()}`;
};

// A link that filters to one status, from the counts at the top.
const statusHref = (target: NotificationStatus) =>
  `/admin/notifications?status=${target}`;

const CHANNEL_LABELS: Record<NotificationChannel, string> = {
  email: 'Email',
  whatsapp: 'WhatsApp',
};

const STATUS_LABELS: Record<NotificationStatus, string> = {
  pending: 'Waiting',
  sent: 'Sent',
  failed: 'Retrying',
  abandoned: 'Given up',
};

const STATUS_CLASSES: Record<NotificationStatus, string> = {
  pending:
    'bg-neutral-200 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300',
  sent: 'bg-mint-200 text-neutral-800 dark:bg-mint-900 dark:text-mint-100',
  failed: 'bg-amber-200 text-amber-900 dark:bg-amber-900 dark:text-amber-100',
  abandoned: 'bg-red-200 text-red-900 dark:bg-red-900 dark:text-red-100',
};

// What a message is about, in the words the officer uses for it. The event
// code is the system's name for the thing, not a person's. Kept in step
// with the canonical labels on Configuration -> Notification wording
// (src/pages/admin/configuration/notification-templates.astro); anything
// that page does not name falls back to a sentence-cased code.
const EVENT_LABELS: Record<string, string> = {
  'application.submitted': 'Application received',
  'application.returned': 'Application returned for correction',
  'application.approved': 'Membership approved',
  'application.rejected': 'Application not approved',
  'account.submitted': 'Account application received',
  'account.returned': 'Account application returned for correction',
  'account.approved': 'Account opened',
  'account.rejected': 'Account application not approved',
  'receipt.issued': 'Receipt issued',
  'statement.issued': 'Statement',
  'closure.submitted': 'Account closure received',
  'closure.under_review': 'Account closure under review',
  'closure.approved': 'Account closed and paid out',
  'closure.rejected': 'Account closure not approved',
  'resignation.submitted': 'Resignation received',
  'resignation.under_review': 'Resignation under review',
  'resignation.approved': 'Resignation approved and paid out',
  'resignation.rejected': 'Resignation not approved',
  'demised.submitted': 'Demised claim received',
  'demised.under_review': 'Demised claim under review',
  'demised.approved': 'Demised claim paid out',
  'demised.rejected': 'Demised claim not approved',
  'deposit.posted': 'Deposit received',
  'withdrawal.submitted': 'Withdrawal received',
  'withdrawal.under_review': 'Withdrawal under review',
  'withdrawal.disbursed': 'Withdrawal paid out',
  'withdrawal.rejected': 'Withdrawal not approved',
  'transfer.posted': 'Transfer completed',
  'balance.near_floor': 'Balance near its minimum',
  'transaction.awaiting': 'Staff: transaction awaiting a step',
  'transaction.returned': 'Staff: transaction returned to its captor',
  'receipt.voided': 'Staff: receipt voided',
};

function sentenceCase(eventCode: string): string {
  const words = eventCode.split('.').join(' ');
  return words.charAt(0).toUpperCase() + words.slice(1);
}

function describeEventCode(eventCode: string): string {
  return EVENT_LABELS[eventCode] ?? sentenceCase(eventCode);
}

const describeEvent = (row: NotificationLogRow) =>
  describeEventCode(row.eventCode);

function whenLine(row: NotificationLogRow): string {
  if (row.status === 'sent' && row.sentAt) {
    return `Sent ${dateTimeFormat.format(row.sentAt)}`;
  }
  if (row.status === 'failed' && row.nextAttemptAt) {
    return `Next try ${dateTimeFormat.format(row.nextAttemptAt)}`;
  }
  return `Created ${dateTimeFormat.format(row.createdAt)}`;
}
---

<DashboardLayout
  title="Notifications · Al Barakah MCSL"
  heading="Notifications"
>
  <div class={PAGE.wide}>
    {testError && <p class={NOTICE_ERROR}>{testError}</p>}
    {testNotice && <p class={NOTICE_OK}>{testNotice}</p>}

    <section class={CARD}>
      <h2 class={CARD_TITLE}>Delivery</h2>
      <ul class="mt-3 space-y-1">
        {statuses.map(s => (
          <li class="flex flex-wrap items-center gap-2 text-sm">
            <span class="font-medium text-neutral-800 dark:text-neutral-100">
              {CHANNEL_LABELS[s.channel]}
            </span>
            <span class="text-neutral-600 dark:text-neutral-300">
              {s.provider}
            </span>
            {!s.configured && (
              <span class={PILL_WARN}>Nothing is being sent</span>
            )}
          </li>
        ))}
      </ul>

      {canTest && sendable.length > 0 && (
        <form method="post" class="mt-4 grid gap-3 sm:grid-cols-3">
          <label class={LABEL}>
            Message
            <select name="templateId" class={INPUT}>
              {sendable.map(t => (
                <option value={t.id}>
                  {describeEventCode(t.eventCode)} · {CHANNEL_LABELS[t.channel]}
                </option>
              ))}
            </select>
          </label>
          <label class={LABEL}>
            Send to
            <input
              type="text"
              name="recipient"
              placeholder="you@albarakah.mu or +23057891234"
              class={INPUT}
            />
          </label>
          <div class="flex items-end">
            <button type="submit" class={SECONDARY}>
              Send test
            </button>
          </div>
        </form>
      )}
    </section>

    <section class="grid gap-3 sm:grid-cols-3">
      <a
        href={statusHref('pending')}
        class={`${FILTER} transition hover:bg-neutral-200 dark:hover:bg-neutral-900`}
      >
        <p class="text-2xl font-bold text-neutral-800 dark:text-neutral-100">
          {counts.waiting}
        </p>
        <p class={MUTED}>Waiting</p>
      </a>
      <a
        href={statusHref('failed')}
        class={`${FILTER} transition hover:bg-neutral-200 dark:hover:bg-neutral-900`}
      >
        <p class="text-2xl font-bold text-neutral-800 dark:text-neutral-100">
          {counts.failed}
        </p>
        <p class={MUTED}>Retrying</p>
      </a>
      <a
        href={statusHref('abandoned')}
        class={`${FILTER} transition hover:bg-neutral-200 dark:hover:bg-neutral-900`}
      >
        <p class="text-2xl font-bold text-neutral-800 dark:text-neutral-100">
          {counts.abandoned}
        </p>
        <p class={MUTED}>Given up</p>
      </a>
    </section>

    <section class={CARD}>
      <form method="get" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <label class={LABEL}>
          Status
          <select name="status" class={INPUT}>
            <option value="">All</option>
            {STATUSES.map(s => (
              <option value={s} selected={s === status}>
                {STATUS_LABELS[s]}
              </option>
            ))}
          </select>
        </label>
        <label class={LABEL}>
          Channel
          <select name="channel" class={INPUT}>
            <option value="">All</option>
            {CHANNELS.map(c => (
              <option value={c} selected={c === channel}>
                {CHANNEL_LABELS[c]}
              </option>
            ))}
          </select>
        </label>
        <label class={LABEL}>
          Address or reference
          <input type="text" name="search" value={search} class={INPUT} />
        </label>
        <div class="flex items-end gap-3">
          <button type="submit" class={BUTTON}>
            Filter
          </button>
          {(status || channel || search) && (
            <a
              href="/admin/notifications"
              class="text-sm text-neutral-500 underline dark:text-neutral-400"
            >
              Clear
            </a>
          )}
        </div>
      </form>
    </section>

    <section class={CARD}>
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class={CARD_TITLE}>
          {total} message{total === 1 ? '' : 's'}
        </h2>
        {totalPages > 1 && (
          <p class={HINT}>
            Page {page} of {totalPages}
          </p>
        )}
      </div>

      {rows.length === 0 ? (
        <p class={`${HINT} mt-4`}>Nothing matches those filters.</p>
      ) : (
        <ul class="mt-4 space-y-2">
          {rows.map(row => (
            <li class={PANEL}>
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <p class="text-sm font-medium text-neutral-800 dark:text-neutral-100">
                    {describeEvent(row)}
                  </p>
                  <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                    {CHANNEL_LABELS[row.channel]} · {row.recipient}
                    {row.reference && row.entityId && (
                      <>
                        {' · '}
                        <a
                          href={`/applications/${row.entityId}`}
                          class="underline"
                        >
                          {row.reference}
                        </a>
                      </>
                    )}
                  </p>
                </div>
                <span
                  class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${STATUS_CLASSES[row.status]}`}
                >
                  {STATUS_LABELS[row.status]}
                </span>
              </div>

              <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">
                {whenLine(row)}
                {row.attempts > 1 && ` · ${row.attempts} attempts`}
              </p>

              {row.lastError && row.status !== 'sent' && (
                <p class="mt-2 rounded-lg bg-neutral-100 px-3 py-2 text-xs text-neutral-700 dark:bg-neutral-950 dark:text-neutral-300">
                  {row.lastError}
                </p>
              )}

              <details class="mt-2">
                <summary class="cursor-pointer text-xs text-neutral-500 dark:text-neutral-400">
                  What was sent
                </summary>
                {row.subject && (
                  <p class="mt-2 text-xs font-medium text-neutral-700 dark:text-neutral-200">
                    {row.subject}
                  </p>
                )}
                <p class="mt-1 text-xs whitespace-pre-wrap text-neutral-600 dark:text-neutral-300">
                  {row.body}
                </p>
              </details>
            </li>
          ))}
        </ul>
      )}

      {totalPages > 1 && (
        <div class="mt-4 flex items-center justify-between gap-2 text-sm">
          {page > 1 ? (
            <a href={pageHref(page - 1)} class={SECONDARY_SM}>
              ← Newer
            </a>
          ) : (
            <span />
          )}
          {page < totalPages && (
            <a href={pageHref(page + 1)} class={SECONDARY_SM}>
              Older →
            </a>
          )}
        </div>
      )}
    </section>
  </div>
</DashboardLayout>
