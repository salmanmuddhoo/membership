---
// What the Society sent, and what did not get through (S-904) — gated by its
// own permission (notification.view, migration 0056) so who may see it is
// Configuration -> Roles' decision, not this page's own.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import {
  listNotifications,
  notificationCounts,
  NOTIFICATION_PAGE_LIMIT,
  type NotificationLogRow,
  type NotificationStatus,
} from '@lib/notifications/log';
import type { NotificationChannel } from '@lib/notifications/templates';

const params = Astro.url.searchParams;

const STATUSES: NotificationStatus[] = [
  'pending',
  'sent',
  'failed',
  'abandoned',
];
const CHANNELS: NotificationChannel[] = ['email', 'whatsapp'];

const statusParam = params.get('status') ?? '';
const channelParam = params.get('channel') ?? '';
const status = STATUSES.includes(statusParam as NotificationStatus)
  ? (statusParam as NotificationStatus)
  : undefined;
const channel = CHANNELS.includes(channelParam as NotificationChannel)
  ? (channelParam as NotificationChannel)
  : undefined;
const search = params.get('search')?.trim() || '';
const page = Math.max(Number(params.get('page') ?? '1') || 1, 1);

const [{ rows, total }, counts] = await Promise.all([
  listNotifications({
    status,
    channel,
    search: search || undefined,
    offset: (page - 1) * NOTIFICATION_PAGE_LIMIT,
  }),
  notificationCounts(),
]);

const totalPages = Math.max(Math.ceil(total / NOTIFICATION_PAGE_LIMIT), 1);

const dateTimeFormat = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'short',
});

const pageHref = (target: number) => {
  const next = new URLSearchParams(params);
  next.set('page', String(target));
  return `/admin/notifications?${next.toString()}`;
};

// A link that filters to one status, from the counts at the top.
const statusHref = (target: NotificationStatus) =>
  `/admin/notifications?status=${target}`;

const CHANNEL_LABELS: Record<NotificationChannel, string> = {
  email: 'Email',
  whatsapp: 'WhatsApp',
};

const STATUS_LABELS: Record<NotificationStatus, string> = {
  pending: 'Waiting',
  sent: 'Sent',
  failed: 'Retrying',
  abandoned: 'Given up',
};

const STATUS_CLASSES: Record<NotificationStatus, string> = {
  pending:
    'bg-neutral-200 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300',
  sent: 'bg-mint-200 text-neutral-800 dark:bg-mint-900 dark:text-mint-100',
  failed: 'bg-amber-200 text-amber-900 dark:bg-amber-900 dark:text-amber-100',
  abandoned: 'bg-red-200 text-red-900 dark:bg-red-900 dark:text-red-100',
};

// What the row is about, in the words the officer uses for it. The event code
// is the system's name for the thing, not a person's.
function describeEvent(row: NotificationLogRow): string {
  switch (row.eventCode) {
    case 'application.submitted':
      return 'Application received';
    case 'application.returned':
      return 'Application returned for correction';
    case 'application.approved':
      return 'Membership approved';
    case 'application.rejected':
      return 'Application not approved';
    case 'account.submitted':
      return 'Account application received';
    case 'account.returned':
      return 'Account application returned for correction';
    case 'account.approved':
      return 'Account opened';
    case 'account.rejected':
      return 'Account application not approved';
    default:
      return row.eventCode.replace(/\./g, ' · ');
  }
}

function whenLine(row: NotificationLogRow): string {
  if (row.status === 'sent' && row.sentAt) {
    return `Sent ${dateTimeFormat.format(row.sentAt)}`;
  }
  if (row.status === 'failed' && row.nextAttemptAt) {
    return `Next try ${dateTimeFormat.format(row.nextAttemptAt)}`;
  }
  return `Created ${dateTimeFormat.format(row.createdAt)}`;
}
---

<DashboardLayout
  title="Notifications · Al Barakah MCSL"
  heading="Notifications"
>
  <div class="mx-auto max-w-6xl space-y-6">
    <section class="grid gap-3 sm:grid-cols-3">
      <a
        href={statusHref('pending')}
        class="rounded-2xl border border-neutral-200 bg-neutral-100 p-4 transition hover:bg-neutral-200 dark:border-neutral-800 dark:bg-neutral-950 dark:hover:bg-neutral-900"
      >
        <p class="text-2xl font-bold text-neutral-800 dark:text-neutral-100">
          {counts.waiting}
        </p>
        <p class="text-sm text-neutral-600 dark:text-neutral-300">Waiting</p>
      </a>
      <a
        href={statusHref('failed')}
        class="rounded-2xl border border-neutral-200 bg-neutral-100 p-4 transition hover:bg-neutral-200 dark:border-neutral-800 dark:bg-neutral-950 dark:hover:bg-neutral-900"
      >
        <p class="text-2xl font-bold text-neutral-800 dark:text-neutral-100">
          {counts.failed}
        </p>
        <p class="text-sm text-neutral-600 dark:text-neutral-300">Retrying</p>
      </a>
      <a
        href={statusHref('abandoned')}
        class="rounded-2xl border border-neutral-200 bg-neutral-100 p-4 transition hover:bg-neutral-200 dark:border-neutral-800 dark:bg-neutral-950 dark:hover:bg-neutral-900"
      >
        <p class="text-2xl font-bold text-neutral-800 dark:text-neutral-100">
          {counts.abandoned}
        </p>
        <p class="text-sm text-neutral-600 dark:text-neutral-300">Given up</p>
      </a>
    </section>

    <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
      <form method="get" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          Status
          <select
            name="status"
            class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
          >
            <option value="">All</option>
            {STATUSES.map(s => (
              <option value={s} selected={s === status}>
                {STATUS_LABELS[s]}
              </option>
            ))}
          </select>
        </label>
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          Channel
          <select
            name="channel"
            class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
          >
            <option value="">All</option>
            {CHANNELS.map(c => (
              <option value={c} selected={c === channel}>
                {CHANNEL_LABELS[c]}
              </option>
            ))}
          </select>
        </label>
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          Address or reference
          <input
            type="text"
            name="search"
            value={search}
            class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
          />
        </label>
        <div class="flex items-end gap-3">
          <button
            type="submit"
            class="bg-mint-300 hover:bg-mint-400 rounded-lg px-4 py-2 text-sm font-bold text-neutral-800 transition"
          >
            Filter
          </button>
          {(status || channel || search) && (
            <a
              href="/admin/notifications"
              class="text-sm text-neutral-500 underline dark:text-neutral-400"
            >
              Clear
            </a>
          )}
        </div>
      </form>
    </section>

    <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
          {total} message{total === 1 ? '' : 's'}
        </h2>
        {totalPages > 1 && (
          <p class="text-sm text-neutral-500 dark:text-neutral-400">
            Page {page} of {totalPages}
          </p>
        )}
      </div>

      {rows.length === 0 ? (
        <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400">
          Nothing matches those filters.
        </p>
      ) : (
        <ul class="mt-4 space-y-2">
          {rows.map(row => (
            <li class="rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <p class="text-sm font-medium text-neutral-800 dark:text-neutral-100">
                    {describeEvent(row)}
                  </p>
                  <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                    {CHANNEL_LABELS[row.channel]} · {row.recipient}
                    {row.reference && row.entityId && (
                      <>
                        {' · '}
                        <a
                          href={`/applications/${row.entityId}`}
                          class="underline"
                        >
                          {row.reference}
                        </a>
                      </>
                    )}
                  </p>
                </div>
                <span
                  class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${STATUS_CLASSES[row.status]}`}
                >
                  {STATUS_LABELS[row.status]}
                </span>
              </div>

              <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">
                {whenLine(row)}
                {row.attempts > 1 && ` · ${row.attempts} attempts`}
              </p>

              {row.lastError && row.status !== 'sent' && (
                <p class="mt-2 rounded-lg bg-neutral-100 px-3 py-2 text-xs text-neutral-700 dark:bg-neutral-950 dark:text-neutral-300">
                  {row.lastError}
                </p>
              )}

              <details class="mt-2">
                <summary class="cursor-pointer text-xs text-neutral-500 dark:text-neutral-400">
                  What was sent
                </summary>
                {row.subject && (
                  <p class="mt-2 text-xs font-medium text-neutral-700 dark:text-neutral-200">
                    {row.subject}
                  </p>
                )}
                <p class="mt-1 text-xs whitespace-pre-wrap text-neutral-600 dark:text-neutral-300">
                  {row.body}
                </p>
              </details>
            </li>
          ))}
        </ul>
      )}

      {totalPages > 1 && (
        <div class="mt-4 flex items-center justify-between gap-2 text-sm">
          {page > 1 ? (
            <a
              href={pageHref(page - 1)}
              class="rounded-lg border border-neutral-300 px-3 py-1.5 font-medium text-neutral-700 transition hover:bg-neutral-100 dark:border-neutral-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
            >
              ← Newer
            </a>
          ) : (
            <span />
          )}
          {page < totalPages && (
            <a
              href={pageHref(page + 1)}
              class="rounded-lg border border-neutral-300 px-3 py-1.5 font-medium text-neutral-700 transition hover:bg-neutral-100 dark:border-neutral-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
            >
              Older →
            </a>
          )}
        </div>
      )}
    </section>
  </div>
</DashboardLayout>
