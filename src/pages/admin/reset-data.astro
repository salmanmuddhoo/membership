---
// Wiping an environment back to empty (System Administrator only).
//
// Offered in production too (officer direction, 14 October 2026), behind a
// longer phrase to type; resetAllTestData() saves the members export to
// SharePoint there before it removes anything (admin/reset.ts).
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { isProductionEnvironment } from '@lib/config';
import {
  ResetError,
  countsBeforeReset,
  resetAllTestData,
} from '@lib/admin/reset';
import {
  PAGE,
  BUTTON_DESTRUCTIVE,
  CARD_DANGER,
  CARD_DANGER_TITLE,
  NOTICE_ERROR,
  NOTICE_OK,
} from '@lib/ui';

const principal = Astro.locals.principal!;
const production = isProductionEnvironment();

const CONFIRMATION_PHRASE = production
  ? 'DELETE ALL PRODUCTION DATA'
  : 'DELETE ALL DATA';

let error: string | null = null;
let done = false;
let backupFile: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const typed = String(form.get('confirmation') ?? '');

  if (typed !== CONFIRMATION_PHRASE) {
    error = `Type "${CONFIRMATION_PHRASE}" exactly to confirm. Nothing was removed.`;
  } else {
    try {
      const outcome = await resetAllTestData({
        userId: principal.userId,
        email: principal.email,
      });
      backupFile = outcome.backup
        ? [outcome.backup.fileName, outcome.backup.transactionsFileName]
            .filter(Boolean)
            .join(' and ') + ` in ${outcome.backup.folder}`
        : null;
      done = true;
    } catch (err) {
      error =
        err instanceof ResetError
          ? err.message
          : 'Something went wrong. Nothing was removed.';
      if (!(err instanceof ResetError)) {
        console.error('[admin/reset-data]', err);
      }
    }
  }
}

const counts = done ? null : await countsBeforeReset(principal.userId);
const heading = production ? 'Reset data' : 'Reset test data';
---

<DashboardLayout title={`${heading} · Al Barakah MCSL`} heading={heading}>
  <div class={PAGE.form}>
    {error && <div class={NOTICE_ERROR}>{error}</div>}

    {done && (
      <div class={NOTICE_OK}>
        Done. Every member, application, document, payment and receipt has been
        removed, and numbering starts over from AB0001. Your staff account,
        roles and configuration are kept.
        {backupFile && <> Saved first: {backupFile}.</>}
      </div>
    )}

    {counts && (
      <section class={CARD_DANGER}>
        <h2 class={CARD_DANGER_TITLE}>This removes everything, permanently</h2>
        <p class="mt-2 text-sm text-red-800 dark:text-red-200">
          {counts.members} member{counts.members === 1 ? '' : 's'},{' '}
          {counts.applications} application
          {counts.applications === 1 ? '' : 's'}, {counts.transactions}{' '}
          transaction{counts.transactions === 1 ? '' : 's'}, {counts.payments}{' '}
          payment
          {counts.payments === 1 ? '' : 's'} and {counts.documents} document
          {counts.documents === 1 ? '' : 's'}, the audit log and the history of
          setting changes. This cannot be undone.
          {production &&
            ' Every member, their balances and every transaction are saved to SharePoint first.'}
        </p>
        <p class="mt-2 text-sm text-red-800 dark:text-red-200">
          {counts.otherStaff === 0
            ? 'Your staff account is kept.'
            : `${counts.otherStaff} other staff account${counts.otherStaff === 1 ? '' : 's'} ${counts.otherStaff === 1 ? 'is' : 'are'} removed; yours is kept.`}{' '}
          Roles, API credentials and everything under Configuration are kept.
        </p>

        <form method="post" class="mt-5 space-y-3" data-reset-form>
          <label class="block text-sm font-medium text-red-900 dark:text-red-200">
            Type "{CONFIRMATION_PHRASE}" to confirm
            <input
              type="text"
              name="confirmation"
              autocomplete="off"
              data-reset-confirmation
              data-phrase={CONFIRMATION_PHRASE}
              class="mt-1 block w-full rounded-lg border border-red-300 bg-white px-3 py-1.5 text-sm dark:border-red-800 dark:bg-neutral-900 dark:text-neutral-100"
            />
          </label>
          <button
            type="submit"
            data-reset-submit
            disabled
            class={BUTTON_DESTRUCTIVE}
          >
            Delete everything
          </button>
        </form>
      </section>
    )}
  </div>
</DashboardLayout>

<script>
  // Off by default, exactly like the noscript-safe forms elsewhere: without
  // scripting the button is simply always enabled and the server's own check
  // of the typed phrase is what actually protects the action.
  const input = document.querySelector<HTMLInputElement>(
    '[data-reset-confirmation]'
  );
  const submit = document.querySelector<HTMLButtonElement>(
    '[data-reset-submit]'
  );
  if (input && submit) {
    submit.disabled = true;
    input.addEventListener('input', () => {
      submit.disabled = input.value !== input.dataset.phrase;
    });
  }

  const resetForm =
    document.querySelector<HTMLFormElement>('[data-reset-form]');
  if (resetForm) {
    window.confirmedSubmit(
      resetForm,
      'This permanently deletes every member, application, document, ' +
        'payment and receipt. There is no undo. Continue?'
    );
  }
</script>
