---
// Wiping a test environment back to empty (System Administrator only).
//
// Reachable only on a deployment PUBLIC_APP_ENV marks as non-production —
// resetAllTestData() refuses outright otherwise, and this page does not even
// offer the button when that is the case, so there is nothing to click
// through by mistake.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { isProductionEnvironment } from '@lib/config';
import {
  ResetError,
  countsBeforeReset,
  resetAllTestData,
} from '@lib/admin/reset';
import {
  PAGE,
  BUTTON_DESTRUCTIVE,
  CARD_DANGER,
  CARD_DANGER_TITLE,
  NOTICE,
  NOTICE_ERROR,
  NOTICE_OK,
} from '@lib/ui';

const principal = Astro.locals.principal!;
const isTestEnvironment = !isProductionEnvironment();

const CONFIRMATION_PHRASE = 'DELETE ALL DATA';

let error: string | null = null;
let done = false;

if (Astro.request.method === 'POST' && isTestEnvironment) {
  const form = await Astro.request.formData();
  const typed = String(form.get('confirmation') ?? '');

  if (typed !== CONFIRMATION_PHRASE) {
    error = `Type "${CONFIRMATION_PHRASE}" exactly to confirm. Nothing was removed.`;
  } else {
    try {
      await resetAllTestData({
        userId: principal.userId,
        email: principal.email,
      });
      done = true;
    } catch (err) {
      error =
        err instanceof ResetError
          ? err.message
          : 'Something went wrong. Nothing was removed.';
      if (!(err instanceof ResetError)) {
        console.error('[admin/reset-data]', err);
      }
    }
  }
}

const counts = isTestEnvironment && !done ? await countsBeforeReset() : null;
---

<DashboardLayout
  title="Reset test data · Al Barakah MCSL"
  heading="Reset test data"
>
  <div class={PAGE.form}>
    {!isTestEnvironment && (
      <div class={NOTICE}>
        This deployment is not marked as a test environment, so this is not
        available here.
      </div>
    )}

    {error && <div class={NOTICE_ERROR}>{error}</div>}

    {done && (
      <div class={NOTICE_OK}>
        Done. Every member, application, document, payment and receipt has been
        removed, and numbering starts over from AB0001. Staff accounts and
        configuration are unchanged.
      </div>
    )}

    {counts && (
      <section class={CARD_DANGER}>
        <h2 class={CARD_DANGER_TITLE}>This removes everything, permanently</h2>
        <p class="mt-2 text-sm text-red-800 dark:text-red-200">
          {counts.members} member{counts.members === 1 ? '' : 's'},{' '}
          {counts.applications} application
          {counts.applications === 1 ? '' : 's'}, {counts.payments} payment
          {counts.payments === 1 ? '' : 's'} and {counts.documents} document
          {counts.documents === 1 ? '' : 's'} — and the record of who did what
          to any of them. This cannot be undone.
        </p>
        <p class="mt-2 text-sm text-red-800 dark:text-red-200">
          Staff accounts, roles and reference configuration (membership types,
          fees, the document checklist) are not touched.
        </p>

        <form method="post" class="mt-5 space-y-3" data-reset-form>
          <label class="block text-sm font-medium text-red-900 dark:text-red-200">
            Type "{CONFIRMATION_PHRASE}" to confirm
            <input
              type="text"
              name="confirmation"
              autocomplete="off"
              data-reset-confirmation
              class="mt-1 block w-full rounded-lg border border-red-300 bg-white px-3 py-1.5 text-sm dark:border-red-800 dark:bg-neutral-900 dark:text-neutral-100"
            />
          </label>
          <button
            type="submit"
            data-reset-submit
            disabled
            class={BUTTON_DESTRUCTIVE}
          >
            Delete everything
          </button>
        </form>
      </section>
    )}
  </div>
</DashboardLayout>

<script>
  // Off by default, exactly like the noscript-safe forms elsewhere: without
  // scripting the button is simply always enabled and the server's own check
  // of the typed phrase is what actually protects the action.
  const input = document.querySelector<HTMLInputElement>(
    '[data-reset-confirmation]'
  );
  const submit = document.querySelector<HTMLButtonElement>(
    '[data-reset-submit]'
  );
  if (input && submit) {
    submit.disabled = true;
    input.addEventListener('input', () => {
      submit.disabled = input.value !== 'DELETE ALL DATA';
    });
  }

  const resetForm =
    document.querySelector<HTMLFormElement>('[data-reset-form]');
  if (resetForm) {
    window.confirmedSubmit(
      resetForm,
      'This permanently deletes every member, application, document, ' +
        'payment and receipt. There is no undo. Continue?'
    );
  }
</script>
