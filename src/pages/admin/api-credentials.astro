---
// Credentials for machine callers (S-909) — gated by its own permission
// (api_credential.manage, migration 0059).
//
// The secret is shown once, on the screen that issued it, and never again.
// That is not a limitation to apologise for: a credential the system could
// show again is one a copy of the database hands over, and re-issuing takes
// a moment.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import {
  ALL_SCOPES,
  CredentialError,
  issueCredential,
  listCredentials,
  revokeCredential,
} from '@lib/api/credentials';
import {
  BUTTON,
  CARD,
  CARD_TITLE,
  HINT,
  INPUT,
  INPUT_BARE,
  LABEL,
  PAGE,
  PANEL,
  CARD_OK,
  DANGER_XS,
  NOTICE_ERROR,
  NOTICE_OK,
  PILL,
} from '@lib/ui';

const principal = Astro.locals.principal!;

let error: string | null = null;
let issuedToken: string | null = null;
let issuedName: string | null = null;
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const actor = { userId: principal.userId, email: principal.email };

  try {
    if (String(form.get('intent')) === 'revoke') {
      await revokeCredential(String(form.get('id')), actor);
      notice = 'Revoked. It stops working on its next request.';
    } else {
      const issued = await issueCredential(
        {
          name: String(form.get('name') ?? ''),
          scopes: form.getAll('scopes').map(String),
          rateLimitPerMinute:
            Number(form.get('rateLimitPerMinute')) || undefined,
        },
        actor
      );
      issuedToken = issued.token;
      issuedName = issued.credential.name;
    }
  } catch (err) {
    if (err instanceof CredentialError) {
      error = err.message;
    } else {
      console.error('[admin/api-credentials]', err);
      error = 'Something went wrong. Please try again.';
    }
  }
}

const credentials = await listCredentials();

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'short',
});

const SCOPE_LABELS: Record<string, string> = {
  'applications.submit': 'Submit applications from the website',
};
---

<DashboardLayout
  title="API credentials · Al Barakah MCSL"
  heading="API credentials"
>
  <div class={PAGE.list}>
    {error && <p class={NOTICE_ERROR}>{error}</p>}
    {notice && <p class={NOTICE_OK}>{notice}</p>}

    {issuedToken && (
      <section class={CARD_OK}>
        <h2 class={CARD_TITLE}>{issuedName}</h2>
        <p class="mt-1 text-sm text-neutral-700 dark:text-neutral-200">
          Copy this now. It is not shown again.
        </p>
        <pre class="mt-3 overflow-auto rounded-lg bg-white p-3 font-mono text-xs break-all text-neutral-800 dark:bg-neutral-900 dark:text-neutral-100">{issuedToken}</pre>
        <p class="mt-2 text-xs text-neutral-600 dark:text-neutral-300">
          Send it as <code>Authorization: Bearer &lt;token&gt;</code>.
        </p>
      </section>
    )}

    <section class={CARD}>
      <h2 class={CARD_TITLE}>Issue a credential</h2>
      <form method="post" class="mt-3 space-y-3">
        <label class={LABEL}>
          Name
          <input
            type="text"
            name="name"
            placeholder="Albarakah.mu website"
            class={INPUT}
          />
        </label>

        <fieldset class="text-sm text-neutral-600 dark:text-neutral-300">
          <legend>What it may do</legend>
          {ALL_SCOPES.map(scope => (
            <label class="mt-1 flex items-center gap-2">
              <input
                type="checkbox"
                name="scopes"
                value={scope}
                class="rounded border-neutral-300 dark:border-neutral-600"
              />
              {SCOPE_LABELS[scope] ?? scope}
            </label>
          ))}
        </fieldset>

        <label class={LABEL}>
          Requests per minute
          <input
            type="number"
            name="rateLimitPerMinute"
            value="60"
            min="1"
            class={`${INPUT_BARE} mt-1 w-32`}
          />
        </label>

        <button type="submit" class={BUTTON}>
          Issue
        </button>
      </form>
    </section>

    <section class={CARD}>
      <h2 class={CARD_TITLE}>
        {credentials.length} credential{credentials.length === 1 ? '' : 's'}
      </h2>

      {credentials.length === 0 ? (
        <p class={`${HINT} mt-3`}>None issued yet.</p>
      ) : (
        <ul class="mt-3 space-y-2">
          {credentials.map(credential => (
            <li class={PANEL}>
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <p class="text-sm font-medium text-neutral-800 dark:text-neutral-100">
                    {credential.name}
                  </p>
                  <p class="mt-1 font-mono text-xs text-neutral-500 dark:text-neutral-400">
                    {credential.clientId}
                  </p>
                </div>
                {credential.isActive ? (
                  <form method="post">
                    <input type="hidden" name="intent" value="revoke" />
                    <input type="hidden" name="id" value={credential.id} />
                    <button type="submit" class={DANGER_XS}>
                      Revoke
                    </button>
                  </form>
                ) : (
                  <span class={PILL}>Revoked</span>
                )}
              </div>

              <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">
                {credential.scopes.map(s => SCOPE_LABELS[s] ?? s).join(', ') ||
                  'Nothing'}
                {' · '}
                {credential.rateLimitPerMinute}/minute
              </p>
              <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                Issued {dateFormat.format(credential.createdAt)}
                {credential.lastUsedAt
                  ? ` · last used ${dateFormat.format(credential.lastUsedAt)}`
                  : ' · never used'}
              </p>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</DashboardLayout>
