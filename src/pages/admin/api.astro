---
// The API reference, and a way to make a request with it (S-110).
//
// docs/openapi.json is generated from the route descriptors, so this page
// cannot drift from the routes: an endpoint that is not in the document does
// not exist, and one that exports no descriptor fails the build. Reading it
// here rather than handing an integrator a JSON file means the reference is
// where the system is, and can be exercised in place.
//
// WHAT "TRY IT" DOES, AND WHAT IT CANNOT DO. A request from this page is an
// ordinary same-origin request carrying the officer's own session cookie. It
// goes through the same middleware, the same per-endpoint permission check and
// the same rate limit as any other caller — so this page grants no access
// whatsoever. It removes the need for a separate HTTP client, nothing more.
//
// What it does change is how easy a destructive call becomes: one button
// rather than a deliberately composed request. So anything that is not a read
// is held behind a switch that has to be turned on first, and says what it is
// for.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import {
  categorise,
  endpointKey,
  tryDefinitions,
  type OpenApiDocument,
} from '@lib/api/explorer';
import {
  CARD,
  CARD_TITLE,
  HINT,
  MUTED,
  PAGE,
  CODE_BLOCK,
  INPUT_SM,
  LABEL,
  SECONDARY_SM,
  TAB_CURRENT,
  SECONDARY_XS,
  SUBTITLE,
} from '@lib/ui';
import openapi from '../../../docs/openapi.json';

const specification = openapi as unknown as OpenApiDocument;
const categories = categorise(specification);
const total = categories.reduce((n, c) => n + c.endpoints.length, 0);
const forBrowser = tryDefinitions(categories);

// The two halves of "API" (officer feedback: one menu item, but still two
// pages) — a tab each, shown only for the half the officer actually holds.
// Reaching this page at all means holding api.explore, so "Reference"
// always shows; "Credentials" only alongside it.
const principal = Astro.locals.principal!;
const showCredentialsTab = principal.permissions.has('api_credential.manage');

const METHOD_CLASSES: Record<string, string> = {
  GET: 'bg-mint-200 text-neutral-800 dark:bg-mint-900 dark:text-mint-100',
  POST: 'bg-sky-200 text-sky-900 dark:bg-sky-900 dark:text-sky-100',
  PUT: 'bg-amber-200 text-amber-900 dark:bg-amber-900 dark:text-amber-100',
  PATCH: 'bg-amber-200 text-amber-900 dark:bg-amber-900 dark:text-amber-100',
  DELETE: 'bg-red-200 text-red-900 dark:bg-red-900 dark:text-red-100',
};

const pretty = (schema: unknown) => JSON.stringify(schema, null, 2);
---

<DashboardLayout title="API · Al Barakah MCSL" heading="API">
  <div class={PAGE.list}>
    <nav class="flex flex-wrap gap-2" aria-label="API sections">
      <a href="/admin/api" aria-current="page" class={TAB_CURRENT}>
        Reference
      </a>
      {showCredentialsTab && (
        <a href="/admin/api-credentials" class={SECONDARY_SM}>
          Credentials
        </a>
      )}
    </nav>

    <section class={CARD}>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class={CARD_TITLE}>
            {total} endpoints in {categories.length} categories
          </h2>
          <p class={HINT}>
            Version {specification.info.version}. A request from this page runs
            as you, against this environment.
          </p>
        </div>
        <label class="flex items-center gap-2 rounded-lg border border-neutral-300 px-3 py-2 text-sm text-neutral-700 dark:border-neutral-600 dark:text-neutral-200">
          <input type="checkbox" id="allow-writes" class="rounded" />
          Allow requests that change data
        </label>
      </div>
    </section>

    {categories.map(category => (
      <section class={CARD}>
        <h2 class={CARD_TITLE}>{category.name}</h2>

        <ul class="mt-3 space-y-2">
          {category.endpoints.map(endpoint => (
            <li class="rounded-xl border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
              <details>
                <summary class="flex cursor-pointer flex-wrap items-center gap-3 p-4">
                  <span
                    class={`rounded px-2 py-0.5 font-mono text-xs font-bold ${METHOD_CLASSES[endpoint.method] ?? ''}`}
                  >
                    {endpoint.method}
                  </span>
                  <code class="min-w-0 break-all text-sm text-neutral-800 dark:text-neutral-100">
                    {endpoint.path}
                  </code>
                  <span class={HINT}>{endpoint.summary}</span>
                </summary>

                <div class="space-y-3 border-t border-neutral-200 p-4 dark:border-neutral-800">
                  {endpoint.description && (
                    <p class={MUTED}>{endpoint.description}</p>
                  )}

                  <p class="text-xs text-neutral-500 dark:text-neutral-400">
                    Requires <code>{endpoint.permission}</code>
                  </p>

                  {endpoint.parameters.length > 0 && (
                    <div>
                      <h3 class={SUBTITLE}>Parameters</h3>
                      <ul class="mt-1 space-y-0.5">
                        {endpoint.parameters.map(p => (
                          <li class="text-xs text-neutral-600 dark:text-neutral-300">
                            <code>{p.name}</code>
                            <span class="text-neutral-400"> in {p.in}</span>
                            {p.required && (
                              <span class="text-red-600 dark:text-red-400">
                                {' '}
                                required
                              </span>
                            )}
                            {p.description && ` — ${p.description}`}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {endpoint.requestSchema && (
                    <details>
                      <summary class="cursor-pointer text-xs font-semibold text-neutral-700 dark:text-neutral-200">
                        Request body
                      </summary>
                      <pre
                        class={`${CODE_BLOCK} mt-1`}
                      >{pretty(endpoint.requestSchema)}</pre>
                    </details>
                  )}

                  {endpoint.responseSchema && (
                    <details>
                      <summary class="cursor-pointer text-xs font-semibold text-neutral-700 dark:text-neutral-200">
                        Response
                      </summary>
                      <pre
                        class={`${CODE_BLOCK} mt-1`}
                      >{pretty(endpoint.responseSchema)}</pre>
                    </details>
                  )}

                  <form
                    class="space-y-2 rounded-lg border border-neutral-200 p-3 dark:border-neutral-800"
                    data-try={endpointKey(endpoint)}
                  >
                    {endpoint.pathParams.map(name => (
                      <label class={LABEL}>
                        {name}
                        <input
                          type="text"
                          data-path-param={name}
                          class={`${INPUT_SM} mt-0.5 w-full font-mono`}
                        />
                      </label>
                    ))}

                    {endpoint.parameters
                      .filter(p => p.in === 'query')
                      .map(p => (
                        <label class={LABEL}>
                          {p.name}
                          <input
                            type="text"
                            data-query-param={p.name}
                            class={`${INPUT_SM} mt-0.5 w-full font-mono`}
                          />
                        </label>
                      ))}

                    {endpoint.requestSchema && (
                      <label class={LABEL}>
                        Body (JSON)
                        <textarea
                          data-body
                          rows="5"
                          placeholder={'{ }'}
                          class={`${INPUT_SM} mt-0.5 w-full font-mono`}
                        ></textarea>
                      </label>
                    )}

                    <button
                      type="submit"
                      class={SECONDARY_XS}
                      data-send
                      disabled={!endpoint.isRead}
                    >
                      Send
                    </button>
                    {!endpoint.isRead && (
                      <span
                        class="ms-2 text-xs text-neutral-500 dark:text-neutral-400"
                        data-write-note
                      >
                        Changes data — switch it on above first.
                      </span>
                    )}

                    <pre
                      class={`${CODE_BLOCK} hidden whitespace-pre-wrap`}
                      data-result
                    ></pre>
                  </form>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <!-- Explicitly closed: a self-closing <script/> is not valid HTML, and a
       browser would read the rest of the document as its content. -->
  <script
    type="application/json"
    id="api-endpoints"
    set:html={JSON.stringify(forBrowser).replace(/</g, '\\u003c')}
  ></script>
  <script>
    import type { TryDefinition } from '@lib/api/explorer';

    const definitions: Record<string, TryDefinition> = JSON.parse(
      document.getElementById('api-endpoints')!.textContent || '{}'
    );

    // Writes stay disabled until the switch is on. Every request here already
    // runs under the officer's own permissions — the server decides that, not
    // this page — so this guards against the accidental click, not against
    // access.
    const allowWrites = document.getElementById(
      'allow-writes'
    ) as HTMLInputElement;

    function applyWriteSetting(): void {
      for (const form of document.querySelectorAll<HTMLFormElement>(
        'form[data-try]'
      )) {
        const definition = definitions[form.dataset.try!];
        if (!definition || definition.isRead) continue;
        const button = form.querySelector<HTMLButtonElement>('[data-send]')!;
        button.disabled = !allowWrites.checked;
        const note = form.querySelector<HTMLElement>('[data-write-note]');
        if (note) note.hidden = allowWrites.checked;
      }
    }

    allowWrites.addEventListener('change', applyWriteSetting);
    applyWriteSetting();

    function buildUrl(form: HTMLFormElement, definition: TryDefinition) {
      let path = definition.path;
      for (const name of definition.pathParams) {
        const input = form.querySelector<HTMLInputElement>(
          `[data-path-param="${name}"]`
        );
        const value = (input?.value ?? '').trim();
        if (value === '') throw new Error(`${name} is needed for this call.`);
        path = path.replace(`{${name}}`, encodeURIComponent(value));
      }

      const search = new URLSearchParams();
      for (const { name, required } of definition.query) {
        const input = form.querySelector<HTMLInputElement>(
          `[data-query-param="${name}"]`
        );
        const value = (input?.value ?? '').trim();
        if (value !== '') search.set(name, value);
        else if (required) throw new Error(`${name} is needed for this call.`);
      }

      const queryString = search.toString();
      return queryString ? `${path}?${queryString}` : path;
    }

    for (const form of document.querySelectorAll<HTMLFormElement>(
      'form[data-try]'
    )) {
      form.addEventListener('submit', async event => {
        event.preventDefault();
        const definition = definitions[form.dataset.try!];
        const result = form.querySelector<HTMLPreElement>('[data-result]')!;
        const button = form.querySelector<HTMLButtonElement>('[data-send]')!;

        result.classList.remove('hidden');
        result.textContent = 'Sending…';
        button.disabled = true;

        try {
          const url = buildUrl(form, definition);
          const bodyField =
            form.querySelector<HTMLTextAreaElement>('[data-body]');

          // Parsed here so a typo in the JSON is reported as a typo rather
          // than as whatever the endpoint makes of a malformed body.
          let body: string | undefined;
          if (definition.hasBody && bodyField) {
            const raw = bodyField.value.trim();
            if (raw !== '') body = JSON.stringify(JSON.parse(raw));
          }

          const started = performance.now();
          const response = await fetch(url, {
            method: definition.method,
            // The officer's own session. Nothing here can exceed what they
            // may already do; the server enforces that as it always does.
            credentials: 'same-origin',
            ...(body === undefined
              ? {}
              : { headers: { 'content-type': 'application/json' }, body }),
          });
          const elapsed = Math.round(performance.now() - started);

          const text = await response.text();
          let shown = text;
          try {
            shown = JSON.stringify(JSON.parse(text), null, 2);
          } catch {
            // Not JSON — show it as it came back rather than hiding it.
          }

          result.textContent =
            `${definition.method} ${url}\n` +
            `${response.status} ${response.statusText} · ${elapsed}ms\n\n` +
            shown;
        } catch (error) {
          result.textContent =
            error instanceof Error ? error.message : String(error);
        } finally {
          button.disabled = !definition.isRead && !allowWrites.checked;
        }
      });
    }
  </script>
</DashboardLayout>
