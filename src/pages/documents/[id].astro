---
// One holder's folder (officer feedback): everything filed for a member or
// a non-member customer — under the applications that made them, against
// the person directly, and on their transactions — with View on each.
// Someone holding document.upload can file a document here for the person,
// outside any application (officer request); their next application picks
// it up (carryForwardMemberDocuments).
import DashboardLayout from '@layouts/DashboardLayout.astro';
import DocumentViewer from '@components/DocumentViewer.astro';
import {
  documentsForHolder,
  filingChoices,
  groupHolderDocuments,
} from '@lib/documents/directory';
import { loadCustomer, loadMember } from '@lib/members/create';
import {
  BUTTON,
  CARD,
  CARD_TITLE,
  DELETE_BUTTON,
  HINT,
  INPUT,
  LABEL,
  MUTED,
  PAGE,
  PANEL,
  PILL,
  SECONDARY_SM,
  SUBTITLE,
  VIEW_BUTTON,
} from '@lib/ui';

const { id } = Astro.params;
const member = id ? await loadMember(id) : null;
const customer = !member && id ? await loadCustomer(id) : null;
if (!member && !customer) return new Response('Not found', { status: 404 });
const holder = (member ?? customer)!;
const name = holder.name;
const number = member ? member.memberNo : null;

const principal = Astro.locals.principal!;
const canUpload = principal.permissions.has('document.upload');
const choices = canUpload ? await filingChoices() : [];

const documents = await documentsForHolder(holder.id);

// Grouped by where each was filed, the founding application first.
const groups = groupHolderDocuments(documents, member ? 'member' : 'customer');

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<DashboardLayout
  title={`${name} · Documents · Al Barakah MCSL`}
  heading={number ? `${name} · ${number}` : name}
>
  <div class={PAGE.detail}>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <a href="/documents" class={`${HINT} inline-block underline`}>
        ← Documents
      </a>
      <a href={`/members/${holder.id}`} class={SECONDARY_SM}>
        {member ? 'Member page' : 'Customer page'}
      </a>
    </div>

    {canUpload && (
      <section class={CARD}>
        <h2 class={CARD_TITLE}>File a document</h2>
        <p class={HINT}>Used again when an application needs it.</p>
        {choices.length === 0 ? (
          <p class={`${MUTED} mt-3`}>No document types are configured.</p>
        ) : (
          <form
            data-file-document
            data-member-id={member ? holder.id : ''}
            data-customer-id={customer ? holder.id : ''}
            class="mt-3 space-y-3"
          >
            <div>
              <label for="file-document-type" class={LABEL}>
                Document
              </label>
              <select
                id="file-document-type"
                data-document-select
                class={INPUT}
              >
                <option value="">Choose…</option>
                {choices.map(c => (
                  <option
                    value={c.value}
                    data-tracks-expiry={c.tracksExpiry ? 'true' : 'false'}
                  >
                    {c.label}
                  </option>
                ))}
              </select>
            </div>
            <div data-expiry-field hidden>
              <label for="file-document-expiry" class={LABEL}>
                Expires on
              </label>
              <input
                id="file-document-expiry"
                type="date"
                data-expiry-input
                class={INPUT}
              />
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <input
                type="file"
                accept="image/*,application/pdf"
                class="sr-only"
                id="file-document-input"
              />
              <label
                for="file-document-input"
                data-file-label
                aria-disabled="true"
                class={`${BUTTON} pointer-events-none cursor-pointer opacity-50`}
              >
                Choose file
              </label>
            </div>
          </form>
        )}
        <p data-file-status class={`${HINT} mt-2`} aria-live="polite" />
      </section>
    )}

    <section class={CARD}>
      <h2 class={CARD_TITLE}>
        {documents.length === 0
          ? 'Nothing on file'
          : `${documents.length} document${documents.length === 1 ? '' : 's'} on file`}
      </h2>
      {groups.length > 0 && (
        <div class="mt-4 space-y-5">
          {groups.map(({ label, documents: entries }) => (
            <div>
              <h3 class={SUBTITLE}>{label}</h3>
              <ul class="mt-2 space-y-2">
                {entries.map(document => (
                  <li
                    class={`${PANEL} flex flex-wrap items-center justify-between gap-3`}
                  >
                    <div class="min-w-0">
                      <p class="flex flex-wrap items-center gap-2 font-medium text-neutral-800 dark:text-neutral-100">
                        {document.documentName}
                        {document.state === 'verified' && (
                          <span class={PILL}>Verified</span>
                        )}
                        {document.state === 'rejected' && (
                          <span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800 dark:bg-red-950 dark:text-red-200">
                            Rejected
                          </span>
                        )}
                      </p>
                      <p class={`${MUTED} truncate`}>
                        {document.fileName} · filed{' '}
                        {dateFormat.format(document.filedAt)} by{' '}
                        {document.filedByName}
                      </p>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                      <button
                        type="button"
                        data-view-document
                        data-document-id={document.documentId}
                        class={VIEW_BUTTON}
                      >
                        View
                      </button>
                      {canUpload && document.sourceKind === 'member' && (
                        <button
                          type="button"
                          data-remove-document
                          data-document-id={document.documentId}
                          title="Delete"
                          aria-label="Remove this document"
                          class={DELETE_BUTTON}
                        >
                          ✕
                        </button>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
    </section>
  </div>
  <DocumentViewer />
</DashboardLayout>

<script>
  import { uploadDocumentBlob } from '@lib/client/document-upload';
  import {
    compressImageForUpload,
    formatBytes,
  } from '@lib/client/image-compression';

  const status = document.querySelector<HTMLElement>('[data-file-status]');
  const say = (message: string) => {
    if (status) status.textContent = message;
  };

  const form = document.querySelector<HTMLFormElement>('[data-file-document]');
  if (form) {
    const select = form.querySelector<HTMLSelectElement>(
      '[data-document-select]'
    )!;
    const expiryField = form.querySelector<HTMLElement>('[data-expiry-field]')!;
    const expiry = form.querySelector<HTMLInputElement>('[data-expiry-input]')!;
    const file = form.querySelector<HTMLInputElement>('#file-document-input')!;
    const label = form.querySelector<HTMLElement>('[data-file-label]')!;

    const tracksExpiry = () =>
      select.selectedOptions[0]?.dataset.tracksExpiry === 'true';
    const setReady = (ready: boolean) => {
      label.setAttribute('aria-disabled', ready ? 'false' : 'true');
      label.classList.toggle('pointer-events-none', !ready);
      label.classList.toggle('opacity-50', !ready);
      file.disabled = !ready;
    };
    const refresh = () => {
      const tracked = tracksExpiry();
      expiryField.hidden = !tracked;
      expiry.required = tracked;
      setReady(select.value !== '' && (!tracked || expiry.value !== ''));
    };
    select.addEventListener('change', refresh);
    expiry.addEventListener('input', refresh);
    refresh();

    file.addEventListener('change', async () => {
      const picked = file.files?.[0];
      if (!picked) return;
      setReady(false);
      select.disabled = true;
      expiry.disabled = true;
      say('Preparing…');
      let chosen = picked;
      try {
        chosen = await compressImageForUpload(picked);
        if (chosen.size < picked.size) {
          say(
            `Compressed ${formatBytes(picked.size)} to ${formatBytes(chosen.size)}…`
          );
        }
      } catch {
        // Nothing here is worth failing an upload over.
      }
      const [documentTypeId, subject] = select.value.split(':');
      const memberId = form.dataset.memberId ?? '';
      const customerId = form.dataset.customerId ?? '';
      try {
        await uploadDocumentBlob({
          ...(memberId ? { memberId } : { customerId }),
          documentTypeId,
          subject: subject as
            'applicant' | 'nominee' | 'guardian' | 'beneficiary',
          fileName: chosen.name,
          blob: chosen,
          expiresAt: tracksExpiry() && expiry.value ? expiry.value : undefined,
          onStatus: message => say(message),
        });
        window.location.reload();
      } catch (error) {
        say(
          (error instanceof Error ? error.message : 'The upload failed.') +
            ' Please try again.'
        );
        select.disabled = false;
        expiry.disabled = false;
        file.value = '';
        refresh();
      }
    });
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    '[data-remove-document]'
  )) {
    button.addEventListener('click', async () => {
      const ok = await window.appConfirm('Remove this document?', {
        okLabel: 'Remove',
      });
      if (!ok) return;
      button.disabled = true;
      try {
        const response = await fetch('/api/v1/documents/remove', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ documentId: button.dataset.documentId }),
        });
        if (!response.ok) {
          const body = await response.json().catch(() => null);
          throw new Error(body?.error?.message ?? 'It could not be removed.');
        }
        window.location.reload();
      } catch (error) {
        button.disabled = false;
        say(
          error instanceof Error ? error.message : 'It could not be removed.'
        );
      }
    });
  }
</script>
