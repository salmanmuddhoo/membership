---
// The resignation request the member signs (S-1703): a sheet, like the
// closure request, read on screen, signed on the pad, rasterised and filed
// against the request. What is filed is this sheet as the member saw it.
import BaseLayout from '@layouts/BaseLayout.astro';
import { listDocumentTypes } from '@lib/config/reference';
import { isEditable } from '@lib/ledger/closures';
import {
  coreAccounts,
  resignationChecklist,
  totalCents,
  REQUEST_DOCUMENT_CODE,
} from '@lib/ledger/resignations';
import { loadTransaction } from '@lib/ledger/review';
import { loadMember } from '@lib/members/create';
import { formatMoney, fromCents } from '@lib/payments/money';

const principal = Astro.locals.principal!;
const { id } = Astro.params;
const request = id ? await loadTransaction(id) : null;
if (
  !request ||
  request.kind !== 'resignation' ||
  !isEditable(request.status) ||
  request.capturedById !== principal.userId
) {
  return new Response('Not found', { status: 404 });
}

const holder = await loadMember(request.holderId);
const nic = (holder?.applicantValues?.nic ?? '').trim();
const accounts = await coreAccounts(request.holderId);
const total = fromCents(totalCents(accounts));
const documentType = (await listDocumentTypes()).find(
  t => t.code === REQUEST_DOCUMENT_CODE
);
const alreadyFiled = (await resignationChecklist(request.id))[0]?.filed ?? null;
const back = `/resignations/${request.id}?step=signature`;
const next = `/resignations/${request.id}?step=documents`;
const dateFormat = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<BaseLayout title={`${request.reference} · Resignation request`}>
  <div
    class="form-page"
    data-transaction-id={request.id}
    data-reference={request.reference}
    data-document-type-id={documentType?.id ?? ''}
    data-next={next}
    data-filed-document-id={alreadyFiled?.documentId ?? ''}
  >
    <header class="head">
      <div>
        <h1>AL BARAKAH MCSL</h1>
        <p class="sub">RESIGNATION REQUEST</p>
      </div>
      <div class="ref">
        <p>
          <strong>{request.reference}</strong>
        </p>
        <p>{dateFormat.format(new Date())}</p>
      </div>
    </header>

    <div class="box">
      <div class="row">
        <span class="label">NAME:</span>
        <span class="value">{request.holderName || <i class="blank" />}</span>
      </div>
      <div class="row">
        <span class="label">MEMBER NO:</span>
        <span class="value">{request.memberNo ?? '—'}</span>
        <span class="label gap">NIC / PASSPORT NO:</span>
        <span class="value">{nic || <i class="blank" />}</span>
      </div>
      {accounts.map(account => (
        <div class="row">
          <span class="label">ACCOUNT:</span>
          <span class="value">
            {account.accountNo} · {account.typeName} ·{' '}
            {formatMoney(account.balance)}
          </span>
        </div>
      ))}
      <div class="row">
        <span class="label">TOTAL PAID OUT:</span>
        <span class="value">{formatMoney(total)}</span>
      </div>
      <div class="row">
        <span class="label">PAID OUT BY:</span>
        <span class="value">
          {request.methodName}
          {request.methodReference && ` · ${request.methodReference}`}
        </span>
      </div>
      <div class="row">
        <span class="label">REASON:</span>
        <span class="value">{request.reason}</span>
      </div>
    </div>

    <p class="certify">
      I hereby resign my membership of Al Barakah Multipurpose Co-operative
      Society Limited and request that my Shares and Multiplier Savings Account
      be closed and their balances paid to me as they stand on the day the
      resignation is approved. I understand that my membership ends when it is
      paid out.
    </p>

    <div class="sign">
      <p class="label">MEMBER'S SIGNATURE:</p>
      <div class="sig-pad">
        <div class="sig-line"></div>
        <img class="sig-image" data-sig-image alt="" hidden />
      </div>
      <div class="sig-controls no-print">
        <button type="button" data-sig-open>
          Sign
        </button>
        <button type="button" data-sig-clear hidden>
          Clear
        </button>
      </div>
    </div>

    <p class="field">
      <span class="label">RECEIVED BY:</span>
      <span class="value">{principal.displayName || principal.email}</span>
    </p>

    <div class="actions no-print">
      <div class="actions-start">
        <a href={back}>← Back to the request</a>
      </div>
      <div class="actions-centre">
        {documentType && (
          <button type="button" id="file-form" disabled>
            Upload to sharepoint
          </button>
        )}
      </div>
      <div class="actions-end"></div>
    </div>
    <p data-status class="status-line no-print" aria-live="polite">
      {alreadyFiled
        ? `On file: ${alreadyFiled.fileName}. Signing again replaces it.`
        : 'Have the member sign, then upload.'}
    </p>
  </div>
</BaseLayout>

<style>
  /* A sheet a person reads and signs, set in absolute units against white,
     exactly as the Cash Deposit Form is. */
  .form-page {
    max-width: 190mm;
    margin: 0 auto;
    padding: 12mm 10mm;
    background: #fff;
    color: #111;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11pt;
    line-height: 1.5;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 6mm;
    margin-bottom: 8mm;
  }
  .head h1 {
    margin: 0;
    font-size: 15pt;
    letter-spacing: 1px;
  }
  .head .sub {
    margin: 1mm 0 0;
    font-size: 12pt;
    font-weight: bold;
    letter-spacing: 1px;
  }
  .head .ref {
    text-align: right;
    font-size: 9pt;
  }
  .head .ref p {
    margin: 0;
  }
  .box {
    border: 1px solid #111;
    border-bottom: none;
    margin-bottom: 6mm;
  }
  .box .row {
    border-bottom: 1px solid #111;
    padding: 2.5mm 3mm;
  }
  .label {
    font-weight: bold;
  }
  .label.gap {
    margin-left: 8mm;
  }
  .label + .value {
    margin-left: 1.5mm;
  }
  .value {
    font-weight: normal;
  }
  .blank {
    display: inline-block;
    min-width: 60mm;
    border-bottom: 1px solid #999;
  }
  .certify {
    margin: 0 0 8mm;
    text-align: justify;
  }
  .sign .label {
    margin: 0 0 2mm;
  }
  .sig-pad {
    position: relative;
    height: 28mm;
    border: 1px solid #111;
    margin-bottom: 2mm;
  }
  .sig-line {
    position: absolute;
    left: 6mm;
    right: 6mm;
    bottom: 6mm;
    border-bottom: 1px solid #999;
  }
  .sig-image {
    position: absolute;
    inset: 2mm;
    width: calc(100% - 4mm);
    height: calc(100% - 4mm);
    object-fit: contain;
  }
  .sig-controls {
    display: flex;
    gap: 3mm;
    margin-bottom: 6mm;
  }
  .sig-controls button,
  .actions button {
    font: inherit;
    padding: 1.5mm 4mm;
    border: 1px solid #111;
    background: #fff;
    cursor: pointer;
  }
  .actions button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .field {
    margin: 0 0 2mm;
  }
  .actions {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-top: 10mm;
    gap: 4mm;
  }
  .actions-start {
    justify-self: start;
  }
  .actions-end {
    justify-self: end;
  }
  .actions a {
    color: #111;
  }
  .status-line {
    margin-top: 3mm;
    font-size: 9pt;
    color: #555;
  }
  .status-line[data-tone='error'] {
    color: #b00020;
  }
  .capturing .no-print,
  .capturing .sig-controls {
    display: none !important;
  }
  @media print {
    .no-print {
      display: none !important;
    }
  }
</style>

<script>
  import { wireSignedRequestForm } from '@lib/client/signed-request';

  wireSignedRequestForm({
    signatureTitle: "Member's signature",
    documentLabel: 'Resignation request',
  });
</script>
