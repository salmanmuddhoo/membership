---
// The cash drawer (S-2001, S-2002).
import DashboardLayout from '@layouts/DashboardLayout.astro';
import {
  CashSessionError,
  PERMISSION_SESSION,
  closeSession,
  drawerFigures,
  openSession,
  openSessionFor,
} from '@lib/cash/sessions';
import { formatMoney, fromCents, toCents } from '@lib/payments/money';
import {
  BUTTON,
  CARD,
  CARD_TITLE,
  HINT,
  INPUT,
  PAGE,
  LABEL,
  NOTICE_ERROR,
  NOTICE_OK,
  TABLE,
  THEAD,
  TH,
  TD,
  TD_NUM,
  ROW,
} from '@lib/ui';

const principal = Astro.locals.principal!;
if (!principal.permissions.has(PERMISSION_SESSION)) {
  return Astro.redirect('/denied');
}

let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  try {
    if (intent === 'open') {
      await openSession(
        {
          openingFloat: String(form.get('openingFloat') ?? ''),
          note: String(form.get('note') ?? ''),
        },
        principal
      );
      notice = 'Drawer opened.';
    } else if (intent === 'close') {
      const closed = await closeSession(
        {
          closingCount: String(form.get('closingCount') ?? ''),
          note: String(form.get('note') ?? ''),
        },
        principal
      );
      const overShortCents = toCents(closed.overShort ?? '0');
      const difference =
        overShortCents === 0
          ? 'The count matches.'
          : overShortCents > 0
            ? `Over by ${formatMoney(closed.overShort!)}.`
            : `Short by ${formatMoney(fromCents(-overShortCents))}.`;
      notice = `Drawer closed. ${difference}`;
    }
  } catch (err) {
    if (err instanceof CashSessionError) {
      error = err.message;
    } else {
      console.error('[cashier]', err);
      error = 'Something went wrong. Please try again.';
    }
  }
}

const session = await openSessionFor(principal.userId);
const figures = session ? await drawerFigures(session.id) : null;

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
---

<DashboardLayout title="Cash drawer · Al Barakah MCSL" heading="Cash drawer">
  <div class={PAGE.form}>
    {error && <div class={NOTICE_ERROR}>{error}</div>}
    {notice && <div class={NOTICE_OK}>{notice}</div>}

    {!session ? (
      <section class={CARD}>
        <h2 class={CARD_TITLE}>No drawer open</h2>
        <form method="post" class="mt-4 grid gap-3 sm:grid-cols-2">
          <input type="hidden" name="intent" value="open" />
          <label class={LABEL}>
            Opening float (Rs)
            <input
              type="text"
              name="openingFloat"
              inputmode="decimal"
              required
              class={INPUT}
            />
          </label>
          <label class={LABEL}>
            Note
            <input type="text" name="note" class={INPUT} />
          </label>
          <div class="sm:col-span-2">
            <button type="submit" class={BUTTON}>
              Open drawer
            </button>
          </div>
        </form>
      </section>
    ) : (
      <>
        <section class={CARD}>
          <dl class="grid gap-4 text-sm sm:grid-cols-5">
            <div>
              <dt class="text-neutral-500 dark:text-neutral-400">Opened</dt>
              <dd class="font-medium text-neutral-800 dark:text-neutral-100">
                {dateFormat.format(session.openedAt)}
              </dd>
            </div>
            <div>
              <dt class="text-neutral-500 dark:text-neutral-400">Float</dt>
              <dd class="font-medium text-neutral-800 tabular-nums dark:text-neutral-100">
                {formatMoney(figures!.openingFloat)}
              </dd>
            </div>
            <div>
              <dt class="text-neutral-500 dark:text-neutral-400">Cash in</dt>
              <dd class="font-medium text-neutral-800 tabular-nums dark:text-neutral-100">
                {formatMoney(figures!.cashIn)}
              </dd>
            </div>
            <div>
              <dt class="text-neutral-500 dark:text-neutral-400">Cash out</dt>
              <dd class="font-medium text-neutral-800 tabular-nums dark:text-neutral-100">
                {formatMoney(figures!.cashOut)}
              </dd>
            </div>
            <div>
              <dt class="text-neutral-500 dark:text-neutral-400">Expected</dt>
              <dd class="text-lg font-bold text-neutral-800 tabular-nums dark:text-neutral-100">
                {formatMoney(figures!.expected)}
              </dd>
            </div>
          </dl>
        </section>

        <section class={CARD}>
          <h2 class={CARD_TITLE}>Movements</h2>
          {figures!.movements.length === 0 ? (
            <p class={`${HINT} mt-3`}>No cash movements yet.</p>
          ) : (
            <table class={`${TABLE} mt-4`}>
              <thead>
                <tr
                  class={`${THEAD} border-b border-neutral-300 dark:border-neutral-700`}
                >
                  <th class={TH}>Time</th>
                  <th class={TH}>What</th>
                  <th class={TH}>Reference</th>
                  <th class={TH}>Receipt</th>
                  <th class={`${TH} text-right`}>In</th>
                  <th class={`${TH} text-right`}>Out</th>
                </tr>
              </thead>
              <tbody>
                {figures!.movements.map(m => (
                  <tr class={ROW}>
                    <td class={`${TD} text-neutral-500 dark:text-neutral-400`}>
                      {dateFormat.format(m.at)}
                    </td>
                    <td class={`${TD} text-neutral-800 dark:text-neutral-100`}>
                      {m.what}
                    </td>
                    <td class={TD}>
                      <code class="text-xs text-neutral-600 dark:text-neutral-300">
                        {m.reference}
                      </code>
                    </td>
                    <td class={`${TD} text-neutral-500 dark:text-neutral-400`}>
                      {m.receiptNo ?? '—'}
                    </td>
                    <td
                      class={`${TD_NUM} text-neutral-800 dark:text-neutral-100`}
                    >
                      {m.direction === 'in' ? formatMoney(m.amount) : ''}
                    </td>
                    <td
                      class={`${TD_NUM} text-neutral-800 dark:text-neutral-100`}
                    >
                      {m.direction === 'out' ? formatMoney(m.amount) : ''}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </section>

        <section class={CARD}>
          <h2 class={CARD_TITLE}>Close drawer</h2>
          <form method="post" class="mt-4 grid gap-3 sm:grid-cols-2">
            <input type="hidden" name="intent" value="close" />
            <label class={LABEL}>
              Counted (Rs)
              <input
                type="text"
                name="closingCount"
                inputmode="decimal"
                required
                class={INPUT}
              />
            </label>
            <label class={LABEL}>
              Note
              <input type="text" name="note" class={INPUT} />
            </label>
            <p class="text-sm text-amber-700 dark:text-amber-400 sm:col-span-2">
              Closing fixes the count and the difference on this drawer.
            </p>
            <div class="sm:col-span-2">
              <button type="submit" class={BUTTON}>
                Close drawer
              </button>
            </div>
          </form>
        </section>
      </>
    )}
  </div>
</DashboardLayout>
