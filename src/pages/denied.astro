---
import AuthLayout from '@layouts/AuthLayout.astro';
import BrandLogo from '@components/BrandLogo.astro';

// Shown when a signed-in person may not reach what they asked for. It is
// deliberately public (see src/middleware.ts): every refusal redirects here, so
// if it required permission the refusal would loop. It therefore shows no data
// at all — only what happened and what to do about it.
//
// The message does not distinguish "you have no account here" from "you lack
// this permission". Both are a refusal as far as the person is concerned, and
// spelling out which one tells an unknown caller whether an account exists. The
// distinction is recorded in the audit trail, where an administrator can see it.
---

<AuthLayout title="Access denied · Al Barakah MCSL">
  <div class="w-full max-w-md text-center">
    <div class="flex justify-center">
      <BrandLogo />
    </div>

    <h1
      class="mt-6 text-xl font-semibold text-neutral-800 dark:text-neutral-100"
    >
      You do not have access to this page
    </h1>

    <p class="mt-3 text-sm text-neutral-500 dark:text-neutral-400">
      Your sign-in was successful, but this account is not permitted to view
      what you asked for. If you believe this is a mistake, contact your
      administrator — the attempt has been recorded.
    </p>

    <div class="mt-8 flex items-center justify-center">
      {
        /*
        Sign out only. Most people who land here have no account in this system
        or a deactivated one, and for them the dashboard is another refusal —
        offering it sends them round a loop with no way out. Signing out is the
        one action that always does something.
      */
      }
      <a
        href="/auth/logout"
        class="bg-mint-300 hover:bg-mint-400 rounded-lg px-4 py-2 text-sm font-bold text-neutral-800 transition duration-300"
      >
        Sign out
      </a>
    </div>
  </div>
</AuthLayout>
