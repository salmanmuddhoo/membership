---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { CARD, CARD_TITLE, PAGE } from '@lib/ui';

const displayName =
  Astro.locals.principal?.displayName ||
  Astro.locals.user?.name ||
  Astro.locals.user?.email ||
  '';
---

<DashboardLayout title="Dashboard · Al Barakah MCSL" heading="Dashboard">
  <div class={PAGE.list}>
    {/* Welcome */}
    <section class={`${CARD} sm:p-8`}>
      <h2 class={CARD_TITLE}>
        Assalamoualaikoum{displayName ? `, ${displayName}` : ''}
      </h2>
    </section>

    {/* Placeholder module tiles for future work (not yet implemented) */}
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {[
        'Membership',
        'Financing',
        'Documents',
        'Approvals',
        'Reports',
        'Settings',
      ].map(name => (
        <div class="rounded-xl border border-dashed border-neutral-300 bg-neutral-50 p-5 dark:border-neutral-700 dark:bg-neutral-900/50">
          <p class="text-sm font-medium text-neutral-700 dark:text-neutral-200">
            {name}
          </p>
          <p class="mt-1 text-xs text-neutral-400 dark:text-neutral-500">
            Coming soon
          </p>
        </div>
      ))}
    </div>
  </div>
</DashboardLayout>
