---
// The Society's day (S-1506): every transaction recorded, newest first,
// today by default, filterable by kind, status and date, and paged. The
// same query as a person's list, unfiltered by person.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import TransactionTable from '@components/TransactionTable.astro';
import Pagination from '@components/Pagination.astro';
import { listTransactions } from '@lib/ledger/history';
import type { TransactionRowKind } from '@lib/config/reference';
import { STATUS_LABELS } from '@lib/ledger/labels';
import { pagingFrom, pageCount } from '@lib/paging';
import { PAGE, FILTER, INPUT, HINT, BUTTON_SM, SECONDARY_SM } from '@lib/ui';

const KINDS: [TransactionRowKind, string][] = [
  ['deposit', 'Deposit'],
  ['withdrawal', 'Withdrawal'],
  ['transfer_leg', 'Transfer'],
  ['closure', 'Account closure'],
  ['resignation', 'Resignation'],
  ['demise', 'Demised claim'],
  ['reversal', 'Reversal'],
];
// The table reads a posted deposit or transfer as recorded and anything
// else as Disbursed (labels.ts); the filter offers one choice for all of
// them (QA-19).
const STATUSES: [string, string][] = [
  ['submitted', STATUS_LABELS.submitted],
  ['under_review', STATUS_LABELS.under_review],
  ['approved', STATUS_LABELS.approved],
  ['posted', 'Disbursed or recorded'],
  ['returned', STATUS_LABELS.returned],
  ['rejected', STATUS_LABELS.rejected],
];
const principal = Astro.locals.principal!;
// Officer feedback: a Regional Officer or Manager sees the transactions they
// recorded; roles holding transaction.view_all see the Society's whole day.
const seesAll = principal.permissions.has('transaction.view_all');
const params = Astro.url.searchParams;
const today = new Date().toISOString().slice(0, 10);
const kind = params.get('kind') ?? '';
const status = params.get('status') ?? '';
const from = params.has('from') ? (params.get('from') ?? '') : today;
const to = params.has('to') ? (params.get('to') ?? '') : today;
const paging = pagingFrom(Astro.url);
const asDate = (value: string, endOfDay: boolean) => {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return undefined;
  return new Date(`${value}T${endOfDay ? '23:59:59.999' : '00:00:00'}`);
};
const result = await listTransactions({
  capturedBy: seesAll ? undefined : principal.userId,
  kind: KINDS.some(([k]) => k === kind)
    ? (kind as TransactionRowKind)
    : undefined,
  status: STATUSES.some(([code]) => code === status) ? status : undefined,
  from: asDate(from, false),
  to: asDate(to, true),
  page: paging.page,
  pageSize: paging.per,
});
// A page past the end (a filter narrowed the list under it) lands on the
// first page rather than showing nothing.
if (paging.page > 1 && paging.page > pageCount(result.total, paging.per)) {
  const next = new URL(Astro.url);
  next.searchParams.delete('page');
  return Astro.redirect(`${next.pathname}${next.search}`);
}
---

<DashboardLayout
  title={`${seesAll ? 'All transactions' : 'Your transactions'} · Al Barakah MCSL`}
  heading={seesAll ? 'All transactions' : 'Your transactions'}
>
  <div class={PAGE.wide}>
    <a href="/transactions" class={`inline-block ${HINT} underline`}>
      ← Transactions
    </a>

    <form method="get" class={`grid gap-3 ${FILTER} text-sm sm:grid-cols-4`}>
      <label class="text-neutral-600 dark:text-neutral-300">
        Kind
        <select name="kind" class={INPUT}>
          <option value="">All</option>
          {KINDS.map(([code, label]) => (
            <option value={code} selected={code === kind}>
              {label}
            </option>
          ))}
        </select>
      </label>
      <label class="text-neutral-600 dark:text-neutral-300">
        Status
        <select name="status" class={INPUT}>
          <option value="">All</option>
          {STATUSES.map(([code, label]) => (
            <option value={code} selected={code === status}>
              {label}
            </option>
          ))}
        </select>
      </label>
      <label class="text-neutral-600 dark:text-neutral-300">
        From
        <input type="date" name="from" value={from} class={INPUT} />
      </label>
      <label class="text-neutral-600 dark:text-neutral-300">
        To
        <input type="date" name="to" value={to} class={INPUT} />
      </label>
      <div class="flex items-end gap-2 sm:col-span-4">
        <button type="submit" class={BUTTON_SM}>
          Filter
        </button>
        <a href="/transactions/all?from=&to=" class={SECONDARY_SM}>
          Every date
        </a>
        <span class="ml-auto text-neutral-500 dark:text-neutral-400">
          {result.total} transaction{result.total === 1 ? '' : 's'}
        </span>
      </div>
    </form>

    <TransactionTable
      transactions={result.transactions}
      showHolder
      empty="Nothing recorded for these dates."
    />
    <Pagination total={result.total} paging={paging} noun="transactions" />
  </div>
</DashboardLayout>
