---
// The Withdrawal Form for a withdrawal at the counter
// (withdrawal-requests.ts): a sheet, like the Cash Deposit Form, read on
// screen, signed on the pad, rasterised and filed against the request.
// What is filed is this sheet as the client saw it.
import BaseLayout from '@layouts/BaseLayout.astro';
import { depositorForApplication } from '@lib/applications/depositor';
import { withdrawalFormItem } from '@lib/ledger/withdrawal-requests';
import { loadTransaction } from '@lib/ledger/review';
import { loadCustomer, loadMember } from '@lib/members/create';
import { formatMoney } from '@lib/payments/money';
import { localFormat } from '@lib/time';

const principal = Astro.locals.principal!;
const { id } = Astro.params;
const withdrawal = id ? await loadTransaction(id) : null;
if (
  !withdrawal ||
  withdrawal.kind !== 'withdrawal' ||
  withdrawal.status !== 'draft' ||
  withdrawal.capturedById !== principal.userId
) {
  return new Response('Not found', { status: 404 });
}

const holder =
  withdrawal.holderKind === 'member'
    ? await loadMember(withdrawal.holderId)
    : await loadCustomer(withdrawal.holderId);

// Who signs for the account: a Minor's guardian, a Corporate entity's
// Contact Person, otherwise the holder — as the Cash Deposit Form names them.
const signer = await depositorForApplication(holder?.applicationId ?? null);
const name = signer.name || holder?.name || withdrawal.holderName;
const nic = (
  signer.name ? signer.nic : (holder?.applicantValues?.nic ?? '')
).trim();

const item = await withdrawalFormItem(withdrawal.id);
const back = `/withdrawals/${withdrawal.id}?step=signature`;
const next = `/withdrawals/${withdrawal.id}?step=submit`;
const dateFormat = localFormat({ dateStyle: 'long' });
---

<BaseLayout title={`${withdrawal.reference} · Withdrawal Form`}>
  <div
    class="form-page"
    data-transaction-id={withdrawal.id}
    data-reference={withdrawal.reference}
    data-document-type-id={item?.documentTypeId ?? ''}
    data-next={next}
    data-filed-document-id={item?.filed?.documentId ?? ''}
  >
    <header class="head">
      <div>
        <h1>AL BARAKAH MCSL</h1>
        <p class="sub">WITHDRAWAL FORM</p>
      </div>
      <div class="ref">
        <p>
          <strong>{withdrawal.reference}</strong>
        </p>
        <p>{dateFormat.format(new Date())}</p>
      </div>
    </header>

    <div class="box">
      <div class="row">
        <span class="label">NAME:</span>
        <span class="value">{name || <i class="blank" />}</span>
      </div>
      <div class="row">
        <span class="label">NIC / PASSPORT NO:</span>
        <span class="value">{nic || <i class="blank" />}</span>
      </div>
      <div class="row">
        <span class="label">ACCOUNT:</span>
        <span class="value">
          {withdrawal.accountNo} · {withdrawal.accountTypeName}
        </span>
      </div>
      <div class="row">
        <span class="label">RUPEES:</span>
        <span class="value">{formatMoney(withdrawal.amount)}</span>
      </div>
      {withdrawal.payeeName && (
        <div class="row">
          <span class="label">PAID TO:</span>
          <span class="value">{withdrawal.payeeName}</span>
        </div>
      )}
      <div class="row">
        <span class="label">Date:</span>
        <span class="value">{dateFormat.format(new Date())}</span>
      </div>
    </div>

    <p class="certify">
      I, {name}, request the withdrawal of {formatMoney(withdrawal.amount)} from
      account {withdrawal.accountNo}
      {withdrawal.payeeName ? `, to be paid to ${withdrawal.payeeName}` : ''}.
    </p>

    <div class="sign">
      <p class="label">CLIENT'S SIGNATURE:</p>
      <div class="sig-pad">
        <div class="sig-line"></div>
        <img class="sig-image" data-sig-image alt="" hidden />
      </div>
      <div class="sig-controls no-print">
        <button type="button" data-sig-open>
          Sign
        </button>
        <button type="button" data-sig-clear hidden>
          Clear
        </button>
      </div>
    </div>

    <div class="actions no-print">
      <div class="actions-start">
        <a href={back}>← Back to the withdrawal</a>
      </div>
      <div class="actions-centre">
        {item && (
          <button type="button" id="file-form" disabled>
            Upload to SharePoint
          </button>
        )}
      </div>
      <div class="actions-end"></div>
    </div>
    <p data-status class="status-line no-print" aria-live="polite">
      {item?.filed
        ? `On file: ${item.filed.fileName}. Signing again replaces it.`
        : 'Have the client sign, then upload.'}
    </p>
  </div>
</BaseLayout>

<style>
  /* A sheet a person reads and signs, set in absolute units against white,
     exactly as the Cash Deposit Form is. */
  .form-page {
    max-width: 190mm;
    margin: 0 auto;
    padding: 12mm 10mm;
    background: #fff;
    color: #111;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11pt;
    line-height: 1.5;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 6mm;
    margin-bottom: 8mm;
  }
  .head h1 {
    margin: 0;
    font-size: 15pt;
    letter-spacing: 1px;
  }
  .head .sub {
    margin: 1mm 0 0;
    font-size: 12pt;
    font-weight: bold;
    letter-spacing: 1px;
  }
  .head .ref {
    text-align: right;
    font-size: 9pt;
  }
  .head .ref p {
    margin: 0;
  }
  .box {
    border: 1px solid #111;
    border-bottom: none;
    margin-bottom: 6mm;
  }
  .box .row {
    border-bottom: 1px solid #111;
    padding: 2.5mm 3mm;
  }
  .label {
    font-weight: bold;
  }
  .label + .value {
    margin-left: 1.5mm;
  }
  .value {
    font-weight: normal;
  }
  .blank {
    display: inline-block;
    min-width: 60mm;
    border-bottom: 1px solid #999;
  }
  .certify {
    margin: 0 0 4mm;
    text-align: justify;
  }
  .sign {
    margin: 8mm 0 4mm;
  }
  .sign .label {
    margin: 0 0 2mm;
  }
  .sig-pad {
    position: relative;
    height: 28mm;
    border: 1px solid #111;
    margin-bottom: 2mm;
  }
  .sig-line {
    position: absolute;
    left: 6mm;
    right: 6mm;
    bottom: 6mm;
    border-bottom: 1px solid #999;
  }
  .sig-image {
    position: absolute;
    inset: 2mm;
    width: calc(100% - 4mm);
    height: calc(100% - 4mm);
    object-fit: contain;
  }
  .sig-controls {
    display: flex;
    gap: 3mm;
    margin-bottom: 6mm;
  }
  .sig-controls button,
  .actions button {
    font: inherit;
    padding: 1.5mm 4mm;
    border: 1px solid #111;
    background: #fff;
    cursor: pointer;
  }
  .actions button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .actions {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-top: 10mm;
    gap: 4mm;
  }
  .actions-start {
    justify-self: start;
  }
  .actions-end {
    justify-self: end;
  }
  .actions a {
    color: #111;
  }
  .status-line {
    margin-top: 3mm;
    font-size: 9pt;
    color: #555;
  }
  .status-line[data-tone='error'] {
    color: #b00020;
  }
  .capturing .no-print,
  .capturing .sig-controls {
    display: none !important;
  }
  @media print {
    .no-print {
      display: none !important;
    }
  }
</style>

<script>
  import { wireSignedRequestForm } from '@lib/client/signed-request';

  wireSignedRequestForm({
    signatureTitle: "Client's signature",
    documentLabel: 'Withdrawal Form',
  });
</script>
