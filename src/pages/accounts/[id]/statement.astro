---
// One account's statement (S-1604): a period, the balance it opened and
// closed at, every entry between, and the totals. Printed through the
// browser, like a receipt; downloaded as a spreadsheet through the API.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { accountStatement } from '@lib/ledger/ledger';
import { statementPeriod } from '@lib/ledger/statement';
import { formatMoney } from '@lib/payments/money';
import { PAGE, FILTER, BUTTON, INPUT, SECONDARY_SM } from '@lib/ui';

const { id } = Astro.params;
const params = Astro.url.searchParams;
const period = statementPeriod({
  from: params.get('from'),
  to: params.get('to'),
});
const invalidPeriod = period === null;
const shown = period ?? statementPeriod({ from: null, to: null })!;

const statement = id ? await accountStatement(id, shown.from, shown.to) : null;
if (!statement) return new Response('Not found', { status: 404 });

const holder = [
  statement.holderName || statement.holderKind,
  statement.memberNo,
]
  .filter(Boolean)
  .join(' · ');
const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const longDate = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
const day = (value: string) => longDate.format(new Date(`${value}T00:00:00`));
const excelHref = `/api/v1/accounts/${id}/statement?from=${shown.from}&to=${shown.to}&format=xlsx`;
---

<DashboardLayout
  title={`Statement ${statement.accountNo} · Al Barakah MCSL`}
  heading={`Statement · ${statement.accountNo}`}
>
  <div class={PAGE.list}>
    <form
      method="get"
      class={`print:hidden flex flex-wrap items-end gap-3 ${FILTER}`}
    >
      <label class="text-sm text-neutral-600 dark:text-neutral-300">
        From
        <input type="date" name="from" value={shown.from} class={INPUT} />
      </label>
      <label class="text-sm text-neutral-600 dark:text-neutral-300">
        To
        <input type="date" name="to" value={shown.to} class={INPUT} />
      </label>
      <button type="submit" class={BUTTON}>
        Show
      </button>
      <span class="grow"></span>
      <button type="button" id="print" class={SECONDARY_SM}>
        Print
      </button>
      <a href={excelHref} class={SECONDARY_SM}>
        Download as Excel
      </a>
      <a href={`/accounts/${id}`} class={SECONDARY_SM}>
        Back
      </a>
      {invalidPeriod && (
        <p class="w-full text-sm text-red-700 dark:text-red-300">
          Choose two dates, the first no later than the second. Showing the
          month to date.
        </p>
      )}
    </form>

    <section class="rounded-2xl border border-neutral-200 bg-white p-6 text-neutral-800 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-100 print:border-0 print:p-0">
      <header class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold">Al Barakah MCSL</h2>
          <p class="text-sm text-neutral-600 dark:text-neutral-300">
            Account statement
          </p>
        </div>
        <div class="text-right text-sm">
          <p class="font-medium">{holder}</p>
          <p>
            {statement.accountNo} · {statement.accountTypeName}
          </p>
          <p class="text-neutral-600 dark:text-neutral-300">
            {day(statement.from)} to {day(statement.to)}
          </p>
        </div>
      </header>

      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="text-left text-xs text-neutral-500 uppercase dark:text-neutral-400">
            <tr>
              <th class="px-2 py-2">Date</th>
              <th class="px-2 py-2">Reference</th>
              <th class="px-2 py-2">Description</th>
              <th class="px-2 py-2">Receipt</th>
              <th class="px-2 py-2 text-right">Out</th>
              <th class="px-2 py-2 text-right">In</th>
              <th class="px-2 py-2 text-right">Balance</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-200 dark:divide-neutral-800">
            <tr class="font-medium">
              <td class="px-2 py-2 whitespace-nowrap">{day(statement.from)}</td>
              <td class="px-2 py-2"></td>
              <td class="px-2 py-2">Opening balance</td>
              <td class="px-2 py-2"></td>
              <td class="px-2 py-2"></td>
              <td class="px-2 py-2"></td>
              <td class="px-2 py-2 text-right tabular-nums">
                {formatMoney(statement.openingBalance)}
              </td>
            </tr>
            {statement.lines.map(line => (
              <tr>
                <td class="px-2 py-2 whitespace-nowrap">
                  {dateFormat.format(line.postedAt)}
                </td>
                <td class="px-2 py-2">
                  <code class="text-xs">{line.reference}</code>
                </td>
                <td class="px-2 py-2">
                  {line.description}
                  {line.reason && (
                    <span class="text-xs text-neutral-500 dark:text-neutral-400">
                      {' · '}
                      {line.reason}
                    </span>
                  )}
                  <span class="block text-xs text-neutral-500 dark:text-neutral-400">
                    {line.methodName}
                    {line.methodReference && ` · ${line.methodReference}`}
                  </span>
                </td>
                <td class="px-2 py-2">
                  <code class="text-xs">{line.receiptNo ?? '—'}</code>
                </td>
                <td class="px-2 py-2 text-right tabular-nums">
                  {line.debit && formatMoney(line.debit)}
                </td>
                <td class="px-2 py-2 text-right tabular-nums">
                  {line.credit && formatMoney(line.credit)}
                </td>
                <td class="px-2 py-2 text-right tabular-nums">
                  {formatMoney(line.balance)}
                </td>
              </tr>
            ))}
            {statement.lines.length === 0 && (
              <tr>
                <td
                  colspan="7"
                  class="px-2 py-3 text-center text-neutral-500 dark:text-neutral-400"
                >
                  Nothing posted in this period.
                </td>
              </tr>
            )}
          </tbody>
          <tfoot class="border-t-2 border-neutral-300 font-medium dark:border-neutral-700">
            <tr>
              <td class="px-2 py-2 whitespace-nowrap">{day(statement.to)}</td>
              <td class="px-2 py-2"></td>
              <td class="px-2 py-2">Closing balance</td>
              <td class="px-2 py-2"></td>
              <td class="px-2 py-2 text-right tabular-nums">
                {formatMoney(statement.totalDebits)}
              </td>
              <td class="px-2 py-2 text-right tabular-nums">
                {formatMoney(statement.totalCredits)}
              </td>
              <td class="px-2 py-2 text-right tabular-nums">
                {formatMoney(statement.closingBalance)}
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </section>
  </div>
</DashboardLayout>

<script>
  document.getElementById('print')?.addEventListener('click', () => {
    window.print();
  });
</script>
