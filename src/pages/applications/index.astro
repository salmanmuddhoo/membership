---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import Pagination from '@components/Pagination.astro';
import {
  ApplicationError,
  countApplications,
  countApplicationsForList,
  deleteDraftApplication,
  listApplications,
} from '@lib/applications/capture';
import {
  PAGE,
  CARD,
  CARD_TITLE,
  INPUT,
  INPUT_BARE,
  BUTTON_SM,
  SECONDARY_SM,
  HINT,
  LINK_CARD,
  MUTED,
  DANGER_XS,
  LABEL,
  NOTICE_ERROR,
  NOTICE_OK,
  PILL,
  TABLE,
  THEAD,
  TH,
  ROW,
  TD,
} from '@lib/ui';
import { pagingFrom, pageHref, pageCount } from '@lib/paging';
import { listMembershipTypes } from '@lib/config/reference';
import {
  pendingApplicationIds,
  returnedByLabelsFor,
  reviewStageLabelsFor,
} from '@lib/applications/workflow';
import { APPLICATION_STATUS_LABELS as STATUS_LABELS } from '@lib/applications/status-labels';

const principal = Astro.locals.principal!;
const canCapture = principal.permissions.has('application.capture');

let error: string | null = null;

if (Astro.request.method === 'POST') {
  if (!canCapture) {
    error = 'You do not have permission to capture applications.';
  } else {
    const form = await Astro.request.formData();
    const intent = String(form.get('intent') ?? 'start');

    if (intent === 'delete') {
      // One checkbox or many — a bulk delete is this same intent with more
      // than one applicationId, not a separate action with its own rules.
      const ids = form.getAll('applicationId').map(String).filter(Boolean);

      // Each deletion is its own business transaction — its own lock, its
      // own checks (not submitted, no receipt, no filed documents) — not
      // rows to delete in one statement. A batch of five separate drafts
      // failing or succeeding independently is the correct behaviour, not
      // something to optimise away.
      const deletedReferences: string[] = [];
      const failures: { reference: string; message: string }[] = [];
      for (const id of ids) {
        try {
          const { reference } = await deleteDraftApplication(id, principal);
          deletedReferences.push(reference);
        } catch (err) {
          const reference = String(form.get(`reference:${id}`) ?? id);
          if (err instanceof ApplicationError) {
            failures.push({ reference, message: err.message });
          } else {
            console.error('[applications/delete]', err);
            failures.push({
              reference,
              message: 'Something went wrong — nothing was removed.',
            });
          }
        }
      }

      if (failures.length === 0 && deletedReferences.length > 0) {
        return Astro.redirect(
          `/applications?deleted=${encodeURIComponent(String(deletedReferences.length))}`
        );
      }
      if (failures.length > 0) {
        error =
          (deletedReferences.length > 0
            ? `${deletedReferences.length} draft${deletedReferences.length === 1 ? '' : 's'} deleted. `
            : '') +
          `Could not delete: ${failures.map(f => `${f.reference} (${f.message})`).join('; ')}`;
      }
    }
  }
}

// Set by the redirect after one or more drafts are deleted: a count, not a
// reference — a bulk delete can span drafts with nothing else in common to
// name them by.
const deletedCount = Number(Astro.url.searchParams.get('deleted') ?? '');

// Set by the redirect after an additional-account application is started
// (S-613, new-account.astro): there is no detail page to land on yet, so the
// officer is sent back here with a reference to confirm against.
const created = Astro.url.searchParams.get('created');

const filter = Astro.url.searchParams.get('status') ?? '';
const search = Astro.url.searchParams.get('q') ?? '';
// Officer feedback: the applications waiting on this officer, alone.
const waitingOnly = Astro.url.searchParams.get('waiting') === '1';
// Officer feedback: 'received' (submitted from the mobile app) used to be
// visible to any officer who could submit at all — the business wants it
// handled by specific staff instead (S-303, application.submit_online).
const canHandleReceived = principal.permissions.has(
  'application.submit_online'
);

// Officer request: a page at a time, 10/25/50 as chosen (src/lib/paging.ts).
const paging = pagingFrom(Astro.url);

// pendingApplicationIds depends only on the signed-in officer, not on this
// page's filters, so it is resolved before the paged query rather than
// alongside it — listApplications needs the ids themselves, to sort
// "Waiting on you" ahead of everything else on every page (not just
// whichever one happened to be asked for) and, with waitingOnly, to narrow
// to just these.
const attentionIds = await pendingApplicationIds(principal);
const attentionIdList = [...attentionIds];

const [applications, total, types, nonDraftCount] = await Promise.all([
  listApplications({
    ...(filter ? { statuses: [filter] } : {}),
    viewerUserId: principal.userId,
    search,
    canHandleReceived,
    attentionIds: attentionIdList,
    waitingOnly,
    limit: paging.per,
    offset: paging.offset,
  }),
  countApplicationsForList({
    viewerUserId: principal.userId,
    ...(filter ? { statuses: [filter] } : {}),
    search,
    canHandleReceived,
    attentionIds: attentionIdList,
    waitingOnly,
  }),
  listMembershipTypes(),
  // Meaningless filtered to Draft specifically — countApplications excludes
  // every draft regardless, so that combination would always read 0 beside
  // a table that is, in fact, showing rows.
  filter === 'draft'
    ? null
    : countApplications({
        ...(filter ? { statuses: [filter] } : {}),
        canHandleReceived,
      }),
]);

// A page past the end — a stale link, or the filter narrowing since it was
// followed — lands on the first page rather than an empty table with no
// way back.
if (paging.page > pageCount(total, paging.per)) {
  return Astro.redirect(pageHref(Astro.url, { page: 1 }));
}

// S-611 follow-up: a status names a stage, never the person holding it.
// 'new' means as many different things as the configured chain has steps
// waiting on it — still with the Regional Manager, past them and with the
// Secretary, or (Secretary review disabled) straight with the President —
// and "Submit for Approval" says no more about the President holding it.
// One batched read for the whole page, driven entirely by the configured
// chain (`reviewStageLabelsFor`, workflow.ts) rather than assuming which
// roles those could be. The same principle applies to 'returned' rows: the
// status badge alone does not say who sent it back, so a second batched
// read adds "Returned by the X" for those.
const [reviewStageLabels, returnedStageLabels] = await Promise.all([
  reviewStageLabelsFor(applications.map(a => ({ id: a.id, status: a.status }))),
  returnedByLabelsFor(
    applications.filter(a => a.status === 'returned').map(a => a.id)
  ),
]);

const STATUS_CLASSES: Record<string, string> = {
  draft:
    'bg-neutral-200 text-neutral-700 dark:bg-neutral-700 dark:text-neutral-200',
  // Amber like 'returned': both are work sitting with the branch.
  received: 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200',
  new: 'bg-mint-200 text-neutral-800 dark:bg-mint-900 dark:text-neutral-100',
  submitted_for_approval:
    'bg-mint-200 text-neutral-800 dark:bg-mint-900 dark:text-neutral-100',
  rejected: 'bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-200',
  returned: 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200',
};

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
---

<DashboardLayout title="Applications · Al Barakah MCSL" heading="Applications">
  <div class={PAGE.list}>
    {error && <div class={NOTICE_ERROR}>{error}</div>}

    {deletedCount > 0 && (
      <div class={NOTICE_OK}>
        {deletedCount === 1
          ? '1 draft was deleted.'
          : `${deletedCount} drafts were deleted.`}
      </div>
    )}

    {created && <div class={NOTICE_OK}>Application {created} started.</div>}

    {attentionIds.size > 0 && !waitingOnly && (
      <a href="/applications?waiting=1" class={LINK_CARD}>
        <span class="font-semibold text-neutral-800 dark:text-neutral-100">
          Waiting on you
        </span>
        <span class={MUTED}>
          {`${attentionIds.size} application${attentionIds.size === 1 ? '' : 's'}`}
          {' →'}
        </span>
      </a>
    )}

    {canCapture && (
      <section class={CARD}>
        <h2 class={CARD_TITLE}>Start an application</h2>
        <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
          {/* A GET, deliberately. Opening the form creates nothing — the
                application exists once a detail is entered. */}
          <form
            method="get"
            action="/applications/new"
            class="flex flex-wrap items-end gap-2"
          >
            <label class={LABEL}>
              Applicant status
              <select name="type" class={INPUT}>
                {types
                  .filter(t => t.isActive)
                  .map(t => (
                    <option value={t.code}>{t.name}</option>
                  ))}
              </select>
            </label>
            <button type="submit" class={BUTTON_SM}>
              Member Registration
            </button>
          </form>

          <a href="/applications/new-account" class={SECONDARY_SM}>
            Open other account
          </a>
        </div>
      </section>
    )}

    <section class={CARD}>
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class={`${CARD_TITLE} flex items-center gap-2`}>
          {waitingOnly ? 'Waiting on you' : 'Applications'}
          {waitingOnly ? (
            <span class={PILL}>{total}</span>
          ) : (
            nonDraftCount !== null && <span class={PILL}>{nonDraftCount}</span>
          )}
        </h2>
        <form method="get" class="flex flex-wrap items-center gap-2">
          <label for="q" class="sr-only">
            Search by applicant or reference
          </label>
          <input
            id="q"
            type="search"
            name="q"
            value={search}
            placeholder="Search applicant or reference"
            class={INPUT_BARE}
            data-suggest="/applications/suggest.json"
          />
          <label for="status" class="sr-only">
            Filter by status
          </label>
          <select id="status" name="status" class={INPUT_BARE}>
            <option value="">All statuses</option>
            {Object.entries(STATUS_LABELS).map(([code, label]) => (
              <option value={code} selected={code === filter}>
                {label}
              </option>
            ))}
          </select>
          <button type="submit" class={SECONDARY_SM}>
            Filter
          </button>
          {waitingOnly && <input type="hidden" name="waiting" value="1" />}
          {(search || filter || waitingOnly) && (
            <a href="/applications" class={`${HINT} underline`}>
              Clear
            </a>
          )}
        </form>
      </div>

      {applications.length === 0 ? (
        <p class={`mt-4 ${HINT}`}>
          {search
            ? `Nothing matches "${search}".`
            : waitingOnly
              ? 'Nothing is waiting for you.'
              : filter
                ? `No applications with status ${STATUS_LABELS[filter] ?? filter}.`
                : 'No applications yet.'}
        </p>
      ) : (
        <form method="post" id="applications-form" data-confirm-delete>
          {canCapture && (
            <div class="mt-4 flex flex-wrap items-center gap-3 text-sm">
              <span
                data-selected-count
                class="text-neutral-600 dark:text-neutral-300"
              >
                0 selected
              </span>
              <button
                type="submit"
                name="intent"
                value="delete"
                data-bulk-delete
                disabled
                class={DANGER_XS}
              >
                Delete selected
              </button>
            </div>
          )}
          <div class="mt-2 overflow-x-auto">
            <table class={TABLE} data-sortable>
              <thead>
                <tr class={THEAD}>
                  {canCapture && (
                    <th class={TH} data-no-sort>
                      <input
                        type="checkbox"
                        data-select-all
                        aria-label="Select all drafts"
                        class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
                      />
                    </th>
                  )}
                  {[
                    ['Reference', 'reference'],
                    ['Applicant', 'applicant'],
                    ['Type', 'type'],
                    ['Status', 'status'],
                    ['Captured by', 'capturedBy'],
                    ['Updated', 'updated'],
                  ].map(([label, key]) => (
                    <th class={TH}>{label}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {applications.map(a => (
                  <tr class={ROW}>
                    {canCapture && (
                      <td class={TD}>
                        {a.status === 'draft' && (
                          <>
                            <input
                              type="checkbox"
                              name="applicationId"
                              value={a.id}
                              data-row-select
                              aria-label={`Select ${a.reference}`}
                              class="text-mint-500 focus:ring-mint-400 rounded border-neutral-300 dark:border-neutral-600"
                            />
                            <input
                              type="hidden"
                              name={`reference:${a.id}`}
                              value={a.reference}
                            />
                          </>
                        )}
                      </td>
                    )}
                    <td class={TD} data-sort-value={a.reference}>
                      <a
                        href={
                          a.applicationKind === 'membership'
                            ? `/applications/${a.id}`
                            : a.applicationKind === 'additional_account'
                              ? `/applications/${a.id}/account`
                              : `/applications/${a.id}/customer`
                        }
                        class="text-mint-700 dark:text-mint-300 font-medium underline"
                      >
                        {a.reference}
                      </a>
                    </td>
                    <td
                      class={`${TD} text-neutral-700 dark:text-neutral-200`}
                      data-sort-value={a.applicantName}
                    >
                      {a.applicantName}
                    </td>
                    <td
                      class={`${TD} text-neutral-600 dark:text-neutral-300`}
                      data-sort-value={a.membershipTypeName}
                    >
                      {a.membershipTypeName}
                    </td>
                    <td
                      class={TD}
                      data-sort-value={STATUS_LABELS[a.status] ?? a.status}
                    >
                      <span
                        class:list={[
                          'rounded px-1.5 py-0.5 text-xs',
                          STATUS_CLASSES[a.status] ??
                            'bg-neutral-200 text-neutral-700 dark:bg-neutral-700 dark:text-neutral-200',
                        ]}
                      >
                        {STATUS_LABELS[a.status] ?? a.status}
                      </span>
                      {reviewStageLabels.has(a.id) && (
                        <span class="mt-1 block text-xs text-neutral-500 dark:text-neutral-400">
                          {reviewStageLabels.get(a.id)}
                        </span>
                      )}
                      {a.status === 'returned' &&
                        returnedStageLabels.has(a.id) && (
                          <span class="mt-1 block text-xs text-neutral-500 dark:text-neutral-400">
                            {returnedStageLabels.get(a.id)}
                          </span>
                        )}
                    </td>
                    <td
                      class={`${TD} text-xs text-neutral-500 dark:text-neutral-400`}
                      data-sort-value={a.capturedByName}
                    >
                      {a.capturedByName}
                    </td>
                    <td
                      class={`${TD} text-xs text-neutral-500 dark:text-neutral-400`}
                      data-sort-value={a.updatedAt.toISOString()}
                    >
                      {dateFormat.format(a.updatedAt)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <Pagination total={total} paging={paging} noun="applications" />
        </form>
      )}
    </section>
  </div>
</DashboardLayout>

<script>
  import { wireSortableTables } from '@lib/client/table-sort';
  const form = document.getElementById(
    'applications-form'
  ) as HTMLFormElement | null;

  if (form) {
    const rowCheckboxes = [
      ...form.querySelectorAll<HTMLInputElement>('[data-row-select]'),
    ];
    const selectAll = form.querySelector<HTMLInputElement>('[data-select-all]');
    const countLabel = form.querySelector('[data-selected-count]');
    const bulkDeleteButton =
      form.querySelector<HTMLButtonElement>('[data-bulk-delete]');

    const selectedCount = () => rowCheckboxes.filter(cb => cb.checked).length;

    const refresh = () => {
      const count = selectedCount();
      if (countLabel) {
        countLabel.textContent = `${count} selected`;
      }
      if (bulkDeleteButton) bulkDeleteButton.disabled = count === 0;
      if (selectAll) {
        selectAll.checked = count > 0 && count === rowCheckboxes.length;
        selectAll.indeterminate = count > 0 && count < rowCheckboxes.length;
      }
    };

    selectAll?.addEventListener('change', () => {
      for (const cb of rowCheckboxes) cb.checked = selectAll.checked;
      refresh();
    });
    for (const cb of rowCheckboxes) {
      cb.addEventListener('change', refresh);
    }
    refresh();

    // Deleting cannot be undone, so ask — naming how many, since a bulk
    // delete is not one draft an officer will remember choosing a moment
    // ago. Without JavaScript the button simply deletes: a confirmation is
    // a courtesy, and a control that only works with scripting would not
    // be. The count is only known at submit time, so this can't use
    // confirmedSubmit's fixed message — same bypass-and-resubmit shape,
    // built fresh here instead.
    let bypassBulkDeleteConfirm = false;
    form.addEventListener('submit', event => {
      if (bypassBulkDeleteConfirm) {
        bypassBulkDeleteConfirm = false;
        return;
      }
      event.preventDefault();
      const count = selectedCount();
      const message =
        count === 1
          ? 'Delete 1 draft? This cannot be undone.'
          : `Delete ${count} drafts? This cannot be undone.`;
      const submitter =
        event.submitter instanceof HTMLElement ? event.submitter : undefined;
      window.appConfirm(message).then(ok => {
        if (!ok) return;
        bypassBulkDeleteConfirm = true;
        form.requestSubmit(submitter);
      });
    });
  }

  wireSortableTables();
</script>
