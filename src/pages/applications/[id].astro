---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import {
  ApplicationError,
  deleteDraftApplication,
  loadApplication,
  problemsBlockingSubmission,
  saveDraft,
  visibleFields,
  type PartyValues,
} from '@lib/applications/capture';
import { listMembershipTypes, type FieldSubject } from '@lib/config/reference';
import { createMemberFromApplication } from '@lib/members/create';
import {
  availableActions,
  decideApplication,
  reviewApplication,
  submitApplication,
  transitionsFor,
} from '@lib/applications/workflow';
import {
  checklistFor,
  isDocumentComplete,
  reviewDocument,
  DocumentError,
} from '@lib/documents/documents';

const principal = Astro.locals.principal!;
const canCapture = principal.permissions.has('application.capture');
const canSeeDocuments = principal.permissions.has('document.view');
const canUpload = principal.permissions.has('document.upload');
const canVerify = principal.permissions.has('document.verify');
const { id } = Astro.params;

let application = id ? await loadApplication(id) : null;
if (!application) return new Response('Not found', { status: 404 });

const type = (await listMembershipTypes()).find(
  t => t.id === application!.membershipTypeId
)!;
const fields = visibleFields(type);
const subjects = [...fields.keys()];

// Read what the form posted back, for every subject the type configures. The
// whole form is posted every time, so a value the officer cleared arrives as
// an empty string and is removed — a partial post would make deleting a wrong
// entry impossible.
async function partiesFromForm(form: FormData): Promise<PartyValues[]> {
  return subjects.map(subject => {
    const values: Record<string, string> = {};
    for (const field of fields.get(subject) ?? []) {
      values[field.fieldKey] = String(
        form.get(`field.${subject}.1.${field.fieldKey}`) ?? ''
      );
    }
    return { subject, ordinal: 1, values };
  });
}

let error: string | null = null;
let notice: string | null = null;
let formatProblems: { fieldKey: string; label: string }[] = [];
let blockingOnSubmit: { label: string; subject: string }[] = [];
let createdMember: { memberNo: string; accountNo: string; id: string } | null =
  null;

let isEditable =
  application.status === 'draft' || application.status === 'returned';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'save');
  const isAutosave = intent === 'autosave';

  // Every refusal below has to reach the autosave caller as a failure status.
  // A refusal that renders the page instead answers 200, and the client — which
  // can only look at response.ok — would report "Saved" for work that was
  // thrown away. The officer then closes the tablet trusting it.
  const refuse = (message: string, status: number): Response | null => {
    error = message;
    return isAutosave
      ? new Response(JSON.stringify({ error: message }), {
          status,
          headers: { 'content-type': 'application/json' },
        })
      : null;
  };

  // Deleting leaves no page to come back to, so it redirects rather than
  // re-rendering an application that is no longer there.
  if (intent === 'delete') {
    try {
      const deleted = await deleteDraftApplication(application.id, principal);
      return Astro.redirect(
        `/applications?deleted=${encodeURIComponent(deleted.reference)}`
      );
    } catch (err) {
      if (err instanceof ApplicationError) {
        error = err.message;
      } else {
        console.error('[applications/delete]', err);
        error =
          'The draft could not be deleted. Nothing has been removed — ' +
          'please try again.';
      }
      application = await loadApplication(application.id);
      if (!application) return Astro.redirect('/applications');
    }
  } else if (intent === 'verify-document' || intent === 'reject-document') {
    try {
      const outcome = intent === 'verify-document' ? 'verify' : 'reject';
      const result = await reviewDocument(
        String(form.get('documentId') ?? ''),
        { outcome, reason: String(form.get('reason') ?? '') },
        principal
      );
      notice =
        result.state === 'verified'
          ? 'Document verified.'
          : 'Document rejected. The officer who filed it can replace it.';
    } catch (err) {
      if (err instanceof DocumentError) {
        error = err.message;
      } else {
        console.error('[documents/review]', err);
        error = 'The document could not be reviewed. Please try again.';
      }
    }
  } else if (
    intent === 'submit' ||
    intent === 'review' ||
    intent === 'decide'
  ) {
    try {
      if (intent === 'submit') {
        const result = await submitApplication(application.id, principal);
        if ('problems' in result) {
          blockingOnSubmit = result.problems;
          error =
            `This application cannot be submitted yet: ${result.problems.length} ` +
            'required field(s) are still empty.';
        } else {
          notice = 'Submitted for central processing.';
        }
      } else if (intent === 'review') {
        const result = await reviewApplication(
          application.id,
          {
            outcome:
              String(form.get('outcome')) === 'return' ? 'return' : 'forward',
            comment: String(form.get('comment') ?? ''),
          },
          principal
        );
        notice =
          result.status === 'returned'
            ? 'Returned to the originating staff.'
            : 'Forwarded to the President.';
      } else {
        const result = await decideApplication(
          application.id,
          {
            outcome:
              String(form.get('outcome')) === 'reject' ? 'reject' : 'approve',
            comment: String(form.get('comment') ?? ''),
          },
          principal,
          createMemberFromApplication
        );
        notice = result.member
          ? `Approved. Member ${result.member.memberNo} created with account ` +
            `${result.member.accountNo}.`
          : 'Rejected and returned to the originating staff.';
        createdMember = result.member ?? null;
      }
      application = await loadApplication(application.id);
    } catch (err) {
      if (err instanceof ApplicationError || err instanceof Error) {
        error = err.message;
      }
      if (!(err instanceof ApplicationError)) {
        console.error('[applications/workflow]', err);
      }
    }
  } else if (!canCapture) {
    const response = refuse(
      'You do not have permission to edit applications.',
      403
    );
    if (response) return response;
  } else if (!isEditable) {
    const response = refuse(
      'This application has been submitted and can no longer be edited.',
      409
    );
    if (response) return response;
  } else {
    try {
      const { problems } = await saveDraft(
        application.id,
        await partiesFromForm(form),
        { userId: principal.userId, email: principal.email }
      );
      formatProblems = problems;

      // The autosave posts the same form and wants no page of its own.
      if (isAutosave) {
        return new Response(
          JSON.stringify({ savedAt: new Date().toISOString(), problems }),
          { headers: { 'content-type': 'application/json' } }
        );
      }

      notice =
        problems.length > 0
          ? 'Draft saved, but some entries need attention.'
          : 'Draft saved.';
      application = await loadApplication(application.id);
    } catch (err) {
      if (err instanceof ApplicationError) {
        const response = refuse(
          err.message,
          err.reason === 'locked' ? 409 : 400
        );
        if (response) return response;
      } else {
        console.error('[applications/capture]', err);
        const response = refuse('Something went wrong. Please try again.', 500);
        if (response) return response;
      }
    }
  }
}

// Recomputed after the POST: a submit that just succeeded leaves an
// application that is no longer editable, and the page below is describing it
// as it is now, not as it was when the request arrived.
isEditable =
  application!.status === 'draft' || application!.status === 'returned';

// A returned application is editable in exactly the same way as a draft but
// has been through the Secretary, and that history is not anyone's to discard.
const isDeletableDraft = canCapture && application!.status === 'draft';

// Only for people who may see documents at all: an application is readable by
// more roles than its scans are.
const checklist = canSeeDocuments
  ? await checklistFor({ applicationId: application!.id })
  : [];
const documentsComplete = checklist.length > 0 && isDocumentComplete(checklist);

const [blocking, actions, history] = await Promise.all([
  problemsBlockingSubmission(application!),
  availableActions(application!, principal),
  transitionsFor(application!.id),
]);
const valuesFor = (subject: FieldSubject) =>
  application!.parties.find(p => p.subject === subject && p.ordinal === 1)
    ?.values ?? {};

const DOCUMENT_STATE_LABELS: Record<string, string> = {
  missing: 'Missing',
  uploaded: 'Uploaded',
  under_review: 'Under review',
  verified: 'Verified',
  rejected: 'Rejected',
  expired: 'Expired',
};

const DOCUMENT_STATE_CLASSES: Record<string, string> = {
  missing:
    'bg-neutral-200 text-neutral-700 dark:bg-neutral-700 dark:text-neutral-200',
  uploaded:
    'bg-mint-200 text-neutral-800 dark:bg-mint-900 dark:text-neutral-100',
  under_review:
    'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200',
  verified:
    'bg-mint-300 text-neutral-800 dark:bg-mint-800 dark:text-neutral-100',
  rejected: 'bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-200',
  expired: 'bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-200',
};

// What the file picker offers, matching what the upload service accepts. A
// device that offers a file the backend will refuse wastes the officer's time
// and their data allowance.
const ACCEPTED_FILES =
  'image/jpeg,image/png,image/heic,image/webp,application/pdf';

const documentsBySubject = new Map<string, typeof checklist>();
for (const entry of checklist) {
  const list = documentsBySubject.get(entry.subject) ?? [];
  list.push(entry);
  documentsBySubject.set(entry.subject, list);
}

const requiredOutstanding = checklist.filter(
  e => e.requirement === 'required' && e.state !== 'verified'
).length;

const SUBJECT_LABELS: Record<string, string> = {
  applicant: 'Applicant',
  nominee: 'Nominee',
  guardian: 'Parent / Guardian',
  beneficiary: 'Takaful beneficiary',
};

// The configured data type decides the keyboard a tablet shows, which matters
// more here than anywhere: capture happens on a tablet in a regional office.
const INPUT_TYPES = {
  text: 'text',
  number: 'number',
  date: 'date',
  email: 'email',
  phone: 'tel',
} as const satisfies Record<string, astroHTML.JSX.HTMLInputTypeAttribute>;

type InputType = (typeof INPUT_TYPES)[keyof typeof INPUT_TYPES];

const inputTypeFor = (dataType: string): InputType =>
  (INPUT_TYPES as Record<string, InputType>)[dataType] ?? 'text';

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
---

<DashboardLayout
  title={`${application!.reference} · Al Barakah MCSL`}
  heading={`Application ${application!.reference}`}
>
  <div class="mx-auto max-w-4xl space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <a
        href="/applications"
        class="inline-block text-sm text-neutral-500 underline dark:text-neutral-400"
        >← All applications</a
      >
      <a
        href={`/applications/${application!.id}/print`}
        class="rounded-lg border border-neutral-300 px-3 py-1.5 text-sm font-medium text-neutral-700 transition hover:bg-neutral-100 dark:border-neutral-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
        >Printable form</a
      >
    </div>

    {
      error && (
        <div class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
          {error}
        </div>
      )
    }
    {
      notice && (
        <div class="border-mint-400 bg-mint-50 dark:border-mint-700 dark:bg-mint-950 rounded-lg border px-4 py-3 text-sm text-neutral-800 dark:text-neutral-100">
          {notice}
        </div>
      )
    }
    {
      formatProblems.length > 0 && (
        <div class="rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-200">
          <p class="font-medium">These entries could not be understood:</p>
          <ul class="mt-1 list-inside list-disc">
            {formatProblems.map(p => (
              <li>{p.label}</li>
            ))}
          </ul>
        </div>
      )
    }

    <section
      class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950"
    >
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="font-medium text-neutral-800 dark:text-neutral-100">
          {application!.membershipTypeName}
        </span>
        <span
          class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-700 dark:bg-neutral-700 dark:text-neutral-200"
        >
          {application!.status}
        </span>
        <span class="text-xs text-neutral-500 dark:text-neutral-400">
          captured by {application!.capturedByName} · updated {
            dateFormat.format(application!.updatedAt)
          }
        </span>
      </div>

      {
        !isEditable && (
          <p class="mt-3 rounded-lg border border-neutral-300 px-3 py-2 text-sm text-neutral-600 dark:border-neutral-700 dark:text-neutral-300">
            This application has left regional hands and is shown read-only.
          </p>
        )
      }

      {
        blocking.length > 0 && isEditable && (
          <div class="mt-3 rounded-lg border border-neutral-300 px-3 py-2 text-sm text-neutral-600 dark:border-neutral-700 dark:text-neutral-300">
            <p class="font-medium">
              {blocking.length} required{' '}
              {blocking.length === 1 ? 'field is' : 'fields are'} still empty.
              The application can be saved as a draft but not submitted.
            </p>
          </div>
        )
      }
    </section>

    {
      createdMember && (
        <section class="border-mint-400 bg-mint-50 dark:border-mint-700 dark:bg-mint-950 rounded-2xl border p-6">
          <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
            Member created
          </h2>
          <p class="mt-1 text-sm text-neutral-700 dark:text-neutral-200">
            <a
              href={`/members/${createdMember.id}`}
              class="font-medium underline"
            >
              {createdMember.memberNo}
            </a>{' '}
            with account {createdMember.accountNo}, opened automatically because
            the membership was approved.
          </p>
        </section>
      )
    }

    {
      blockingOnSubmit.length > 0 && (
        <section class="rounded-2xl border border-red-300 bg-red-50 p-6 dark:border-red-900 dark:bg-red-950">
          <h2 class="text-sm font-medium text-red-900 dark:text-red-200">
            Still required before this can be submitted
          </h2>
          <ul class="mt-2 list-inside list-disc text-sm text-red-800 dark:text-red-200">
            {blockingOnSubmit.map(b => (
              <li>
                {b.label} <span class="text-xs">({b.subject})</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      actions.length > 0 && (
        <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
          <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
            Your next step
          </h2>

          {actions.map(action => (
            <form method="post" class="mt-4 space-y-3">
              {action.stepCode === 'capture' && (
                <button
                  type="submit"
                  name="intent"
                  value="submit"
                  disabled={blocking.length > 0}
                  class="bg-mint-300 hover:bg-mint-400 rounded-lg px-4 py-2 text-sm font-bold text-neutral-800 transition disabled:cursor-not-allowed disabled:opacity-50"
                >
                  {blocking.length > 0
                    ? `Submit (${blocking.length} required field(s) still empty)`
                    : 'Submit for central processing'}
                </button>
              )}

              {(action.stepCode === 'secretary_review' ||
                action.stepCode === 'president_decision') && (
                <>
                  <label class="block text-sm text-neutral-600 dark:text-neutral-300">
                    Comment
                    <textarea
                      name="comment"
                      rows="3"
                      class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                      placeholder={
                        action.stepCode === 'secretary_review'
                          ? 'Required if you return this application.'
                          : 'Required if you reject this application.'
                      }
                    />
                  </label>
                  <div class="flex flex-wrap gap-2">
                    <button
                      type="submit"
                      name="outcome"
                      value={
                        action.stepCode === 'secretary_review'
                          ? 'forward'
                          : 'approve'
                      }
                      class="bg-mint-300 hover:bg-mint-400 rounded-lg px-4 py-2 text-sm font-bold text-neutral-800 transition"
                    >
                      {action.stepCode === 'secretary_review'
                        ? 'Forward to the President'
                        : 'Approve'}
                    </button>
                    <button
                      type="submit"
                      name="outcome"
                      value={
                        action.stepCode === 'secretary_review'
                          ? 'return'
                          : 'reject'
                      }
                      class="rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-700 transition hover:bg-red-50 dark:border-red-900 dark:text-red-300 dark:hover:bg-red-950"
                    >
                      {action.stepCode === 'secretary_review'
                        ? 'Return for correction'
                        : 'Reject'}
                    </button>
                  </div>
                  <input
                    type="hidden"
                    name="intent"
                    value={
                      action.stepCode === 'secretary_review'
                        ? 'review'
                        : 'decide'
                    }
                  />
                </>
              )}
            </form>
          ))}
        </section>
      )
    }

    {
      canSeeDocuments && checklist.length > 0 && (
        <section
          class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950"
          id="documents"
        >
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
              Documents
            </h2>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">
              {documentsComplete
                ? 'Every required document has been verified.'
                : `${requiredOutstanding} required ${
                    requiredOutstanding === 1 ? 'document is' : 'documents are'
                  } not yet verified.`}
            </p>
          </div>

          {[...documentsBySubject].map(([subject, entries]) => (
            <div class="mt-5">
              <h3 class="text-sm font-medium text-neutral-700 dark:text-neutral-200">
                {SUBJECT_LABELS[subject] ?? subject}
              </h3>
              <ul class="mt-2 space-y-3">
                {entries.map(entry => (
                  <li class="rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                      <span class="font-medium text-neutral-800 dark:text-neutral-100">
                        {entry.documentName}
                      </span>
                      <span
                        class={`rounded px-1.5 py-0.5 text-xs ${DOCUMENT_STATE_CLASSES[entry.state]}`}
                      >
                        {DOCUMENT_STATE_LABELS[entry.state]}
                      </span>
                      {entry.requirement === 'required' ? (
                        <span class="text-xs text-neutral-500 dark:text-neutral-400">
                          required
                        </span>
                      ) : (
                        <span class="text-xs text-neutral-500 dark:text-neutral-400">
                          optional
                        </span>
                      )}
                    </div>

                    {entry.uploadedAt && (
                      <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                        {entry.fileName} · filed by {entry.uploadedByName} on{' '}
                        {dateFormat.format(entry.uploadedAt)}
                        {entry.versionCount > 1 &&
                          ` · version ${entry.versionCount}`}
                        {entry.verifiedByName &&
                          ` · verified by ${entry.verifiedByName}`}
                        {entry.expiresAt &&
                          ` · expires ${dateFormat.format(entry.expiresAt)}`}
                      </p>
                    )}

                    {entry.rejectionReason && (
                      <p class="mt-2 rounded-lg border border-red-300 px-3 py-2 text-sm text-red-800 dark:border-red-900 dark:text-red-200">
                        Rejected: {entry.rejectionReason}
                      </p>
                    )}

                    {canUpload && (
                      <div
                        class="mt-3 flex flex-wrap items-end gap-3"
                        data-upload
                        data-application-id={application!.id}
                        data-document-type-id={entry.documentTypeId}
                        data-subject={entry.subject}
                        data-tracks-expiry={entry.tracksExpiry ? 'yes' : 'no'}
                      >
                        {entry.tracksExpiry && (
                          <label class="text-xs text-neutral-600 dark:text-neutral-300">
                            Expires on
                            <input
                              type="date"
                              data-expires
                              class="mt-1 block rounded-lg border border-neutral-300 bg-white px-2 py-1 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                            />
                          </label>
                        )}
                        <label class="cursor-pointer rounded-lg border border-neutral-300 px-3 py-1.5 text-sm font-medium text-neutral-700 transition hover:bg-neutral-200 dark:border-neutral-600 dark:text-neutral-200 dark:hover:bg-neutral-800">
                          {entry.state === 'missing' ? 'Upload' : 'Replace'}
                          {/* The native control writes its own "no file
                              chosen" text in the browser's language, which on
                              a French-locale device puts French in an English
                              app. Hidden, and driven by this label instead. */}
                          <input
                            type="file"
                            data-file
                            accept={ACCEPTED_FILES}
                            capture="environment"
                            disabled
                            class="sr-only"
                          />
                        </label>
                        <p
                          data-status
                          class="text-xs text-neutral-500 dark:text-neutral-400"
                        >
                          Uploading requires JavaScript.
                        </p>
                      </div>
                    )}

                    {canVerify &&
                      (entry.state === 'under_review' ||
                        entry.state === 'uploaded') && (
                        <form method="post" class="mt-3 space-y-2">
                          <input
                            type="hidden"
                            name="documentId"
                            value={entry.documentId}
                          />
                          <input
                            type="text"
                            name="reason"
                            placeholder="Reason — required if you reject this document"
                            class="w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                          />
                          <div class="flex flex-wrap gap-2">
                            <button
                              type="submit"
                              name="intent"
                              value="verify-document"
                              class="bg-mint-300 hover:bg-mint-400 rounded-lg px-3 py-1.5 text-sm font-bold text-neutral-800 transition"
                            >
                              Verify
                            </button>
                            <button
                              type="submit"
                              name="intent"
                              value="reject-document"
                              class="rounded-lg border border-red-300 px-3 py-1.5 text-sm font-medium text-red-700 transition hover:bg-red-50 dark:border-red-900 dark:text-red-300 dark:hover:bg-red-950"
                            >
                              Reject
                            </button>
                          </div>
                        </form>
                      )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )
    }

    {
      history.length > 0 && (
        <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
          <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
            History
          </h2>
          <ol class="mt-4 space-y-3">
            {history.map(entry => (
              <li class="border-l-2 border-neutral-300 pl-3 text-sm dark:border-neutral-700">
                <div class="flex flex-wrap items-center gap-x-2">
                  <span class="font-medium text-neutral-800 dark:text-neutral-100">
                    {entry.fromStatus ?? 'created'} → {entry.toStatus}
                  </span>
                  {entry.actorRole && (
                    <span class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
                      {entry.actorRole}
                    </span>
                  )}
                  <span class="text-xs text-neutral-500 dark:text-neutral-400">
                    {entry.actorName} · {dateFormat.format(entry.occurredAt)}
                  </span>
                </div>
                {entry.comment && (
                  <p class="mt-1 text-neutral-600 dark:text-neutral-300">
                    {entry.comment}
                  </p>
                )}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <form method="post" id="capture-form" class="space-y-6">
      {
        subjects.map(subject => {
          const values = valuesFor(subject);
          const missing = new Set(
            blocking.filter(b => b.subject === subject).map(b => b.fieldKey)
          );
          return (
            <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
              <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
                {SUBJECT_LABELS[subject] ?? subject}
              </h2>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {(fields.get(subject) ?? []).map(field => {
                  const name = `field.${subject}.1.${field.fieldKey}`;
                  const value = values[field.fieldKey] ?? '';
                  return (
                    <label class="text-sm text-neutral-600 dark:text-neutral-300">
                      <span>
                        {field.label}
                        {field.isMandatory && (
                          <span
                            class="text-red-600 dark:text-red-400"
                            aria-hidden="true"
                          >
                            {' '}
                            *
                          </span>
                        )}
                      </span>
                      {field.dataType === 'choice' ? (
                        <select
                          name={name}
                          disabled={!isEditable}
                          required={field.isMandatory}
                          class:list={[
                            'mt-1 w-full rounded-lg border bg-white px-3 py-1.5 text-sm dark:bg-neutral-900 dark:text-neutral-100',
                            missing.has(field.fieldKey)
                              ? 'border-red-400 dark:border-red-700'
                              : 'border-neutral-300 dark:border-neutral-600',
                          ]}
                        >
                          <option value="">—</option>
                          {field.choices.map(choice => (
                            <option value={choice} selected={choice === value}>
                              {choice}
                            </option>
                          ))}
                        </select>
                      ) : (
                        <input
                          type={inputTypeFor(field.dataType)}
                          name={name}
                          value={value}
                          disabled={!isEditable}
                          required={field.isMandatory}
                          placeholder={
                            field.dataType === 'phone' ? '5789 1234' : undefined
                          }
                          class:list={[
                            'mt-1 w-full rounded-lg border bg-white px-3 py-1.5 text-sm dark:bg-neutral-900 dark:text-neutral-100',
                            missing.has(field.fieldKey)
                              ? 'border-red-400 dark:border-red-700'
                              : 'border-neutral-300 dark:border-neutral-600',
                          ]}
                        />
                      )}
                    </label>
                  );
                })}
              </div>
            </section>
          );
        })
      }

      {
        isEditable && (
          <div class="flex flex-wrap items-center gap-3">
            <button
              type="submit"
              name="intent"
              value="save"
              class="bg-mint-300 hover:bg-mint-400 rounded-lg px-4 py-2 text-sm font-bold text-neutral-800 transition"
            >
              Save draft
            </button>
            <span
              id="autosave-status"
              class="text-xs text-neutral-500 dark:text-neutral-400"
              aria-live="polite"
            />
          </div>
        )
      }
    </form>

    {
      isDeletableDraft && (
        <section class="rounded-2xl border border-neutral-200 p-6 dark:border-neutral-800">
          <h2 class="text-sm font-medium text-neutral-800 dark:text-neutral-100">
            Delete this draft
          </h2>
          <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
            Removes everything captured on it and any documents filed against
            it. This cannot be undone.
          </p>
          <form method="post" class="mt-4" data-confirm-delete>
            <button
              type="submit"
              name="intent"
              value="delete"
              class="rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-700 transition hover:bg-red-50 dark:border-red-900 dark:text-red-300 dark:hover:bg-red-950"
            >
              Delete draft {application!.reference}
            </button>
          </form>
        </section>
      )
    }
  </div>
</DashboardLayout>

<script>
  // S-302, decision 14: an officer on a tablet must not lose work to a dropped
  // connection. The explicit Save draft button is the guarantee — this only
  // reduces how much a lapse costs, so the page works identically with
  // JavaScript switched off.
  // S-403, S-404 · Filing a document from the device.
  //
  // The bytes go from here straight to Microsoft, over a short-lived URL the
  // backend obtained for this one file in this one folder (see
  // docs/documents.md, decision of 26 August 2026). They never pass through
  // this application, which is what makes a 12 MB photograph of an identity
  // card possible at all: the platform's request body limit is about 4.5 MB.
  //
  // The upload therefore cannot work without scripting, which is why the file
  // input starts disabled with an explanation, and is enabled here.
  for (const panel of document.querySelectorAll<HTMLElement>('[data-upload]')) {
    const file = panel.querySelector<HTMLInputElement>('[data-file]');
    const expiry = panel.querySelector<HTMLInputElement>('[data-expires]');
    const status = panel.querySelector<HTMLElement>('[data-status]');
    if (!file || !status) continue;

    file.disabled = false;
    status.textContent = '';

    const say = (message: string) => {
      status.textContent = message;
    };

    file.addEventListener('change', async () => {
      const chosen = file.files?.[0];
      if (!chosen) return;

      if (panel.dataset.tracksExpiry === 'yes' && !expiry?.value) {
        say('Enter the expiry date first — this document type expires.');
        file.value = '';
        return;
      }

      file.disabled = true;
      say('Preparing…');

      try {
        // Phase one. The backend decides where this goes and whether it is
        // allowed at all; all this sends is what the file is.
        const begun = await fetch('/api/v1/documents/begin-upload', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            applicationId: panel.dataset.applicationId,
            documentTypeId: panel.dataset.documentTypeId,
            subject: panel.dataset.subject,
            fileName: chosen.name,
            contentType: chosen.type,
            sizeBytes: chosen.size,
            ...(expiry?.value ? { expiresAt: expiry.value } : {}),
          }),
        });
        const begunBody = await begun.json();
        if (!begun.ok) {
          throw new Error(
            begunBody?.error?.message ?? 'The upload was refused.'
          );
        }
        const { versionId, uploadUrl, chunkSize } = begunBody.data;

        // Phase two: the transfer. In chunks, because the connection in a
        // regional office is the least reliable part of this, and a chunk that
        // fails costs one chunk rather than the whole photograph.
        for (let start = 0; start < chosen.size; start += chunkSize) {
          const end = Math.min(start + chunkSize, chosen.size);
          const response = await fetch(uploadUrl, {
            method: 'PUT',
            headers: {
              'content-range': `bytes ${start}-${end - 1}/${chosen.size}`,
            },
            body: chosen.slice(start, end),
          });
          if (!response.ok && response.status !== 202) {
            throw new Error(`The transfer failed (${response.status}).`);
          }
          say(`Sending… ${Math.round((end / chosen.size) * 100)}%`);
        }

        // Phase three. Our word that the transfer finished is not what files
        // the document — the backend asks SharePoint.
        say('Confirming…');
        const committed = await fetch('/api/v1/documents/commit-upload', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ versionId }),
        });
        const commitBody = await committed.json();
        if (!committed.ok) {
          throw new Error(
            commitBody?.error?.message ?? 'The file could not be confirmed.'
          );
        }

        // Reload rather than patch the row: the checklist state, the version
        // count and whether the Secretary may now act all come from the
        // server, and guessing them here is how a screen starts disagreeing
        // with the record.
        window.location.reload();
      } catch (error) {
        say(error instanceof Error ? error.message : 'The upload failed.');
        file.disabled = false;
        file.value = '';
      }
    });
  }

  // Deleting a draft cannot be undone, so ask. Without JavaScript the button
  // simply deletes: a confirmation is a courtesy, and a control that only
  // works with scripting would not be.
  document
    .querySelector<HTMLFormElement>('form[data-confirm-delete]')
    ?.addEventListener('submit', event => {
      if (
        !window.confirm(
          'Delete this draft? Everything captured on it, and any documents ' +
            'filed against it, will be removed. This cannot be undone.'
        )
      ) {
        event.preventDefault();
      }
    });

  const form = document.getElementById(
    'capture-form'
  ) as HTMLFormElement | null;
  const status = document.getElementById('autosave-status');

  if (form && status) {
    let dirty = false;
    let inFlight = false;

    form.addEventListener('input', () => {
      dirty = true;
    });

    const save = async () => {
      if (!dirty || inFlight) return;
      inFlight = true;
      const body = new FormData(form);
      body.set('intent', 'autosave');

      try {
        const response = await fetch(window.location.pathname, {
          method: 'POST',
          body,
          headers: { 'x-requested-with': 'autosave' },
        });
        if (!response.ok) throw new Error(String(response.status));
        dirty = false;
        status.textContent = `Saved at ${new Date().toLocaleTimeString('en-GB')}`;
      } catch {
        // Saying "saved" when nothing was saved is the one thing this must
        // never do: the officer would close the tablet trusting it.
        status.textContent =
          'Not saved — check your connection, or press Save draft.';
      } finally {
        inFlight = false;
      }
    };

    setInterval(save, 20_000);
    // Leaving the page or switching away is exactly when work is lost.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') void save();
    });
  }
</script>
