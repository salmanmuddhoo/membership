---
// Starting an application (S-301, S-302).
//
// This page has no application behind it, and that is the point. Opening the
// capture form is not starting an application: an officer who taps Capture,
// realises it is the wrong applicant and closes the tab leaves nothing behind
// — no reference spent, no row in the list, no draft for somebody to delete.
//
// The application comes into existence on the first save that carries a value,
// and from then on the officer is working on /applications/<id> without having
// been interrupted to get there.
import ApplicationTimeline from '@components/ApplicationTimeline.astro';
import CaptureFields from '@components/CaptureFields.astro';
import DashboardLayout from '@layouts/DashboardLayout.astro';
import {
  ApplicationError,
  startApplicationWithValues,
  visibleFields,
  type PartyValues,
} from '@lib/applications/capture';
import { applicationTimeline } from '@lib/applications/timeline';
import {
  checklistForMembershipType,
  listMembershipTypes,
} from '@lib/config/reference';

const principal = Astro.locals.principal!;
if (!principal.permissions.has('application.capture')) {
  return Astro.redirect('/denied');
}

const requested = Astro.url.searchParams.get('type') ?? '';
const types = await listMembershipTypes();
const type = types.find(t => t.code === requested && t.isActive);
if (!type) {
  // Nothing to capture into. Back to the list, where the choice is made.
  return Astro.redirect('/applications');
}

const fields = visibleFields(type);
const subjects = [...fields.keys()];

// Nothing is captured yet, so this is the timeline's opening position rather
// than a read of a real record: every mandatory field counts as outstanding,
// and — since no document row exists until something is filed against it —
// so does every required document the configuration asks for. Getting the
// documents count right matters: 0 would read as "nothing outstanding",
// which is done, not empty, and would tick that step off before capture is
// even finished. It does not update as the officer types — the id page they
// reach on Next is where the live version lives — but it is the same roadmap
// from the first keystroke.
const mandatoryFieldsTotal = [...fields.values()]
  .flat()
  .filter(f => f.isMandatory).length;
const requiredDocumentsTotal = [
  ...(await checklistForMembershipType(type.code)).values(),
]
  .flat()
  .filter(item => item.requirement === 'required').length;
// Every field and document reads as outstanding here (see above), which
// would otherwise mark Applicant details red before the officer has typed a
// single character — nothing has actually been attempted yet, so nothing
// here is a problem yet either. That only becomes true once there is a real
// application to fall short on, which is what the id page's own read of
// `applicationTimeline` is for.
const timeline = applicationTimeline({
  status: 'draft',
  mandatoryFieldsOutstanding: mandatoryFieldsTotal,
  signedFormFiled: false,
  requiredDocumentsOutstanding: requiredDocumentsTotal,
  paymentRecorded: false,
}).map(({ problem: _problem, ...step }) => step);

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const isAutosave = String(form.get('intent') ?? '') === 'autosave';

  const parties: PartyValues[] = subjects.map(subject => {
    const values: Record<string, string> = {};
    for (const field of fields.get(subject) ?? []) {
      values[field.fieldKey] = String(
        form.get(`field.${subject}.1.${field.fieldKey}`) ?? ''
      );
    }
    return { subject, ordinal: 1, values };
  });

  try {
    const created = await startApplicationWithValues(type.code, parties, {
      userId: principal.userId,
      email: principal.email,
    });

    if (!created) {
      // Nothing was typed, so nothing was created. The autosave is told as
      // much and stops reporting a save that did not happen.
      if (isAutosave) {
        return new Response(JSON.stringify({ created: false }), {
          headers: { 'content-type': 'application/json' },
        });
      }
      error = 'Fill in at least one detail before saving.';
    } else if (isAutosave) {
      // The officer keeps typing. The client moves the address bar to the
      // application that now exists, so a refresh — or a dropped connection
      // — lands on the real thing rather than back here.
      return new Response(
        JSON.stringify({
          created: true,
          id: created.id,
          reference: created.reference,
          savedAt: created.savedAt.toISOString(),
          problems: created.problems,
        }),
        { headers: { 'content-type': 'application/json' } }
      );
    } else {
      return Astro.redirect(`/applications/${created.id}`);
    }
  } catch (err) {
    if (err instanceof ApplicationError) {
      error = err.message;
    } else {
      console.error('[applications/new]', err);
      error = 'Something went wrong. Please try again.';
    }
    if (isAutosave) {
      return new Response(JSON.stringify({ error }), {
        status: 500,
        headers: { 'content-type': 'application/json' },
      });
    }
  }
}
---

<DashboardLayout
  title={`New ${type.name} application · Al Barakah MCSL`}
  heading={`New ${type.name} application`}
>
  <div class="mx-auto max-w-4xl space-y-6">
    <ApplicationTimeline steps={timeline} />

    <a
      href="/applications"
      class="inline-block text-sm text-neutral-500 underline dark:text-neutral-400"
      >← All applications</a
    >

    {
      error && (
        <div class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
          {error}
        </div>
      )
    }

    <form method="post" id="capture-form" class="space-y-6">
      <CaptureFields fields={fields} parties={[]} />

      <div class="flex flex-wrap items-center gap-3">
        {
          /* Hidden until the script below un-hides it, so a reader with
            scripting off never sees an inert button — they get the noscript
            one, which works by being a real form submission. */
        }
        <button
          type="button"
          id="next-button"
          hidden
          class="bg-mint-300 hover:bg-mint-400 rounded-lg px-4 py-2 text-sm font-bold text-neutral-800 transition disabled:cursor-not-allowed disabled:opacity-50"
        >
          Next
        </button>
        <span
          id="autosave-status"
          class="text-xs text-neutral-500 dark:text-neutral-400"
          aria-live="polite">Saved as you type.</span
        >
        {
          /* Next is driven by the script below. Without it, submitting this
            button the ordinary way saves and moves on in one step, which is
            the same thing Next does with scripting on. */
        }
        <noscript>
          <button
            type="submit"
            class="bg-mint-300 hover:bg-mint-400 rounded-lg px-4 py-2 text-sm font-bold text-neutral-800 transition"
          >
            Next
          </button>
        </noscript>
      </div>
    </form>
  </div>
</DashboardLayout>

<script>
  // Saving is automatic, so it has to be quick enough that nobody wonders. A
  // short pause after typing stops, a backstop interval, and every way of
  // leaving the page.
  //
  // Until the first value is entered this posts nothing at all: an empty form
  // must not create an application, and a request that would create nothing is
  // a request not worth making.
  const form = document.getElementById(
    'capture-form'
  ) as HTMLFormElement | null;
  const status = document.getElementById('autosave-status');
  const nextButton = document.getElementById(
    'next-button'
  ) as HTMLButtonElement | null;

  if (form && status) {
    let dirty = false;
    let pending: number | undefined;
    // Set the moment the first save creates the application. Once this is
    // known, a later response is judged only by whether the request
    // succeeded — not by re-checking `created`/`reference`, which this same
    // endpoint stops returning after the application exists. Getting that
    // wrong before left every save after the first quietly unable to report
    // itself, though the data was still being saved underneath.
    let applicationId: string | null = null;

    const anythingEntered = () =>
      [...new FormData(form).entries()].some(
        ([key, value]) =>
          key.startsWith('field.') && String(value).trim() !== ''
      );

    const performSave = async () => {
      const body = new FormData(form);
      body.set('intent', 'autosave');

      try {
        const response = await fetch(
          window.location.pathname + window.location.search,
          {
            method: 'POST',
            body,
            headers: { 'x-requested-with': 'autosave' },
          }
        );
        if (!response.ok) throw new Error(String(response.status));

        const result = await response.json();

        if (!applicationId) {
          // Nothing existed before this save, so this response is the one
          // that says whether it does now.
          if (!result.created) return;
          applicationId = result.id;

          // From here on this IS an application. replaceState rather than a
          // navigation: the officer is mid-word, and reloading the page under
          // them to show a heading they did not ask for is not worth the
          // interruption. window.location updates with it, so the next save
          // above posts to /applications/<id> rather than back here.
          window.history.replaceState({}, '', `/applications/${result.id}`);
          status.textContent = `${result.reference} saved at ${new Date().toLocaleTimeString('en-GB')}`;
        } else {
          status.textContent = `Saved at ${new Date().toLocaleTimeString('en-GB')}`;
        }

        dirty = false;
      } catch {
        // Saying "saved" when nothing was saved is the one thing this must
        // never do: the officer would close the tablet trusting it.
        status.textContent = 'Not saved — check your connection.';
      }
    };

    // Dispatches a save and makes every caller genuinely wait for it. A plain
    // "in flight" boolean used to let a second caller — Next, arriving right
    // behind focusout's own un-awaited save — walk straight past a save
    // already running with nothing to await, so Next navigated before that
    // save's fetch had finished and the browser could cancel it mid-flight.
    // That is how a field filled in a moment before Next was clicked (a
    // Nominee detail, say) went unsaved. Chaining onto the in-flight promise
    // instead means a caller that arrives mid-save waits for it to land, then
    // saves again if something changed in the meantime, rather than skipping
    // its turn.
    let saveInFlight: Promise<void> | null = null;
    const save = (): Promise<void> => {
      if (saveInFlight) return saveInFlight.then(save);
      if (!dirty || !anythingEntered()) return Promise.resolve();
      saveInFlight = performSave().finally(() => {
        saveInFlight = null;
      });
      return saveInFlight;
    };

    form.addEventListener('input', () => {
      dirty = true;
      window.clearTimeout(pending);
      pending = window.setTimeout(save, 2_000);
    });
    form.addEventListener('focusout', () => void save());
    window.setInterval(save, 20_000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') void save();
    });

    if (nextButton) {
      nextButton.hidden = false;

      nextButton.addEventListener('click', async () => {
        window.clearTimeout(pending);
        nextButton.disabled = true;

        // Flushes whatever is still unsaved. If the application already
        // exists and nothing changed since the last save, this is a no-op —
        // save() itself checks `dirty`.
        await save();

        if (applicationId) {
          // A real navigation, not replaceState: the officer asked to move
          // on, and /applications/<id> is a different page — documents,
          // submission, the timeline — that this one was never going to grow
          // into.
          window.location.assign(`/applications/${applicationId}`);
          return;
        }

        nextButton.disabled = false;
        if (!anythingEntered()) {
          status.textContent = 'Add at least one detail before continuing.';
        }
        // Otherwise save() already explained itself (e.g. a dropped
        // connection), and that message should stand rather than being
        // overwritten here.
      });
    }
  }
</script>
