---
// The printable application form (S-401).
//
// Rendered from the membership type's field configuration, not from a fixed
// template — so a field an administrator adds in M2 appears on the printed
// form without a release, which is the whole reason the configuration exists.
//
// A field with no value prints as a ruled blank rather than being left out.
// The applicant is sitting there with a pen: a form that silently omits what
// was not captured gives them nothing to complete.
import BaseLayout from '@layouts/BaseLayout.astro';
import { loadApplication, visibleFields } from '@lib/applications/capture';
import { listMembershipTypes, type FieldSubject } from '@lib/config/reference';
import { SIGNATURES } from '@lib/documents/documents';

const { id } = Astro.params;
const application = id ? await loadApplication(id) : null;
if (!application) return new Response('Not found', { status: 404 });
// S-613: printed forms exist for a flow that actually captures applicant
// fields — an additional-account application (opening an extra account for
// an existing member) has none, so there is nothing here to print. A
// customer_account application (S-614: a non-member opening an account of
// their own) captures exactly the same way a membership application does,
// against the same field configuration, so it prints the same way too
// (S-614, phase 8 — this page used to refuse it, on the reasoning that the
// flow had no print step; it does now).
if (
  application.applicationKind !== 'membership' &&
  application.applicationKind !== 'customer_account'
) {
  return new Response('Not found', { status: 404 });
}
const isAccountApplication = application.applicationKind === 'customer_account';
// Where Back and Next lead: customer.astro mirrors this page's own step
// numbering exactly (capture=1, print=2, documents=3) for this reason, so
// only the base path differs between the two kinds.
const basePath = isAccountApplication
  ? `/applications/${application.id}/customer`
  : `/applications/${application.id}`;

const type = (await listMembershipTypes()).find(
  t => t.id === application.membershipTypeId
)!;
const fields = visibleFields(type);

const valuesFor = (subject: FieldSubject) =>
  application.parties.find(p => p.subject === subject && p.ordinal === 1)
    ?.values ?? {};

const SUBJECT_LABELS: Record<string, string> = {
  applicant: 'Applicant',
  nominee: 'Nominee',
  guardian: 'Parent / Guardian',
  beneficiary: 'Takaful beneficiary',
};

// An unsigned print of a draft must not be mistaken for the real thing.
const isDraft = application.status === 'draft';

// Step 2 of the capture wizard (docs/applications.md): this page IS that
// step, not a separate one that mirrors it — the officer lands here on Next
// from capture and leaves on Next here, straight to filing documents. Only
// while the application is still the officer's to work on; once submitted,
// this is just the print view again; whoever opens it, the printed page
// itself carries no wizard chrome.
const isEditable =
  application.status === 'draft' || application.status === 'returned';

const dateFormat = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<BaseLayout title={`${application.reference} · Application form`}>
  <div class="print-page">
    {isDraft && <div class="watermark">DRAFT</div>}

    <header class="head">
      <div>
        <h1>Al Barakah MCSL</h1>
        <p class="sub">
          {
            isAccountApplication
              ? `Account application — ${type.name}`
              : `Application for Membership — ${type.name}`
          }
        </p>
      </div>
      <div class="ref">
        <p><strong>{application.reference}</strong></p>
        <p>{dateFormat.format(application.updatedAt)}</p>
      </div>
    </header>

    {
      [...fields].map(([subject, subjectFields]) => {
        const values = valuesFor(subject);
        return (
          <section class="block">
            <h2>{SUBJECT_LABELS[subject] ?? subject}</h2>
            <dl>
              {subjectFields.map(field => {
                const value = (values[field.fieldKey] ?? '').trim();
                return (
                  <div class="row">
                    <dt>
                      {field.label}
                      {field.isMandatory && <span class="req">*</span>}
                    </dt>
                    <dd class={value ? '' : 'blank'}>{value}</dd>
                  </div>
                );
              })}
            </dl>
          </section>
        );
      })
    }

    <section class="declaration block">
      <h2>Declaration</h2>
      <p>
        {
          isAccountApplication
            ? 'I declare that the information given above is true and complete to the best of my knowledge. I have read and accept the terms governing this account and the rules and by-laws of Al Barakah Multipurpose Co-operative Society Limited, and I undertake to abide by them. I understand that any information found to be false may result in my application being refused or the account being closed.'
            : 'I declare that the information given above is true and complete to the best of my knowledge. I have read and accept the rules and by-laws of Al Barakah Multipurpose Co-operative Society Limited, and I undertake to abide by them. I understand that any information found to be false may result in my application being refused or my membership terminated.'
        }
      </p>
    </section>

    <section class="block">
      {
        isEditable && (
          <p class="sig-help no-print">
            Tap Sign under each name, or print and sign by hand.
          </p>
        )
      }
      <div class="signatures">
        {
          SIGNATURES.map(who => (
            <div class="sig">
              <div class="sig-pad" data-sig-pad data-sig-who={who}>
                <div class="sig-line" />
                <img class="sig-image" data-sig-image alt="" hidden />
              </div>
              {isEditable && (
                <div class="sig-controls no-print">
                  <button type="button" data-sig-open>
                    Sign
                  </button>
                  <button type="button" data-sig-clear-image hidden>
                    Clear
                  </button>
                </div>
              )}
              <p class="sig-name">{who}</p>
              <p class="sig-date">Name and date</p>
              <div class="sig-line short" />
            </div>
          ))
        }
      </div>
    </section>

    {
      isEditable && (
        // Fixed to the actual screen, not to anything in this page's own
        // millimetre-based layout — that layout is built for the paper this
        // becomes, not a phone, and does not fit one, which is exactly why
        // signing directly inside it used to drag the whole page around
        // under a finger instead of drawing. A modal sized to the real
        // viewport cannot inherit a scroll or a pinch-zoom state that isn't
        // its own.
        <div id="sig-modal" class="sig-modal no-print" hidden>
          <div class="sig-modal-bar">
            <span data-sig-modal-title>Sign</span>
            <button type="button" data-sig-modal-close>
              Cancel
            </button>
          </div>
          <canvas class="sig-modal-canvas" data-sig-modal-canvas />
          <div class="sig-modal-bar">
            <button type="button" data-sig-modal-clear>
              Clear
            </button>
            <button type="button" data-sig-modal-done class="primary">
              Use this signature
            </button>
          </div>
        </div>
      )
    }

    <div class="actions">
      <button type="button" id="print">Print</button>
      {
        isEditable ? (
          <>
            <a href={`${basePath}?step=1`}>← Back</a>
            <a href={`${basePath}?step=3`} class="next">
              Next: upload documents →
            </a>
          </>
        ) : (
          <a href={basePath}>Back to the application</a>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* Deliberately plain and self-contained. This sheet is printed, handed to a
     person and signed, so it is set in absolute units against white — not in
     the application's theme, which follows the reader's dark mode and would
     print an unreadable page. */
  .print-page {
    position: relative;
    max-width: 190mm;
    margin: 0 auto;
    padding: 12mm 10mm;
    background: #fff;
    color: #111;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 11pt;
    line-height: 1.45;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10mm;
    border-bottom: 2px solid #111;
    padding-bottom: 4mm;
  }
  h1 {
    margin: 0;
    font-size: 16pt;
    letter-spacing: 0.02em;
  }
  .sub {
    margin: 1mm 0 0;
    font-size: 11pt;
  }
  .ref {
    text-align: right;
    font-size: 10pt;
  }
  .ref p {
    margin: 0;
  }

  .block {
    margin-top: 7mm;
    break-inside: avoid;
  }
  h2 {
    margin: 0 0 3mm;
    font-size: 11pt;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px solid #999;
    padding-bottom: 1mm;
  }

  dl {
    margin: 0;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 4mm;
    padding: 1.6mm 0;
  }
  dt {
    flex: 0 0 55mm;
    font-size: 10pt;
    color: #333;
  }
  .req {
    color: #333;
  }
  dd {
    flex: 1;
    margin: 0;
    min-height: 6mm;
    border-bottom: 1px solid #bbb;
  }
  /* An empty field prints as a ruled line to write on, never as nothing. */
  .blank {
    border-bottom: 1px solid #444;
  }

  .declaration p {
    margin: 0;
    text-align: justify;
  }

  .signatures {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10mm 12mm;
    margin-top: 4mm;
  }
  .sig {
    break-inside: avoid;
  }
  .sig-line {
    height: 14mm;
    border-bottom: 1px solid #444;
  }
  .sig-line.short {
    height: 8mm;
  }
  .sig-name {
    margin: 1mm 0 0;
    font-size: 10pt;
    font-weight: bold;
  }
  .sig-date {
    margin: 3mm 0 0;
    font-size: 9pt;
    color: #555;
  }

  .sig-help {
    margin: 0 0 3mm;
    font-family: system-ui, sans-serif;
    font-size: 9pt;
    color: #666;
  }
  /* The line stays underneath as the fallback a pen can still use — without
     scripting, or once the box below carries a signature, this is what
     Print (and Save as PDF) actually sees. */
  .sig-pad {
    position: relative;
    height: 14mm;
  }
  .sig-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Whatever aspect ratio the signing box drew at, contained rather than
       stretched — a squashed signature is a strange thing to hand someone. */
    object-fit: contain;
    object-position: left center;
  }
  .sig-controls {
    margin-top: 1mm;
    display: flex;
    gap: 2mm;
  }
  .sig-controls button {
    padding: 0.5mm 2mm;
    border: 1px solid #999;
    background: #f5f5f5;
    font: inherit;
    font-size: 8pt;
    cursor: pointer;
  }

  /* Fixed to the real viewport (see the comment above the markup), not to
     this page's own layout — sized in ordinary CSS units, not the
     millimetres the rest of this sheet uses for paper. Two heights: a
     browser that does not know `dvh` keeps the first and ignores the
     second, one that does gets the one that actually tracks a mobile
     browser's own address bar showing or hiding, rather than assuming the
     larger figure and running the bars below the visible screen. */
  .sig-modal {
    position: fixed;
    inset: 0;
    height: 100vh;
    height: 100dvh;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    background: #fff;
    color: #111;
    font-family: system-ui, sans-serif;
    /* Scrollable, not clipped: belt and braces against the same thing the
       two heights above already guard against — if a bar ever still ends
       up outside the visible area, the officer can reach it by scrolling
       the box itself rather than being unable to reach it at all. Only the
       canvas below blocks touch, and only there, since a drag meant for
       the pen reaching past it and moving the page is what this guards
       against — the bars need every tap to reach the button underneath it,
       plainly, the first time. */
    overflow-y: auto;
  }
  .sig-modal[hidden] {
    display: none;
  }
  .sig-modal-bar {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3mm;
    padding: 3mm 4mm;
    font-size: 11pt;
    border-bottom: 1px solid #ddd;
  }
  .sig-modal-bar:last-child {
    border-bottom: none;
    border-top: 1px solid #ddd;
  }
  .sig-modal-canvas {
    flex: 1;
    min-height: 40vh;
    width: 100%;
    touch-action: none;
    cursor: crosshair;
  }
  .sig-modal button {
    padding: 2mm 4mm;
    border: 1px solid #333;
    background: #eee;
    font: inherit;
    cursor: pointer;
    color: #111;
  }
  .sig-modal button.primary {
    background: #cdeedb;
    font-weight: bold;
  }

  .watermark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 90pt;
    font-weight: bold;
    color: rgba(0, 0, 0, 0.08);
    transform: rotate(-30deg);
    pointer-events: none;
    letter-spacing: 0.1em;
  }

  .actions {
    margin-top: 8mm;
    display: flex;
    gap: 4mm;
    align-items: center;
    font-family: system-ui, sans-serif;
    font-size: 10pt;
  }
  .actions button,
  .actions a.next {
    padding: 2mm 5mm;
    border: 1px solid #333;
    background: #eee;
    cursor: pointer;
    font: inherit;
    text-decoration: none;
    color: #111;
  }

  @media print {
    /* The controls are for the screen; the paper carries the form. */
    .actions,
    .no-print {
      display: none;
    }
    .print-page {
      max-width: none;
      padding: 0;
    }
    .watermark {
      position: fixed;
      /* Screen opacity disappears on paper, where a draft mark matters most. */
      color: rgba(0, 0, 0, 0.13);
    }
    @page {
      size: A4;
      margin: 14mm;
    }
  }

  /* The sheet above is built in millimetres for the A4 page it becomes,
     which is wider than a phone screen — left alone, the whole page would
     sit wider than the viewport and pan under a finger the same way signing
     used to. Screen-only: none of this touches what actually prints. */
  @media screen and (max-width: 700px) {
    .print-page {
      max-width: 100%;
      padding: 6mm 4mm;
    }
    .head {
      flex-direction: column;
      gap: 2mm;
    }
    .ref {
      text-align: left;
    }
    .row {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5mm;
    }
    dt {
      flex: none;
    }
    .signatures {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.getElementById('print')?.addEventListener('click', () => {
    window.print();
  });

  // Lets whoever is holding the phone or tablet sign on screen instead of
  // only on paper afterward, in one shared full-screen box rather than a
  // canvas living inside this page's own millimetre-wide layout — that
  // layout does not fit a phone, and a drawing surface inside it inherited
  // the same instability: the page panned under a finger trying to sign.
  // Fixed to the viewport, the box cannot inherit a scroll or zoom state
  // that isn't its own. Print (choose "Save as PDF" in the print dialog)
  // carries the result straight into the file the officer uploads on the
  // documents step. The ruled line stays the fallback for an actual pen,
  // which is also what a reader without scripting gets by default.
  const modal = document.getElementById('sig-modal');
  const modalCanvas = document.querySelector<HTMLCanvasElement>(
    '[data-sig-modal-canvas]'
  );
  const modalTitle = document.querySelector('[data-sig-modal-title]');
  const modalClose = document.querySelector('[data-sig-modal-close]');
  const modalClear = document.querySelector('[data-sig-modal-clear]');
  const modalDone = document.querySelector('[data-sig-modal-done]');

  if (
    modal &&
    modalCanvas &&
    modalTitle &&
    modalClose &&
    modalClear &&
    modalDone
  ) {
    const ctx = modalCanvas.getContext('2d');
    let activePad: HTMLElement | null = null;

    // Sized from the box actually on screen, at the device's pixel density
    // so the line does not look soft. Done on open rather than at page
    // load: a [hidden] element measures as zero, so there is nothing to
    // size against before then.
    const sizeCanvas = () => {
      if (!ctx) return;
      const rect = modalCanvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      modalCanvas.width = Math.max(1, Math.round(rect.width * dpr));
      modalCanvas.height = Math.max(1, Math.round(rect.height * dpr));
      ctx.scale(dpr, dpr);
      ctx.lineWidth = 2.5;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.strokeStyle = '#1a1a2e';
    };

    const clearCanvas = () => {
      if (!ctx) return;
      // Reset the transform first: clearRect is drawn in the CURRENT
      // coordinate space, and that space is scaled by dpr above.
      ctx.save();
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, modalCanvas.width, modalCanvas.height);
      ctx.restore();
    };

    let drawing = false;
    let last: { x: number; y: number } | null = null;
    const pointFrom = (e: PointerEvent) => {
      const box = modalCanvas.getBoundingClientRect();
      return { x: e.clientX - box.left, y: e.clientY - box.top };
    };
    modalCanvas.addEventListener('pointerdown', e => {
      e.preventDefault();
      modalCanvas.setPointerCapture(e.pointerId);
      drawing = true;
      last = pointFrom(e);
    });
    modalCanvas.addEventListener('pointermove', e => {
      if (!drawing || !last || !ctx) return;
      const point = pointFrom(e);
      ctx.beginPath();
      ctx.moveTo(last.x, last.y);
      ctx.lineTo(point.x, point.y);
      ctx.stroke();
      last = point;
    });
    const stopDrawing = () => {
      drawing = false;
      last = null;
    };
    modalCanvas.addEventListener('pointerup', stopDrawing);
    modalCanvas.addEventListener('pointercancel', stopDrawing);
    modalCanvas.addEventListener('pointerleave', stopDrawing);

    const closeModal = () => {
      modal.hidden = true;
      activePad = null;
    };

    for (const pad of document.querySelectorAll<HTMLElement>(
      '[data-sig-pad]'
    )) {
      const controls = pad.closest('.sig');
      const openButton =
        controls?.querySelector<HTMLButtonElement>('[data-sig-open]');
      const clearImageButton = controls?.querySelector<HTMLButtonElement>(
        '[data-sig-clear-image]'
      );
      const image = pad.querySelector<HTMLImageElement>('[data-sig-image]');
      if (!openButton || !image) continue;

      openButton.addEventListener('click', () => {
        activePad = pad;
        modalTitle.textContent = `Sign — ${pad.dataset.sigWho ?? ''}`;
        modal.hidden = false;
        requestAnimationFrame(() => {
          sizeCanvas();
          clearCanvas();
        });
      });

      clearImageButton?.addEventListener('click', () => {
        image.hidden = true;
        image.removeAttribute('src');
        openButton.textContent = 'Sign';
        clearImageButton.hidden = true;
      });
    }

    modalClose.addEventListener('click', closeModal);
    modalClear.addEventListener('click', clearCanvas);
    modalDone.addEventListener('click', () => {
      if (!activePad) {
        closeModal();
        return;
      }
      const image =
        activePad.querySelector<HTMLImageElement>('[data-sig-image]');
      const controls = activePad.closest('.sig');
      const openButton =
        controls?.querySelector<HTMLButtonElement>('[data-sig-open]');
      const clearImageButton = controls?.querySelector<HTMLButtonElement>(
        '[data-sig-clear-image]'
      );
      if (image) {
        image.src = modalCanvas.toDataURL('image/png');
        image.hidden = false;
      }
      if (openButton) openButton.textContent = 'Re-sign';
      if (clearImageButton) clearImageButton.hidden = false;
      closeModal();
    });
  }
</script>
