          {due && (
            <form
              method="post"
              class="mt-4 space-y-4"
              data-payment-form
              data-cash-threshold={cashThreshold}
            >
              <table class="w-full text-sm">
                <tbody>
                  {due.components.map(component => (
                    <tr class="border-t border-neutral-200 dark:border-neutral-800">
                      <td class="py-2 text-neutral-600 dark:text-neutral-300">
                        <label for={`amount-${component.accountTypeId}`}>
                          {component.label}
                        </label>
                        {/* This IS the account type's own minimum opening
                            amount — paying more is the payer's own choice
                            and needs no reason; paying less is refused. */}
                        <span class="ml-2 text-xs text-neutral-500 dark:text-neutral-400">
