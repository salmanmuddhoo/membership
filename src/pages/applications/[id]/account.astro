---
// The officer-facing page for an additional-account application (S-613,
// phase 8) — opening an account type an existing member's membership did
// not already open for them.
//
// A separate page from [id].astro, not a retrofit of it (docs/backlog.md,
// phase 3): that page is built entirely around a membership type's field
// configuration and its four-signature form, neither of which this kind
// has. What it needs instead is smaller — there is no applicant to
// capture, so this page opens straight on documents, payment and the
// review chain, the same generic engine (workflow.ts) the membership page
// already drives with zero changes required for this kind (S-612, S-613
// phase 7).
import DashboardLayout from '@layouts/DashboardLayout.astro';
import {
  ApplicationError,
  loadApplication,
  type AdditionalAccountApplication,
} from '@lib/applications/capture';
import {
  availableActions,
  boardReadiness,
  boardReadinessReasons,
  decideApplication,
  reviewApplication,
  reviewStageLabel,
  signoffsFor,
  submitApplication,
  transitionsFor,
} from '@lib/applications/workflow';
import {
  checklistFor,
  isDocumentComplete,
  removeFiledDocument,
  reviewDocument,
  DocumentError,
} from '@lib/documents/documents';
import {
  amountDueForAdditionalAccount,
  paymentsForApplication,
  recordAccountOpeningPayment,
  METHOD_LABELS,
  PAYMENT_METHODS,
  PaymentError,
  type AccountAmountDue,
  type Payment,
  type PaymentMethod,
} from '@lib/payments/payments';
import { formatMoney, fromCents, sumCents } from '@lib/payments/money';
import { openAccountsForApplication } from '@lib/members/create';

const principal = Astro.locals.principal!;
const canSeeDocuments = principal.permissions.has('document.view');
const canUpload = principal.permissions.has('document.upload');
const canVerify = principal.permissions.has('document.verify');
const canSeePayments = principal.permissions.has('payment.view');
const canRecordPayment = principal.permissions.has('payment.record');
const { id } = Astro.params;

// Mirrors [id].astro's own loadMembershipApplication: the application this
// narrowed on the way in never changes kind underneath a reload, so a
// mismatch here is a bug in the wiring, not an ordinary "not found".
async function loadAccountApplication(
  applicationId: string
): Promise<AdditionalAccountApplication | null> {
  const found = await loadApplication(applicationId);
  if (!found) return null;
  if (found.applicationKind !== 'additional_account') {
    throw new Error(
      `Application ${applicationId} is not an additional-account application.`
    );
  }
  return found;
}

let application = id ? await loadAccountApplication(id) : null;
if (!application) return new Response('Not found', { status: 404 });
// A draft is the capturing officer's own work in progress — not something a
// colleague browsing by URL should be able to open before it is submitted.
if (
  application.status === 'draft' &&
  application.capturedBy !== principal.userId
) {
  return new Response('Not found', { status: 404 });
}

let error: string | null = null;
let notice: string | null = null;
let createdAccounts: {
  id: string;
  memberNo: string;
  accounts: { id: string; typeCode: string; typeName: string }[];
} | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'record-payment') {
    try {
      const amounts: Record<string, string> = {};
      for (const [key, value] of form.entries()) {
        if (key.startsWith('amount.')) {
          amounts[key.slice('amount.'.length)] = String(value);
        }
      }

      const payment = await recordAccountOpeningPayment(
        {
          applicationId: application.id,
          method: String(form.get('method') ?? '') as PaymentMethod,
          methodReference: String(form.get('methodReference') ?? ''),
          varianceReason: String(form.get('varianceReason') ?? ''),
          amounts,
        },
        principal
      );
      notice = `Receipt ${payment.receiptNo} recorded.`;
    } catch (err) {
      if (err instanceof PaymentError) {
        error = err.message;
      } else {
        console.error('[applications/account/payments]', err);
        error =
          'The payment could not be recorded. Nothing has been taken — ' +
          'please try again.';
      }
    }
  } else if (intent === 'delete-document') {
    try {
      await removeFiledDocument(
        String(form.get('documentId') ?? ''),
        principal
      );
      notice = 'Document removed. It can be filed again.';
    } catch (err) {
      if (err instanceof DocumentError) {
        error = err.message;
      } else {
        console.error('[applications/account/documents]', err);
        error = 'The document could not be removed. Please try again.';
      }
    }
  } else if (intent === 'verify-document' || intent === 'reject-document') {
    try {
      const outcome = intent === 'verify-document' ? 'verify' : 'reject';
      const result = await reviewDocument(
        String(form.get('documentId') ?? ''),
        { outcome, reason: String(form.get('reason') ?? '') },
        principal
      );
      notice =
        result.state === 'verified'
          ? 'Document verified.'
          : 'Document rejected. The officer who filed it can replace it.';
    } catch (err) {
      if (err instanceof DocumentError) {
        error = err.message;
      } else {
        console.error('[applications/account/documents]', err);
        error = 'The document could not be reviewed. Please try again.';
      }
    }
  } else if (
    intent === 'submit' ||
    intent === 'review' ||
    intent === 'decide'
  ) {
    try {
      if (intent === 'submit') {
        const result = await submitApplication(application.id, principal);
        notice =
          'problems' in result
            ? `This application cannot be submitted yet: ${result.problems.length} ` +
              `item${result.problems.length === 1 ? '' : 's'} still need attention.`
            : 'Submitted for central processing.';
      } else if (intent === 'review') {
        const stepCode = String(form.get('stepCode') ?? 'secretary_review');
        const result = await reviewApplication(
          application.id,
          {
            outcome:
              String(form.get('outcome')) === 'return' ? 'return' : 'forward',
            comment: String(form.get('comment') ?? ''),
          },
          principal,
          stepCode
        );
        notice =
          result.status === 'returned'
            ? 'Returned to the originating staff.'
            : stepCode === 'regional_review'
              ? 'Forwarded for central review.'
              : 'Forwarded to the President.';
      } else {
        const result = await decideApplication(
          application.id,
          {
            outcome:
              String(form.get('outcome')) === 'reject' ? 'reject' : 'approve',
            comment: String(form.get('comment') ?? ''),
          },
          principal,
          openAccountsForApplication
        );
        if (result.signoff) {
          const remaining = result.signoff.required - result.signoff.recorded;
          notice =
            `Sign-off recorded (${result.signoff.recorded} of ` +
            `${result.signoff.required}). Waiting for ${remaining} more ` +
            `${remaining === 1 ? 'decision' : 'decisions'} before this ` +
            `completes.`;
        } else {
          notice = result.member
            ? `Approved. Opened ${result.member.accounts.map(a => a.typeName).join(' and ')} ` +
              `for ${result.member.memberNo}.`
            : 'Rejected and returned to the originating staff.';
          createdAccounts = result.member ?? null;
        }
      }
      application = await loadAccountApplication(application.id);
    } catch (err) {
      if (err instanceof ApplicationError || err instanceof Error) {
        error = err.message;
      }
      if (!(err instanceof ApplicationError)) {
        console.error('[applications/account/workflow]', err);
      }
    }
  }
}

// The reload above (a review/decide action, S-613 phase 7) is the only way
// application could have become null — narrowed here once, rather than a
// non-null assertion on every read below.
if (!application) return Astro.redirect('/applications');

const isDecided =
  application!.status === 'approved' || application!.status === 'rejected';
// Officer feedback: once an application is out of the originating officer's
// hands (status 'new' and beyond), a filed document is a record of what was
// submitted, not something to delete — only 'draft' and 'returned' (sent
// back for exactly this kind of correction) still allow it.
const isEditable =
  application!.status === 'draft' || application!.status === 'returned';

// Everything here depends only on the application itself, so it is read in
// one round of parallel queries rather than one after another — and the
// Board-readiness check below reuses two of these reads instead of
// repeating them.
const [checklist, actions, history, stageLabel, payments, dueRead] =
  await Promise.all([
    checklistFor({ applicationId: application.id }),
    availableActions(application!, principal),
    transitionsFor(application!.id),
    reviewStageLabel(application!),
    paymentsForApplication(application!.id),
    canRecordPayment && !isDecided
      ? amountDueForAdditionalAccount(application!.id).then(
          due => ({ due, problem: null as string | null }),
          (err: unknown) => ({
            due: null as AccountAmountDue | null,
            problem:
              err instanceof PaymentError
                ? err.message
                : 'The amount due could not be read.',
          })
        )
      : Promise.resolve(null),
  ]);
const documentsComplete = checklist.length > 0 && isDocumentComplete(checklist);
const requiredOutstanding = checklist.filter(
  e => e.requirement === 'required' && e.state !== 'verified'
).length;

const REVIEW_STEP_META: Record<
  string,
  {
    intent: 'review' | 'decide';
    forwardOutcome: string;
    forwardLabel: string;
    returnOutcome: string;
    returnLabel: string;
    commentPlaceholder: string;
  }
> = {
  regional_review: {
    intent: 'review',
    forwardOutcome: 'forward',
    forwardLabel: 'Forward for central review',
    returnOutcome: 'return',
    returnLabel: 'Return for correction',
    commentPlaceholder: 'Required if you return this application.',
  },
  secretary_review: {
    intent: 'review',
    forwardOutcome: 'forward',
    forwardLabel: 'Forward to the President',
    returnOutcome: 'return',
    returnLabel: 'Return for correction',
    commentPlaceholder: 'Required if you return this application.',
  },
  president_decision: {
    intent: 'decide',
    forwardOutcome: 'approve',
    forwardLabel: 'Approve',
    returnOutcome: 'reject',
    returnLabel: 'Reject',
    commentPlaceholder: 'Required if you reject this application.',
  },
};

const forwardAction = actions.find(a => a.stepCode === 'secretary_review');
const boardReasons = forwardAction
  ? boardReadinessReasons(
      await boardReadiness(application!, { checklist, payments })
    )
  : [];

const decideAction = actions.find(a => a.stepCode === 'president_decision');
const signoffs =
  decideAction && decideAction.quorumCount > 1
    ? await signoffsFor(application!.id)
    : [];

const DOCUMENT_STATE_LABELS: Record<string, string> = {
  missing: 'Missing',
  uploaded: 'Uploaded',
  under_review: 'Under review',
  verified: 'Verified',
  rejected: 'Rejected',
  expired: 'Expired',
};
const DOCUMENT_STATE_CLASSES: Record<string, string> = {
  missing:
    'bg-neutral-200 text-neutral-700 dark:bg-neutral-700 dark:text-neutral-200',
  uploaded: 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200',
  under_review:
    'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200',
  verified:
    'bg-mint-200 text-neutral-800 dark:bg-mint-900 dark:text-neutral-100',
  rejected: 'bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-200',
  expired: 'bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-200',
};
const ACCEPTED_FILES =
  'image/jpeg,image/png,image/heic,image/heif,application/pdf';

const livePayment: Payment | null =
  payments.find(p => p.kind === 'payment' && !p.voidedAt) ?? null;

// Read above alongside everything else; only shown while nothing has been
// taken yet — once a payment stands, the figure has been settled.
const due: AccountAmountDue | null = livePayment
  ? null
  : (dueRead?.due ?? null);
const dueProblem: string | null = livePayment
  ? null
  : (dueRead?.problem ?? null);
const initialTotal = due
  ? fromCents(sumCents(due.components.map(c => c.amount)))
  : '0';

const STATUS_LABELS: Record<string, string> = {
  draft: 'Draft',
  new: 'New',
  submitted_for_review: 'Submit for Review',
  submitted_for_approval: 'Submit for Approval',
  approved: 'Approved',
  rejected: 'Rejected',
  returned: 'Returned for Correction',
  abeyance: 'Abeyance',
};

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
---

<DashboardLayout
  title={`${application.reference} · Al Barakah MCSL`}
  heading={application.reference}
>
  <div class="mx-auto max-w-5xl space-y-6">
    <a
      href="/applications"
      class="inline-block text-sm text-neutral-500 underline dark:text-neutral-400"
      >← All applications</a
    >

    {
      error && (
        <div class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
          {error}
        </div>
      )
    }
    {
      notice && (
        <div class="border-mint-400 bg-mint-50 dark:border-mint-700 dark:bg-mint-950 rounded-lg border px-4 py-3 text-sm text-neutral-800 dark:text-neutral-100">
          {notice}
        </div>
      )
    }

    {
      createdAccounts && (
        <section class="border-mint-400 bg-mint-50 dark:border-mint-700 dark:bg-mint-950 rounded-2xl border p-6">
          <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
            Account opened
          </h2>
          <p class="mt-1 text-sm text-neutral-700 dark:text-neutral-200">
            <a
              href={`/members/${createdAccounts.id}`}
              class="font-medium underline"
            >
              {createdAccounts.memberNo}
            </a>{' '}
            now holds{' '}
            {createdAccounts.accounts.map(a => a.typeName).join(' and ')}.
          </p>
        </section>
      )
    }

    <section
      class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950"
    >
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2
          class="text-lg font-semibold text-neutral-800 dark:text-neutral-100"
        >
          Opening an account for {application.existingMemberNo}
        </h2>
        <span
          class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300"
        >
          {STATUS_LABELS[application.status] ?? application.status}
        </span>
      </div>
      <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">
        {application.selectedAccountTypes.map(t => t.name).join(' + ')}
      </p>
      {
        application.status === 'new' && stageLabel && (
          <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
            {stageLabel}
          </p>
        )
      }
    </section>

    {
      canSeeDocuments && checklist.length > 0 && (
        <section
          class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950"
          id="documents"
        >
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
              Documents
            </h2>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">
              {documentsComplete
                ? 'Every required document has been verified.'
                : `${requiredOutstanding} required ${
                    requiredOutstanding === 1 ? 'document is' : 'documents are'
                  } not yet verified.`}
            </p>
          </div>

          <ul class="mt-4 space-y-3">
            {checklist.map(entry => (
              <li class="rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
                <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span class="font-medium text-neutral-800 dark:text-neutral-100">
                      {entry.documentName}
                    </span>
                    <span
                      class={`rounded px-1.5 py-0.5 text-xs ${DOCUMENT_STATE_CLASSES[entry.state]}`}
                    >
                      {DOCUMENT_STATE_LABELS[entry.state]}
                    </span>
                    <span class="text-xs text-neutral-500 dark:text-neutral-400">
                      {entry.requirement === 'required'
                        ? 'required'
                        : 'optional'}
                    </span>
                  </div>

                  {canUpload && entry.state === 'missing' && (
                    <div
                      class="flex flex-wrap items-center gap-3"
                      data-upload
                      data-application-id={application.id}
                      data-document-type-id={entry.documentTypeId}
                      data-subject={entry.subject}
                      data-tracks-expiry={entry.tracksExpiry ? 'yes' : 'no'}
                    >
                      {entry.tracksExpiry && (
                        <label class="text-xs text-neutral-600 dark:text-neutral-300">
                          Expires on
                          <input
                            type="date"
                            data-expires
                            class="mt-1 block rounded-lg border border-neutral-300 bg-white px-2 py-1 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                          />
                        </label>
                      )}
                      <label class="cursor-pointer rounded-lg border border-neutral-300 px-3 py-1.5 text-sm font-medium text-neutral-700 transition hover:bg-neutral-200 dark:border-neutral-600 dark:text-neutral-200 dark:hover:bg-neutral-800">
                        Upload
                        <input
                          type="file"
                          data-file
                          accept={ACCEPTED_FILES}
                          capture="environment"
                          disabled
                          class="sr-only"
                        />
                      </label>
                      <p
                        data-status
                        class="text-xs text-neutral-500 dark:text-neutral-400"
                      >
                        Uploading requires JavaScript.
                      </p>
                    </div>
                  )}

                  {canUpload && isEditable && entry.state !== 'missing' && (
                    <form method="post" data-confirm-delete-document>
                      <input
                        type="hidden"
                        name="documentId"
                        value={entry.documentId}
                      />
                      <button
                        type="submit"
                        name="intent"
                        value="delete-document"
                        title="Delete this document"
                        aria-label="Delete this document"
                        class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-red-600 transition hover:bg-red-100 dark:text-red-400 dark:hover:bg-red-950"
                      >
                        <svg
                          class="size-4"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M18 6 6 18M6 6l12 12" />
                        </svg>
                      </button>
                    </form>
                  )}
                </div>

                {entry.uploadedAt && (
                  <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-neutral-500 dark:text-neutral-400">
                    <span>
                      {entry.fileName} · filed by {entry.uploadedByName} on{' '}
                      {dateFormat.format(entry.uploadedAt)}
                      {entry.versionCount > 1 &&
                        ` · version ${entry.versionCount}`}
                      {entry.verifiedByName &&
                        ` · verified by ${entry.verifiedByName}`}
                      {entry.expiresAt &&
                        ` · expires ${dateFormat.format(entry.expiresAt)}`}
                    </span>
                    <button
                      type="button"
                      data-view-document
                      data-document-id={entry.documentId}
                      class="font-medium text-neutral-700 underline hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-neutral-100"
                    >
                      View
                    </button>
                  </p>
                )}

                {entry.rejectionReason && (
                  <p class="mt-2 rounded-lg border border-red-300 px-3 py-2 text-sm text-red-800 dark:border-red-900 dark:text-red-200">
                    Rejected: {entry.rejectionReason}
                  </p>
                )}

                {canVerify &&
                  (entry.state === 'under_review' ||
                    entry.state === 'uploaded') && (
                    <form method="post" class="mt-3 space-y-2">
                      <input
                        type="hidden"
                        name="documentId"
                        value={entry.documentId}
                      />
                      <input
                        type="text"
                        name="reason"
                        placeholder="Reason — required if you reject this document"
                        class="w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                      />
                      <div class="flex flex-wrap gap-2">
                        <button
                          type="submit"
                          name="intent"
                          value="verify-document"
                          class="bg-mint-300 hover:bg-mint-400 rounded-lg px-3 py-1.5 text-sm font-bold text-neutral-800 transition"
                        >
                          Verify
                        </button>
                        <button
                          type="submit"
                          name="intent"
                          value="reject-document"
                          class="rounded-lg border border-red-300 px-3 py-1.5 text-sm font-medium text-red-700 transition hover:bg-red-50 dark:border-red-900 dark:text-red-300 dark:hover:bg-red-950"
                        >
                          Reject
                        </button>
                      </div>
                    </form>
                  )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (livePayment || due || dueProblem) && (
        <section
          class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950"
          id="payment"
        >
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
              Payment
            </h2>
            {livePayment &&
              (canSeePayments ? (
                <a
                  href={`/receipts/${livePayment.id}`}
                  class="text-sm text-neutral-600 underline dark:text-neutral-300"
                >
                  Receipt {livePayment.receiptNo}
                </a>
              ) : (
                <span class="text-sm text-neutral-600 dark:text-neutral-300">
                  Receipt {livePayment.receiptNo}
                </span>
              ))}
          </div>

          {dueProblem && (
            <p class="mt-3 rounded-lg border border-amber-300 px-3 py-2 text-sm text-amber-900 dark:border-amber-900 dark:text-amber-200">
              {dueProblem}
            </p>
          )}

          {livePayment && (
            <div class="mt-4">
              <p class="text-sm text-neutral-600 dark:text-neutral-300">
                {canSeePayments
                  ? `${formatMoney(livePayment.totalAmount, livePayment.currency)} · ${METHOD_LABELS[livePayment.method]}`
                  : 'Recorded'}{' '}
                · taken by {livePayment.recordedByName} on{' '}
                {dateFormat.format(livePayment.receivedAt)}
              </p>

              {canSeePayments && (
                <table class="mt-3 w-full text-sm">
                  <tbody>
                    {livePayment.accountLines.map(line => (
                      <tr class="border-t border-neutral-200 dark:border-neutral-800">
                        <td class="py-1.5 text-neutral-600 dark:text-neutral-300">
                          {line.label}
                        </td>
                        <td class="py-1.5 text-right text-neutral-800 tabular-nums dark:text-neutral-100">
                          {formatMoney(line.amount, livePayment.currency)}
                        </td>
                      </tr>
                    ))}
                    <tr class="border-t-2 border-neutral-300 dark:border-neutral-700">
                      <td class="py-1.5 font-medium text-neutral-800 dark:text-neutral-100">
                        Total
                      </td>
                      <td class="py-1.5 text-right font-bold text-neutral-800 tabular-nums dark:text-neutral-100">
                        {formatMoney(
                          livePayment.totalAmount,
                          livePayment.currency
                        )}
                      </td>
                    </tr>
                  </tbody>
                </table>
              )}

              {livePayment.varianceReason && canSeePayments && (
                <p class="mt-3 rounded-lg border border-amber-300 px-3 py-2 text-sm text-amber-900 dark:border-amber-900 dark:text-amber-200">
                  {livePayment.varianceReason}
                </p>
              )}
            </div>
          )}

          {due && (
            <form method="post" class="mt-4 space-y-4" data-payment-form>
              <table class="w-full text-sm">
                <tbody>
                  {due.components.map(component => (
                    <tr class="border-t border-neutral-200 dark:border-neutral-800">
                      <td class="py-2 text-neutral-600 dark:text-neutral-300">
                        <label for={`amount-${component.accountTypeId}`}>
                          {component.label}
                        </label>
                      </td>
                      <td class="w-40 py-2 text-right">
                        <input
                          id={`amount-${component.accountTypeId}`}
                          type="text"
                          inputmode="decimal"
                          name={`amount.${component.accountTypeId}`}
                          value={component.amount}
                          data-amount-input
                          class="w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-right text-sm tabular-nums dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                        />
                      </td>
                    </tr>
                  ))}
                  <tr class="border-t-2 border-neutral-300 dark:border-neutral-700">
                    <td class="py-2 font-medium text-neutral-800 dark:text-neutral-100">
                      Total
                    </td>
                    <td
                      data-payment-total
                      class="py-2 text-right font-bold text-neutral-800 tabular-nums dark:text-neutral-100"
                    >
                      {formatMoney(initialTotal)}
                    </td>
                  </tr>
                </tbody>
              </table>

              <div class="flex flex-wrap gap-3">
                <label class="text-sm text-neutral-600 dark:text-neutral-300">
                  Method
                  <select
                    name="method"
                    class="mt-1 block rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                  >
                    {PAYMENT_METHODS.map(method => (
                      <option value={method}>{METHOD_LABELS[method]}</option>
                    ))}
                  </select>
                </label>
                <label class="flex-1 text-sm text-neutral-600 dark:text-neutral-300">
                  Cheque or transfer reference
                  <input
                    type="text"
                    name="methodReference"
                    class="mt-1 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                  />
                </label>
              </div>

              <label class="block text-sm text-neutral-600 dark:text-neutral-300">
                Reason, if the amount differs from what is due
                <input
                  type="text"
                  name="varianceReason"
                  class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                />
              </label>

              <button
                type="submit"
                name="intent"
                value="record-payment"
                class="bg-mint-300 hover:bg-mint-400 rounded-lg px-4 py-2 text-sm font-bold text-neutral-800 transition"
              >
                Record payment and issue receipt
              </button>
            </form>
          )}
        </section>
      )
    }

    {
      actions.length > 0 && (
        <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
          <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
            Your next step
          </h2>

          {actions.map(action => {
            const reviewMeta = REVIEW_STEP_META[action.stepCode];
            return (
              <form method="post" class="mt-4 space-y-3">
                {action.stepCode === 'capture' && (
                  <button
                    type="submit"
                    name="intent"
                    value="submit"
                    class="bg-mint-300 hover:bg-mint-400 rounded-lg px-4 py-2 text-sm font-bold text-neutral-800 transition"
                  >
                    Submit for Processing
                  </button>
                )}

                {action.stepCode === 'secretary_review' &&
                  boardReasons.length > 0 && (
                    <div class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
                      <p class="font-medium">Not ready for the Board yet:</p>
                      <ul class="mt-1 list-disc pl-5">
                        {boardReasons.map(reason => (
                          <li>{reason}</li>
                        ))}
                      </ul>
                    </div>
                  )}

                {action.stepCode === 'president_decision' &&
                  signoffs.length > 0 && (
                    <div class="rounded-lg border border-neutral-300 bg-white px-4 py-3 text-sm dark:border-neutral-700 dark:bg-neutral-900">
                      <p class="font-medium text-neutral-700 dark:text-neutral-200">
                        {signoffs.filter(s => s.outcome === 'approve').length}{' '}
                        of {action.quorumCount} sign-off
                        {action.quorumCount === 1 ? '' : 's'} recorded
                      </p>
                      <ul class="mt-1 space-y-0.5 text-neutral-600 dark:text-neutral-300">
                        {signoffs.map(s => (
                          <li>
                            {s.outcome === 'approve' ? 'Approved' : 'Rejected'}{' '}
                            by {s.actorName}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                {reviewMeta && (
                  <>
                    <label class="block text-sm text-neutral-600 dark:text-neutral-300">
                      Comment
                      <textarea
                        name="comment"
                        rows="3"
                        class="mt-1 w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
                        placeholder={reviewMeta.commentPlaceholder}
                      />
                    </label>
                    <div class="flex flex-wrap gap-2">
                      <button
                        type="submit"
                        name="outcome"
                        value={reviewMeta.forwardOutcome}
                        disabled={
                          action.stepCode === 'secretary_review' &&
                          boardReasons.length > 0
                        }
                        class="bg-mint-300 hover:bg-mint-400 rounded-lg px-4 py-2 text-sm font-bold text-neutral-800 transition disabled:cursor-not-allowed disabled:opacity-50"
                      >
                        {reviewMeta.forwardLabel}
                      </button>
                      <button
                        type="submit"
                        name="outcome"
                        value={reviewMeta.returnOutcome}
                        class="rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-700 transition hover:bg-red-50 dark:border-red-900 dark:text-red-300 dark:hover:bg-red-950"
                      >
                        {reviewMeta.returnLabel}
                      </button>
                    </div>
                    <input
                      type="hidden"
                      name="intent"
                      value={reviewMeta.intent}
                    />
                    {reviewMeta.intent === 'review' && (
                      <input
                        type="hidden"
                        name="stepCode"
                        value={action.stepCode}
                      />
                    )}
                  </>
                )}
              </form>
            );
          })}
        </section>
      )
    }

    {
      history.length > 0 && (
        <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
          <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
            History
          </h2>
          <ol class="mt-4 space-y-3">
            {history.map(entry => (
              <li class="border-l-2 border-neutral-300 pl-3 text-sm dark:border-neutral-700">
                <div class="flex flex-wrap items-center gap-x-2">
                  <span class="font-medium text-neutral-800 dark:text-neutral-100">
                    {entry.fromStatus ?? 'created'} → {entry.toStatus}
                  </span>
                  {entry.actorRole && (
                    <span class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
                      {entry.actorRole}
                    </span>
                  )}
                  <span class="text-xs text-neutral-500 dark:text-neutral-400">
                    {entry.actorName} · {dateFormat.format(entry.occurredAt)}
                  </span>
                </div>
                {entry.comment && (
                  <p class="mt-1 text-neutral-600 dark:text-neutral-300">
                    {entry.comment}
                  </p>
                )}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      canSeeDocuments && (
        <dialog
          id="document-viewer-dialog"
          class="h-[85vh] w-[95vw] max-w-3xl rounded-2xl border border-neutral-200 bg-white p-0 text-neutral-800 backdrop:bg-neutral-900/50 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-100"
        >
          <div class="flex items-center justify-between gap-3 border-b border-neutral-200 px-5 py-3 dark:border-neutral-800">
            <p
              data-viewer-name
              class="truncate text-sm font-semibold text-neutral-800 dark:text-neutral-100"
            />
            <button
              type="button"
              data-viewer-close
              class="shrink-0 rounded-lg border border-neutral-300 px-2.5 py-1 text-xs font-medium text-neutral-600 transition hover:bg-neutral-100 dark:border-neutral-600 dark:text-neutral-300 dark:hover:bg-neutral-800"
            >
              Close
            </button>
          </div>
          <div
            data-viewer-body
            class="flex h-[calc(85vh-3rem)] items-center justify-center overflow-auto p-4 text-sm"
          >
            Loading…
          </div>
        </dialog>
      )
    }
  </div>
</DashboardLayout>

<script>
  // S-403, S-404 · Filing a document from the device, and viewing one back —
  // identical to [id].astro's own script for the same endpoints
  // (documents.ts is generic across application kinds since S-613 phase 4).
  // Officer feedback: filing an identity card and a utility bill at the same
  // time only kept one of them. Each box below runs its own upload
  // independently — correctly — but the FIRST one to finish reloaded the
  // page immediately, which aborted every other upload still in flight
  // rather than waiting for it. Counted here instead, so the reload this
  // page still wants (the checklist state is the server's to say, not a
  // guess made here) waits for every upload that was running to finish
  // first.
  let uploadsInFlight = 0;

  for (const panel of document.querySelectorAll<HTMLElement>('[data-upload]')) {
    const file = panel.querySelector<HTMLInputElement>('[data-file]');
    const expiry = panel.querySelector<HTMLInputElement>('[data-expires]');
    const status = panel.querySelector<HTMLElement>('[data-status]');
    if (!file || !status) continue;

    file.disabled = false;
    status.textContent = '';

    const say = (message: string) => {
      status.textContent = message;
    };

    file.addEventListener('change', async () => {
      const chosen = file.files?.[0];
      if (!chosen) return;

      if (panel.dataset.tracksExpiry === 'yes' && !expiry?.value) {
        say('Enter the expiry date first — this document type expires.');
        file.value = '';
        return;
      }

      uploadsInFlight++;
      file.disabled = true;
      say('Preparing…');

      try {
        const begun = await fetch('/api/v1/documents/begin-upload', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            applicationId: panel.dataset.applicationId,
            documentTypeId: panel.dataset.documentTypeId,
            subject: panel.dataset.subject,
            fileName: chosen.name,
            contentType: chosen.type,
            sizeBytes: chosen.size,
            ...(expiry?.value ? { expiresAt: expiry.value } : {}),
          }),
        });
        const begunBody = await begun.json();
        if (!begun.ok) {
          throw new Error(
            begunBody?.error?.message ?? 'The upload was refused.'
          );
        }
        const { versionId, uploadUrl, chunkSize } = begunBody.data;

        // fetch() gives no signal until a whole chunk has landed — for an
        // 8 MB photo in one chunk, that is several seconds of "Sending… 0%"
        // on a weak connection, which reads as stuck even when it is not.
        // XMLHttpRequest's own upload.progress event reports as the bytes
        // actually go, so the number on screen moves the whole time.
        const putChunk = (
          start: number,
          end: number
        ): Promise<{ ok: boolean; status: number }> =>
          new Promise((resolve, reject) => {
            const xhr = new XMLHttpRequest();
            xhr.open('PUT', uploadUrl);
            xhr.setRequestHeader(
              'content-range',
              `bytes ${start}-${end - 1}/${chosen.size}`
            );
            xhr.upload.addEventListener('progress', e => {
              if (!e.lengthComputable) return;
              const sent = start + e.loaded;
              say(`Sending… ${Math.round((sent / chosen.size) * 100)}%`);
            });
            xhr.addEventListener('load', () =>
              resolve({
                ok: xhr.status >= 200 && xhr.status < 300,
                status: xhr.status,
              })
            );
            xhr.addEventListener('error', () =>
              reject(new Error('The transfer failed — check your connection.'))
            );
            xhr.send(chosen.slice(start, end));
          });

        for (let start = 0; start < chosen.size; start += chunkSize) {
          const end = Math.min(start + chunkSize, chosen.size);
          const result = await putChunk(start, end);
          if (!result.ok && result.status !== 202) {
            throw new Error(`The transfer failed (${result.status}).`);
          }
        }

        say('Confirming…');
        const committed = await fetch('/api/v1/documents/commit-upload', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ versionId }),
        });
        const commitBody = await committed.json();
        if (!committed.ok) {
          throw new Error(
            commitBody?.error?.message ?? 'The file could not be confirmed.'
          );
        }

        // Held back until every other upload started alongside this one has
        // also finished, so none of them gets cut off mid-transfer by a
        // reload that was never theirs.
        say('Filed.');
        uploadsInFlight--;
        if (uploadsInFlight === 0) window.location.reload();
      } catch (error) {
        uploadsInFlight--;
        say(error instanceof Error ? error.message : 'The upload failed.');
        file.disabled = false;
        file.value = '';
      }
    });
  }

  for (const deleteForm of document.querySelectorAll<HTMLFormElement>(
    'form[data-confirm-delete-document]'
  )) {
    deleteForm.addEventListener('submit', event => {
      if (
        !window.confirm('Remove this document? You can file it again after.')
      ) {
        event.preventDefault();
      }
    });
  }

  // Officer feedback: this used to be window.open(url), which handed the
  // browser a SharePoint download link — a save-to-disk prompt on some
  // devices before the file could even be looked at. An <img> or a PDF's own
  // <iframe> viewer renders the same URL in place instead, closed with an
  // explicit Close rather than left to guess when a new tab was done with it.
  const viewerDialog = document.getElementById(
    'document-viewer-dialog'
  ) as HTMLDialogElement | null;
  const viewerName =
    viewerDialog?.querySelector<HTMLElement>('[data-viewer-name]');
  const viewerBody =
    viewerDialog?.querySelector<HTMLElement>('[data-viewer-body]');
  const viewerClose = viewerDialog?.querySelector<HTMLButtonElement>(
    '[data-viewer-close]'
  );

  if (viewerDialog && viewerName && viewerBody && viewerClose) {
    viewerClose.addEventListener('click', () => viewerDialog.close());
    viewerDialog.addEventListener('close', () => {
      viewerBody.replaceChildren();
    });

    for (const viewButton of document.querySelectorAll<HTMLButtonElement>(
      '[data-view-document]'
    )) {
      viewButton.addEventListener('click', async () => {
        const documentId = viewButton.dataset.documentId;
        if (!documentId) return;

        const original = viewButton.textContent;
        viewButton.disabled = true;
        viewButton.textContent = 'Opening…';

        try {
          const response = await fetch('/api/v1/documents/view-url', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ documentId }),
          });
          const body = await response.json();
          if (!response.ok) {
            throw new Error(
              body?.error?.message ?? 'The file could not be opened.'
            );
          }
          const {
            url,
            fileName,
            contentType,
          }: { url: string; fileName: string; contentType: string } = body.data;

          viewerName.textContent = fileName;
          viewerBody.replaceChildren();
          if (
            contentType.startsWith('image/') &&
            contentType !== 'image/heic'
          ) {
            const img = document.createElement('img');
            img.src = url;
            img.alt = fileName;
            img.className = 'max-h-full max-w-full object-contain';
            viewerBody.appendChild(img);
          } else if (contentType === 'application/pdf') {
            const frame = document.createElement('iframe');
            frame.src = url;
            frame.title = fileName;
            frame.className = 'h-full w-full';
            viewerBody.appendChild(frame);
          } else {
            const p = document.createElement('p');
            p.className = 'text-center text-neutral-600 dark:text-neutral-300';
            p.textContent = "This file type can't be previewed here.";
            const link = document.createElement('a');
            link.href = url;
            link.target = '_blank';
            link.rel = 'noopener';
            link.className = 'mt-2 inline-block underline';
            link.textContent = 'Open in a new tab';
            const wrap = document.createElement('div');
            wrap.className = 'text-center';
            wrap.append(p, link);
            viewerBody.appendChild(wrap);
          }
          viewerDialog.showModal();
        } catch (error) {
          window.alert(
            error instanceof Error
              ? error.message
              : 'The file could not be opened.'
          );
        } finally {
          viewButton.disabled = false;
          viewButton.textContent = original;
        }
      });
    }
  }

  // Every amount is editable here (unlike the membership payment form, whose
  // mandatory components are fixed) — recordAccountOpeningPayment supports a
  // variance from what is due the same way recordPayment does, and there is
  // no "optional" component to distinguish it from.
  const paymentForm = document.querySelector<HTMLFormElement>(
    '[data-payment-form]'
  );
  if (paymentForm) {
    const totalCell = paymentForm.querySelector<HTMLElement>(
      '[data-payment-total]'
    );
    const amountInputs = paymentForm.querySelectorAll<HTMLInputElement>(
      '[data-amount-input]'
    );

    const parseCents = (raw: string): number => {
      const trimmed = raw.trim();
      if (!/^-?\d+(\.\d{1,2})?$/.test(trimmed)) return 0;
      const negative = trimmed.startsWith('-');
      const [whole, fraction = ''] = trimmed.replace('-', '').split('.');
      return (
        (negative ? -1 : 1) *
        (Number(whole) * 100 + Number(fraction.padEnd(2, '0')))
      );
    };

    const formatCents = (cents: number): string => {
      const sign = cents < 0 ? '-' : '';
      const absolute = Math.abs(cents);
      const rupees = new Intl.NumberFormat('en-GB').format(
        Math.trunc(absolute / 100)
      );
      return `${sign}MUR ${rupees}.${String(absolute % 100).padStart(2, '0')}`;
    };

    const recomputeTotal = () => {
      if (!totalCell) return;
      let total = 0;
      for (const input of amountInputs) total += parseCents(input.value);
      totalCell.textContent = formatCents(total);
    };

    for (const input of amountInputs) {
      input.addEventListener('input', recomputeTotal);
    }
  }
</script>
