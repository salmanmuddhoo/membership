---
// Starting an application to open an account outside a membership (S-613,
// phase 5; S-614, phase 3).
//
// Two people can want this: an existing member opening a type their
// membership did not already open for them, and someone not on the system
// at all, opening one of their own. Both pick from the same account types
// and go through the same review chain after this (Regional Manager →
// Secretary → President), so this page asks one question — "is this for
// an existing member?" — and only then differs in what else it needs:
// which member, for one; the applicant's own details, captured the same way
// a membership application's are, for the other (business direction: no new
// form to design for this).
import DashboardLayout from '@layouts/DashboardLayout.astro';
import {
  ApplicationError,
  startAdditionalAccountApplication,
  startCustomerAccountApplication,
  startCustomerAdditionalAccountApplication,
} from '@lib/applications/capture';
import { loadCustomer } from '@lib/members/create';
import { listAccountTypes } from '@lib/config/reference';

const principal = Astro.locals.principal!;
if (!principal.permissions.has('application.capture')) {
  return Astro.redirect('/denied');
}

// Officer feedback: an existing customer (a non-member who already holds an
// account) opening a further one of their own comes in here from a button on
// their own detail page, which names them with ?customer=<id>. That is a
// third mode alongside the member/non-member choice below: the person is
// already known, so there is nothing to search or capture — only the account
// type(s) to pick. Read once here; the POST re-reads it from a hidden field.
const customerParam = Astro.url.searchParams.get('customer');
const customerHolder = customerParam ? await loadCustomer(customerParam) : null;
if (customerParam && !customerHolder) {
  return new Response('Not found', { status: 404 });
}

// Any active, non-membership-default account type is a valid selection
// (S-612) — nothing here names HSA or Investment specifically. Shares and
// the MSA open only on a membership's own approval and never appear here.
//
// Officer feedback: for a customer opening a further account, drop the
// type(s) they already hold — a customer holds at most one of each
// (account_one_per_type_per_customer_idx), so offering one they already
// have could only ever be refused on approval. Nothing to drop for the
// member/non-member search modes, where the holder is not yet known here.
const alreadyHeldTypeIds = new Set(
  customerHolder?.accounts.map(a => a.accountTypeId) ?? []
);
const accountTypes = (await listAccountTypes()).filter(
  t => t.isActive && !t.isMembershipDefault && !alreadyHeldTypeIds.has(t.id)
);

let error: string | null = null;
// Echoed back on a failed submission so the officer is not made to search
// again for a member or reselect account types they already picked.
let isMember = true;
let memberId = '';
let memberLabel = '';
let selected = new Set<string>();
// Officer feedback: Corporate had no way in here at all — only Individual
// (the default) or Minor, via what used to be a single "Minor" checkbox.
// A select generalises that same choice to the three customer types a
// non-member application already knows how to be captured against
// (startCustomerAccountApplication takes any membership type code).
const CUSTOMER_TYPES = ['individual', 'minor', 'corporate'] as const;
type CustomerType = (typeof CUSTOMER_TYPES)[number];
let customerType: CustomerType = 'individual';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  isMember = String(form.get('isMember') ?? 'yes') !== 'no';
  memberId = String(form.get('memberId') ?? '');
  memberLabel = String(form.get('memberLabel') ?? '');
  selected = new Set(form.getAll('accountTypeId').map(String));
  const postedType = String(form.get('customerType') ?? 'individual');
  customerType = (CUSTOMER_TYPES as readonly string[]).includes(postedType)
    ? (postedType as CustomerType)
    : 'individual';

  if (customerHolder) {
    // Customer mode: the holder is already known from ?customer=, so there is
    // no member/non-member choice — only the account type(s) to open.
    if (selected.size === 0) {
      error = 'Select at least one account type to open.';
    } else {
      try {
        const created = await startCustomerAdditionalAccountApplication(
          customerHolder.id,
          [...selected],
          { userId: principal.userId, email: principal.email }
        );
        // Straight into the new application's own workflow — its applicant
        // details (the customer's own), the signed form, documents, payment
        // and the review chain, the same as the member flow.
        return Astro.redirect(`/applications/${created.id}/account`);
      } catch (err) {
        if (err instanceof ApplicationError) {
          error = err.message;
        } else {
          console.error('[applications/new-account/customer]', err);
          error = 'Something went wrong. Please try again.';
        }
      }
    }
  } else if (isMember && !memberId) {
    error = 'Search for the member and pick one before continuing.';
  } else if (selected.size === 0) {
    error = 'Select at least one account type to open.';
  } else if (isMember) {
    try {
      const created = await startAdditionalAccountApplication(
        memberId,
        [...selected],
        { userId: principal.userId, email: principal.email }
      );
      // Officer feedback: land straight on the new application's own
      // workflow page, not back on the Applications list — the same as the
      // non-member path below goes to its own page. An additional-account
      // application for an existing member has no applicant to capture (the
      // member already exists), so this opens on the first step it does
      // have, documents, rather than an applicant-details step.
      return Astro.redirect(`/applications/${created.id}/account`);
    } catch (err) {
      if (err instanceof ApplicationError) {
        error = err.message;
      } else {
        console.error('[applications/new-account]', err);
        error = 'Something went wrong. Please try again.';
      }
    }
  } else {
    try {
      const created = await startCustomerAccountApplication(
        [...selected],
        { userId: principal.userId, email: principal.email },
        customerType
      );
      // Nothing about the applicant is captured yet — the officer fills that
      // in on the application itself, the same way a membership
      // application's capture form works.
      return Astro.redirect(`/applications/${created.id}/customer`);
    } catch (err) {
      if (err instanceof ApplicationError) {
        error = err.message;
      } else {
        console.error('[applications/new-account]', err);
        error = 'Something went wrong. Please try again.';
      }
    }
  }
}
---

<DashboardLayout
  title="Open an account · Al Barakah MCSL"
  heading="Open an account"
>
  <div class="mx-auto max-w-5xl space-y-6">
    <div
      id="application-nav"
      class="sticky z-20 -mx-4 flex flex-wrap items-center gap-2 border-b border-neutral-200/80 bg-neutral-200/95 px-4 py-3 backdrop-blur-md sm:mx-0 sm:rounded-xl sm:border-b-0 sm:px-3 sm:py-1.5 dark:border-neutral-800/80 dark:bg-neutral-900/95"
      style="top: calc(var(--app-header-height, 3.75rem) + var(--app-timeline-height, 0px) + 1.5rem)"
    >
      <a
        href="/applications"
        class="inline-block text-sm text-neutral-500 underline dark:text-neutral-400"
        >← All applications</a
      >
    </div>

    {
      error && (
        <div class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
          {error}
        </div>
      )
    }

    {
      accountTypes.length === 0 ? (
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
          {customerHolder
            ? `${customerHolder.name} already holds every account type available to open.`
            : 'No account type is configured for this yet. Add one under Configuration → Account types.'}
        </p>
      ) : (
        <form
          method="post"
          class="space-y-6 rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950"
        >
          {customerHolder && (
            <div class="rounded-lg border border-neutral-200 bg-white px-4 py-3 text-sm dark:border-neutral-800 dark:bg-neutral-900">
              <p class="text-neutral-800 dark:text-neutral-100">
                Opening another account for{' '}
                <span class="font-medium">{customerHolder.name}</span>
              </p>
              <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                Their own details carry over from their record — pick the
                account type(s) to open. They stay a non-member.
              </p>
            </div>
          )}

          <fieldset hidden={!!customerHolder}>
            <legend class="text-sm text-neutral-600 dark:text-neutral-300">
              Is this for an existing member?
            </legend>
            <div class="mt-2 flex gap-4">
              <label class="flex items-center gap-2 text-sm text-neutral-800 dark:text-neutral-100">
                <input
                  type="radio"
                  name="isMember"
                  value="yes"
                  checked={isMember}
                  data-is-member-toggle
                  class="text-mint-500 focus:ring-mint-400 border-neutral-300 dark:border-neutral-600"
                />
                Yes
              </label>
              <label class="flex items-center gap-2 text-sm text-neutral-800 dark:text-neutral-100">
                <input
                  type="radio"
                  name="isMember"
                  value="no"
                  checked={!isMember}
                  data-is-member-toggle
                  class="text-mint-500 focus:ring-mint-400 border-neutral-300 dark:border-neutral-600"
                />
                No
              </label>
            </div>
          </fieldset>

          <div
            class="relative"
            data-member-search
            hidden={!!customerHolder || !isMember}
          >
            <label class="block text-sm text-neutral-600 dark:text-neutral-300">
              Member
              <input
                type="text"
                autocomplete="off"
                placeholder="Name, NIC or Member No."
                value={memberLabel}
                data-member-search-input
                class="mt-1 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
              />
            </label>
            <input type="hidden" name="memberId" value={memberId} />
            <input type="hidden" name="memberLabel" value={memberLabel} />
            <p
              data-member-search-status
              class="mt-1 text-xs text-neutral-500 dark:text-neutral-400"
            />
            <ul
              data-member-search-results
              hidden
              class="absolute z-10 mt-1 max-h-56 w-full overflow-y-auto rounded-lg border border-neutral-300 bg-white text-sm shadow-lg dark:border-neutral-600 dark:bg-neutral-900"
            />
          </div>

          <div data-non-member-only hidden={!!customerHolder || isMember}>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">
              Their own details are filled in on the next screen — the same
              information a membership application asks for.
            </p>
            <label class="mt-2 block text-sm text-neutral-600 dark:text-neutral-300">
              Applicant type
              <select
                name="customerType"
                data-customer-type
                class="mt-1 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
              >
                <option
                  value="individual"
                  selected={customerType === 'individual'}
                >
                  Individual
                </option>
                <option value="minor" selected={customerType === 'minor'}>
                  Minor
                </option>
                <option
                  value="corporate"
                  selected={customerType === 'corporate'}
                >
                  Corporate
                </option>
              </select>
            </label>
            <p
              data-minor-note
              hidden={customerType !== 'minor'}
              class="mt-2 text-xs text-neutral-500 dark:text-neutral-400"
            >
              A parent or guardian's details are asked for too.
            </p>
          </div>

          <fieldset>
            <legend class="text-sm text-neutral-600 dark:text-neutral-300">
              Account type(s) to open
            </legend>
            <div class="mt-2 space-y-2">
              {accountTypes.map(t => (
                <label class="flex items-center gap-2 text-sm text-neutral-800 dark:text-neutral-100">
                  <input
                    type="checkbox"
                    name="accountTypeId"
                    value={t.id}
                    checked={selected.has(t.id)}
                    class="rounded border-neutral-300 dark:border-neutral-600"
                  />
                  {t.name}
                </label>
              ))}
            </div>
          </fieldset>

          <button
            type="submit"
            class="bg-mint-300 hover:bg-mint-400 rounded-lg px-4 py-2 text-sm font-bold text-neutral-800 transition"
          >
            Open account
          </button>
        </form>
      )
    }
  </div>
</DashboardLayout>

<script>
  // Yes/No toggles whether the member search shows at all — without
  // scripting the server's own isMember default (checked on load) is what
  // decides it, since there is no other way to react to a choice not yet
  // submitted.
  const memberToggles = [
    ...document.querySelectorAll<HTMLInputElement>('[data-is-member-toggle]'),
  ];
  const memberSearchWrapper = document.querySelector<HTMLElement>(
    '[data-member-search]'
  );
  const syncMemberSearchVisibility = () => {
    if (!memberSearchWrapper) return;
    const checked = memberToggles.find(t => t.checked);
    memberSearchWrapper.hidden = checked?.value === 'no';
  };
  // The inverse of the above: shown only once "No" is picked, same as the
  // member search is hidden once it is.
  const nonMemberOnly = document.querySelector<HTMLElement>(
    '[data-non-member-only]'
  );
  const syncNonMemberOnlyVisibility = () => {
    if (!nonMemberOnly) return;
    const checked = memberToggles.find(t => t.checked);
    nonMemberOnly.hidden = checked?.value !== 'no';
  };
  for (const toggle of memberToggles) {
    toggle.addEventListener('change', () => {
      syncMemberSearchVisibility();
      syncNonMemberOnlyVisibility();
    });
  }

  // The guardian note only means something once Minor is actually picked.
  const customerTypeSelect = document.querySelector<HTMLSelectElement>(
    '[data-customer-type]'
  );
  const minorNote = document.querySelector<HTMLElement>('[data-minor-note]');
  customerTypeSelect?.addEventListener('change', () => {
    if (minorNote) minorNote.hidden = customerTypeSelect.value !== 'minor';
  });

  // Mirrors the guardian search on the capture form (CaptureFields.astro,
  // S-604) — same debounce, same picker — against a different endpoint and
  // active members only (S-613).
  const wrapper = document.querySelector<HTMLElement>('[data-member-search]');
  const input = wrapper?.querySelector<HTMLInputElement>(
    '[data-member-search-input]'
  );
  const results = wrapper?.querySelector<HTMLUListElement>(
    '[data-member-search-results]'
  );
  const status = wrapper?.querySelector<HTMLElement>(
    '[data-member-search-status]'
  );
  const memberIdField = document.querySelector<HTMLInputElement>(
    'input[name="memberId"]'
  );
  const memberLabelField = document.querySelector<HTMLInputElement>(
    'input[name="memberLabel"]'
  );

  if (wrapper && input && results && status && memberIdField) {
    interface Candidate {
      memberId: string;
      memberNo: string;
      surname: string;
      name: string;
      nic: string;
    }

    const close = () => {
      results.hidden = true;
      results.replaceChildren();
    };

    const render = (candidates: Candidate[]) => {
      results.replaceChildren();
      if (candidates.length === 0) {
        results.hidden = true;
        return;
      }
      for (const candidate of candidates) {
        const item = document.createElement('li');
        const button = document.createElement('button');
        button.type = 'button';
        button.className =
          'block w-full px-3 py-2 text-left hover:bg-neutral-100 dark:hover:bg-neutral-800';
        const name = `${candidate.name} ${candidate.surname}`.trim();
        button.innerHTML =
          `<span class="block font-medium text-neutral-800 dark:text-neutral-100">${name || '(no name)'}</span>` +
          `<span class="block text-xs text-neutral-500 dark:text-neutral-400">${candidate.memberNo}</span>`;
        button.addEventListener('click', () => {
          memberIdField.value = candidate.memberId;
          const label = `${name} (${candidate.memberNo})`.trim();
          if (memberLabelField) memberLabelField.value = label;
          input.value = label;
          status.textContent = `Selected ${candidate.memberNo}.`;
          close();
        });
        item.appendChild(button);
        results.appendChild(item);
      }
      results.hidden = false;
    };

    let pending: number | undefined;
    input.addEventListener('input', () => {
      // A fresh search means the previous pick no longer holds — the officer
      // is looking for someone else, or correcting a mistake, and the form
      // must not submit the old member under a changed search term.
      memberIdField.value = '';
      window.clearTimeout(pending);
      const term = input.value.trim();
      if (term.length < 2) {
        close();
        status.textContent = '';
        return;
      }
      pending = window.setTimeout(async () => {
        status.textContent = 'Searching…';
        try {
          const response = await fetch(
            `/api/v1/applications/existing-member-search?q=${encodeURIComponent(term)}`
          );
          const body = await response.json();
          if (!response.ok) throw new Error(body?.error?.message);
          const candidates = body.data.candidates as Candidate[];
          render(candidates);
          status.textContent = candidates.length === 0 ? 'No match found.' : '';
        } catch {
          status.textContent = 'Search failed — check your connection.';
        }
      }, 300);
    });

    document.addEventListener('click', event => {
      if (!wrapper.contains(event.target as Node)) close();
    });
  }
</script>
