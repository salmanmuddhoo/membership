---
// Record a deposit into one of a member's (or a customer's) accounts
// (S-1305, S-1306, S-1308). The rules are ledger/deposits.ts's; this page
// gathers the form, shows what was refused, and shows the receipt.
import IdempotencyKeyField from '@components/IdempotencyKeyField.astro';
import { canTransact } from '@lib/members/status';
import DashboardLayout from '@layouts/DashboardLayout.astro';
import {
  cashMaximum,
  cashSourceOfFundThreshold,
  listAccountTypes,
  offeredBankAccounts,
  offeredPaymentMethods,
} from '@lib/config/reference';
import { startDepositRequest } from '@lib/ledger/deposit-requests';
import {
  DepositError,
  PERMISSION_CAPTURE,
  recordDeposit,
  type Deposit,
} from '@lib/ledger/deposits';
import { accountBalance } from '@lib/ledger/ledger';
import { loadCustomer, loadMember } from '@lib/members/create';
import { formatMoney, toCents } from '@lib/payments/money';
import { routePreviewGroups } from '@lib/workflow/timeline';
import RoutePreview from '@components/RoutePreview.astro';
import {
  PAGE,
  MUTED,
  CARD,
  CARD_TITLE,
  FORM_CARD,
  LABEL,
  INPUT,
  SECONDARY_SM,
  BUTTON,
  CARD_OK,
  NOTICE_ERROR,
} from '@lib/ui';

const principal = Astro.locals.principal!;
if (!principal.permissions.has(PERMISSION_CAPTURE)) {
  return Astro.redirect('/denied');
}

const { id } = Astro.params;
// A member or a non-member customer (0027), the way the person's own page
// finds them — member first because it is the common case.
const member = id ? await loadMember(id) : null;
const customer = !member && id ? await loadCustomer(id) : null;
if (!member && !customer) return new Response('Not found', { status: 404 });
const person = (member ?? customer)!;
const personLabel = member
  ? `${member.name} · ${member.memberNo}`
  : person.name;

const types = new Map((await listAccountTypes()).map(t => [t.id, t]));
const accounts = await Promise.all(
  person.accounts.map(async account => ({
    ...account,
    balance: (await accountBalance(account.id))?.balance ?? '0.00',
    acceptsDeposits: types.get(account.accountTypeId)?.allowsDeposit ?? false,
  }))
);
const depositable = accounts.filter(
  a => a.status === 'active' && a.acceptsDeposits
);

const paymentMethods = await offeredPaymentMethods();
const bankAccounts = await offeredBankAccounts();
// From the Transactions page (officer feedback): the account is already
// chosen, and the way back is there rather than to the person's page.
const requestedAccount = Astro.url.searchParams.get('account') ?? '';
const fromTransactions = Astro.url.searchParams.get('from') === 'transactions';
const cashThreshold = await cashSourceOfFundThreshold();
const cashMax = await cashMaximum();

// What the form carries back on a refusal, and the key it was issued with:
// the same key on a retry is the same deposit (S-1308), so a refresh after
// a success cannot post twice, and a correction after a refusal — nothing
// was written — is free to reuse it.
let values: Record<
  | 'accountId'
  | 'amount'
  | 'method'
  | 'methodReference'
  | 'bankAccountId'
  | 'reason'
  | 'idempotencyKey',
  string
> = {
  accountId:
    depositable.find(a => a.id === requestedAccount)?.id ??
    depositable[0]?.id ??
    '',
  amount: '',
  method: paymentMethods[0]?.code ?? '',
  methodReference: '',
  bankAccountId: '',
  reason: '',
  idempotencyKey: crypto.randomUUID(),
};
let error: string | null = null;
let deposit: Deposit | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const text = (name: string) => String(form.get(name) ?? '');
  const intent = text('intent') || 'record';
  values = {
    accountId: text('accountId'),
    amount: text('amount'),
    method: text('method'),
    methodReference: text('methodReference'),
    bankAccountId: text('bankAccountId'),
    reason: text('reason'),
    idempotencyKey: text('idempotencyKey') || crypto.randomUUID(),
  };
  // Only this person's accounts: the id in the form is theirs to choose
  // among, not a free pointer into the ledger.
  if (!person.accounts.some(a => a.id === values.accountId)) {
    error = 'Choose which account the deposit goes into.';
  } else if (intent === 'request') {
    // Cash above the Source of Fund threshold: a request, not a deposit
    // posted at once — the officer continues into the wizard that has the
    // depositor sign the form before anything reaches the ledger.
    try {
      const request = await startDepositRequest(
        {
          accountId: values.accountId,
          amount: values.amount,
          method: values.method,
          reason: values.reason,
        },
        principal
      );
      // Straight to the form: signing it is the only thing left to do
      // before the request can go.
      return Astro.redirect(`/deposits/${request.id}/form`);
    } catch (err) {
      if (err instanceof DepositError) {
        error = err.message;
      } else {
        console.error('[members/deposit]', err);
        error = 'Something went wrong. Please try again.';
      }
    }
  } else {
    try {
      deposit = await recordDeposit(
        { ...values, sourceOfFundFormConfirmed: false },
        principal
      );
    } catch (err) {
      if (err instanceof DepositError) {
        // A conflict here is this form posted a second time — Back, then
        // a change and Post again — under the key it was first posted
        // with (QA-01). The key is not something the officer knows about.
        error =
          err.reason === 'conflict'
            ? 'This deposit was already recorded. Open a new deposit form to record another.'
            : err.message;
      } else {
        console.error('[members/deposit]', err);
        error = 'Something went wrong. Please try again.';
      }
    }
  }
}
// The timeline experience: what will happen to this transaction, by
// account and amount, drawn over the form before it is recorded.
const routeGroups = await routePreviewGroups(
  'deposit',
  depositable,
  principal.roles
);
const initialCents = /^\d{1,12}(\.\d{1,2})?$/.test(values.amount ?? '')
  ? toCents(values.amount)
  : null;
---

<DashboardLayout title="Deposit · Al Barakah MCSL" heading="Record a deposit">
  <div class={PAGE.form}>
    <p class={`flex flex-wrap items-center gap-x-3 ${MUTED}`}>
      {fromTransactions && (
        <a
          href="/transactions"
          class="text-neutral-500 underline dark:text-neutral-400"
        >
          ← Transactions
        </a>
      )}
      <a
        href={`/members/${person.id}`}
        class="font-medium underline hover:text-neutral-900 dark:hover:text-neutral-100"
      >
        {personLabel}
      </a>
    </p>

    {error && <div class={NOTICE_ERROR}>{error}</div>}

    {deposit ? (
      <section class={CARD_OK}>
        <h2 class={CARD_TITLE}>
          {deposit.status === 'posted'
            ? `Deposit ${deposit.reference} posted`
            : `Deposit ${deposit.reference} submitted for approval`}
        </h2>
        {deposit.status !== 'posted' && deposit.currentStepName && (
          <p class={`${MUTED} mt-1`}>
            Waiting for {deposit.currentStepName}
            {deposit.currentStepRole && ` (${deposit.currentStepRole})`}. The
            receipt is issued when it posts.
          </p>
        )}
        <dl class="mt-4 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
          {deposit.receiptNo && (
            <>
              <dt class="text-neutral-500 dark:text-neutral-400">Receipt</dt>
              <dd class="font-medium text-neutral-800 dark:text-neutral-100">
                <a href={`/receipts/${deposit.id}`} class="underline">
                  {deposit.receiptNo}
                </a>
              </dd>
            </>
          )}
          <dt class="text-neutral-500 dark:text-neutral-400">Amount</dt>
          <dd class="font-medium text-neutral-800 dark:text-neutral-100">
            {formatMoney(deposit.amount, deposit.currency)} by{' '}
            {deposit.methodName}
            {deposit.methodReference && ` · ${deposit.methodReference}`}
          </dd>
          <dt class="text-neutral-500 dark:text-neutral-400">Into</dt>
          <dd class="font-medium text-neutral-800 dark:text-neutral-100">
            {deposit.accountNo} · {deposit.accountTypeName}
          </dd>
          {deposit.balanceAfter && (
            <>
              <dt class="text-neutral-500 dark:text-neutral-400">
                Balance now
              </dt>
              <dd class="font-medium text-neutral-800 dark:text-neutral-100">
                {formatMoney(deposit.balanceAfter, deposit.currency)}
              </dd>
            </>
          )}
        </dl>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href={`/members/${person.id}`} class={BUTTON}>
            Back to {member ? 'member' : 'customer'}
          </a>
          {deposit.status !== 'posted' && (
            <a href={`/transactions/${deposit.id}`} class={SECONDARY_SM}>
              Follow it
            </a>
          )}
          <a
            href={
              fromTransactions
                ? '/transactions/deposit'
                : `/members/${person.id}/deposit`
            }
            class={SECONDARY_SM}
          >
            Record another
          </a>
        </div>
      </section>
    ) : depositable.length === 0 ? (
      <section class={`${CARD} text-sm text-neutral-600 dark:text-neutral-300`}>
        {!canTransact(person.status)
          ? `This ${member ? 'member' : 'customer'} is ${person.status}, so no deposit can be taken.`
          : 'None of these accounts can take a deposit.'}
      </section>
    ) : (
      <>
        <RoutePreview
          groups={routeGroups}
          accountField="accountId"
          initialAccountId={values.accountId}
          initialAmountCents={initialCents}
        />
        <form
          method="post"
          data-deposit-form
          data-cash-threshold={cashThreshold}
          data-cash-maximum={cashMax}
          class={FORM_CARD}
        >
          <IdempotencyKeyField value={values.idempotencyKey} />

          <label class={LABEL}>
            Account
            <select name="accountId" class={INPUT}>
              {accounts.map(account => (
                <option
                  value={account.id}
                  selected={account.id === values.accountId}
                  disabled={
                    !(account.status === 'active' && account.acceptsDeposits)
                  }
                >
                  {account.accountNo} · {account.accountTypeName} ·{' '}
                  {formatMoney(account.balance)}
                  {account.status !== 'active'
                    ? ` · ${account.status}`
                    : account.acceptsDeposits
                      ? ''
                      : ' · no deposits'}
                </option>
              ))}
            </select>
          </label>

          <div class="grid gap-3 sm:grid-cols-2">
            <label class={LABEL}>
              Amount (Rs)
              <input
                type="text"
                inputmode="decimal"
                name="amount"
                required
                value={values.amount}
                data-amount
                class={INPUT}
              />
            </label>
            <label class={LABEL}>
              Method
              <select name="method" class={INPUT}>
                {paymentMethods.map(method => (
                  <option
                    value={method.code}
                    data-cash={method.isCash ? 'true' : 'false'}
                    data-requires-reference={
                      method.requiresReference ? 'true' : 'false'
                    }
                    data-touches-bank={method.touchesBank ? 'true' : 'false'}
                    selected={method.code === values.method}
                  >
                    {method.name}
                  </option>
                ))}
              </select>
            </label>
            <label data-method-reference-field class={LABEL}>
              Reference (cheque number, transfer reference)
              <input
                type="text"
                name="methodReference"
                value={values.methodReference}
                class={INPUT}
              />
            </label>
            <label data-bank-account-field class={LABEL}>
              Bank account
              <select name="bankAccountId" class={INPUT}>
                <option value="">Choose…</option>
                {bankAccounts.map(account => (
                  <option
                    value={account.id}
                    selected={account.id === values.bankAccountId}
                  >
                    {account.name} · {account.bankName}
                  </option>
                ))}
              </select>
            </label>
            <label class={LABEL}>
              Note
              <input
                type="text"
                name="reason"
                value={values.reason}
                maxlength="200"
                class={INPUT}
              />
            </label>
          </div>

          <p
            data-cash-maximum-warning
            hidden
            class="rounded-lg border border-red-300 px-3 py-2 text-sm text-red-800 dark:border-red-900 dark:text-red-200"
          >
            Cash deposits above {formatMoney(cashMax)} are not authorised. Use
            another method, or split the deposit.
          </p>

          <div class="flex flex-wrap gap-2 pt-2">
            <button
              type="submit"
              name="intent"
              value="record"
              data-deposit-submit
              class={BUTTON}
            >
              Post deposit
            </button>
            <button
              type="submit"
              name="intent"
              value="request"
              data-request-submit
              hidden
              class={BUTTON}
            >
              Sign the Source of Fund form
            </button>
            <a href={`/members/${person.id}`} class={SECONDARY_SM}>
              Cancel
            </a>
          </div>
        </form>
      </>
    )}
  </div>
</DashboardLayout>

<script>
  // A visual nudge only — every rule here is enforced server-side
  // (ledger/deposits.ts) whether or not this script runs. Whether a method
  // is cash, and whether it carries a reference, is configuration (S-1307),
  // read off the selected option.
  const form = document.querySelector<HTMLFormElement>('[data-deposit-form]');
  if (form) {
    const toCents = (value: string | undefined): number | null => {
      const trimmed = (value ?? '').trim();
      if (!/^\d{1,12}(\.\d{1,2})?$/.test(trimmed)) return null;
      const [whole, fraction = ''] = trimmed.split('.');
      return Number(whole) * 100 + Number(fraction.padEnd(2, '0'));
    };
    const thresholdCents = toCents(form.dataset.cashThreshold);
    const maximumCents = toCents(form.dataset.cashMaximum);
    const amountInput = form.querySelector<HTMLInputElement>('[data-amount]');
    const methodSelect =
      form.querySelector<HTMLSelectElement>('[name="method"]');
    const referenceField = form.querySelector<HTMLElement>(
      '[data-method-reference-field]'
    );
    const bankField = form.querySelector<HTMLElement>(
      '[data-bank-account-field]'
    );
    const maximumWarning = form.querySelector<HTMLElement>(
      '[data-cash-maximum-warning]'
    );
    const submit = form.querySelector<HTMLButtonElement>(
      '[data-deposit-submit]'
    );
    const requestSubmit = form.querySelector<HTMLButtonElement>(
      '[data-request-submit]'
    );

    const recompute = () => {
      const selected = methodSelect?.selectedOptions[0];
      const isCash = selected?.dataset.cash === 'true';
      const cents = toCents(amountInput?.value);

      if (referenceField) {
        referenceField.hidden = selected?.dataset.requiresReference !== 'true';
      }
      if (bankField) {
        bankField.hidden = selected?.dataset.touchesBank !== 'true';
      }

      const overMaximum =
        isCash &&
        cents !== null &&
        maximumCents !== null &&
        cents > maximumCents;
      if (maximumWarning) maximumWarning.hidden = !overMaximum;

      const needsSourceOfFund =
        !overMaximum &&
        isCash &&
        cents !== null &&
        thresholdCents !== null &&
        cents > thresholdCents;
      if (requestSubmit) {
        requestSubmit.disabled = !needsSourceOfFund;
        requestSubmit.hidden = !needsSourceOfFund;
      }

      if (submit) submit.disabled = overMaximum || needsSourceOfFund;
    };

    amountInput?.addEventListener('input', recompute);
    methodSelect?.addEventListener('change', recompute);
    recompute();
  }
</script>
