---
// Record a transfer out of one of a member's (or a customer's) accounts
// (S-1504): to another of their own, to another person's account found by
// type and number, or to a payee with no account here. The rules are
// ledger/transfers.ts's; this page gathers the form and shows both legs.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import {
  listAccountTypes,
  offeredBankAccounts,
  offeredPaymentMethods,
} from '@lib/config/reference';
import { availableBalance } from '@lib/ledger/ledger';
import { findAccountByNumber } from '@lib/ledger/lookup';
import {
  PERMISSION_CAPTURE,
  recordTransfer,
  TransferError,
  type Transfer,
  type TransferDestination,
} from '@lib/ledger/transfers';
import { loadCustomer, loadMember } from '@lib/members/create';
import { formatMoney, toCents } from '@lib/payments/money';
import { routePreviewGroups } from '@lib/workflow/timeline';
import RoutePreview from '@components/RoutePreview.astro';
import {
  PAGE,
  MUTED,
  CARD,
  CARD_TITLE,
  FORM_CARD,
  LABEL,
  INPUT,
  SECONDARY_SM,
  BUTTON,
  CARD_OK,
  CHECK_LABEL,
  NOTICE_ERROR,
} from '@lib/ui';

const principal = Astro.locals.principal!;
if (!principal.permissions.has(PERMISSION_CAPTURE)) {
  return Astro.redirect('/denied');
}

const { id } = Astro.params;
const member = id ? await loadMember(id) : null;
const customer = !member && id ? await loadCustomer(id) : null;
if (!member && !customer) return new Response('Not found', { status: 404 });
const person = (member ?? customer)!;
const personLabel = member
  ? `${member.name} · ${member.memberNo}`
  : person.name;

const allTypes = await listAccountTypes();
const types = new Map(allTypes.map(t => [t.id, t]));
const accounts = await Promise.all(
  person.accounts.map(async account => {
    const figures = await availableBalance(account.id);
    const type = types.get(account.accountTypeId);
    return {
      ...account,
      balance: figures.balance,
      available: figures.available,
      pendingDebits: figures.pendingDebits,
      floor: type?.minimumBalance ?? '0.00',
      allowsTransfer: type?.allowsTransfer ?? false,
      allowsDeposit: type?.allowsDeposit ?? false,
    };
  })
);
const sources = accounts.filter(a => a.status === 'active' && a.allowsTransfer);
const ownTargets = accounts.filter(
  a => a.status === 'active' && a.allowsDeposit
);
// Another person's account is found the way the Transactions page finds
// one: by type and number.
const lookupTypes = allTypes.filter(t => t.isActive && t.allowsDeposit);
const paymentMethods = await offeredPaymentMethods();
const bankAccounts = await offeredBankAccounts();
const requestedAccount = Astro.url.searchParams.get('account') ?? '';
const fromTransactions = Astro.url.searchParams.get('from') === 'transactions';

let values: Record<
  | 'sourceAccountId'
  | 'amount'
  | 'destinationKind'
  | 'ownAccountId'
  | 'otherTypeId'
  | 'otherNumber'
  | 'payeeName'
  | 'method'
  | 'methodReference'
  | 'bankAccountId'
  | 'reason'
  | 'idempotencyKey',
  string
> = {
  sourceAccountId:
    sources.find(a => a.id === requestedAccount)?.id ?? sources[0]?.id ?? '',
  amount: '',
  destinationKind: 'own',
  ownAccountId: '',
  otherTypeId: lookupTypes[0]?.id ?? '',
  otherNumber: '',
  payeeName: '',
  method: paymentMethods[0]?.code ?? '',
  methodReference: '',
  bankAccountId: '',
  reason: '',
  idempotencyKey: crypto.randomUUID(),
};
let error: string | null = null;
let transfer: Transfer | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const text = (name: string) => String(form.get(name) ?? '');
  values = {
    sourceAccountId: text('sourceAccountId'),
    amount: text('amount'),
    destinationKind: text('destinationKind'),
    ownAccountId: text('ownAccountId'),
    otherTypeId: text('otherTypeId'),
    otherNumber: text('otherNumber'),
    payeeName: text('payeeName'),
    method: text('method'),
    methodReference: text('methodReference'),
    bankAccountId: text('bankAccountId'),
    reason: text('reason'),
    idempotencyKey: text('idempotencyKey') || crypto.randomUUID(),
  };
  let destination: TransferDestination | null = null;
  if (!person.accounts.some(a => a.id === values.sourceAccountId)) {
    error = 'Choose which account the transfer comes from.';
  } else if (values.destinationKind === 'own') {
    if (!person.accounts.some(a => a.id === values.ownAccountId)) {
      error = 'Choose which of their accounts it goes to.';
    } else {
      destination = { kind: 'account', accountId: values.ownAccountId };
    }
  } else if (values.destinationKind === 'other') {
    const type = lookupTypes.find(t => t.id === values.otherTypeId);
    const found = type
      ? await findAccountByNumber(type.id, values.otherNumber)
      : null;
    if (!type) {
      error = 'Choose the account type it goes to.';
    } else if (!found) {
      error = `No ${type.name} account ${values.otherNumber.trim().toUpperCase()}.`;
    } else {
      destination = { kind: 'account', accountId: found.accountId };
    }
  } else if (values.destinationKind === 'payee') {
    destination = {
      kind: 'payee',
      payeeName: values.payeeName,
      method: values.method,
      methodReference: values.methodReference,
      bankAccountId: values.bankAccountId,
    };
  } else {
    error = 'Choose where the money goes.';
  }
  if (!error && destination) {
    try {
      transfer = await recordTransfer(
        {
          sourceAccountId: values.sourceAccountId,
          amount: values.amount,
          destination,
          reason: values.reason,
          idempotencyKey: values.idempotencyKey,
        },
        principal
      );
    } catch (err) {
      if (err instanceof TransferError) {
        error = err.message;
      } else {
        console.error('[members/transfer]', err);
        error = 'Something went wrong. Please try again.';
      }
    }
  }
}

const RADIO =
  'text-mint-500 focus:ring-mint-400 rounded-full border-neutral-300 dark:border-neutral-600';
// The timeline experience: what will happen to this transaction, by
// account and amount, drawn over the form before it is recorded.
const routeGroups = await routePreviewGroups(
  'transfer',
  sources,
  principal.roles
);
const initialCents = /^\d{1,12}(\.\d{1,2})?$/.test(values.amount ?? '')
  ? toCents(values.amount)
  : null;
---

<DashboardLayout title="Transfer · Al Barakah MCSL" heading="Record a transfer">
  <div class={PAGE.form}>
    <p class={`flex flex-wrap items-center gap-x-3 ${MUTED}`}>
      {fromTransactions && (
        <a
          href="/transactions"
          class="text-neutral-500 underline dark:text-neutral-400"
        >
          ← Transactions
        </a>
      )}
      <a
        href={`/members/${person.id}`}
        class="font-medium underline hover:text-neutral-900 dark:hover:text-neutral-100"
      >
        {personLabel}
      </a>
    </p>

    {error && <div class={NOTICE_ERROR}>{error}</div>}

    {transfer ? (
      <section class={CARD_OK}>
        <h2 class={CARD_TITLE}>
          {transfer.status === 'posted'
            ? `Transfer ${transfer.reference} posted`
            : `Transfer ${transfer.reference} submitted for approval`}
        </h2>
        {transfer.status !== 'posted' && transfer.debitLeg.currentStepName && (
          <p class={`${MUTED} mt-1`}>
            Waiting for {transfer.debitLeg.currentStepName}
            {transfer.debitLeg.currentStepRole &&
              ` (${transfer.debitLeg.currentStepRole})`}
            .
          </p>
        )}
        <dl class="mt-4 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
          <dt class="text-neutral-500 dark:text-neutral-400">Amount</dt>
          <dd class="font-medium text-neutral-800 dark:text-neutral-100">
            {formatMoney(transfer.debitLeg.amount, transfer.debitLeg.currency)}
          </dd>
          <dt class="text-neutral-500 dark:text-neutral-400">From</dt>
          <dd class="font-medium text-neutral-800 dark:text-neutral-100">
            {transfer.debitLeg.accountNo} · {transfer.debitLeg.accountTypeName}
            {transfer.debitLeg.balanceAfter &&
              ` · now ${formatMoney(transfer.debitLeg.balanceAfter)}`}
          </dd>
          <dt class="text-neutral-500 dark:text-neutral-400">To</dt>
          <dd class="font-medium text-neutral-800 dark:text-neutral-100">
            {transfer.creditLeg
              ? `${transfer.creditLeg.holderName || transfer.creditLeg.holderKind} · ${transfer.creditLeg.accountNo} · ${transfer.creditLeg.accountTypeName}`
              : `${transfer.debitLeg.payeeName} by ${transfer.debitLeg.methodName}${transfer.debitLeg.methodReference ? ` · ${transfer.debitLeg.methodReference}` : ''}`}
          </dd>
          {transfer.debitLeg.receiptNo && (
            <>
              <dt class="text-neutral-500 dark:text-neutral-400">Receipt</dt>
              <dd class="font-medium text-neutral-800 dark:text-neutral-100">
                <a href={`/receipts/${transfer.debitLeg.id}`} class="underline">
                  {transfer.debitLeg.receiptNo}
                </a>
              </dd>
            </>
          )}
        </dl>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href={`/members/${person.id}`} class={BUTTON}>
            Back to {member ? 'member' : 'customer'}
          </a>
          {transfer.status !== 'posted' && (
            <a
              href={`/transactions/${transfer.debitLeg.id}`}
              class={SECONDARY_SM}
            >
              Follow it
            </a>
          )}
          <a
            href={
              fromTransactions
                ? '/transactions/transfer'
                : `/members/${person.id}/transfer`
            }
            class={SECONDARY_SM}
          >
            Record another
          </a>
        </div>
      </section>
    ) : sources.length === 0 ? (
      <section class={`${CARD} text-sm text-neutral-600 dark:text-neutral-300`}>
        {person.status !== 'active'
          ? `This ${member ? 'member' : 'customer'} is ${person.status}, so nothing can be transferred.`
          : 'None of these accounts allows a transfer out.'}
      </section>
    ) : (
      <>
        <RoutePreview
          groups={routeGroups}
          accountField="sourceAccountId"
          initialAccountId={values.sourceAccountId}
          initialAmountCents={initialCents}
        />
        <form method="post" data-transfer-form class={FORM_CARD}>
          <input
            type="hidden"
            name="idempotencyKey"
            value={values.idempotencyKey}
          />

          <label class={LABEL}>
            From
            <select name="sourceAccountId" class={INPUT}>
              {accounts.map(account => (
                <option
                  value={account.id}
                  selected={account.id === values.sourceAccountId}
                  disabled={
                    !(account.status === 'active' && account.allowsTransfer)
                  }
                  data-available={account.available}
                  data-floor={account.floor}
                >
                  {account.accountNo} · {account.accountTypeName} ·{' '}
                  {formatMoney(account.balance)}
                  {account.pendingDebits !== '0.00' &&
                    ` · ${formatMoney(account.available)} available`}
                  {account.status !== 'active'
                    ? ` · ${account.status}`
                    : account.allowsTransfer
                      ? ''
                      : ' · no transfers'}
                </option>
              ))}
            </select>
          </label>
          <p
            data-available-note
            class="text-xs text-neutral-500 dark:text-neutral-400"
          ></p>

          <label class={LABEL}>
            Amount (Rs)
            <input
              type="text"
              inputmode="decimal"
              name="amount"
              required
              value={values.amount}
              class={INPUT}
            />
          </label>

          <fieldset class="space-y-3">
            <legend class="text-sm text-neutral-600 dark:text-neutral-300">
              To
            </legend>
            <label class={CHECK_LABEL}>
              <input
                type="radio"
                name="destinationKind"
                value="own"
                checked={values.destinationKind === 'own'}
                class={RADIO}
              />
              Another of {member ? 'their' : 'the customer’s'} accounts
            </label>
            <div data-destination="own" class="pl-6">
              <select name="ownAccountId" class={INPUT}>
                {ownTargets.map(account => (
                  <option
                    value={account.id}
                    selected={account.id === values.ownAccountId}
                  >
                    {account.accountNo} · {account.accountTypeName} ·{' '}
                    {formatMoney(account.balance)}
                  </option>
                ))}
              </select>
            </div>
            <label class={CHECK_LABEL}>
              <input
                type="radio"
                name="destinationKind"
                value="other"
                checked={values.destinationKind === 'other'}
                class={RADIO}
              />
              Another member’s or customer’s account
            </label>
            <div
              data-destination="other"
              class="grid gap-3 pl-6 sm:grid-cols-2"
            >
              <label class={LABEL}>
                Account type
                <select name="otherTypeId" class={INPUT}>
                  {lookupTypes.map(type => (
                    <option
                      value={type.id}
                      selected={type.id === values.otherTypeId}
                      data-membership-default={
                        type.isMembershipDefault ? 'true' : 'false'
                      }
                      data-prefix={type.numberPrefix ?? ''}
                    >
                      {type.name}
                    </option>
                  ))}
                </select>
              </label>
              <label class={LABEL}>
                <span data-number-label>Member number</span>
                <input
                  type="text"
                  name="otherNumber"
                  autocomplete="off"
                  value={values.otherNumber}
                  data-number
                  placeholder="AB0001"
                  class={INPUT}
                />
              </label>
            </div>
            <label class={CHECK_LABEL}>
              <input
                type="radio"
                name="destinationKind"
                value="payee"
                checked={values.destinationKind === 'payee'}
                class={RADIO}
              />
              Someone without an account here
            </label>
            <div
              data-destination="payee"
              class="grid gap-3 pl-6 sm:grid-cols-2"
            >
              <label class={`${LABEL} sm:col-span-2`}>
                Paid to
                <input
                  type="text"
                  name="payeeName"
                  value={values.payeeName}
                  maxlength="200"
                  class={INPUT}
                />
              </label>
              <label class={LABEL}>
                Paid by
                <select name="method" class={INPUT}>
                  {paymentMethods.map(method => (
                    <option
                      value={method.code}
                      data-requires-reference={
                        method.requiresReference || method.touchesBank
                          ? 'true'
                          : 'false'
                      }
                      data-touches-bank={method.touchesBank ? 'true' : 'false'}
                      selected={method.code === values.method}
                    >
                      {method.name}
                    </option>
                  ))}
                </select>
              </label>
              <label data-method-reference-field class={LABEL}>
                Reference (cheque number, transfer reference)
                <input
                  type="text"
                  name="methodReference"
                  value={values.methodReference}
                  class={INPUT}
                />
              </label>
              <label data-bank-account-field class={LABEL}>
                Bank account
                <select name="bankAccountId" class={INPUT}>
                  <option value="">Choose…</option>
                  {bankAccounts.map(account => (
                    <option
                      value={account.id}
                      selected={account.id === values.bankAccountId}
                    >
                      {account.name} · {account.bankName}
                    </option>
                  ))}
                </select>
              </label>
            </div>
          </fieldset>

          <label class={LABEL}>
            Note
            <input
              type="text"
              name="reason"
              value={values.reason}
              maxlength="200"
              class={INPUT}
            />
          </label>

          <div class="flex flex-wrap gap-2 pt-2">
            <button type="submit" class={BUTTON}>
              Record transfer
            </button>
            <a href={`/members/${person.id}`} class={SECONDARY_SM}>
              Cancel
            </a>
          </div>
        </form>
      </>
    )}
  </div>
</DashboardLayout>

<script>
  // A visual nudge only — every rule is enforced server-side
  // (ledger/transfers.ts) whether or not this script runs: which
  // destination's fields show, what is available on the source, and
  // whether the pay-out method carries a reference.
  const form = document.querySelector<HTMLFormElement>('[data-transfer-form]');
  if (form) {
    const sourceSelect = form.querySelector<HTMLSelectElement>(
      '[name="sourceAccountId"]'
    );
    const note = form.querySelector<HTMLElement>('[data-available-note]');
    const methodSelect =
      form.querySelector<HTMLSelectElement>('[name="method"]');
    const referenceField = form.querySelector<HTMLElement>(
      '[data-method-reference-field]'
    );
    const bankField = form.querySelector<HTMLElement>(
      '[data-bank-account-field]'
    );
    const typeSelect = form.querySelector<HTMLSelectElement>(
      '[name="otherTypeId"]'
    );
    const numberLabel = form.querySelector<HTMLElement>('[data-number-label]');
    const numberInput = form.querySelector<HTMLInputElement>('[data-number]');
    const money = (value: string) =>
      `Rs ${Number(value).toLocaleString('en-GB', { minimumFractionDigits: 2 })}`;
    const recompute = () => {
      const chosen = form.querySelector<HTMLInputElement>(
        'input[name="destinationKind"]:checked'
      )?.value;
      for (const block of form.querySelectorAll<HTMLElement>(
        '[data-destination]'
      )) {
        block.hidden = block.dataset.destination !== chosen;
      }
      const account = sourceSelect?.selectedOptions[0];
      if (note && account) {
        const available = account.dataset.available ?? '0';
        const floor = account.dataset.floor ?? '0';
        const room = Math.max(0, Number(available) - Number(floor));
        note.textContent =
          Number(floor) > 0
            ? `${money(available)} available; the account keeps at least ${money(floor)}, so up to ${money(room.toFixed(2))} can be transferred.`
            : `${money(available)} available.`;
      }
      const method = methodSelect?.selectedOptions[0];
      if (referenceField) {
        referenceField.hidden = method?.dataset.requiresReference !== 'true';
      }
      if (bankField) {
        bankField.hidden = method?.dataset.touchesBank !== 'true';
      }
      const type = typeSelect?.selectedOptions[0];
      const own = type?.dataset.membershipDefault === 'true';
      const prefix = type?.dataset.prefix || 'HSA';
      if (numberLabel) {
        numberLabel.textContent = own ? 'Member number' : 'Account number';
      }
      if (numberInput)
        numberInput.placeholder = own ? 'AB0001' : `${prefix}0001`;
    };
    form.addEventListener('change', recompute);
    recompute();
  }
</script>
