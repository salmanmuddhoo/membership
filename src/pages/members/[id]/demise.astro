---
// Start a deceased member's claim (S-1704): who is paid — the nominee the
// member named, or another person — and how. What this makes is a draft;
// the death certificate and the affidavit are filed on the next screen and
// the officer submits it from there.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { offeredPaymentMethods } from '@lib/config/reference';
import {
  claimTotals,
  demiseInFlightFor,
  DemiseError,
  nomineeFor,
  startDemise,
  PERMISSION_CAPTURE,
} from '@lib/ledger/demises';
import { loadMember } from '@lib/members/create';
import { formatMoney } from '@lib/payments/money';

const principal = Astro.locals.principal!;
if (!principal.permissions.has(PERMISSION_CAPTURE)) {
  return Astro.redirect('/denied');
}

const { id } = Astro.params;
const member = id ? await loadMember(id) : null;
if (!member) return new Response('Not found', { status: 404 });

const inFlight = await demiseInFlightFor(member.id);
if (inFlight) return Astro.redirect(`/transactions/${inFlight.id}`);

const [nominee, totals, paymentMethods] = await Promise.all([
  nomineeFor(member.id),
  claimTotals(member.id),
  offeredPaymentMethods(),
]);

let values = {
  kind: nominee ? 'nominee' : 'other',
  name: '',
  nic: '',
  address: '',
  relation: '',
  email: '',
  mobile: '',
  method: paymentMethods[0]?.code ?? '',
  methodReference: '',
  reason: '',
};
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const text = (name: string) => String(form.get(name) ?? '');
  values = {
    kind: text('kind'),
    name: text('name'),
    nic: text('nic'),
    address: text('address'),
    relation: text('relation'),
    email: text('email'),
    mobile: text('mobile'),
    method: text('method'),
    methodReference: text('methodReference'),
    reason: text('reason'),
  };
  try {
    const claim = await startDemise(
      {
        memberId: member.id,
        claimant: {
          kind: values.kind === 'nominee' ? 'nominee' : 'other',
          name: values.name,
          nic: values.nic,
          address: values.address,
          relation: values.relation,
          email: values.email,
          mobile: values.mobile,
        },
        method: values.method,
        methodReference: values.methodReference,
        reason: values.reason,
      },
      principal
    );
    return Astro.redirect(`/demises/${claim.id}?step=documents`);
  } catch (err) {
    if (err instanceof DemiseError) {
      error = err.message;
    } else {
      console.error('[members/demise]', err);
      error = 'Something went wrong. Please try again.';
    }
  }
}

const INPUT =
  'mt-1 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100';
---

<DashboardLayout
  title="Demised claim · Al Barakah MCSL"
  heading="Demised claim"
>
  <div class="mx-auto max-w-3xl space-y-6">
    <a
      href={`/members/${member.id}`}
      class="inline-block text-sm text-neutral-500 underline dark:text-neutral-400"
    >
      ← {member.name} · {member.memberNo}
    </a>

    {error && (
      <div class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
        {error}
      </div>
    )}

    <section class="space-y-3 rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
      <h2 class="text-sm font-semibold text-neutral-700 uppercase dark:text-neutral-200">
        Entitlements
      </h2>
      <ul class="divide-y divide-neutral-200 text-sm dark:divide-neutral-800">
        {totals.accounts.map(account => (
          <li class="flex items-center justify-between py-2">
            <span class="text-neutral-800 dark:text-neutral-100">
              {account.accountNo} · {account.typeName}
            </span>
            <span class="tabular-nums">{formatMoney(account.balance)}</span>
          </li>
        ))}
        <li class="flex items-center justify-between py-2">
          <span class="text-neutral-800 dark:text-neutral-100">
            Takaful benefit
          </span>
          <span class="tabular-nums">{formatMoney(totals.takafulBenefit)}</span>
        </li>
        <li class="flex items-center justify-between py-2 font-semibold">
          <span>Total</span>
          <span class="tabular-nums">{formatMoney(totals.total)}</span>
        </li>
      </ul>
    </section>

    <form
      method="post"
      data-claimant-form
      class="space-y-4 rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950"
    >
      <h2 class="text-sm font-semibold text-neutral-700 uppercase dark:text-neutral-200">
        Claimant
      </h2>
      <div class="space-y-2 text-sm text-neutral-700 dark:text-neutral-200">
        {nominee && (
          <label class="flex items-start gap-3">
            <input
              type="radio"
              name="kind"
              value="nominee"
              checked={values.kind === 'nominee'}
              class="mt-1"
            />
            <span>
              <span class="font-medium">Nominee: {nominee.name}</span>
              <span class="block text-xs text-neutral-500 dark:text-neutral-400">
                {[nominee.nic, nominee.address].filter(Boolean).join(' · ')}
              </span>
            </span>
          </label>
        )}
        <label class="flex items-start gap-3">
          <input
            type="radio"
            name="kind"
            value="other"
            checked={values.kind === 'other'}
            class="mt-1"
          />
          <span class="font-medium">Another person</span>
        </label>
      </div>
      <div
        data-other-fields
        class="grid gap-3 sm:grid-cols-2"
        hidden={values.kind !== 'other'}
      >
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          Name
          <input type="text" name="name" value={values.name} class={INPUT} />
        </label>
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          NIC
          <input type="text" name="nic" value={values.nic} class={INPUT} />
        </label>
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          Address
          <input
            type="text"
            name="address"
            value={values.address}
            class={INPUT}
          />
        </label>
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          Relation to the member
          <input
            type="text"
            name="relation"
            value={values.relation}
            class={INPUT}
          />
        </label>
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          Email
          <input type="email" name="email" value={values.email} class={INPUT} />
        </label>
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          Mobile
          <input type="tel" name="mobile" value={values.mobile} class={INPUT} />
        </label>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          Paid out by
          <select name="method" class={INPUT}>
            {paymentMethods.map(method => (
              <option
                value={method.code}
                selected={method.code === values.method}
              >
                {method.name}
              </option>
            ))}
          </select>
        </label>
        <label class="text-sm text-neutral-600 dark:text-neutral-300">
          Reference (cheque number, transfer reference)
          <input
            type="text"
            name="methodReference"
            value={values.methodReference}
            class={INPUT}
          />
        </label>
      </div>
      <label class="block text-sm text-neutral-600 dark:text-neutral-300">
        Note
        <input
          type="text"
          name="reason"
          value={values.reason}
          maxlength="500"
          class={INPUT}
        />
      </label>
      <p class="text-xs text-neutral-500 dark:text-neutral-400">
        The total is paid out when the claim is approved, as the accounts stand
        then. Every account closes and the membership ends.
      </p>
      <button
        type="submit"
        class="bg-mint-300 hover:bg-mint-400 rounded-lg px-4 py-2 text-sm font-bold text-neutral-800 transition"
      >
        Continue to documents
      </button>
    </form>
  </div>
</DashboardLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-claimant-form]');
  const other = form?.querySelector<HTMLElement>('[data-other-fields]');
  if (form && other) {
    const refresh = () => {
      const picked = form.querySelector<HTMLInputElement>(
        'input[name="kind"]:checked'
      );
      other.hidden = picked?.value !== 'other';
    };
    form.addEventListener('change', refresh);
    refresh();
  }
</script>
