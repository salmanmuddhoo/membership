---
// Start closing one of a person's accounts (S-1702): which account and
// why. What this makes is a draft; the member signs the request on the
// next screen and the officer submits it from there. The payout is the
// Treasurer's to record at disbursement, except where the matrix posts
// the closure at once — then the submit step (closures/[id].astro) asks
// for it, as submitting is the posting.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { accountBalance } from '@lib/ledger/ledger';
import {
  ClosureError,
  closuresInFlightFor,
  startClosure,
  PERMISSION_CAPTURE,
} from '@lib/ledger/closures';
import { loadCustomer, loadMember } from '@lib/members/create';
import { formatMoney } from '@lib/payments/money';
import {
  PAGE,
  HINT,
  CARD,
  FORM_CARD,
  LABEL,
  INPUT,
  BUTTON,
  NOTICE_ERROR,
} from '@lib/ui';

const principal = Astro.locals.principal!;
if (!principal.permissions.has(PERMISSION_CAPTURE)) {
  return Astro.redirect('/denied');
}

const { id } = Astro.params;
const member = id ? await loadMember(id) : null;
const customer = !member && id ? await loadCustomer(id) : null;
if (!member && !customer) return new Response('Not found', { status: 404 });
const person = (member ?? customer)!;
const personLabel = member
  ? `${member.name} · ${member.memberNo}`
  : person.name;

const closing = await closuresInFlightFor(
  member ? { memberId: member.id } : { customerId: customer!.id }
);
const closable = await Promise.all(
  person.accounts
    .filter(
      a =>
        a.status === 'active' &&
        !('isMembershipDefault' in a && a.isMembershipDefault) &&
        !closing.has(a.id)
    )
    .map(async a => ({
      ...a,
      balance: (await accountBalance(a.id))?.balance ?? '0.00',
    }))
);
const requestedAccount = Astro.url.searchParams.get('account') ?? '';

let values = {
  accountId:
    closable.find(a => a.id === requestedAccount)?.id ?? closable[0]?.id ?? '',
  reason: '',
};
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const text = (name: string) => String(form.get(name) ?? '');
  values = {
    accountId: text('accountId'),
    reason: text('reason'),
  };
  if (!person.accounts.some(a => a.id === values.accountId)) {
    error = 'Choose which account is closing.';
  } else {
    try {
      const closure = await startClosure(values, principal);
      return Astro.redirect(`/closures/${closure.id}?step=signature`);
    } catch (err) {
      if (err instanceof ClosureError) {
        error = err.message;
      } else {
        console.error('[members/close]', err);
        error = 'Something went wrong. Please try again.';
      }
    }
  }
}
---

<DashboardLayout
  title="Close an account · Al Barakah MCSL"
  heading="Close an account"
>
  <div class={PAGE.form}>
    <a href={`/members/${id}`} class={`${HINT} inline-block underline`}>
      ← {personLabel}
    </a>

    {error && <div class={NOTICE_ERROR}>{error}</div>}

    {closable.length === 0 ? (
      <p class={`${CARD} text-sm text-neutral-600 dark:text-neutral-300`}>
        No account here can close. Shares and the Multiplier Savings Account go
        together: leaving them is a resignation.
      </p>
    ) : (
      <form method="post" class={FORM_CARD}>
        <label class={LABEL}>
          Account
          <select name="accountId" class={INPUT}>
            {closable.map(account => (
              <option
                value={account.id}
                selected={account.id === values.accountId}
              >
                {account.accountNo} · {account.accountTypeName} ·{' '}
                {formatMoney(account.balance)}
              </option>
            ))}
          </select>
        </label>
        <label class={LABEL}>
          Reason
          <textarea
            name="reason"
            rows="3"
            required
            maxlength="500"
            class={INPUT}
          >{values.reason}</textarea>
        </label>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">
          The balance is paid out when the closure is approved, as it stands
          then.
        </p>
        <button type="submit" class={BUTTON}>
          Continue to signature
        </button>
      </form>
    )}
  </div>
</DashboardLayout>
