---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { loadMember, loadCustomer } from '@lib/members/create';
import {
  ApplicationError,
  loadApplication,
  startMembershipApplicationFromCustomer,
} from '@lib/applications/capture';
import { forDisplay } from '@lib/applications/phone';
import {
  paymentsForApplication,
  paymentsForMember,
  METHOD_LABELS,
  type Payment,
} from '@lib/payments/payments';
import { formatMoney } from '@lib/payments/money';
import {
  checklistFor,
  documentsForMember,
  type MemberDocumentGroup,
} from '@lib/documents/documents';

const principal = Astro.locals.principal!;
const canSeePayments = principal.permissions.has('payment.view');
const canSeeDocuments = principal.permissions.has('document.view');
// Officer feedback: who may turn a non-member customer into a membership
// applicant is its own, narrower question than who may capture applications
// generally — configurable on its own under Configuration -> Roles
// (migration 0031), not tied to application.capture.
const canConvertCustomer = principal.permissions.has('member.convert');

const { id } = Astro.params;
// Two different tables (member, customer — migration 0027), and no way to
// know which this id belongs to without asking: an account rows says which
// (member_id vs customer_id) but the id here names the person, not their
// account. S-614's own "not all members" — member is tried first only
// because it is the far more common case, not because a customer is any
// less a real record.
const member = id ? await loadMember(id) : null;
const customer = !member && id ? await loadCustomer(id) : null;
if (!member && !customer) return new Response('Not found', { status: 404 });

let error: string | null = null;

// S-614: a non-member applying to become one. Handled here, on their own
// page, rather than on /applications/new — that page starts an application
// from nothing, and this one starts from what customer_account capture
// already collected.
if (Astro.request.method === 'POST' && customer) {
  if (!canConvertCustomer) {
    error = 'You do not have permission to do this.';
  } else {
    const form = await Astro.request.formData();
    if (String(form.get('intent') ?? '') === 'apply-for-membership') {
      try {
        const created = await startMembershipApplicationFromCustomer(
          customer.id,
          { userId: principal.userId, email: principal.email }
        );
        // Officer feedback: parties are prefilled, but the officer still
        // needs to look them over — and, for a minor, add the guardian
        // details a customer_account application never asked for — before
        // print and signature are the right next step. Explicit rather
        // than left to the id page's own default landing spot, which reads
        // as already signed and ready to move on.
        return Astro.redirect(`/applications/${created.id}?step=1`);
      } catch (err) {
        if (err instanceof ApplicationError) {
          error = err.message;
        } else {
          console.error('[members/apply-for-membership]', err);
          error = 'Something went wrong. Please try again.';
        }
      }
    }
  }
}

// What has been paid: for a member, including the receipt that admitted
// them (paymentsForMember reads member_id and, falling back, the
// application that created them — they did not exist when that one was
// taken). A customer carries no such member_id-equivalent column on
// payment; the account-opening receipt is the only one there ever is today,
// and it is found the same way it was on the application itself.
const payments: Payment[] = canSeePayments
  ? member
    ? await paymentsForMember(member.id)
    : await paymentsForApplication(customer!.applicationId)
  : [];

// Officer feedback: what has been filed for this person, everywhere it was
// filed — a member can have more than one application on file (the founding
// membership application plus any additional_account application since),
// each carrying its own checklist; a customer only ever has the one. Only
// what has actually been uploaded — the checklist's own Missing rows belong
// on the application page, not this summary.
const documentGroups: MemberDocumentGroup[] = canSeeDocuments
  ? member
    ? await documentsForMember(member.id, member.applicationId)
    : customer!.applicationId
      ? [
          {
            applicationId: customer!.applicationId,
            applicationReference: customer!.applicationReference!,
            entries: (
              await checklistFor({ applicationId: customer!.applicationId })
            ).filter(entry => entry.uploadedAt !== null),
          },
        ].filter(g => g.entries.length > 0)
      : []
  : [];

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'short',
});

// Phone values are stored in E.164; +23057891234 is not what anyone wants to
// read off a screen.
const PHONE_KEYS = new Set(['mobile', 'telephone', 'contact_telephone']);
const applicantValues = (member ?? customer)!.applicantValues;
const details = Object.entries(applicantValues).map(([key, value]) => ({
  key,
  label: key.replace(/_/g, ' '),
  value: PHONE_KEYS.has(key) ? forDisplay(value) : value,
}));

// Officer feedback: the applicant's own details are the person; a nominee
// (or, for a minor, the successor guardian and Takaful beneficiary) is who
// this record concerns beyond them, and both belong on the same page. Read
// from the application itself — the member/customer record only ever kept
// the applicant's own values (loadMember/loadCustomer above) — via the
// applicationId both already carry.
const SUBJECT_LABELS: Record<string, string> = {
  nominee: 'Nominee',
  guardian: 'Parent / Guardian',
  beneficiary: 'Takaful beneficiary',
  employment: 'Employment Details',
};
const applicationId = (member ?? customer)!.applicationId;
const sourceApplication = applicationId
  ? await loadApplication(applicationId)
  : null;
// Officer feedback: a membership type that captures two nominees writes a
// row for each the moment the form is drafted (saveDraft, capture.ts) — one
// exists in application_party whether or not the officer ever filled it in.
// Left in, an untouched Nominee 2 showed up here as a heading over nothing.
// Filtered out by whether anything was actually entered, not by presence of
// the row — and before subjectOccurrences below, so a member with only
// Nominee 1 filled in reads "Nominee", not "Nominee 1" for the one that
// remains.
const otherParties = (sourceApplication?.parties ?? [])
  .filter(p => p.subject !== 'applicant')
  .filter(p => Object.values(p.values).some(value => value.trim() !== ''));
const subjectOccurrences = otherParties.reduce<Record<string, number>>(
  (counts, p) => {
    counts[p.subject] = (counts[p.subject] ?? 0) + 1;
    return counts;
  },
  {}
);
const otherPartyGroups = otherParties.map(p => ({
  key: `${p.subject}-${p.ordinal}`,
  label:
    (SUBJECT_LABELS[p.subject] ?? p.subject) +
    (subjectOccurrences[p.subject] > 1 ? ` ${p.ordinal}` : ''),
  details: Object.entries(p.values)
    .filter(([, value]) => value.trim() !== '')
    .map(([key, value]) => ({
      key,
      label: key.replace(/_/g, ' '),
      value: PHONE_KEYS.has(key) ? forDisplay(value) : value,
    })),
}));

const name = (member ?? customer)!.name;
const status = (member ?? customer)!.status;
const joinedAt = (member ?? customer)!.joinedAt;
const applicationReference = (member ?? customer)!.applicationReference;
const pageTitle = member ? member.memberNo : name;
---

<DashboardLayout
  title={`${pageTitle} · Al Barakah MCSL`}
  heading={member ? `Member ${member.memberNo}` : name}
>
  <div class="mx-auto max-w-4xl space-y-6">
    <a
      href="/members"
      class="inline-block text-sm text-neutral-500 underline dark:text-neutral-400"
      >← All members</a
    >

    {
      error && (
        <div class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200">
          {error}
        </div>
      )
    }

    <section
      class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950"
    >
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <h2
          class="text-lg font-semibold text-neutral-800 dark:text-neutral-100"
        >
          {name}
        </h2>
        {
          member && (
            <code class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
              {member.memberNo}
            </code>
          )
        }
        {
          customer && (
            <span class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
              Non-member
            </span>
          )
        }
        <span
          class="bg-mint-200 dark:bg-mint-900 rounded px-1.5 py-0.5 text-xs text-neutral-800 dark:text-neutral-100"
        >
          {status}
        </span>
      </div>
      <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
        {member && `${member.membershipTypeName} · `}joined {
          dateFormat.format(joinedAt)
        }
        {
          applicationReference && (
            <>
              {' '}
              · from application{' '}
              <span class="font-medium">{applicationReference}</span>
            </>
          )
        }
        {
          member?.capturedByName && (
            <>
              {' '}
              · captured by{' '}
              <span class="font-medium">{member.capturedByName}</span>
            </>
          )
        }
      </p>

      {
        details.length > 0 && (
          <dl class="mt-5 grid gap-x-6 gap-y-2 sm:grid-cols-2">
            {details.map(d => (
              <div class="flex gap-2 text-sm">
                <dt class="min-w-32 text-neutral-500 capitalize dark:text-neutral-400">
                  {d.label}
                </dt>
                <dd class="text-neutral-800 dark:text-neutral-100">
                  {d.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        customer && customer.status === 'active' && canConvertCustomer && (
          <form
            method="post"
            class="mt-5 border-t border-neutral-200 pt-4 dark:border-neutral-800"
          >
            <input type="hidden" name="intent" value="apply-for-membership" />
            <button
              type="submit"
              class="bg-mint-300 hover:bg-mint-400 rounded-lg px-3 py-1.5 text-sm font-bold text-neutral-800 transition"
            >
              Apply to become a member
            </button>
          </form>
        )
      }
    </section>

    {
      otherPartyGroups.length > 0 && (
        <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
          <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
            Nominee
          </h2>
          <div class="mt-4 space-y-4">
            {otherPartyGroups.map(group => (
              <div>
                <h3 class="text-sm font-semibold text-neutral-700 dark:text-neutral-200">
                  {group.label}
                </h3>
                <dl class="mt-2 grid gap-x-6 gap-y-2 sm:grid-cols-2">
                  {group.details.map(d => (
                    <div class="flex gap-2 text-sm">
                      <dt class="min-w-32 text-neutral-500 capitalize dark:text-neutral-400">
                        {d.label}
                      </dt>
                      <dd class="text-neutral-800 dark:text-neutral-100">
                        {d.value}
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section
      class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950"
    >
      <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
        Accounts
      </h2>
      {
        (member ?? customer)!.accounts.length === 0 ? (
          <p class="mt-1 text-sm text-red-700 dark:text-red-300">
            {member
              ? 'This member has no account. That should not be possible — the default account is opened at the same moment as the member. Please report it.'
              : customer!.status === 'converted'
                ? 'Moved to their new membership when it was approved.'
                : 'No account has opened yet.'}
          </p>
        ) : (
          <ul class="mt-4 space-y-3">
            {(member ?? customer)!.accounts.map(account => (
              <li class="rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <code class="font-medium text-neutral-800 dark:text-neutral-100">
                    {account.accountNo}
                  </code>
                  <span class="text-sm text-neutral-600 dark:text-neutral-300">
                    {account.accountTypeName}
                  </span>
                  {'isMembershipDefault' in account &&
                    account.isMembershipDefault && (
                      <span class="bg-mint-200 dark:bg-mint-900 rounded px-1.5 py-0.5 text-xs text-neutral-800 dark:text-neutral-100">
                        opened on approval
                      </span>
                    )}
                  <span class="text-xs text-neutral-500 dark:text-neutral-400">
                    {account.category} · {account.status} · opened{' '}
                    {dateFormat.format(account.openedAt)}
                  </span>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      canSeeDocuments && (
        <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
          <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
            Documents
          </h2>
          {documentGroups.length === 0 ? (
            <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
              Nothing filed for {member ? 'this member' : 'them'} yet.
            </p>
          ) : (
            <div class="mt-4 space-y-5">
              {documentGroups.map(group => (
                <div>
                  {documentGroups.length > 1 && (
                    <h3 class="text-sm font-semibold text-neutral-700 dark:text-neutral-200">
                      {group.applicationReference}
                    </h3>
                  )}
                  <ul class="mt-2 space-y-2">
                    {group.entries.map(entry => (
                      <li class="flex items-center justify-between gap-3 rounded-xl border border-neutral-200 bg-white px-4 py-3 dark:border-neutral-800 dark:bg-neutral-900">
                        <span class="font-medium text-neutral-800 dark:text-neutral-100">
                          {entry.documentName}
                        </span>
                        <button
                          type="button"
                          data-view-document
                          data-document-id={entry.documentId}
                          class="shrink-0 font-medium text-neutral-700 underline hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-neutral-100"
                        >
                          View
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </section>
      )
    }

    {
      canSeeDocuments && (
        <dialog
          id="document-viewer-dialog"
          class="fixed top-1/2 left-1/2 m-0 h-[85vh] w-[95vw] max-w-3xl -translate-x-1/2 -translate-y-1/2 rounded-2xl border border-neutral-200 bg-white p-0 text-neutral-800 backdrop:bg-neutral-900/50 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-100"
        >
          <div class="flex items-center justify-between gap-3 border-b border-neutral-200 px-5 py-3 dark:border-neutral-800">
            <p
              data-viewer-name
              class="truncate text-sm font-semibold text-neutral-800 dark:text-neutral-100"
            />
            <button
              type="button"
              data-viewer-close
              class="shrink-0 rounded-lg border border-neutral-300 px-2.5 py-1 text-xs font-medium text-neutral-600 transition hover:bg-neutral-100 dark:border-neutral-600 dark:text-neutral-300 dark:hover:bg-neutral-800"
            >
              Close
            </button>
          </div>
          <div
            data-viewer-body
            class="flex h-[calc(85vh-3rem)] items-center justify-center overflow-auto p-4 text-sm"
          >
            Loading…
          </div>
        </dialog>
      )
    }

    {
      canSeePayments && (
        <section class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950">
          <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
            Payments
          </h2>
          {payments.length === 0 ? (
            <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
              Nothing recorded against this member.
            </p>
          ) : (
            <ul class="mt-4 space-y-3">
              {payments.map(payment => (
                <li class="rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <a
                      href={`/receipts/${payment.id}`}
                      class="font-medium text-neutral-800 underline dark:text-neutral-100"
                    >
                      {payment.receiptNo}
                    </a>
                    <span class="font-medium text-neutral-800 tabular-nums dark:text-neutral-100">
                      {payment.kind === 'refund' && '−'}
                      {formatMoney(payment.totalAmount, payment.currency)}
                    </span>
                    {payment.kind === 'refund' && (
                      <span class="rounded bg-amber-100 px-1.5 py-0.5 text-xs text-amber-900 dark:bg-amber-950 dark:text-amber-200">
                        refund of {payment.refundsReceiptNo}
                      </span>
                    )}
                    {payment.voidedAt && (
                      <span class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-700 dark:bg-neutral-700 dark:text-neutral-200">
                        void
                      </span>
                    )}
                    <span class="text-xs text-neutral-500 dark:text-neutral-400">
                      {METHOD_LABELS[payment.method]} ·{' '}
                      {dateFormat.format(payment.receivedAt)} · taken by{' '}
                      {payment.recordedByName}
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }
  </div>
</DashboardLayout>

<script>
  // S-403, S-404 · Viewing a filed document — identical to the application
  // pages' own script for the same endpoint (documents.ts is generic across
  // application kinds, and this reads it back the same way regardless of
  // which application actually filed it).
  //
  // Officer feedback: this used to be window.open(url), which handed the
  // browser a SharePoint download link — a save-to-disk prompt on some
  // devices before the file could even be looked at. An <img> or a PDF's own
  // <iframe> viewer renders the same URL in place instead, closed with an
  // explicit Close rather than left to guess when a new tab was done with it.
  const viewerDialog = document.getElementById(
    'document-viewer-dialog'
  ) as HTMLDialogElement | null;
  const viewerName =
    viewerDialog?.querySelector<HTMLElement>('[data-viewer-name]');
  const viewerBody =
    viewerDialog?.querySelector<HTMLElement>('[data-viewer-body]');
  const viewerClose = viewerDialog?.querySelector<HTMLButtonElement>(
    '[data-viewer-close]'
  );

  if (viewerDialog && viewerName && viewerBody && viewerClose) {
    viewerClose.addEventListener('click', () => viewerDialog.close());
    // Emptying the body on close, not just on the next open: a filled
    // <iframe> or <img> left behind keeps loading, or keeps playing, in a
    // dialog that is supposedly shut.
    viewerDialog.addEventListener('close', () => {
      viewerBody.replaceChildren();
    });

    for (const viewButton of document.querySelectorAll<HTMLButtonElement>(
      '[data-view-document]'
    )) {
      viewButton.addEventListener('click', async () => {
        const documentId = viewButton.dataset.documentId;
        if (!documentId) return;

        const original = viewButton.textContent;
        viewButton.disabled = true;
        viewButton.textContent = 'Opening…';

        try {
          const response = await fetch('/api/v1/documents/view-url', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ documentId }),
          });
          const body = await response.json();
          if (!response.ok) {
            throw new Error(
              body?.error?.message ?? 'The file could not be opened.'
            );
          }
          const {
            url,
            fileName,
            contentType,
          }: { url: string; fileName: string; contentType: string } = body.data;

          viewerName.textContent = fileName;
          viewerBody.replaceChildren();
          if (
            contentType.startsWith('image/') &&
            contentType !== 'image/heic'
          ) {
            const img = document.createElement('img');
            img.src = url;
            img.alt = fileName;
            img.className = 'max-h-full max-w-full object-contain';
            viewerBody.appendChild(img);
          } else if (contentType === 'application/pdf') {
            const frame = document.createElement('iframe');
            frame.src = url;
            frame.title = fileName;
            frame.className = 'h-full w-full';
            viewerBody.appendChild(frame);
          } else {
            // HEIC (no browser renders it inline) and anything unforeseen:
            // still openable, just not previewable here.
            const p = document.createElement('p');
            p.className = 'text-center text-neutral-600 dark:text-neutral-300';
            p.textContent = "This file type can't be previewed here.";
            const link = document.createElement('a');
            link.href = url;
            link.target = '_blank';
            link.rel = 'noopener';
            link.className = 'mt-2 inline-block underline';
            link.textContent = 'Open in a new tab';
            const wrap = document.createElement('div');
            wrap.className = 'text-center';
            wrap.append(p, link);
            viewerBody.appendChild(wrap);
          }
          viewerDialog.showModal();
        } catch (error) {
          await window.appAlert(
            error instanceof Error
              ? error.message
              : 'The file could not be opened.'
          );
        } finally {
          viewButton.disabled = false;
          viewButton.textContent = original;
        }
      });
    }
  }
</script>
