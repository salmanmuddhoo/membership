---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { listMembers } from '@lib/members/create';

const search = Astro.url.searchParams.get('q') ?? '';
const { members, total, truncated } = await listMembers({ search });

const dateFormat = new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium' });
---

<DashboardLayout title="Members · Al Barakah MCSL" heading="Members">
  <div class="mx-auto max-w-5xl space-y-6">
    <section
      class="rounded-2xl border border-neutral-200 bg-neutral-100 p-6 dark:border-neutral-800 dark:bg-neutral-950"
    >
      <h2 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">
        Members
      </h2>
      <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
        Created automatically when the President approves an application, with a
        Member ID that stays theirs for the lifetime of the system (FRD 7.5).
      </p>

      <form method="get" class="mt-5 flex flex-wrap items-center gap-2">
        <label for="q" class="sr-only">Search members</label>
        <input
          id="q"
          type="search"
          name="q"
          value={search}
          placeholder="Search by Member ID or name"
          class="focus:border-mint-400 focus:ring-mint-400 min-w-64 flex-1 rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-sm text-neutral-800 dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
        />
        <button
          type="submit"
          class="rounded-lg border border-neutral-300 px-3 py-1.5 text-sm font-medium text-neutral-700 transition hover:bg-neutral-100 dark:border-neutral-600 dark:text-neutral-200 dark:hover:bg-neutral-800"
        >
          Search
        </button>
        {
          search && (
            <a
              href="/members"
              class="px-2 py-1.5 text-sm text-neutral-500 underline dark:text-neutral-400"
            >
              Clear
            </a>
          )
        }
      </form>

      <p class="mt-3 text-sm text-neutral-500 dark:text-neutral-400">
        {
          total === 0
            ? search
              ? `No members match “${search}”.`
              : 'No members yet. One is created when an application is approved.'
            : truncated
              ? `Showing the first ${members.length} of ${total} members — search to narrow the list.`
              : `${total} member${total === 1 ? '' : 's'}.`
        }
      </p>

      {
        members.length > 0 && (
          <div class="mt-4 overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-xs text-neutral-500 dark:text-neutral-400">
                  <th class="py-2 pr-4 font-medium">Member ID</th>
                  <th class="py-2 pr-4 font-medium">Name</th>
                  <th class="py-2 pr-4 font-medium">Type</th>
                  <th class="py-2 pr-4 font-medium">Status</th>
                  <th class="py-2 pr-4 font-medium">From</th>
                  <th class="py-2 font-medium">Joined</th>
                </tr>
              </thead>
              <tbody>
                {members.map(m => (
                  <tr class="border-t border-neutral-200 dark:border-neutral-800">
                    <td class="py-2 pr-4">
                      <a
                        href={`/members/${m.id}`}
                        class="text-mint-700 dark:text-mint-300 font-medium underline"
                      >
                        {m.memberNo}
                      </a>
                    </td>
                    <td class="py-2 pr-4 text-neutral-700 dark:text-neutral-200">
                      {m.name}
                    </td>
                    <td class="py-2 pr-4 text-neutral-600 dark:text-neutral-300">
                      {m.membershipTypeName}
                    </td>
                    <td class="py-2 pr-4 text-neutral-600 dark:text-neutral-300">
                      {m.status}
                    </td>
                    <td class="py-2 pr-4 text-xs text-neutral-500 dark:text-neutral-400">
                      {m.applicationReference ?? '—'}
                    </td>
                    <td class="py-2 text-xs text-neutral-500 dark:text-neutral-400">
                      {dateFormat.format(m.joinedAt)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>
  </div>
</DashboardLayout>
