---
import DashboardLayout from '@layouts/DashboardLayout.astro';
import {
  listMembers,
  MEMBER_LIST_PAGE_SIZE,
  type MemberListAccount,
} from '@lib/members/create';
import { countPendingDetailsRequests } from '@lib/members/details-requests';
import { listAccountTypes } from '@lib/config/reference';
import { formatMoney } from '@lib/payments/money';
import { statusLabel } from '@lib/members/labels';
import { shownStatus } from '@lib/members/status';
import {
  PAGE,
  CARD,
  CARD_TITLE,
  HINT,
  INPUT_BARE,
  SECONDARY_SM,
  DIALOG,
  DIALOG_HEADER,
  SECONDARY_XS,
  TABLE,
  THEAD,
  TH,
  ROW,
  TD,
  TD_NUM,
} from '@lib/ui';

const principal = Astro.locals.principal!;
const canSeePayments = principal.permissions.has('payment.view');

// Members correcting their own details from the app queue up for
// verification (docs/member-app.md). Surfaced here rather than only on its
// own page: nobody visits a page they have no reason to think has anything
// on it, and a member waiting on a verification is waiting on someone
// noticing.
const pendingDetailsUpdates = await countPendingDetailsRequests();

const search = Astro.url.searchParams.get('q') ?? '';
// Performance QA: past the first 100, members were reachable only by
// searching. A page of 100 at a time, the search kept across pages.
const page = Math.max(Number(Astro.url.searchParams.get('page')) || 1, 1);
const pageHref = (target: number) => {
  const next = new URLSearchParams();
  if (search) next.set('q', search);
  if (target > 1) next.set('page', String(target));
  const query = next.toString();
  return query ? `/members?${query}` : '/members';
};
// Officer feedback: every account button lines up under the others of its
// own type across every row — Investment never under Shares — rather than
// packing left to right per row. A fixed table column per active account
// type, in the same sort_order/name order listMembers' own query returns
// them in, gets that alignment from the browser's own table layout, no
// per-row logic needed.
const [
  { members, total, memberCount, nonMemberCount, formerCount },
  accountTypeColumns,
] = await Promise.all([
  listMembers({ search, offset: (page - 1) * MEMBER_LIST_PAGE_SIZE }),
  listAccountTypes(),
]);
// A page past the end (the list shrank since the link was made) goes back
// to the first.
if (members.length === 0 && page > 1) return Astro.redirect(pageHref(1));
const totalPages = Math.max(Math.ceil(total / MEMBER_LIST_PAGE_SIZE), 1);
const firstShown = (page - 1) * MEMBER_LIST_PAGE_SIZE + 1;
const lastShown = firstShown + members.length - 1;
const activeAccountTypeColumns = accountTypeColumns.filter(t => t.isActive);

const dateFormat = new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium' });

// Officer feedback: the account's own number, styled by what kind of
// account it is, is the identity a colleague reads off this list — not a
// plain id column up front. Matched on the account type's code and name
// rather than a fixed set this schema knows by name (Configuration ->
// Account types is where HSA and Investment, like every other account
// type, are actually defined — migrations 0025/0027) so a type added later
// still gets a button, just the same neutral one an unrecognised name
// falls back to.
// Officer feedback: the hover highlight had square corners and the row's
// own text overflowed it. A <tr>'s background does not respect
// border-radius (table row backgrounds paint as one rectangle behind every
// cell, corners included), so the highlight lives on each <td> instead,
// tied to the row via Tailwind's group/group-hover rather than :hover on
// the <tr> directly. `first:`/`last:` rounds whichever cell actually ends
// up first or last — the first is always Name, but the last is either an
// Accounts cell or Total funds depending on canSeePayments and how many
// account types are active, never hardcoded here — and adds the padding
// that keeps the row's own text clear of that curve instead of running
// into it.
const ROW_HOVER =
  'group-hover:bg-neutral-200/60 dark:group-hover:bg-neutral-900 first:rounded-l-lg first:pl-4 last:rounded-r-lg last:pr-4';

function accountButtonClasses(account: MemberListAccount): string {
  const key = `${account.code} ${account.name}`.toLowerCase();
  if (key.includes('hsa')) {
    return 'bg-blue-600 text-white dark:bg-blue-500';
  }
  if (key.includes('invest')) {
    return 'bg-rose-200 text-rose-900 dark:bg-rose-300 dark:text-rose-950';
  }
  if (key.includes('shares')) {
    return 'bg-amber-400 text-neutral-900 dark:bg-amber-500 dark:text-neutral-900';
  }
  if (key.includes('msa')) {
    return 'bg-indigo-500 text-white dark:bg-indigo-400 dark:text-neutral-950';
  }
  return 'bg-slate-500 text-white dark:bg-slate-600';
}
---

<DashboardLayout title="Members · Al Barakah MCSL" heading="Members">
  <div class={PAGE.list}>
    <section class={CARD}>
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class={CARD_TITLE}>Members</h2>
        {pendingDetailsUpdates > 0 && (
          <a
            href="/members/details-updates"
            class="rounded-lg bg-amber-100 px-3 py-1.5 text-sm font-medium text-amber-900 transition hover:bg-amber-200 dark:bg-amber-950 dark:text-amber-200 dark:hover:bg-amber-900"
          >
            {pendingDetailsUpdates} details update
            {pendingDetailsUpdates === 1 ? '' : 's'} to verify
          </a>
        )}
      </div>

      <form method="get" class="mt-5 flex flex-wrap items-center gap-2">
        <label for="q" class="sr-only">
          Search members
        </label>
        <input
          id="q"
          type="search"
          name="q"
          value={search}
          placeholder="Search by ID or name"
          class={`${INPUT_BARE} min-w-64 flex-1 text-neutral-800`}
        />
        <button type="submit" class={SECONDARY_SM}>
          Search
        </button>
        {search && (
          <a href="/members" class={`${HINT} px-2 py-1.5 underline`}>
            Clear
          </a>
        )}
      </form>

      <p class={`${HINT} mt-3`}>
        {total === 0
          ? search
            ? `No members match “${search}”.`
            : 'No members yet. One is created when an application is approved.'
          : (() => {
              // Officer feedback: split the count into members (their
              // membership is open) and non-members (a customer, or a
              // resigned member, still holding an open account); LC-10
              // adds former — a resigned or demised member, or a customer,
              // with nothing open — shown only when there is one to report.
              const breakdown =
                `${memberCount} member${memberCount === 1 ? '' : 's'}, ` +
                `${nonMemberCount} non-member${nonMemberCount === 1 ? '' : 's'}` +
                (formerCount > 0 ? `, ${formerCount} former` : '');
              return totalPages > 1
                ? `${firstShown}–${lastShown} of ${total} — ${breakdown}.`
                : `${breakdown}.`;
            })()}
      </p>

      {members.length > 0 && (
        <div class="mt-4 overflow-x-auto">
          <table class={TABLE} data-sortable>
            <thead>
              <tr class={THEAD}>
                <th class={TH}>Name</th>
                <th class={TH}>Status</th>
                <th class={TH}>Joined</th>
                {activeAccountTypeColumns.length === 0 ? (
                  <th class={TH} data-no-sort>
                    Accounts
                  </th>
                ) : (
                  activeAccountTypeColumns.map((_, i) => (
                    <th class={TH} data-no-sort>
                      {i === 0 ? 'Accounts' : ''}
                    </th>
                  ))
                )}
                {canSeePayments && (
                  <th class={`${TH} text-right`}>Total funds</th>
                )}
              </tr>
            </thead>
            <tbody>
              {members.map(m => (
                <tr
                  data-href={`/members/${m.id}`}
                  class={`${ROW} group cursor-pointer`}
                >
                  <td
                    class={`${TD} text-neutral-700 dark:text-neutral-200 ${ROW_HOVER}`}
                    data-sort-value={m.name}
                  >
                    <span class="flex flex-wrap items-center gap-x-2">
                      {m.name}
                      {m.nonMember && (
                        <span class="rounded bg-neutral-200 px-1.5 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
                          Non-member
                        </span>
                      )}
                    </span>
                  </td>
                  <td
                    class={`${TD} text-neutral-600 dark:text-neutral-300 ${ROW_HOVER}`}
                  >
                    {statusLabel(shownStatus(m.status, m.nonMember))}
                  </td>
                  <td
                    class={`${TD} text-xs text-neutral-500 dark:text-neutral-400 ${ROW_HOVER}`}
                    data-sort-value={m.joinedAt.toISOString()}
                  >
                    {dateFormat.format(m.joinedAt)}
                  </td>
                  {activeAccountTypeColumns.length === 0 ? (
                    <td class={`${TD} ${ROW_HOVER}`}>
                      {m.accountBadges.length === 0 && (
                        <span class="text-xs text-neutral-400 dark:text-neutral-500">
                          —
                        </span>
                      )}
                    </td>
                  ) : (
                    activeAccountTypeColumns.map(type => {
                      const account = m.accountBadges.find(
                        a => a.code === type.code
                      );
                      return (
                        <td class={`${TD} ${ROW_HOVER}`}>
                          {account &&
                            (canSeePayments ? (
                              <button
                                type="button"
                                data-account-id={account.id}
                                data-account-name={account.name}
                                data-account-no={account.no}
                                data-account-balance={account.balance}
                                data-account-balance-label={formatMoney(
                                  account.balance
                                )}
                                class:list={[
                                  'cursor-pointer rounded-md px-2 py-1 text-xs font-semibold whitespace-nowrap',
                                  accountButtonClasses(account),
                                ]}
                                title={account.name}
                              >
                                {account.no}
                              </button>
                            ) : (
                              <span
                                class:list={[
                                  'rounded-md px-2 py-1 text-xs font-semibold whitespace-nowrap',
                                  accountButtonClasses(account),
                                ]}
                                title={account.name}
                              >
                                {account.no}
                              </span>
                            ))}
                        </td>
                      );
                    })
                  )}
                  {canSeePayments && (
                    <td
                      class={`${TD_NUM} font-medium text-neutral-800 dark:text-neutral-100 ${ROW_HOVER}`}
                      data-sort-value={m.totalFunds}
                    >
                      {formatMoney(m.totalFunds)}
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {totalPages > 1 && (
        <div class="mt-4 flex items-center justify-between gap-2 text-sm">
          {page > 1 ? (
            <a href={pageHref(page - 1)} class={SECONDARY_SM}>
              ← Previous
            </a>
          ) : (
            <span />
          )}
          <span class={HINT}>
            Page {page} of {totalPages}
          </span>
          {page < totalPages ? (
            <a href={pageHref(page + 1)} class={SECONDARY_SM}>
              Next →
            </a>
          ) : (
            <span />
          )}
        </div>
      )}
    </section>

    {canSeePayments && (
      <dialog
        id="account-transactions-dialog"
        class={`${DIALOG} w-[90vw] max-w-lg p-0`}
      >
        <div class={DIALOG_HEADER}>
          <div>
            <p
              data-dialog-name
              class="text-sm font-semibold text-neutral-800 dark:text-neutral-100"
            />
            <code
              data-dialog-no
              class="text-xs text-neutral-500 dark:text-neutral-400"
            />
            <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-300">
              Balance{' '}
              <span
                data-dialog-balance
                class="font-bold text-neutral-900 dark:text-neutral-100"
              />
            </p>
          </div>
          <button type="button" data-dialog-close class={SECONDARY_XS}>
            Close
          </button>
        </div>
        <div
          data-dialog-body
          class="max-h-[60vh] overflow-y-auto px-5 py-4 text-sm"
        >
          Loading…
        </div>
      </dialog>
    )}
  </div>
</DashboardLayout>

<script>
  import { wireSortableTables } from '@lib/client/table-sort';

  // Officer feedback: the row itself opens the member's full record — the
  // account buttons inside it are their own click target (see below), so a
  // click landing on one of those must not also navigate the row.
  for (const row of document.querySelectorAll<HTMLTableRowElement>(
    'tr[data-href]'
  )) {
    row.addEventListener('click', e => {
      const target = e.target as HTMLElement;
      if (target.closest('a, button')) return;
      const href = row.dataset.href;
      if (href) window.location.assign(href);
    });
  }

  // Officer feedback: clicking an HSA/Investment/etc. button opens a popup
  // with every credit and debit recorded against that account — read only,
  // and closed explicitly rather than dismissed by clicking elsewhere, so a
  // stray tap on the backdrop cannot be mistaken for reading it.
  const dialog = document.getElementById(
    'account-transactions-dialog'
  ) as HTMLDialogElement | null;
  const dialogName = dialog?.querySelector<HTMLElement>('[data-dialog-name]');
  const dialogNo = dialog?.querySelector<HTMLElement>('[data-dialog-no]');
  const dialogBalance = dialog?.querySelector<HTMLElement>(
    '[data-dialog-balance]'
  );
  const dialogBody = dialog?.querySelector<HTMLElement>('[data-dialog-body]');
  const dialogClose = dialog?.querySelector<HTMLButtonElement>(
    '[data-dialog-close]'
  );

  if (
    dialog &&
    dialogName &&
    dialogNo &&
    dialogBalance &&
    dialogBody &&
    dialogClose
  ) {
    dialogClose.addEventListener('click', () => dialog.close());
    // QA-15: a click on the backdrop closes the dialog too, not only Escape
    // and Close. A click landing on the dialog's own content bubbles with a
    // target inside it; one on the backdrop bubbles with the dialog element
    // itself as the target, which is how the two are told apart here.
    dialog.addEventListener('click', e => {
      if (e.target === dialog) dialog.close();
    });

    const amountFormat = (amount: string) =>
      Number(amount).toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
    const dateFormat = (iso: string) =>
      new Date(iso).toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });

    for (const button of document.querySelectorAll<HTMLButtonElement>(
      '[data-account-id]'
    )) {
      button.addEventListener('click', () => {
        const accountId = button.dataset.accountId;
        if (!accountId) return;

        dialogName.textContent = button.dataset.accountName ?? '';
        dialogNo.textContent = button.dataset.accountNo ?? '';
        dialogBalance.textContent = button.dataset.accountBalanceLabel ?? '';
        dialogBody.textContent = 'Loading…';
        dialog.showModal();

        fetch(`/api/v1/accounts/${accountId}/transactions`)
          .then(response => {
            if (!response.ok) throw new Error(String(response.status));
            return response.json();
          })
          .then(
            (body: {
              data?: {
                transactions: {
                  type: 'credit' | 'debit';
                  amount: string;
                  currency: string;
                  occurredAt: string;
                  description: string;
                }[];
              };
            }) => {
              const transactions = body.data?.transactions ?? [];
              if (transactions.length === 0) {
                dialogBody.textContent =
                  'Nothing recorded against this account.';
                return;
              }

              dialogBody.innerHTML = '';
              const list = document.createElement('ul');
              list.className = 'space-y-2';
              for (const t of transactions) {
                const item = document.createElement('li');
                item.className =
                  'flex items-center justify-between gap-3 rounded-lg border border-neutral-200 bg-white px-3 py-2 dark:border-neutral-800 dark:bg-neutral-900';
                const left = document.createElement('div');
                const description = document.createElement('p');
                description.className =
                  'font-medium text-neutral-800 dark:text-neutral-100';
                description.textContent = t.description;
                const date = document.createElement('p');
                date.className =
                  'text-xs text-neutral-500 dark:text-neutral-400';
                date.textContent = dateFormat(t.occurredAt);
                left.append(description, date);

                const amount = document.createElement('span');
                amount.className =
                  t.type === 'debit'
                    ? 'font-semibold tabular-nums text-red-700 dark:text-red-300'
                    : 'font-semibold tabular-nums text-emerald-700 dark:text-emerald-300';
                amount.textContent = `${t.type === 'debit' ? '−' : '+'}${t.currency} ${amountFormat(t.amount)}`;

                item.append(left, amount);
                list.appendChild(item);
              }
              dialogBody.appendChild(list);
            }
          )
          .catch(() => {
            dialogBody.textContent = 'Could not load this account.';
          });
      });
    }
  }

  wireSortableTables();
</script>
