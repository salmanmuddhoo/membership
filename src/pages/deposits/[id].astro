---
// A large cash deposit as a request (S-1306): the details, the depositor's
// signature on the Source of Fund form, and the submission that posts it —
// the same shape as a closure request (closures/[id].astro), once it is
// clear the form needs a second pair of eyes rather than a tick box.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import {
  cancelDepositRequest,
  sourceOfFundItem,
  submitDepositRequest,
  updateDepositRequest,
} from '@lib/ledger/deposit-requests';
import { DepositError, loadDeposit } from '@lib/ledger/deposits';
import { DocumentError, removeFiledDocument } from '@lib/documents/documents';
import DocumentViewer from '@components/DocumentViewer.astro';
import ChainTimeline from '@components/ChainTimeline.astro';
import { chainTimeline } from '@lib/workflow/timeline';
import { formatMoney } from '@lib/payments/money';
import {
  PAGE,
  FORM_CARD,
  CARD_LABEL,
  MUTED,
  LABEL,
  INPUT,
  BUTTON,
  DANGER,
  NOTICE_ERROR,
  PANEL,
  PILL_WARN,
  SECONDARY_SM,
  ICON_BUTTON_DANGER,
  TAG,
} from '@lib/ui';

const principal = Astro.locals.principal!;
const { id } = Astro.params;
let deposit = id ? await loadDeposit(id) : null;
if (
  !deposit ||
  deposit.kind !== 'deposit' ||
  deposit.status !== 'draft' ||
  deposit.capturedById !== principal.userId
) {
  return new Response('Not found', { status: 404 });
}

const STEPS = ['details', 'signature', 'submit'] as const;
type Step = (typeof STEPS)[number];
const base = `/deposits/${deposit.id}`;

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const text = (name: string) => String(form.get(name) ?? '');
  const intent = text('intent');
  try {
    if (intent === 'details') {
      deposit = await updateDepositRequest(
        deposit.id,
        { amount: text('amount'), reason: text('reason') },
        principal
      );
      return Astro.redirect(`${base}?step=signature`);
    } else if (intent === 'submit') {
      await submitDepositRequest(deposit.id, principal);
      return Astro.redirect(`/transactions/${deposit.id}`);
    } else if (intent === 'remove-form') {
      // The form on THIS request, read here rather than taken from the
      // page: the id in a POST is not a pointer into anyone's documents.
      const current = (await sourceOfFundItem(deposit.id))?.filed;
      if (current) await removeFiledDocument(current.documentId, principal);
      return Astro.redirect(`${base}?step=signature`);
    } else if (intent === 'cancel') {
      await cancelDepositRequest(deposit.id, principal);
      return Astro.redirect(
        `/members/${deposit.memberId ?? deposit.customerId}`
      );
    }
  } catch (err) {
    if (err instanceof DepositError || err instanceof DocumentError) {
      error = err.message;
    } else {
      console.error('[deposits]', err);
      error = 'Something went wrong. Please try again.';
    }
  }
}

const requested = Astro.url.searchParams.get('step') ?? 'details';
const step: Step = (STEPS as readonly string[]).includes(requested)
  ? (requested as Step)
  : 'details';

const item = await sourceOfFundItem(deposit.id);
// The request's chevron: Details, the Source of Fund form, then the route
// the matrix will send it on — each of this page's steps a link.
const timeline = (await chainTimeline('transaction', deposit.id)) ?? [];
const stepHrefs: Record<string, string> = {
  details: `${base}?step=details`,
  signature: `${base}?step=signature`,
  capture: `${base}?step=submit`,
};
const filed = item?.filed ?? null;
const canSubmit = !!filed && filed.state !== 'rejected';

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});
---

<DashboardLayout
  title={`${deposit.reference} · Al Barakah MCSL`}
  heading={`Cash deposit ${deposit.reference}`}
>
  <div class={PAGE.detail}>
    <div class="-mx-4 flex flex-wrap items-center justify-between gap-2 border-t border-neutral-200/80 bg-neutral-100/95 px-4 py-3 text-sm sm:mx-0 sm:rounded-b-2xl sm:px-3 sm:py-1.5 dark:border-neutral-800/80 dark:bg-neutral-950/95">
      <a
        href={`/members/${deposit.memberId ?? deposit.customerId}`}
        class="text-neutral-500 underline dark:text-neutral-400"
      >
        ← Back
      </a>
      <span class={TAG}>
        {deposit.accountNo} · {deposit.accountTypeName} ·{' '}
        {formatMoney(deposit.amount)}
      </span>
    </div>

    <ChainTimeline
      steps={timeline}
      hrefs={stepHrefs}
      label="Deposit progress"
    />

    {error && <div class={NOTICE_ERROR}>{error}</div>}

    {step === 'details' && (
      <form method="post" class={FORM_CARD}>
        <h2 class={CARD_LABEL}>Details</h2>
        <dl class="grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
          <dt class="text-neutral-500 dark:text-neutral-400">Account</dt>
          <dd class="font-medium text-neutral-800 dark:text-neutral-100">
            {deposit.accountNo} · {deposit.accountTypeName}
          </dd>
        </dl>
        <label class={LABEL}>
          Amount (Rs)
          <input
            type="text"
            inputmode="decimal"
            name="amount"
            required
            value={deposit.amount}
            class={INPUT}
          />
        </label>
        <label class={LABEL}>
          Reason
          <input
            type="text"
            name="reason"
            value={deposit.reason}
            class={INPUT}
          />
        </label>
        <div class="flex flex-wrap gap-2 pt-2">
          <button type="submit" class={BUTTON} name="intent" value="details">
            Save
          </button>
          <button
            type="submit"
            class={DANGER}
            name="intent"
            value="cancel"
            formnovalidate
          >
            Cancel request
          </button>
        </div>
      </form>
    )}

    {step === 'signature' && (
      <section class={FORM_CARD}>
        <h2 class={CARD_LABEL}>Signature</h2>
        {!item ? (
          <p class="text-sm text-red-700 dark:text-red-300">
            The Source of Fund form document type is not configured. Ask an
            administrator.
          </p>
        ) : !filed ? (
          <div class="flex flex-wrap gap-2">
            <a href={`${base}/form`} class={BUTTON}>
              Sign the Source of Fund form
            </a>
          </div>
        ) : (
          <>
            <div
              class={`${PANEL} flex flex-wrap items-center justify-between gap-3`}
            >
              <div class="min-w-0">
                <p class="truncate font-medium text-neutral-800 dark:text-neutral-100">
                  {filed.fileName}
                </p>
                <p class={MUTED}>
                  Signed {dateFormat.format(filed.uploadedAt)} ·{' '}
                  {filed.uploadedByName}
                </p>
              </div>
              <div class="flex shrink-0 flex-wrap items-center gap-2">
                {filed.state === 'rejected' && (
                  <span class={PILL_WARN}>Rejected</span>
                )}
                <button
                  type="button"
                  data-view-document
                  data-document-id={filed.documentId}
                  class={SECONDARY_SM}
                >
                  View
                </button>
                <form method="post" data-confirm-remove>
                  <button
                    type="submit"
                    name="intent"
                    value="remove-form"
                    aria-label="Delete the signed form"
                    title="Delete"
                    class={ICON_BUTTON_DANGER}
                  >
                    ✕
                  </button>
                </form>
              </div>
            </div>
            {filed.state === 'rejected' && (
              <p class="text-sm text-red-700 dark:text-red-300">
                Rejected. Delete it and sign the form again.
              </p>
            )}
            <div class="flex flex-wrap gap-2">
              <a href={`${base}?step=submit`} class={BUTTON}>
                Next
              </a>
            </div>
          </>
        )}
      </section>
    )}

    {step === 'submit' && (
      <form method="post" class={FORM_CARD}>
        <h2 class={CARD_LABEL}>Submit</h2>
        <dl class="grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
          <dt class="text-neutral-500 dark:text-neutral-400">Account</dt>
          <dd class="font-medium text-neutral-800 dark:text-neutral-100">
            {deposit.accountNo} · {deposit.accountTypeName}
          </dd>
          <dt class="text-neutral-500 dark:text-neutral-400">Amount</dt>
          <dd class="font-medium text-neutral-800 dark:text-neutral-100">
            {formatMoney(deposit.amount)}
          </dd>
          <dt class="text-neutral-500 dark:text-neutral-400">Method</dt>
          <dd class="text-neutral-800 dark:text-neutral-100">
            {deposit.methodName}
          </dd>
          <dt class="text-neutral-500 dark:text-neutral-400">Reason</dt>
          <dd class="text-neutral-800 dark:text-neutral-100">
            {deposit.reason}
          </dd>
        </dl>
        <div class="flex flex-wrap items-center gap-2 pt-2">
          <button
            type="submit"
            class={BUTTON}
            name="intent"
            value="submit"
            disabled={!canSubmit}
          >
            Submit
          </button>
          <button
            type="submit"
            class={DANGER}
            name="intent"
            value="cancel"
            formnovalidate
          >
            Cancel request
          </button>
        </div>
        {!filed ? (
          <p class={MUTED}>
            Sign the Source of Fund form first.{' '}
            <a href={`${base}/form`} class="underline">
              Sign it now
            </a>
          </p>
        ) : filed.state === 'rejected' ? (
          <p class={MUTED}>
            The Source of Fund form was rejected.{' '}
            <a href={`${base}?step=signature`} class="underline">
              Delete it and sign again
            </a>
          </p>
        ) : null}
      </form>
    )}
  </div>
  {filed && <DocumentViewer />}
</DashboardLayout>

<script>
  // A destructive action warns once.
  for (const form of document.querySelectorAll<HTMLFormElement>(
    'form[data-confirm-remove]'
  )) {
    form.addEventListener('submit', event => {
      if (!confirm('Delete the signed Source of Fund form?')) {
        event.preventDefault();
      }
    });
  }
</script>
