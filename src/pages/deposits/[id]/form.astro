---
// The Cash Deposit Form for a deposit request (S-1306): a sheet, like the
// account closure request, read on screen, signed on the pad, rasterised and
// filed against the request. What is filed is this sheet as the depositor
// saw it, not a second rendering of it.
import BaseLayout from '@layouts/BaseLayout.astro';
import { depositorForApplication } from '@lib/applications/depositor';
import { cashSourceOfFundChecklist } from '@lib/config/reference';
import { sourceOfFundItem } from '@lib/ledger/deposit-requests';
import { loadDeposit } from '@lib/ledger/deposits';
import { loadCustomer, loadMember } from '@lib/members/create';
import { formatMoney } from '@lib/payments/money';

const principal = Astro.locals.principal!;
const { id } = Astro.params;
const deposit = id ? await loadDeposit(id) : null;
if (
  !deposit ||
  deposit.kind !== 'deposit' ||
  deposit.status !== 'draft' ||
  deposit.capturedById !== principal.userId
) {
  return new Response('Not found', { status: 404 });
}

const holder = deposit.memberId
  ? await loadMember(deposit.memberId)
  : await loadCustomer(deposit.customerId!);

// Who hands over the money, as against whose account it goes into — a
// guardian for a Minor, a Contact Person for a Corporate entity, as the
// receipt names them. Falling back to the holder's own name and NIC where
// that cannot be read, as the paper form did.
const depositor = await depositorForApplication(holder?.applicationId ?? null);
const holderName = depositor.name || holder?.name || '';
const nic = (
  depositor.name ? depositor.nic : (holder?.applicantValues?.nic ?? '')
).trim();

const item = await sourceOfFundItem(deposit.id);
const checklistItems = await cashSourceOfFundChecklist();
// Back to the first step of the request, not the one this page left from.
const back = `/deposits/${deposit.id}?step=details`;
const next = `/deposits/${deposit.id}?step=signature`;
const dateFormat = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });

const PURPOSES = [
  'Shares',
  'Donation/Gift',
  'Repayment of loan',
  'Deposit',
] as const;
---

<BaseLayout title={`${deposit.reference} · Cash Deposit Form`}>
  <div
    class="form-page"
    data-transaction-id={deposit.id}
    data-reference={deposit.reference}
    data-document-type-id={item?.documentTypeId ?? ''}
    data-next={next}
    data-filed-document-id={item?.filed?.documentId ?? ''}
  >
    <header class="head">
      <div>
        <h1>AL BARAKAH MCSL</h1>
        <p class="sub">CASH DEPOSIT FORM</p>
      </div>
      <div class="ref">
        <p>
          <strong>{deposit.reference}</strong>
        </p>
        <p>{dateFormat.format(new Date())}</p>
      </div>
    </header>

    <div class="box">
      <div class="row">
        <span class="label">NAME:</span>
        <span class="value">{holderName || <i class="blank" />}</span>
      </div>
      <div class="row">
        <span class="label">NIC / PASSPORT NO:</span>
        <span class="value">{nic || <i class="blank" />}</span>
      </div>
      <div class="row">
        <span class="label">RUPEES:</span>
        <span class="value">{formatMoney(deposit.amount)}</span>
      </div>
      <div class="row">
        <span class="label">Date:</span>
        <span class="value">{dateFormat.format(new Date())}</span>
      </div>
      <div class="row purpose">
        <p class="label">Purpose:</p>
        <div class="grid">
          {PURPOSES.map(purpose => (
            <label>
              <input type="checkbox" data-purpose value={purpose} />
              <span>{purpose}</span>
            </label>
          ))}
          <label>
            <input type="checkbox" data-purpose-other />
            <span>Others...</span>
          </label>
        </div>
        <p class="specify">
          <label>
            <i>(Please Specify:</i>
            <input type="text" data-purpose-specify />
            <i>)</i>
          </label>
        </p>
      </div>
    </div>

    <p class="certify">
      I hereby certify that the source of funds of this deposit is from:
    </p>
    {checklistItems.length > 0 ? (
      <ul class="sources">
        {checklistItems.map(source => (
          <li>
            <label>
              <input type="checkbox" data-source value={source} />
              <span>{source}</span>
            </label>
          </li>
        ))}
      </ul>
    ) : (
      <p class="missing no-print">
        No source-of-funds list is configured. An administrator sets one from
        Configuration → Fee schedules.
      </p>
    )}

    <p class="certify">
      I hereby certify that this deposit does not directly or indirectly
      originate from or is not in any way whatsoever connected with any illicit
      financial activity, pursuant to any Anti-Money Laundering Legislation in
      force in the Republic of Mauritius.
    </p>

    <div class="sign">
      <p class="label">DEPOSITOR'S SIGNATURE:</p>
      <div class="sig-pad">
        <div class="sig-line"></div>
        <img class="sig-image" data-sig-image alt="" hidden />
      </div>
      <div class="sig-controls no-print">
        <button type="button" data-sig-open>
          Sign
        </button>
        <button type="button" data-sig-clear hidden>
          Clear
        </button>
      </div>
    </div>

    <div class="actions no-print">
      <div class="actions-start">
        <a href={back}>← Back to the request</a>
      </div>
      <div class="actions-centre">
        {item && (
          <button type="button" id="file-form" disabled>
            Upload to SharePoint
          </button>
        )}
      </div>
      <div class="actions-end"></div>
    </div>
    <p data-status class="status-line no-print" aria-live="polite">
      {item?.filed
        ? `On file: ${item.filed.fileName}. Signing again replaces it.`
        : 'Tick what applies, have the depositor sign, then upload.'}
    </p>
  </div>
</BaseLayout>

<style>
  /* A sheet a person reads and signs, set in absolute units against white,
     exactly as the Cash Deposit Form on an application is. */
  .form-page {
    max-width: 190mm;
    margin: 0 auto;
    padding: 12mm 10mm;
    background: #fff;
    color: #111;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11pt;
    line-height: 1.5;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 6mm;
    margin-bottom: 8mm;
  }
  .head h1 {
    margin: 0;
    font-size: 15pt;
    letter-spacing: 1px;
  }
  .head .sub {
    margin: 1mm 0 0;
    font-size: 12pt;
    font-weight: bold;
    letter-spacing: 1px;
  }
  .head .ref {
    text-align: right;
    font-size: 9pt;
  }
  .head .ref p {
    margin: 0;
  }
  .box {
    border: 1px solid #111;
    border-bottom: none;
    margin-bottom: 6mm;
  }
  .box .row {
    border-bottom: 1px solid #111;
    padding: 2.5mm 3mm;
  }
  .label {
    font-weight: bold;
  }
  .label + .value {
    margin-left: 1.5mm;
  }
  .value {
    font-weight: normal;
  }
  .blank {
    display: inline-block;
    min-width: 60mm;
    border-bottom: 1px solid #999;
  }
  .purpose .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1mm 6mm;
    margin-top: 1.5mm;
  }
  .purpose label,
  .sources label {
    display: flex;
    align-items: flex-start;
    gap: 2mm;
  }
  .purpose .specify {
    margin: 2mm 0 0;
    font-style: italic;
  }
  .purpose .specify label {
    display: flex;
    align-items: center;
    gap: 1mm;
  }
  .purpose .specify input {
    flex: 1;
    border: none;
    border-bottom: 1px solid #999;
    font: inherit;
    font-style: normal;
    padding: 0 1mm;
    background: transparent;
    color: inherit;
  }
  .certify {
    margin: 0 0 4mm;
    text-align: justify;
  }
  .sources {
    list-style: none;
    margin: 0 0 6mm;
    padding-left: 8mm;
  }
  .sources li {
    margin-bottom: 1.5mm;
  }
  .missing {
    font-style: italic;
    color: #9a1c1c;
  }
  .sign {
    margin: 8mm 0 4mm;
  }
  .sign .label {
    margin: 0 0 2mm;
  }
  .sig-pad {
    position: relative;
    height: 28mm;
    border: 1px solid #111;
    margin-bottom: 2mm;
  }
  .sig-line {
    position: absolute;
    left: 6mm;
    right: 6mm;
    bottom: 6mm;
    border-bottom: 1px solid #999;
  }
  .sig-image {
    position: absolute;
    inset: 2mm;
    width: calc(100% - 4mm);
    height: calc(100% - 4mm);
    object-fit: contain;
  }
  .sig-controls {
    display: flex;
    gap: 3mm;
    margin-bottom: 6mm;
  }
  .sig-controls button,
  .actions button {
    font: inherit;
    padding: 1.5mm 4mm;
    border: 1px solid #111;
    background: #fff;
    cursor: pointer;
  }
  .actions button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .actions {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-top: 10mm;
    gap: 4mm;
  }
  .actions-start {
    justify-self: start;
  }
  .actions-end {
    justify-self: end;
  }
  .actions a {
    color: #111;
  }
  .status-line {
    margin-top: 3mm;
    font-size: 9pt;
    color: #555;
  }
  .status-line[data-tone='error'] {
    color: #b00020;
  }
  .capturing .no-print,
  .capturing .sig-controls {
    display: none !important;
  }
  @media print {
    .no-print {
      display: none !important;
    }
  }
</style>

<script>
  import { wireSignedRequestForm } from '@lib/client/signed-request';

  wireSignedRequestForm({
    signatureTitle: "Depositor's signature",
    documentLabel: 'Source of Fund form',
  });
</script>
