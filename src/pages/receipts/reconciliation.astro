---
// The receipt sequence, audited (S-506).
//
// The sequence is only evidence if something checks it. Three findings, all
// from the ledger: a number that never became a receipt, one that was voided,
// and one that appears twice. Nothing is derived from the payments — a
// reconciliation that reads only the payments cannot see a number that never
// reached one, which is the whole point.
import DashboardLayout from '@layouts/DashboardLayout.astro';
import { reconcileReceipts, type ExceptionKind } from '@lib/payments/receipts';
import { formatMoney } from '@lib/payments/money';
import {
  PAGE,
  CARD,
  CARD_TITLE,
  HINT,
  MUTED,
  INPUT,
  BUTTON,
  LABEL,
  TABLE,
  THEAD,
  ROW,
  TH,
  TD,
} from '@lib/ui';

const principal = Astro.locals.principal!;
if (!principal.permissions.has('receipt.reconcile')) {
  return Astro.redirect('/denied');
}

// Default to the current month, which is the period a Treasurer reconciles.
const now = new Date();
const monthStart = new Date(
  Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1)
);
const asDate = (value: Date) => value.toISOString().slice(0, 10);

const params = Astro.url.searchParams;
const parse = (value: string | null, fallback: Date) => {
  if (!value) return fallback;
  const parsed = new Date(`${value}T00:00:00Z`);
  return Number.isNaN(parsed.getTime()) ? fallback : parsed;
};

const from = parse(params.get('from'), monthStart);
const toInclusive = parse(params.get('to'), now);
// The query is half-open, so the last day the officer typed is included.
const to = new Date(toInclusive.getTime() + 24 * 60 * 60 * 1000);

const period = await reconcileReceipts(from, to);

const KIND_LABELS: Record<ExceptionKind, string> = {
  unissued: 'No receipt',
  void: 'Voided',
  duplicate: 'Duplicate number',
  missing: 'Not in the ledger',
};

const KIND_CLASSES: Record<ExceptionKind, string> = {
  unissued: 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-200',
  void: 'bg-neutral-200 text-neutral-700 dark:bg-neutral-700 dark:text-neutral-200',
  duplicate: 'bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-200',
  missing: 'bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-200',
};

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
---

<DashboardLayout
  title="Receipt reconciliation · Al Barakah MCSL"
  heading="Receipt reconciliation"
>
  <div class={PAGE.list}>
    <form method="get" class={`flex flex-wrap items-end gap-3 ${CARD}`}>
      <label class={LABEL}>
        From
        <input type="date" name="from" value={asDate(from)} class={INPUT} />
      </label>
      <label class={LABEL}>
        To
        <input
          type="date"
          name="to"
          value={asDate(toInclusive)}
          class={INPUT}
        />
      </label>
      <button type="submit" class={BUTTON}>
        Show
      </button>
    </form>

    <section class={CARD}>
      <div class="grid gap-4 sm:grid-cols-3">
        <div>
          <p class="text-2xl font-bold text-neutral-800 tabular-nums dark:text-neutral-100">
            {period.issuedCount}
          </p>
          <p class={HINT}>receipts issued</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-neutral-800 tabular-nums dark:text-neutral-100">
            {formatMoney(period.issuedTotal)}
          </p>
          <p class={HINT}>net of refunds</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-neutral-800 tabular-nums dark:text-neutral-100">
            {period.firstSerial === null
              ? '—'
              : `${period.firstSerial}–${period.lastSerial}`}
          </p>
          <p class={HINT}>numbers allocated</p>
        </div>
      </div>
    </section>

    <section class={CARD}>
      <h2 class={CARD_TITLE}>Exceptions</h2>

      {period.exceptions.length === 0 ? (
        /* Said in words. An empty table would read the same whether the
             sequence is clean or the query found nothing to look at. */
        <p class={`mt-3 ${MUTED}`}>
          {period.firstSerial === null
            ? 'No receipt numbers were allocated in this period.'
            : `Every number from ${period.firstSerial} to ${period.lastSerial} is accounted for. No gaps, no duplicates, no voids.`}
        </p>
      ) : (
        <table class={`${TABLE} mt-4`} data-sortable>
          <thead>
            <tr
              class={`${THEAD} border-b border-neutral-300 dark:border-neutral-700`}
            >
              <th class={`${TH} text-neutral-600 dark:text-neutral-300`}>
                Receipt
              </th>
              <th class={`${TH} text-neutral-600 dark:text-neutral-300`}>
                Finding
              </th>
              <th class={`${TH} text-neutral-600 dark:text-neutral-300`}>
                Reason
              </th>
              <th class={`${TH} text-neutral-600 dark:text-neutral-300`}>
                When
              </th>
            </tr>
          </thead>
          <tbody>
            {period.exceptions.map(exception => (
              <tr class={`${ROW} align-top`}>
                <td
                  class={`${TD} font-medium text-neutral-800 tabular-nums dark:text-neutral-100`}
                >
                  {exception.paymentId || exception.transactionId ? (
                    <a
                      href={`/receipts/${exception.paymentId ?? exception.transactionId}`}
                      class="underline"
                    >
                      {exception.receiptNo}
                    </a>
                  ) : (
                    /* No receipt to open. The number was allocated and the
                         payment never happened, which is the finding. */
                    exception.receiptNo
                  )}
                </td>
                <td class={TD}>
                  <span
                    class={`rounded px-1.5 py-0.5 text-xs ${KIND_CLASSES[exception.kind]}`}
                  >
                    {KIND_LABELS[exception.kind]}
                  </span>
                </td>
                <td class={`${TD} text-neutral-600 dark:text-neutral-300`}>
                  {exception.reason || 'Not recorded'}
                </td>
                <td
                  class={`${TD} text-neutral-500 dark:text-neutral-400`}
                  data-sort-value={
                    exception.at ? exception.at.toISOString() : ''
                  }
                >
                  {exception.at ? dateFormat.format(exception.at) : '—'}
                  {exception.who && ` · ${exception.who}`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>
  </div>
</DashboardLayout>

<script>
  import { wireSortableTables } from '@lib/client/table-sort';

  wireSortableTables();
</script>
