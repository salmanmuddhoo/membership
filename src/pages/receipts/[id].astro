---
// The receipt (S-503, S-505).
//
// Two things at once: the sheet the applicant is handed, and the page the
// Treasurer works from. The Treasurer's controls are on screen only — the
// paper carries the receipt and nothing else.
import BaseLayout from '@layouts/BaseLayout.astro';
import { query } from '@lib/db/pool';
import '@styles/receipt.css';
import {
  loadPayment,
  paymentsForApplication,
  printHistoryFor,
  recordReceiptPrint,
  refundableComponents,
  refundPayment,
  voidPayment,
  PaymentError,
  type Payment,
  type PaymentMethod,
  type RefundableComponent,
} from '@lib/payments/payments';
import { formatMoney } from '@lib/payments/money';
import { depositorForApplication } from '@lib/applications/depositor';
import { offeredPaymentMethods } from '@lib/config/reference';
import type { FeeComponentCode } from '@lib/config/reference';
import TransactionReceiptSheet from '@components/TransactionReceiptSheet.astro';
import {
  loadTransactionReceipt,
  recordTransactionReceiptPrint,
  ReceiptError,
  transactionPrintHistory,
  voidTransactionReceipt,
  PERMISSION_VOID,
  type TransactionReceipt,
} from '@lib/ledger/receipts';
import { notifyReceiptIssued } from '@lib/ledger/receipt-notifications';
import { notificationsFor } from '@lib/notifications/notify';

const principal = Astro.locals.principal!;
const canRefund = principal.permissions.has('payment.refund');
const canVoid = principal.permissions.has('payment.void');

const { id: param } = Astro.params;
// By its number, as printed and as an officer types it (QA-06): the
// receipt behind it, a fee receipt or a transaction's. Anything that is
// neither a number nor an id is simply not found, rather than handed to a
// uuid column that throws on it.
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
if (param && /^RCT-\d+$/i.test(param)) {
  const found = await query<{ id: string }>(
    `select coalesce(p.id, t.id) as id
       from receipt_number r
       left join payment p on p.receipt_number_id = r.id
       left join transaction t
         on t.receipt_number_id = r.id
        and t.payment_line_id is null
        and t.payment_account_line_id is null
      where r.receipt_no = upper($1) and coalesce(p.id, t.id) is not null
      order by t.created_at nulls first
      limit 1`,
    [param]
  );
  if (found.rows[0]) return Astro.redirect(`/receipts/${found.rows[0].id}`);
  return new Response('Not found', { status: 404 });
}
const id = param && UUID.test(param) ? param : undefined;
let payment = id ? await loadPayment(id) : null;
// A transaction's receipt shares this page and its sheet (S-1601): the id
// is the transaction's, or the number's.
let transactionReceipt: TransactionReceipt | null =
  !payment && id ? await loadTransactionReceipt(id) : null;
if (!payment && !transactionReceipt) {
  return new Response('Not found', { status: 404 });
}

let error: string | null = null;
let notice: string | null = null;

if (transactionReceipt && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  if (intent === 'record-print') {
    try {
      await recordTransactionReceiptPrint(
        transactionReceipt.transaction.id,
        principal
      );
      return new Response(null, { status: 204 });
    } catch (err) {
      console.error('[receipts/print]', err);
      return new Response(null, { status: 500 });
    }
  }
  // Send it again (S-1602): the same message the ledger sent when the
  // receipt was issued, to whatever address the member has on file now.
  if (intent === 'send') {
    const send = await notifyReceiptIssued(transactionReceipt.transaction.id);
    if (send.notificationIds.length > 0) {
      notice = `Receipt ${transactionReceipt.receiptNo} sent.`;
    } else if (!send.contact?.email && !send.contact?.mobile) {
      error = 'No email address or mobile number on file for this member.';
    } else {
      error = 'Nothing was sent: no wording is active for receipts.';
    }
  }
  if (intent === 'void') {
    try {
      transactionReceipt = await voidTransactionReceipt(
        transactionReceipt.transaction.id,
        String(form.get('reason') ?? ''),
        principal
      );
      notice = `Receipt ${transactionReceipt.receiptNo} voided.`;
    } catch (err) {
      if (err instanceof ReceiptError) {
        error = err.message;
      } else {
        console.error('[receipts]', err);
        error =
          'That could not be done. Nothing has changed — please try again.';
      }
    }
  }
}

const transactionPrints = transactionReceipt
  ? await transactionPrintHistory(transactionReceipt.transaction.id)
  : null;
const transactionSends = transactionReceipt
  ? (await notificationsFor('transaction', transactionReceipt.transaction.id))
      .filter(n => n.eventCode === 'receipt.issued')
      .map(n => ({
        channel: n.channel,
        recipient: n.recipient,
        status: n.status,
        at: n.createdAt,
      }))
  : [];

if (payment && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  // The print is recorded, not rendered, so it answers with nothing and the
  // browser's own print dialog carries on.
  if (intent === 'record-print') {
    try {
      await recordReceiptPrint(payment!.id, principal);
      return new Response(null, { status: 204 });
    } catch (err) {
      console.error('[receipts/print]', err);
      return new Response(null, { status: 500 });
    }
  }

  try {
    if (intent === 'void') {
      const voided = await voidPayment(
        payment!.id,
        String(form.get('reason') ?? ''),
        principal
      );
      payment = voided;
      notice = `Receipt ${voided.receiptNo} voided.`;
    } else if (intent === 'refund') {
      const amounts: Partial<Record<FeeComponentCode, string>> = {};
      for (const [key, value] of form.entries()) {
        if (key.startsWith('refund.')) {
          amounts[key.slice('refund.'.length) as FeeComponentCode] =
            String(value);
        }
      }

      const refund = await refundPayment(
        {
          paymentId: payment!.id,
          method: String(form.get('method') ?? '') as PaymentMethod,
          methodReference: String(form.get('methodReference') ?? ''),
          reason: String(form.get('reason') ?? ''),
          amounts,
        },
        principal
      );
      return Astro.redirect(`/receipts/${refund.id}`);
    }
  } catch (err) {
    if (err instanceof PaymentError) {
      error = err.message;
    } else {
      console.error('[receipts]', err);
      error = 'That could not be done. Nothing has changed — please try again.';
    }
    payment = (await loadPayment(payment!.id)) ?? payment;
  }
}

// None of the three below depends on another — they all read off `payment`
// alone — so they go out together rather than one after another.
const [prints, refundable, related] = payment
  ? await Promise.all([
      printHistoryFor(payment.id),
      canRefund && payment.kind === 'payment' && !payment.voidedAt
        ? refundableComponents(payment.id)
        : Promise.resolve([] as RefundableComponent[]),
      // Refunds already made against this one, so the Treasurer is not
      // deciding blind.
      payment.applicationId
        ? paymentsForApplication(payment.applicationId)
        : Promise.resolve([] as Payment[]),
    ])
  : [
      { count: 0, firstPrintedAt: null, firstPrintedByName: null },
      [] as RefundableComponent[],
      [] as Payment[],
    ];
const isReprint = prints.count > 0;
const anythingRefundable = refundable.some(c => Number(c.refundable) > 0);
const refunds = related.filter(p => p.refundsId === payment?.id && !p.voidedAt);

// Officer feedback: this named the application or the member, never the
// person who actually paid — the applicant's own name, with the reference
// that ties it back to a specific record.
//
// And for two membership types the applicant is still not who paid: a Minor
// cannot pay in for themselves and a Corporate entity is not a person, so
// the guardian and the Contact Person respectively are who stood at the
// counter (depositorFor). "Received from" names them, and the account they
// paid into gets a line of its own so nothing is lost — the same two names
// the Cash Deposit Form filed alongside this receipt carries.
const depositor = payment
  ? await depositorForApplication(payment.applicationId)
  : { name: null };
const reference = payment?.applicationReference ?? payment?.memberNo ?? null;
const paidBy =
  !!payment && !!depositor.name && depositor.name !== payment.applicantName;
const owner = paidBy
  ? depositor.name
  : [payment?.applicantName, reference].filter(Boolean).join(' · ') || '—';
const accountOf = paidBy
  ? [payment?.applicantName, reference].filter(Boolean).join(' · ') || '—'
  : null;
const ownerHref = payment?.applicationId
  ? `/applications/${payment.applicationId}`
  : payment?.memberId
    ? `/members/${payment.memberId}`
    : null;

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'long',
  timeStyle: 'short',
});

// The methods a refund may go back by (S-1307).
const paymentMethods = await offeredPaymentMethods();
---

<BaseLayout
  title={`${payment?.receiptNo ?? transactionReceipt?.receiptNo} · Receipt`}
>
  <div class="screen-only messages">
    {error && <p class="message error">{error}</p>}
    {notice && <p class="message notice">{notice}</p>}
  </div>

  {transactionReceipt && transactionPrints && (
    <TransactionReceiptSheet
      receipt={transactionReceipt}
      prints={transactionPrints}
      canVoid={principal.permissions.has(PERMISSION_VOID)}
      sent={transactionSends}
      canSend={principal.permissions.has('transaction.view')}
    />
  )}

  {payment && (
    <>
      <div class="print-page">
        {payment.voidedAt && <div class="watermark">VOID</div>}

        <header class="head">
          <div>
            <h1>Al Barakah MCSL</h1>
            <p class="sub">
              {payment.kind === 'refund' ? 'Refund' : 'Official receipt'}
            </p>
          </div>
          <div class="ref">
            <p>
              <strong>{payment.receiptNo}</strong>
            </p>
            <p>{dateFormat.format(payment.receivedAt)}</p>
            {isReprint && <p class="reprint">REPRINT</p>}
          </div>
        </header>

        {isReprint && (
          <p class="reprint-note">
            Reprint. First issued {dateFormat.format(prints.firstPrintedAt!)} by{' '}
            {prints.firstPrintedByName}.
          </p>
        )}

        {payment.voidedAt && (
          <p class="void-note">
            Voided {dateFormat.format(payment.voidedAt)} by{' '}
            {payment.voidedByName}. {payment.voidReason}
          </p>
        )}

        <dl class="facts">
          <div class="row">
            <dt>Received from</dt>
            <dd>{owner}</dd>
          </div>
          {accountOf && (
            <div class="row">
              <dt>Account of</dt>
              <dd>{accountOf}</dd>
            </div>
          )}
          <div class="row">
            <dt>Method</dt>
            <dd>
              {payment.methodName}
              {payment.methodReference && ` · ${payment.methodReference}`}
            </dd>
          </div>
          {payment.refundsReceiptNo && (
            <div class="row">
              <dt>Refund of</dt>
              <dd>{payment.refundsReceiptNo}</dd>
            </div>
          )}
          <div class="row">
            <dt>Received by</dt>
            <dd>
              {payment.recordedByName}
              {payment.recordedByRole && ` · ${payment.recordedByRole}`}
            </dd>
          </div>
        </dl>

        <table class="lines">
          <tbody>
            {
              // Never both: a payment is either against a membership fee
              // schedule (lines) or an additional-account opening amount
              // (accountLines, S-613) — one of the two is always empty.
              [...payment.lines, ...payment.accountLines].map(line => (
                <tr>
                  <td>{line.label}</td>
                  <td class="amount">
                    {formatMoney(line.amount, payment!.currency)}
                  </td>
                </tr>
              ))
            }
            <tr class="total">
              <td>Total</td>
              <td class="amount">
                {formatMoney(payment.totalAmount, payment.currency)}
              </td>
            </tr>
          </tbody>
        </table>

        {payment.varianceReason && <p class="note">{payment.varianceReason}</p>}

        <div class="signature">
          <div class="sig-line"></div>
          <p>For Al Barakah Multipurpose Co-operative Society Limited</p>
        </div>

        <div class="actions screen-only">
          <button type="button" id="print" data-payment-id={payment.id}>
            Print
          </button>
          {ownerHref && <a href={ownerHref}>Back</a>}
        </div>
      </div>

      {refunds.length > 0 && (
        <section class="screen-only panel">
          <h2>Refunded against this receipt</h2>
          <ul>
            {refunds.map(refund => (
              <li>
                <a href={`/receipts/${refund.id}`}>{refund.receiptNo}</a> ·{' '}
                {formatMoney(refund.totalAmount, refund.currency)} ·{' '}
                {dateFormat.format(refund.receivedAt)}
              </li>
            ))}
          </ul>
        </section>
      )}

      {canRefund && refundable.length > 0 && (
        <section class="screen-only panel">
          <h2>Refund</h2>
          {!anythingRefundable && (
            <p>Nothing on this receipt is still refundable.</p>
          )}
          <form method="post">
            <table class="lines">
              <tbody>
                {refundable.map(component => (
                  <tr>
                    <td>
                      <label for={`refund-${component.code}`}>
                        {component.label}
                      </label>
                      <span class="hint">
                        {component.blockedReason
                          ? component.blockedReason
                          : `${formatMoney(component.refundable)} of ${formatMoney(
                              component.paid
                            )} still refundable`}
                      </span>
                    </td>
                    <td class="amount">
                      <input
                        id={`refund-${component.code}`}
                        type="text"
                        inputmode="decimal"
                        name={`refund.${component.code}`}
                        value="0.00"
                        disabled={Number(component.refundable) === 0}
                      />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>

            <label>
              Method
              <select name="method">
                {paymentMethods.map(method => (
                  <option value={method.code}>{method.name}</option>
                ))}
              </select>
            </label>
            <label>
              Reference (cheque number, transfer reference)
              <input type="text" name="methodReference" />
            </label>
            <label>
              Reason
              <input type="text" name="reason" required />
            </label>

            <button
              type="submit"
              name="intent"
              value="refund"
              disabled={!anythingRefundable}
            >
              Record refund
            </button>
          </form>
        </section>
      )}

      {canVoid && !payment.voidedAt && (
        <section class="screen-only panel danger">
          <h2>Void this receipt</h2>
          <form method="post" id="void-form">
            <label>
              Reason
              <input type="text" name="reason" required />
            </label>
            <button type="submit" name="intent" value="void">
              Void {payment.receiptNo}
            </button>
          </form>
        </section>
      )}
    </>
  )}
</BaseLayout>

<script>
  const button = document.getElementById('print') as HTMLButtonElement | null;

  button?.addEventListener('click', async () => {
    const body = new FormData();
    body.set('intent', 'record-print');

    // Recorded before the dialog opens, and a failure to record does not stop
    // the print: the officer has an applicant waiting. The reprint mark is
    // then one print behind, which is the lesser of the two problems.
    try {
      await fetch(window.location.pathname, { method: 'POST', body });
    } catch {
      // Deliberately swallowed; see above.
    }
    window.print();
  });

  const voidForm = document.getElementById(
    'void-form'
  ) as HTMLFormElement | null;
  if (voidForm) {
    window.confirmedSubmit(
      voidForm,
      'Void this receipt? The number is never reused and the void is on ' +
        'the record.'
    );
  }
</script>
