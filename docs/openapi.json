                            "reachable",
                            "unreachable"
                          ]
                        },
                        "checkedAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    },
                    "correlationId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
