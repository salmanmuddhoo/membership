                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "memberReference",
                  "fileName",
                  "sizeBytes",
                  "contentType"
                ],
                "properties": {
                  "memberReference": {
                    "type": "string",
                    "examples": [
                      "ABM-000001"
                    ]
                  },
                  "fileName": {
                    "type": "string"
                  },
                  "sizeBytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "contentType": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
