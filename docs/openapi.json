            }
          },
          "429": {
            "description": "Rate limited. See the retry-after header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure. Quote the correlation id.",
            "content": {
