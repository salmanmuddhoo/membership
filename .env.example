# --- Backend provider ------------------------------------------------------
# Which backend powers auth. "supabase" today; "entra" is the target
# (Azure-native, Microsoft Entra External ID) — see
# docs/adr/0001-azure-native-backend.md. Test/preview and production are
# separated by setting variables per-environment (Vercel: Production vs Preview).
PUBLIC_AUTH_PROVIDER="supabase"

# --- Supabase (current backend) -------------------------------------------
# Project Settings -> API. The PUBLIC_ prefix exposes these to the browser,
# which is expected for the URL and anon key. Use a DIFFERENT project per env.
PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# --- Microsoft Entra External ID (target backend; server-side only) --------
# Set these once you switch PUBLIC_AUTH_PROVIDER to "entra". No PUBLIC_ prefix:
# these are secrets and must never reach the browser. One app registration per
# environment (test tenant vs production tenant).
# ENTRA_AUTHORITY="https://your-tenant.ciamlogin.com/"
# ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"
# ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# ENTRA_CLIENT_SECRET="your-client-secret"
# ENTRA_REDIRECT_URI="https://your-app-url/auth/callback"
# ENTRA_POST_LOGOUT_REDIRECT_URI="https://your-app-url/login"
# ENTRA_SCOPES="openid profile email offline_access"
# AUTH_SESSION_SECRET="a-long-random-secret-for-signing-session-cookies"

# --- Local scripts only (Supabase; retired with Supabase) -----------------
# Used by `pnpm create:user`. Secret — never commit or expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
