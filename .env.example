# --- Microsoft Entra External ID (OIDC) -----------------------------------
# The backend is Azure-native — see docs/adr/0001-azure-native-backend.md.
# SERVER-SIDE secrets: no PUBLIC_ prefix, never exposed to the browser. Use a
# separate app registration per environment (test vs prod), set per-scope in
# Vercel (Preview = test, Production = prod).

# EASIEST: paste the exact "OpenID Connect metadata document" URL from the app
# registration's Endpoints panel. If set, ENTRA_AUTHORITY/ENTRA_TENANT_ID below
# are not needed.
# ENTRA_METADATA_URL="https://<subdomain>.ciamlogin.com/<tenant-id>/v2.0/.well-known/openid-configuration"

# OR provide these two instead of ENTRA_METADATA_URL.
# NOTE: <subdomain> is your tenant's onmicrosoft prefix (a SINGLE label, e.g.
# "albarakah" from albarakah.onmicrosoft.com) — NOT a business domain like
# "albarakah.mu".
ENTRA_AUTHORITY="https://<subdomain>.ciamlogin.com/"
ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"

ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"
ENTRA_CLIENT_SECRET="your-client-secret"
ENTRA_REDIRECT_URI="http://localhost:4321/auth/callback"
ENTRA_POST_LOGOUT_REDIRECT_URI="http://localhost:4321/login"
ENTRA_SCOPES="openid profile email offline_access"

# Secret used to sign the app's own session cookie (any long random string).
# Generate one with:  openssl rand -base64 40
AUTH_SESSION_SECRET="a-long-random-secret-for-signing-session-cookies"

# --- PostgreSQL -----------------------------------------------------------
# Azure Database for PostgreSQL Flexible Server. Per environment, exactly like
# the Entra values above: the test server for the test environment, a separate
# production server for production. See docs/database.md.
#
# The APPLICATION connects as a least-privilege role that cannot change the
# schema. Never point this at the Azure admin account.
#
# Use sslmode=verify-full. node-postgres lets the connection string's sslmode
# override the code's own TLS setting, so this value — not the application —
# would otherwise decide whether traffic is encrypted. The app normalises it and
# refuses any mode that does not verify the certificate.
DATABASE_URL="postgresql://albarakah_app:<password>@<server>.postgres.database.azure.com:5432/albarakah?sslmode=verify-full"

# MIGRATIONS connect as the schema owner, which does have DDL rights. Used by
# the pipeline and by `pnpm migrate`; the running app never needs it.
DATABASE_MIGRATION_URL="postgresql://<owner>:<password>@<server>.postgres.database.azure.com:5432/albarakah?sslmode=verify-full"

# Per-instance connection ceiling. Serverless scales by process, so the server
# sees this multiplied by the number of warm instances — keep it small. An idle
# connection is kept for a minute so an officer's next click reuses it instead
# of opening a new one.
# DATABASE_POOL_MAX="3"
# DATABASE_IDLE_TIMEOUT_MS="60000"
# DATABASE_CONNECT_TIMEOUT_MS="10000"

# LOCAL DEVELOPMENT ONLY. Opens a plaintext connection, for a local cluster that
# has no TLS. Refused when PUBLIC_APP_ENV is production or unset.
# DATABASE_ALLOW_INSECURE="true"

# --- SharePoint document repository (Microsoft Graph) ---------------------
# NOTE: a DIFFERENT tenant from sign-in. Staff authenticate against the Entra
# External ID (CIAM) tenant above; SharePoint lives in Al Barakah's Microsoft
# 365 organisational tenant. Separate directory, separate app registration.
# See docs/documents.md.
#
# The application authenticates as itself (client credentials), not as the
# signed-in officer, so officers need no SharePoint licence.
GRAPH_TENANT_ID="00000000-0000-0000-0000-000000000000"
GRAPH_CLIENT_ID="00000000-0000-0000-0000-000000000000"
GRAPH_CLIENT_SECRET="your-graph-client-secret"
# The document library documents are filed in.
GRAPH_DRIVE_ID="b!xxxxxxxxxxxxxxxxxxxxx"

# --- API rate limiting (optional) -----------------------------------------
# A shared, database-backed counter — see docs/api.md. Defaults are generous:
# this slows abuse, it does not shape normal use.
# RATE_LIMIT_MAX_REQUESTS="300"
# RATE_LIMIT_WINDOW_SECONDS="60"
# LOCAL DEVELOPMENT ONLY: switch the limiter off entirely.
# RATE_LIMIT_DISABLED="true"

# --- Member mobile app (docs/member-app.md) --------------------------------
# Signs the member app's access tokens. Its OWN secret, never the value of
# AUTH_SESSION_SECRET: a staff cookie and a member token must never be
# interchangeable. At least 32 characters:  openssl rand -base64 40
MEMBER_SESSION_SECRET="a-different-long-random-secret-for-member-app-tokens"

# How one-time codes reach a member's phone. "http" posts { to, message }
# as JSON to the URL below — whichever SMS or WhatsApp gateway the Society
# uses — with MEMBER_OTP_WEBHOOK_TOKEN as a bearer token if set.
MEMBER_OTP_DELIVERY="http"
MEMBER_OTP_WEBHOOK_URL="https://<gateway>/send"
# MEMBER_OTP_WEBHOOK_TOKEN="your-gateway-token"

# NON-PRODUCTION ONLY (refused when PUBLIC_APP_ENV is production or unset):
# write codes to the server log instead of sending them, and/or accept one
# fixed six-digit code on every challenge so the app can be exercised
# against the test environment without a gateway.
# MEMBER_OTP_DELIVERY="log"
# MEMBER_OTP_FIXED_CODE="123456"

# Token lifetimes (optional).
# MEMBER_ACCESS_TOKEN_SECONDS="3600"
# MEMBER_REFRESH_TOKEN_DAYS="90"

# --- Environment label (optional, public) ---------------------------------
# Shown as a badge in the UI so Test and Production are never confused.
# Set to "test" on the test environment; leave "production" (or unset) on prod.
PUBLIC_APP_ENV="test"
