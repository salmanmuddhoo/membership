# --- Backend provider ------------------------------------------------------
# Which backend powers auth (and, later, data). "supabase" today; "azure" is
# reserved for a future production backend and not implemented yet.
# Test/preview and production are separated by setting these variables
# per-environment (in Vercel: Production vs Preview scopes) — the code is the
# same everywhere.
PUBLIC_AUTH_PROVIDER="supabase"

# --- Supabase (browser + server) ------------------------------------------
# From your Supabase project: Project Settings -> API. The PUBLIC_ prefix
# exposes these to the browser, which is expected for the URL and anon key.
# Use a DIFFERENT Supabase project for test vs production.
PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# --- Local scripts / CI only (NEVER expose to the browser) ----------------
# Used only by `pnpm create:user` to provision staff accounts. This is a
# SECRET: do not add a PUBLIC_ prefix and never commit it.
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
