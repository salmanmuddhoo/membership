# --- Microsoft Entra External ID (OIDC) -----------------------------------
# The backend is Azure-native — see docs/adr/0001-azure-native-backend.md.
# SERVER-SIDE secrets: no PUBLIC_ prefix, never exposed to the browser. Use a
# separate app registration per environment (test vs prod), set per-scope in
# Vercel (Preview = test, Production = prod).

# EASIEST: paste the exact "OpenID Connect metadata document" URL from the app
# registration's Endpoints panel. If set, ENTRA_AUTHORITY/ENTRA_TENANT_ID below
# are not needed.
# ENTRA_METADATA_URL="https://<subdomain>.ciamlogin.com/<tenant-id>/v2.0/.well-known/openid-configuration"

# OR provide these two instead of ENTRA_METADATA_URL.
# NOTE: <subdomain> is your tenant's onmicrosoft prefix (a SINGLE label, e.g.
# "albarakah" from albarakah.onmicrosoft.com) — NOT a business domain like
# "albarakah.mu".
ENTRA_AUTHORITY="https://<subdomain>.ciamlogin.com/"
ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"

ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"
ENTRA_CLIENT_SECRET="your-client-secret"
ENTRA_REDIRECT_URI="http://localhost:4321/auth/callback"
ENTRA_POST_LOGOUT_REDIRECT_URI="http://localhost:4321/login"
ENTRA_SCOPES="openid profile email offline_access"

# Secret used to sign the app's own session cookie (any long random string).
# Generate one with:  openssl rand -base64 40
AUTH_SESSION_SECRET="a-long-random-secret-for-signing-session-cookies"

# --- Environment label (optional, public) ---------------------------------
# Shown as a badge in the UI so Test and Production are never confused.
# Set to "test" on the test environment; leave "production" (or unset) on prod.
PUBLIC_APP_ENV="test"
