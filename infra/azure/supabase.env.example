# ---------------------------------------------------------------------------
# Self-hosted Supabase (production) — environment for the Docker stack.
# Copy to `.env` next to the official Supabase docker-compose.yml on the host.
# These are the values the Supabase self-hosting stack expects. NONE of these
# are the app's PUBLIC_ vars — only ANON_KEY and API_EXTERNAL_URL are later
# handed to the Vercel Production scope (see README).
# ---------------------------------------------------------------------------

############ Secrets — generate strong, unique values ############
# 40+ char random string. All JWTs (ANON_KEY, SERVICE_ROLE_KEY) are signed
# with this. Rotating it invalidates every issued token.
JWT_SECRET="replace-with-a-long-random-secret"

# Postgres superuser password (for the bundled db) OR the password of your
# Azure Database for PostgreSQL admin user if you use managed Postgres.
POSTGRES_PASSWORD="replace-with-strong-db-password"

# Supabase Studio (admin UI) basic-auth credentials.
DASHBOARD_USERNAME="albarakah-admin"
DASHBOARD_PASSWORD="replace-with-strong-password"

############ API keys — JWTs signed with JWT_SECRET ############
# Generate at https://supabase.com/docs/guides/self-hosting/docker#api-keys
#   anon:         { "role": "anon",         "iss": "supabase", "iat":..., "exp":... }
#   service_role: { "role": "service_role", "iss": "supabase", "iat":..., "exp":... }
ANON_KEY="replace-with-generated-anon-jwt"
SERVICE_ROLE_KEY="replace-with-generated-service-role-jwt"

############ URLs — must be the PUBLIC https URL of this deployment ############
# e.g. https://api.albarakah.example.com  (the domain pointing at this host)
API_EXTERNAL_URL="https://api.your-domain.com"
SUPABASE_PUBLIC_URL="https://api.your-domain.com"
# The app's own URL (used in auth emails / redirect allow-list).
SITE_URL="https://app.your-domain.com"
ADDITIONAL_REDIRECT_URLS=""

############ Auth (GoTrue) ############
# We use email + password only. Disable public sign-ups (staff are provisioned).
DISABLE_SIGNUP="true"
# Staff accounts are created confirmed via the admin API, so email sending is
# optional. Configure SMTP only if you later need password-reset emails.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_ADMIN_EMAIL="no-reply@your-domain.com"
# SMTP_SENDER_NAME="Al Barakah MCSL"

############ Managed Azure Postgres (optional) ############
# Leave blank to use the Postgres bundled in the compose. To use Azure Database
# for PostgreSQL Flexible Server instead, point the stack at it:
# POSTGRES_HOST="your-server.postgres.database.azure.com"
# POSTGRES_PORT="5432"
# POSTGRES_DB="postgres"
